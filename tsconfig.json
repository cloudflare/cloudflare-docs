{
	"extends": "astro/tsconfigs/strict",
	"compilerOptions": {
		"baseUrl": ".",
		"target": "ESNext",
		"paths": {
			"~/*": ["src/*"]
		},
		"jsx": "react-jsx",
		"jsxImportSource": "react"
	},
	"include": ["src", ".astro/types.d.ts", "**/*.astro", "**/*.ts", "**/*.tsx"],
	"exclude": ["dist", "worker"]
}
