{
	"name": "cloudflare-docs-flue",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "Flue-powered docs bot for cloudflare/cloudflare-docs. Deployed as a Cloudflare Worker.",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"evals": "vitest run --config vitest.evals.config.ts",
		"evals:json": "vitest run --config vitest.evals.config.ts --reporter=vitest-evals/reporter --reporter=json --outputFile.json=vitest-results.json"
	},
	"dependencies": {
		"@cloudflare/workers-types": "4.20260526.1",
		"@flue/runtime": "0.4.0-nightly.202605211826",
		"@octokit/auth-app": "8.3.1",
		"agents": "0.24.0",
		"hono": "4.13.8",
		"valibot": "1.5.0"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "1.56.0",
		"@flue/cli": "0.4.0-nightly.202605211826",
		"@flue/sdk": "0.4.0-nightly.202605211826",
		"@flue/vite": "0.4.0-nightly.202605211826",
		"typescript": "5.9.3",
		"vite": "8.3.0",
		"vitest": "4.1.10",
		"vitest-evals": "0.17.0",
		"wrangler": "4.135.0"
	}
}
