{
	"name": "cloudflare-docs-flue",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "Flue-powered docs bot for cloudflare/cloudflare-docs. Deployed as a Cloudflare Worker.",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit",
		"test": "vitest run && python3 -m unittest discover -s bin -p '*_test.py'",
		"evals": "vitest run --config vitest.evals.config.ts",
		"evals:json": "vitest run --config vitest.evals.config.ts --reporter=vitest-evals/reporter --reporter=json --outputFile.json=vitest-results.json",
		"types": "wrangler types --config wrangler.jsonc --include-runtime=false --strict-vars=false"
	},
	"dependencies": {
		"@cloudflare/sandbox": "0.12.9",
		"@flue/runtime": "2.0.3",
		"@octokit/auth-app": "8.2.0",
		"hono": "4.12.25",
		"valibot": "1.4.1"
	},
	"devDependencies": {
		"@babel/core": "8.0.5",
		"@cloudflare/vite-plugin": "1.46.0",
		"@cloudflare/workers-types": "5.20260911.1",
		"@flue/cli": "2.0.3",
		"@flue/vite": "2.0.3",
		"@types/node": "24.13.4",
		"typescript": "5.9.3",
		"vite": "8.1.2",
		"vitest": "4.1.10",
		"vitest-evals": "0.15.0",
		"wrangler": "4.113.0"
	}
}
