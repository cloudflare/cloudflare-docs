{
	"$schema": "../node_modules/wrangler/config-schema.json",
	"name": "cloudflare-docs-flue",
	"account_id": "b54f07a6c269ecca2fa60f1ae4920c99",
	"compatibility_date": "2026-04-01",
	"compatibility_flags": ["nodejs_compat"],
	"ai": {
		"binding": "AI",
	},
	"worker_loaders": [{ "binding": "LOADER" }],
	"r2_buckets": [
		{
			"binding": "DOCS_FLUE_BUCKET",
			"bucket_name": "docs-flue-bucket",
		},
	],
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"FlueRegistry",
				"OrchestrateWorkflow",
				"CodeReviewOrchestratorWorkflow",
				"SpamAndOffTopicFilterWorkflow",
				"StyleGuideReviewWorkflow",
			],
		},
		{
			"tag": "v2",
			"new_sqlite_classes": ["DependabotReviewWorkflow"],
		},
		{
			"tag": "v3",
			"renamed_classes": [
				{ "from": "OrchestrateWorkflow", "to": "FlueOrchestrateWorkflow" },
				{
					"from": "CodeReviewOrchestratorWorkflow",
					"to": "FlueCodeReviewOrchestratorWorkflow",
				},
				{
					"from": "SpamAndOffTopicFilterWorkflow",
					"to": "FlueSpamAndOffTopicFilterWorkflow",
				},
				{
					"from": "StyleGuideReviewWorkflow",
					"to": "FlueStyleGuideReviewWorkflow",
				},
				{
					"from": "DependabotReviewWorkflow",
					"to": "FlueDependabotReviewWorkflow",
				},
			],
		},
		{
			// The style-guide-review workflow was retired: its per-file review now
			// runs in-process inside the style-guide-specialist workflow via
			// concurrent sessions (lib/style-guide-inproc.ts), so the standalone
			// workflow's Durable Object class is no longer generated.
			"tag": "v4",
			"deleted_classes": ["FlueStyleGuideReviewWorkflow"],
		},
		{
			// The code review and style-guide fan-outs were split back out of the
			// orchestrator into their own specialist workflows, so each runs in its
			// own Durable Object isolate (own memory budget) instead of competing
			// for the orchestrator DO's. See workflows/{code-review,style-guide}-specialist.ts.
			"tag": "v5",
			"new_sqlite_classes": [
				"FlueCodeReviewSpecialistWorkflow",
				"FlueStyleGuideSpecialistWorkflow",
			],
		},
		{
			// The finalize-review workflow handles reconciliation, rendering, and
			// posting the review comment. It is admitted by whichever specialist
			// finishes last via an R2 rendezvous lock, replacing the orchestrator's
			// 20-minute specialist poll. See workflows/finalize-review.ts.
			"tag": "v6",
			"new_sqlite_classes": ["FlueFinalizeReviewWorkflow"],
		},
		{
			// The specialist DOs accumulated too much SQLite state from crashed runs
			// (each OOM leaves orphaned session data), causing the Flue alarm recovery
			// handler to OOM on startup in a death spiral. Phase 1: rename the bloated
			// instances out of the way (abandoned). Phase 2 (v8): recreate fresh
			// instances with the original names so the bindings still work.
			"tag": "v7",
			"renamed_classes": [
				{
					"from": "FlueCodeReviewSpecialistWorkflow",
					"to": "FlueCodeReviewSpecialistWorkflowOld",
				},
				{
					"from": "FlueStyleGuideSpecialistWorkflow",
					"to": "FlueStyleGuideSpecialistWorkflowOld",
				},
			],
		},
		{
			// Phase 2: recreate the specialist classes with empty storage. The *Old
			// instances from v7 are orphaned and stop receiving traffic.
			"tag": "v8",
			"new_sqlite_classes": [
				"FlueCodeReviewSpecialistWorkflow",
				"FlueStyleGuideSpecialistWorkflow",
			],
		},
	],
	// Explicitly empty crons list so wrangler clears any previously registered
	// cron triggers on deploy (an absent triggers key leaves existing ones intact).
	"triggers": {
		"crons": [],
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true,
			"invocation_logs": false,
		},
		"traces": {
			"enabled": true,
			"persist": true,
			"head_sampling_rate": 1,
		},
	},

}
