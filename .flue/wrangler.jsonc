{
	"$schema": "../node_modules/wrangler/config-schema.json",
	"name": "cloudflare-docs-flue",
	"account_id": "b54f07a6c269ecca2fa60f1ae4920c99",
	"compatibility_date": "2026-04-01",
	"compatibility_flags": ["nodejs_compat"],
	"ai": {
		"binding": "AI",
	},
	"worker_loaders": [{ "binding": "LOADER" }],
	"r2_buckets": [
		{
			"binding": "DOCS_FLUE_BUCKET",
			"bucket_name": "docs-flue-bucket",
		},
	],
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"FlueRegistry",
				"OrchestrateWorkflow",
				"CodeReviewOrchestratorWorkflow",
				"SpamAndOffTopicFilterWorkflow",
				"StyleGuideReviewWorkflow",
			],
		},
		{
			"tag": "v2",
			"new_sqlite_classes": ["DependabotReviewWorkflow"],
		},
		{
			"tag": "v3",
			"renamed_classes": [
				{ "from": "OrchestrateWorkflow", "to": "FlueOrchestrateWorkflow" },
				{
					"from": "CodeReviewOrchestratorWorkflow",
					"to": "FlueCodeReviewOrchestratorWorkflow",
				},
				{
					"from": "SpamAndOffTopicFilterWorkflow",
					"to": "FlueSpamAndOffTopicFilterWorkflow",
				},
				{
					"from": "StyleGuideReviewWorkflow",
					"to": "FlueStyleGuideReviewWorkflow",
				},
				{
					"from": "DependabotReviewWorkflow",
					"to": "FlueDependabotReviewWorkflow",
				},
			],
		},
		{
			// The style-guide-review workflow was retired: its per-file review now
			// runs in-process inside the code-review orchestrator via concurrent
			// sessions (lib/style-guide-inproc.ts), so the standalone workflow's
			// Durable Object class is no longer generated.
			"tag": "v4",
			"deleted_classes": ["FlueStyleGuideReviewWorkflow"],
		},
		{
			// The code review and style-guide fan-outs were split back out of the
			// orchestrator into their own specialist workflows, so each runs in its
			// own Durable Object isolate (own memory budget) instead of competing
			// for the orchestrator DO's. See workflows/{code-review,style-guide}-specialist.ts.
			"tag": "v5",
			"new_sqlite_classes": [
				"FlueCodeReviewSpecialistWorkflow",
				"FlueStyleGuideSpecialistWorkflow",
			],
		},
	],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true,
			"invocation_logs": false,
		},
		"traces": {
			"enabled": true,
			"persist": true,
			"head_sampling_rate": 1,
		},
	},
	// Cron trigger for the code-review watchdog (lib/review-watchdog.ts). Runs
	// every 2 minutes to re-drive reviews whose orchestrator Durable Object was
	// interrupted (Flue does not resume interrupted workflows).
	"triggers": {
		"crons": ["*/2 * * * *"],
	},
	"vars": {
		// Origin the scheduled handler uses to self-admit recovery runs. A
		// scheduled invocation has no inbound request to derive the origin from.
		"DOCS_FLUE_BASE_URL": "https://cloudflare-docs-flue.cloudflare-docs.workers.dev",
	},
}
