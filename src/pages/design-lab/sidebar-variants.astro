---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import type { StarlightPageProps } from "@astrojs/starlight/props";
import { Icon as AstroIcon } from "astro-icon/components";

const props = {
	frontmatter: {
		title: "Sidebar Nav — Final Variants",
		description:
			"Five high-fidelity sidebar variants informed by the adversarial suggestion pipeline.",
		template: "doc",
		tableOfContents: false,
	},
	hasSidebar: false,
	hideBreadcrumbs: true,
	headings: [],
} as StarlightPageProps;

const navItems = [
	{ label: "Overview", active: true },
	{ label: "Get started", group: false },
	{ label: "Configuration", group: false },
	{ label: "Runtime APIs", group: true },
	{ label: "Workers AI", group: true },
	{ label: "Observability", group: true },
	{ label: "Cron Triggers", group: false },
	{ label: "Examples", group: true },
	{ label: "Wrangler", group: true },
	{ label: "Platform", group: true },
];

const computeSiblings = [
	{ label: "Workers", slug: "workers", active: true },
	{ label: "Pages", slug: "pages", active: false },
	{ label: "Containers", slug: "containers", active: false },
	{ label: "Workflows", slug: "workflows", active: false },
	{ label: "Durable Objects", slug: "durable-objects", active: false },
	{ label: "Queues", slug: "queues", active: false },
	{ label: "Pipelines", slug: "pipelines", active: false },
];

const taxonomyGroups = [
	{
		label: "Compute",
		icon: "workers",
		products: [
			"Workers",
			"Pages",
			"Containers",
			"Workflows",
			"Durable Objects",
			"Queues",
			"Pipelines",
		],
	},
	{
		label: "AI",
		icon: "workers-ai",
		products: ["Workers AI", "AI Gateway", "Vectorize", "Browser Rendering"],
	},
	{
		label: "Storage & Database",
		icon: "kv",
		products: ["D1", "R2", "KV", "Hyperdrive"],
	},
	{
		label: "Media",
		icon: "images",
		products: ["Images", "Stream", "Realtime"],
	},
];
---

<StarlightPage {...props}>
	<p class="lab-intro">
		Five variants informed by the adversarial pipeline. Key principles:
		search-first for 99 products, passive breadcrumb context, no full taxonomy
		in the sidebar. All interactive — click to test. Product: <strong
			>Workers</strong
		> (Build → Compute).
	</p>

	<div class="lab-grid">
		<!-- ────────────────────────────────────────
		     BASELINE — Current production sidebar
		     ──────────────────────────────────────── -->
		<div class="lab-col">
			<div class="lab-tag baseline">Current</div>
			<div class="sb">
				<div class="sb-sticky">
					<div class="sb-product-title">
						<a href="/workers/" class="sb-product-link">
							<AstroIcon name="workers" size="32px" class="sb-icon" />
							<span class="sb-name">Cloudflare Workers</span>
						</a>
					</div>
					<div class="sb-search-wrap">
						<input
							class="sb-search"
							type="text"
							placeholder="Search sidebar..."
							disabled
						/>
						<span class="sb-search-hint">/</span>
					</div>
				</div>
				<nav class="sb-nav">
					{
						navItems.map((item) => (
							<a
								class:list={[
									"sb-nav-item",
									{ active: item.active, group: item.group },
								]}
							>
								<span>{item.label}</span>
								{item.group && <span class="sb-caret">›</span>}
							</a>
						))
					}
				</nav>
			</div>
			<p class="lab-note">
				No category context. No way to switch products without going back to the
				homepage.
			</p>
		</div>

		<!-- ════════════════════════════════════════
		     1 — COMMAND PALETTE PRODUCT FINDER
		     Separate from sidebar search. ⌘K or
		     button opens a full overlay with
		     taxonomy-grouped search.
		     ════════════════════════════════════════ -->
		<div class="lab-col">
			<div class="lab-tag">1</div>
			<div class="sb v1-sb">
				<div class="sb-sticky">
					<div class="sb-product-title">
						<a href="/workers/" class="sb-product-link">
							<AstroIcon name="workers" size="32px" class="sb-icon" />
							<span class="sb-name">Cloudflare Workers</span>
						</a>
						<button
							class="v1-switch-btn"
							data-v1-open
							aria-label="Switch product"
						>
							<svg width="16" height="16" viewBox="0 0 16 16" fill="none"
								><path
									d="M6 2h4M6 14h4M2 6v4M14 6v4"
									stroke="currentColor"
									stroke-width="1.5"
									stroke-linecap="round"></path></svg
							>
						</button>
					</div>
					<div class="sb-search-wrap">
						<input
							class="sb-search"
							type="text"
							placeholder="Search sidebar..."
							disabled
						/>
						<span class="sb-search-hint">/</span>
					</div>
				</div>
				<nav class="sb-nav">
					{
						navItems.map((item) => (
							<a
								class:list={[
									"sb-nav-item",
									{ active: item.active, group: item.group },
								]}
							>
								<span>{item.label}</span>
								{item.group && <span class="sb-caret">›</span>}
							</a>
						))
					}
				</nav>

				<!-- Overlay -->
				<div class="v1-overlay" data-v1-overlay>
					<div class="v1-palette">
						<div class="v1-palette-search-wrap">
							<svg
								class="v1-search-icon"
								width="14"
								height="14"
								viewBox="0 0 16 16"
								fill="none"
								><circle
									cx="7"
									cy="7"
									r="5.5"
									stroke="currentColor"
									stroke-width="1.5"></circle><path
									d="m11 11 3.5 3.5"
									stroke="currentColor"
									stroke-width="1.5"
									stroke-linecap="round"></path></svg
							>
							<input
								class="v1-palette-search"
								type="text"
								placeholder="Search all products..."
								data-v1-search
								autofocus
							/>
							<kbd class="v1-kbd">esc</kbd>
						</div>
						<div class="v1-palette-body" data-v1-body>
							<div class="v1-section-label">Build</div>
							{
								taxonomyGroups.map((group) => (
									<div class="v1-group">
										<div class="v1-group-label">
											<AstroIcon
												name={group.icon}
												size="14px"
												class="v1-group-icon"
											/>
											{group.label}
										</div>
										{group.products.map((p) => (
											<a
												class:list={["v1-product", { active: p === "Workers" }]}
												href="#"
											>
												{p}
												{p === "Workers" && (
													<span class="v1-current">current</span>
												)}
											</a>
										))}
									</div>
								))
							}
							<div class="v1-section-label" style="margin-top: 0.5rem;">
								Protect &amp; Connect
							</div>
							<div class="v1-group">
								<div class="v1-group-label">
									<AstroIcon name="waf" size="14px" class="v1-group-icon" />
									Application Security
								</div>
								<a class="v1-product" href="#">WAF</a>
								<a class="v1-product" href="#">DDoS Protection</a>
								<a class="v1-product" href="#">SSL/TLS</a>
							</div>
						</div>
					</div>
				</div>
			</div>
			<p class="lab-note">
				<strong>Command palette.</strong> A dedicated switch button (or ⌘K) opens
				a search-first product finder as a full overlay. Taxonomy groups visible
				while searching. Handles 99 products gracefully because search is primary,
				not browsing.
			</p>
		</div>

		<!-- ════════════════════════════════════════
		     2 — INLINE EXPANDABLE SWITCHER
		     Product title expands to reveal a
		     compact categorized product picker.
		     ════════════════════════════════════════ -->
		<div class="lab-col">
			<div class="lab-tag">2</div>
			<div class="sb">
				<div class="sb-sticky">
					<div class="sb-product-title">
						<button class="v2-trigger" data-v2-trigger>
							<AstroIcon name="workers" size="32px" class="sb-icon" />
							<div class="v2-title-text">
								<span class="sb-name">Cloudflare Workers</span>
								<span class="v2-context">Build › Compute</span>
							</div>
							<span class="v2-chevron" data-v2-chevron>‹</span>
						</button>
					</div>
					<div class="v2-panel" data-v2-panel>
						<input
							class="v2-filter"
							type="text"
							placeholder="Find a product..."
							data-v2-filter
						/>
						<div class="v2-panel-body" data-v2-panel-body>
							{
								taxonomyGroups.map((group) => (
									<div class="v2-group">
										<div class="v2-group-label">
											<AstroIcon
												name={group.icon}
												size="13px"
												class="v2-group-icon"
											/>
											{group.label}
										</div>
										<div class="v2-group-items">
											{group.products.map((p) => (
												<a
													class:list={["v2-item", { active: p === "Workers" }]}
													href="#"
												>
													{p}
												</a>
											))}
										</div>
									</div>
								))
							}
						</div>
						<a href="/" class="v2-all-link">All products →</a>
					</div>
					<div class="sb-search-wrap">
						<input
							class="sb-search"
							type="text"
							placeholder="Search sidebar..."
							disabled
						/>
						<span class="sb-search-hint">/</span>
					</div>
				</div>
				<nav class="sb-nav">
					{
						navItems.map((item) => (
							<a
								class:list={[
									"sb-nav-item",
									{ active: item.active, group: item.group },
								]}
							>
								<span>{item.label}</span>
								{item.group && <span class="sb-caret">›</span>}
							</a>
						))
					}
				</nav>
			</div>
			<p class="lab-note">
				<strong>Inline switcher.</strong> Product title is clickable — expands a
				compact panel with search + categorized product list. Panel pushes content
				down (not an overlay). Category context always visible as subtitle.
			</p>
		</div>

		<!-- ════════════════════════════════════════
		     3 — BREADCRUMB TITLE WITH POPOVERS
		     Compact breadcrumb format. Clicking
		     segments opens popovers showing
		     siblings at that level.
		     ════════════════════════════════════════ -->
		<div class="lab-col">
			<div class="lab-tag">3</div>
			<div class="sb">
				<div class="sb-sticky">
					<div class="sb-product-title v3-title">
						<AstroIcon name="workers" size="32px" class="sb-icon" />
						<div class="v3-crumbs">
							<a href="/" class="v3-crumb-link">Build</a>
							<span class="v3-crumb-sep">›</span>
							<button class="v3-crumb-btn" data-v3-trigger>
								Compute
								<svg
									width="10"
									height="10"
									viewBox="0 0 10 10"
									class="v3-crumb-chevron"
									><path
										d="M2.5 4 5 6.5 7.5 4"
										stroke="currentColor"
										stroke-width="1.25"
										fill="none"
										stroke-linecap="round"
										stroke-linejoin="round"></path></svg
								>
							</button>
							<div class="v3-popover" data-v3-popover>
								{
									computeSiblings.map((p) => (
										<a
											class:list={["v3-pop-item", { active: p.active }]}
											href={`/${p.slug}/`}
										>
											<AstroIcon
												name={p.slug}
												size="16px"
												class="v3-pop-icon"
											/>
											{p.label}
										</a>
									))
								}
							</div>
							<span class="v3-crumb-sep">›</span>
							<span class="v3-crumb-current">Workers</span>
						</div>
					</div>
					<div class="sb-search-wrap">
						<input
							class="sb-search"
							type="text"
							placeholder="Search sidebar..."
							disabled
						/>
						<span class="sb-search-hint">/</span>
					</div>
				</div>
				<nav class="sb-nav">
					{
						navItems.map((item) => (
							<a
								class:list={[
									"sb-nav-item",
									{ active: item.active, group: item.group },
								]}
							>
								<span>{item.label}</span>
								{item.group && <span class="sb-caret">›</span>}
							</a>
						))
					}
				</nav>
			</div>
			<p class="lab-note">
				<strong>Breadcrumb with popovers.</strong> Replaces the product title with
				a full breadcrumb trail. Clicking "Compute" opens a popover with sibling
				products. Passive context + quick switching in one element.
			</p>
		</div>

		<!-- ════════════════════════════════════════
		     4 — DUAL-MODE SEARCH
		     Sidebar search has two modes: current
		     product (default) and all products.
		     Tab to switch.
		     ════════════════════════════════════════ -->
		<div class="lab-col">
			<div class="lab-tag">4</div>
			<div class="sb">
				<div class="sb-sticky">
					<div class="sb-product-title">
						<a href="/workers/" class="sb-product-link">
							<AstroIcon name="workers" size="32px" class="sb-icon" />
							<div class="v4-title-stack">
								<span class="sb-name">Cloudflare Workers</span>
								<span class="v4-subtitle">Build › Compute</span>
							</div>
						</a>
					</div>
					<div class="v4-search-area">
						<div class="v4-tabs">
							<button class="v4-tab active" data-v4-tab="sidebar"
								>Sidebar</button
							>
							<button class="v4-tab" data-v4-tab="products">All Products</button
							>
						</div>
						<div class="sb-search-wrap">
							<input
								class="sb-search"
								type="text"
								placeholder="Search sidebar..."
								data-v4-input
							/>
							<span class="sb-search-hint">/</span>
						</div>
					</div>
				</div>
				<div class="v4-product-results" data-v4-results>
					{
						taxonomyGroups.slice(0, 2).map((group) => (
							<div class="v4-result-group">
								<div class="v4-result-label">
									<AstroIcon
										name={group.icon}
										size="13px"
										class="v4-result-icon"
									/>
									{group.label}
								</div>
								{group.products.map((p) => (
									<a
										class:list={["v4-result-item", { active: p === "Workers" }]}
										href="#"
									>
										{p}
									</a>
								))}
							</div>
						))
					}
				</div>
				<nav class="sb-nav" data-v4-nav>
					{
						navItems.map((item) => (
							<a
								class:list={[
									"sb-nav-item",
									{ active: item.active, group: item.group },
								]}
							>
								<span>{item.label}</span>
								{item.group && <span class="sb-caret">›</span>}
							</a>
						))
					}
				</nav>
			</div>
			<p class="lab-note">
				<strong>Dual-mode search.</strong> The search bar gains a tab toggle: "Sidebar"
				(default) searches the current product tree, "All Products" shows the full
				taxonomy. One input, two modes. Category context as subtitle.
			</p>
		</div>

		<!-- ════════════════════════════════════════
		     5 — SIBLING STRIP + BREADCRUMB
		     Horizontal scrollable strip of sibling
		     product icons below the product title.
		     ════════════════════════════════════════ -->
		<div class="lab-col">
			<div class="lab-tag">5</div>
			<div class="sb">
				<div class="sb-sticky">
					<div class="sb-product-title">
						<a href="/workers/" class="sb-product-link">
							<AstroIcon name="workers" size="32px" class="sb-icon" />
							<div class="v5-title-stack">
								<span class="sb-name">Cloudflare Workers</span>
								<a href="/" class="v5-breadcrumb">Build › Compute</a>
							</div>
						</a>
					</div>
					<div class="v5-strip-wrap">
						<div class="v5-strip">
							{
								computeSiblings.map((p) => (
									<a
										class:list={["v5-chip", { active: p.active }]}
										href={`/${p.slug}/`}
										title={p.label}
									>
										<AstroIcon name={p.slug} size="16px" class="v5-chip-icon" />
										<span class="v5-chip-label">{p.label}</span>
									</a>
								))
							}
						</div>
					</div>
					<div class="sb-search-wrap">
						<input
							class="sb-search"
							type="text"
							placeholder="Search sidebar..."
							disabled
						/>
						<span class="sb-search-hint">/</span>
					</div>
				</div>
				<nav class="sb-nav">
					{
						navItems.map((item) => (
							<a
								class:list={[
									"sb-nav-item",
									{ active: item.active, group: item.group },
								]}
							>
								<span>{item.label}</span>
								{item.group && <span class="sb-caret">›</span>}
							</a>
						))
					}
				</nav>
			</div>
			<p class="lab-note">
				<strong>Sibling strip.</strong> A horizontal scrollable row of sibling product
				icons below the title. Active product is highlighted. Breadcrumb subtitle
				for category context. Enables one-click switching to related products.
			</p>
		</div>
	</div>
</StarlightPage>

<script>
	/* ═══ 1 — Command palette ═══ */
	document.querySelectorAll("[data-v1-open]").forEach((btn) => {
		btn.addEventListener("click", () => {
			const overlay = btn
				.closest(".sb")
				?.querySelector("[data-v1-overlay]") as HTMLElement;
			if (overlay) {
				overlay.classList.add("open");
				(
					overlay.querySelector("[data-v1-search]") as HTMLInputElement
				)?.focus();
			}
		});
	});
	document.querySelectorAll("[data-v1-overlay]").forEach((overlay) => {
		overlay.addEventListener("click", (e) => {
			if (e.target === overlay) overlay.classList.remove("open");
		});
	});
	document.querySelectorAll("[data-v1-search]").forEach((input) => {
		input.addEventListener("keydown", (e) => {
			if ((e as KeyboardEvent).key === "Escape") {
				(input as HTMLElement)
					.closest("[data-v1-overlay]")
					?.classList.remove("open");
			}
		});
	});

	/* ═══ 2 — Inline switcher ═══ */
	document.querySelectorAll("[data-v2-trigger]").forEach((btn) => {
		btn.addEventListener("click", () => {
			const panel = btn
				.closest(".sb-sticky")
				?.querySelector("[data-v2-panel]") as HTMLElement;
			const chevron = btn.querySelector("[data-v2-chevron]") as HTMLElement;
			if (panel) {
				const isOpen = panel.classList.toggle("open");
				chevron?.classList.toggle("open", isOpen);
				if (isOpen) {
					(
						panel.querySelector("[data-v2-filter]") as HTMLInputElement
					)?.focus();
				}
			}
		});
	});

	/* ═══ 3 — Breadcrumb popover ═══ */
	document.querySelectorAll("[data-v3-trigger]").forEach((btn) => {
		btn.addEventListener("click", (e) => {
			e.stopPropagation();
			const pop = btn.parentElement?.querySelector(
				"[data-v3-popover]",
			) as HTMLElement;
			pop?.classList.toggle("open");
		});
	});
	document.addEventListener("click", () => {
		document
			.querySelectorAll("[data-v3-popover].open")
			.forEach((p) => p.classList.remove("open"));
	});

	/* ═══ 4 — Dual-mode search ═══ */
	document.querySelectorAll("[data-v4-tab]").forEach((tab) => {
		tab.addEventListener("click", () => {
			const parent = tab.closest(".sb");
			if (!parent) return;
			parent
				.querySelectorAll("[data-v4-tab]")
				.forEach((t) => t.classList.remove("active"));
			tab.classList.add("active");
			const mode = (tab as HTMLElement).dataset.v4Tab;
			const results = parent.querySelector("[data-v4-results]") as HTMLElement;
			const nav = parent.querySelector("[data-v4-nav]") as HTMLElement;
			const input = parent.querySelector("[data-v4-input]") as HTMLInputElement;
			if (mode === "products") {
				results?.classList.add("open");
				nav?.classList.add("hidden");
				if (input) input.placeholder = "Search all products...";
			} else {
				results?.classList.remove("open");
				nav?.classList.remove("hidden");
				if (input) input.placeholder = "Search sidebar...";
			}
		});
	});
</script>

<style is:global>
	/* ─── Layout ─── */
	.right-sidebar-container,
	mobile-starlight-toc {
		display: none;
	}
	.main-pane {
		justify-items: center;
	}
	.sl-markdown-content {
		max-width: 100%;
	}

	.lab-intro {
		max-width: 720px;
		color: var(--sl-color-gray-3);
		font-size: 0.9375rem;
		line-height: 1.6;
		margin-bottom: 2rem;
	}
	.lab-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
		gap: 2.5rem;
		padding-bottom: 4rem;
	}
	.lab-col {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}
	.lab-tag {
		display: inline-flex;
		align-self: flex-start;
		align-items: center;
		justify-content: center;
		min-width: 1.5rem;
		height: 1.5rem;
		padding: 0 0.375rem;
		border-radius: 6px;
		font-size: 0.6875rem;
