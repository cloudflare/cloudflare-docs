---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import ModelCatalog from "~/components/ModelCatalog.tsx";
import { getLegacyModels } from "~/util/model-resolver";
import { Aside } from "~/components";

const models = await getLegacyModels();
---

<StarlightPage
	frontmatter={{ title: "Workers AI Models", tableOfContents: false }}
>
	<Aside type="tip" title="Looking for more models?">
		Looking for all available AI models including external providers? Check out
		the <a href="/ai/models/">unified AI model catalog</a>.
	</Aside>
	<ModelCatalog models={models} client:load />
</StarlightPage>

<style>
	:root {
		--sl-content-width: 1350px !important;
	}
</style>
