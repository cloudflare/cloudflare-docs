const props = {
	frontmatter: {
		title: "Cloudflare Developer Docs",
		description:
			"Build, protect, and accelerate anything on Cloudflare's global network. Deploy serverless applications, secure your perimeter, and deliver content from 330+ cities worldwide.",
		template: "doc",
		tableOfContents: false,
	},
	sidebar,
	hasSidebar: true,
	hideBreadcrumbs: true,
	hideTitle: true,
	headings: [],
} as StarlightPageProps;
---

<StarlightPage {...props}>
	<div class="landing-root">
		<div class="relative">
			<FullPageLines />
			<StructuralGrid />
			<main class="relative z-10 mx-auto max-w-[1280px]" id="main-content">
				<!-- Origin marker -->
				<div class="relative h-0 max-[1024px]:hidden">
					<div class="pointer-events-none absolute inset-0">
						<svg
							class="v27-broadcast"
							width="56"
							height="56"
							viewBox="0 0 56 56"
							style="animation-delay:0s;margin-left:0;margin-top:32px"
							><line
								x1="0"
								y1="28"
								x2="56"
								y2="28"
								stroke="#f56500"
								stroke-width="1"></line><line
								x1="28"
								y1="0"
								x2="28"
								y2="56"
								stroke="#f56500"
								stroke-width="1"></line></svg
						>
						<svg
							class="v27-broadcast"
							width="56"
							height="56"
							viewBox="0 0 56 56"
							style="animation-delay:2s;margin-left:0;margin-top:32px"
							><line
								x1="0"
								y1="28"
								x2="56"
								y2="28"
								stroke="#f56500"
								stroke-width="1"></line><line
								x1="28"
								y1="0"
								x2="28"
								y2="56"
								stroke="#f56500"
								stroke-width="1"></line></svg
						>
						<svg
							class="v27-origin-static"
							width="28"
							height="28"
							viewBox="0 0 28 28"
							style="margin-left:0;margin-top:32px"
							><line
								x1="0"
								y1="14"
								x2="28"
								y2="14"
								stroke="#f56500"
								stroke-width="1"></line><line
								x1="14"
								y1="0"
								x2="14"
								y2="28"
								stroke="#f56500"
								stroke-width="1"></line></svg
						>
					</div>
				</div>

				<Hero />
				<PlatformStats />

				<BuildFromScratch />

				<RequestLifecycle />

				<SecureSection />

				<AccelerateSection />
			</main>
		</div>
	</div>
</StarlightPage>

<script>
	// Instant scroll to hash target on page load (no smooth animation).
	// Subsequent in-page clicks use CSS scroll-behavior: smooth.
	{
		const hash = window.location.hash;
		if (hash.length > 1) {
			let target: Element | null = null;
			let id = hash.slice(1);
			try {
				id = decodeURIComponent(id);
			} catch {
				// keep raw id when hash is malformed
			}
			target = document.getElementById(id);
			if (!target) {
				try {
					target = document.querySelector(hash);
				} catch {
					target = null;
				}
			}
			if (target) {
				// Temporarily disable smooth scrolling for the initial jump
				const html = document.documentElement;
				const prev = html.style.scrollBehavior;
				html.style.scrollBehavior = "auto";
				requestAnimationFrame(() => {
					target.scrollIntoView();
					// Restore after the frame so future clicks are smooth again
					requestAnimationFrame(() => {
						html.style.scrollBehavior = prev;
					});
				});
			}
		}
	}
</script>

<style is:global>
	/* Starlight layout overrides */
	.right-sidebar-container,
	mobile-starlight-toc {
		display: none;
	}

	.main-frame {
		padding-top: var(--sl-nav-height);
	}
	.main-pane {
		padding: 0;
		gap: 0;
		isolation: isolate;
		z-index: 0;
	}
	.content-panel {
		padding: 0;
		margin: 0;
		overflow: visible;
	}
	.sl-container {
		max-width: none;
		margin: 0;
		padding: 0;
		overflow: visible;
	}
	.sl-markdown-content {
		margin: 0;
		padding: 0;
		overflow: visible;
	}
	.sl-markdown-content > :first-child {
		margin-top: 0;
	}
	.sl-markdown-content
		:not(a, strong, em, del, span, input, code, br)
		+ :not(a, strong, em, del, span, input, code, br, :where(.not-content *)) {
		margin-top: 0;
	}
	footer {
		display: none;
	}
</style>
