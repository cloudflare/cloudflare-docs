---
import { getCollection } from "astro:content";
import type { AgentData } from "~/components/agent-setup/types";
import AgentPageScaffold from "~/components/agent-setup/AgentPageScaffold.astro";
import QuickStartSteps from "~/components/agent-setup/QuickStartSteps.astro";
import PlatformAccessSection from "~/components/agent-setup/PlatformAccessSection.astro";
import "~/styles/agent-setup.css";

const entries = await getCollection("agent-setup");
const allAgents = entries.map((e) => e.data as AgentData);
const agent = allAgents.find((a) => a.slug === "claude-code")!;
---

<AgentPageScaffold agent={agent} allAgents={allAgents}>
	<Fragment slot="quick-start">
		<QuickStartSteps steps={agent.quick_start} />
	</Fragment>

	<Fragment slot="platform-access">
		<PlatformAccessSection
			agentName="Claude Code"
		>
			<Fragment slot="wrangler">
				<p class="agent-platform-hint">
					Local dev, deploys, and Workers-specific commands.
				</p>
				<p>
					Claude Code uses <a href="/workers/wrangler/">Wrangler</a> directly in
					the terminal for local dev, deploys, and commands like <code
						>wrangler d1 migrations apply</code
					> or <code>wrangler tail</code>. The bundled <strong>wrangler</strong>
					Skill teaches Claude exactly when to reach for it.
				</p>
			</Fragment>

			<Fragment slot="docs">
				<p class="agent-platform-hint">
					Token-efficient references you can point Claude at.
				</p>
				<p>
					Claude Code automatically sends <code>Accept: text/markdown</code> when
					fetching Cloudflare docs, so it gets the clean markdown version by default.
					For preloaded context without using the docs MCP server:
				</p>
				<ul class="agent-platform-resources">
					<li>
						<a href="/llms.txt">developers.cloudflare.com/llms.txt</a> &mdash; a
						directory of every Cloudflare product.
					</li>
					<li>
						<a href="/workers/llms.txt"
							>developers.cloudflare.com/workers/llms.txt</a
						> &mdash; a page index scoped to one product, sized for a single context
						window.
					</li>
					<li>
						Append <code>/index.md</code> to any docs URL for a clean markdown version.
					</li>
				</ul>
			</Fragment>
		</PlatformAccessSection>
	</Fragment>
</AgentPageScaffold>
