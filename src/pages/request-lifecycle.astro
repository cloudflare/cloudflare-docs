---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import type { StarlightPageProps } from "@astrojs/starlight/props";
import RequestLifecycleSection from "../components/landing/RequestLifecycle.astro";

import "../styles/landing.css";

const props = {
	frontmatter: {
		title: "Request Lifecycle",
		description: "Interactive request lifecycle visualization",
		template: "doc",
		tableOfContents: false,
	},
	sidebar: [],
	hasSidebar: false,
	hideBreadcrumbs: true,
	hideTitle: true,
	headings: [],
} as StarlightPageProps;
---

<StarlightPage {...props}>
	<div class="landing-root">
		<RequestLifecycleSection />
	</div>
</StarlightPage>

<style is:global>
	.right-sidebar-container,
	mobile-starlight-toc {
		display: none;
	}
	.main-frame {
		padding-top: var(--sl-nav-height);
	}
	.main-pane {
		padding: 0;
		gap: 0;
	}
	.content-panel {
		padding: 0;
		margin: 0;
		overflow: visible;
	}
	.sl-container {
		max-width: none;
		margin: 0;
		padding: 0;
	}
	.sl-markdown-content {
		margin: 0;
		padding: 0;
	}
	.sl-markdown-content > :first-child {
		margin-top: 0;
	}
	.sl-markdown-content
		:not(a, strong, em, del, span, input, code, br)
		+ :not(a, strong, em, del, span, input, code, br, :where(.not-content *)) {
		margin-top: 0;
	}
</style>
