---
/**
 * DocsLayout — three-column docs layout.
 *
 * Named slots for overrides (all optional, defaults render otherwise):
 *   header, sidebar, toc, page-title, content-footer, pagination
 */
import { Icon } from "astro-icon/components";
import BaseLayout from "./BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { Banner } from "@/components/ui/banner";
import {
	Sidebar,
	SidebarFilter,
	SidebarProductNav,
	SidebarStateRestore,
} from "@/components/ui/sidebar";
import { TOC, MobileTOC } from "@/components/ui/toc";
import { Breadcrumbs } from "@/components/ui/breadcrumbs";
import { Pagination } from "@/components/ui/pagination";
import { PageActions, PageActionLinks } from "@/components/ui/page-actions";
import { Badge } from "@/components/ui/badge";
import { ScrollToTop } from "@/components/ui/scroll-to-top";
import ComponentUsage from "@/components/cf/ComponentUsage.astro";
import FeedbackPrompt from "@/components/react/FeedbackPrompt";
import type { DocsPageProps } from "nimbus-docs/types";
import { marked } from "marked";
import {
	getVersionStatus,
	getVersionAlternates,
	getSectionTitle,
} from "nimbus-docs";
import { sectionTitleResolver } from "@/util/sidebar";
import {
	assertNoClientIslandInDerivedSlot,
	generateDescriptionFromHtml,
} from "@/util/description";
import logo from "~/assets/logo.svg";
import { CloudflareWordmark } from "@/components/icons/CloudflareWordmark";
import type { PageMeta } from "@/components/PageHead.astro";

type Props = DocsPageProps & {
	audience?: "human";
	wide?: boolean;
	hideTitle?: boolean;
	summary?: string;
	meta?: PageMeta;
	feedback?: boolean;
	styleGuide?: { component: string };
};

const {
	title,
	description,
	summary,
	sidebar,
	headings,
	breadcrumbs,
	prevNext,
	mode = "doc",
	banner,
	head = [],
	noindex,
	markdownUrl,
	socialImage,
	lastUpdated,
	editUrl,
	draft,
	audience,
	collection,
	entryId,
	wide = false,
	hideTitle = false,
	meta,
	feedback = true,
	styleGuide,
} = Astro.props;

const isCustom = mode === "custom";

// Parity with production Page.astro: derive from the content's first
// paragraph when frontmatter has no description.
let resolvedDescription = description;
const descriptionDerived = !description;
if (descriptionDerived) {
	const contentHtml = await Astro.slots.render("default");
	assertNoClientIslandInDerivedSlot(contentHtml, Astro.url.pathname);
	resolvedDescription = generateDescriptionFromHtml(contentHtml);
}

// `sidebar: false` / `tableOfContents: false` in frontmatter come through
// from the route as literal `false` (not coerced to `[]`). They drive
// per-column suppression — rail, mobile dialog, header menu button.
const showSidebar = sidebar !== false;

// Per-page status drives the deprecation banner and version alternates below.
const versionStatus = collection ? await getVersionStatus(collection) : null;
const versionAlternates =
	collection && entryId
		? await getVersionAlternates(collection, entryId)
		: null;
const currentSiblingUrl = versionAlternates?.canonical?.url ?? null;

// Sidebar header above the filter — an "all products" button plus the
// current product title. The rail title can diverge from the breadcrumb
// (learning paths suffix the module title with "(Learning Paths)"), so it
// comes from `getSectionTitle`; the breadcrumb labels come from the nav tree.
const productSlug = Astro.url.pathname.split("/").filter(Boolean)[0] ?? null;
const sectionTitle = await getSectionTitle(
	Astro.url.pathname,
	sectionTitleResolver,
);
// Link the product (seg0) crumb to the product root when the tree leaves it
// non-interactive (a section landing with no resolvable page entry).
const breadcrumbItems = (breadcrumbs ?? []).map((c, i) =>
	i === 1 && !c.href && productSlug ? { ...c, href: `/${productSlug}/` } : c,
);
const product = productSlug
	? {
			title: sectionTitle?.rail ?? breadcrumbItems[1]?.label ?? productSlug,
			href: `/${productSlug}/`,
		}
	: null;

const hasHeader = Astro.slots.has("header");
const hasSidebar = Astro.slots.has("sidebar");
const hasToc = Astro.slots.has("toc");
const hasPageTitle = Astro.slots.has("page-title");
const hasContentFooter = Astro.slots.has("content-footer");
const showActions = !Astro.url.pathname.startsWith("/support/");
const hasPagination = Astro.slots.has("pagination");

// Feedback: rail copy on wide screens, content-column fallback otherwise.
const hasTocAside = headings !== false;
const showFeedback = feedback !== false && !isCustom;
---

<BaseLayout
	title={title}
	description={resolvedDescription}
	noindex={noindex || draft}
	markdownUrl={markdownUrl}
	socialImage={socialImage}
	lastUpdated={lastUpdated}
	head={head}
	collection={collection}
	entryId={entryId}
	footer={false}
	meta={{ ...meta, descriptionDerived }}
>
	<div class="flex min-h-screen flex-col">
		{
			hasHeader ? (
				<slot name="header" />
			) : (
				<Header
					collection={collection}
					entryId={entryId}
					showSidebar={showSidebar}
				/>
			)
		}

		{
			isCustom ? (
				<Fragment>
					<main id="main-content" class="flex-1">
						<slot />
					</main>
					<Footer />
				</Fragment>
			) : (
				<div class="mx-auto flex w-full flex-1 flex-col">
					<div class="flex flex-1">
						{showSidebar && (
							<aside
								id="desktop-sidebar"
								data-nb-desktop-sidebar
								class="border-border relative sticky top-14 hidden max-h-[calc(100vh-3.5rem)] w-(--nb-sidebar-width) shrink-0 flex-col overflow-y-auto border-r lg:flex"
							>
								{hasSidebar ? (
									<div data-sidebar-home class="flex-1">
										<div
											data-shared-sidebar-nav
											class="flex-1 pb-12 max-lg:pb-8"
										>
											<slot name="sidebar" />
										</div>
									</div>
								) : (
									<div data-sidebar-home class="flex-1">
										<nav
											data-shared-sidebar-nav
											class="flex-1 pb-12 max-lg:pb-8"
										>
											<div class="bg-background z-10 px-4 pb-3 lg:sticky lg:top-0">
												{product && (
													<SidebarProductNav
														title={product.title}
														href={product.href}
														class="py-2.5"
													/>
												)}
												<SidebarFilter class="mb-0" />
											</div>
											<div class="px-4 pt-2">
												<Sidebar items={sidebar} persist />
											</div>
										</nav>
									</div>
								)}
								<div class="from-base pointer-events-none sticky bottom-0 h-8 bg-gradient-to-t to-transparent" />
							</aside>
						)}

						{/* Only emit when the sidebar is rendered; see SidebarStateRestore. */}
						{showSidebar && <SidebarStateRestore />}

						{/* Right column: the content row (main + TOC). The footer is a
              sibling of this whole row (below), so it spans the full page
              width — under the sidebar as well as the body. */}
						<div class="flex min-w-0 flex-1 flex-col">
							<div class="flex min-w-0 flex-1">
								<main id="main-content" class="min-w-0 flex-1">
									<div
										class={`mx-auto px-4 pt-6 pb-12 lg:px-6 ${wide ? "max-w-[1400px]" : "max-w-(--nb-content-max)"}`}
									>
										{versionStatus?.isDeprecated && (
											<Banner
												type="caution"
												content={
													currentSiblingUrl
														? `This is the <strong>${versionStatus.version}</strong> version of the docs and is no longer maintained. The latest version of this page is at <a href="${currentSiblingUrl}">${currentSiblingUrl}</a>.`
														: `This is the <strong>${versionStatus.version}</strong> version of the docs and is no longer maintained. See the <a href="/">current docs</a> for up-to-date content.`
												}
											/>
										)}
										{banner && (
											<Banner
												content={banner.content}
												type={banner.type}
												dismissible={banner.dismissible}
											/>
										)}
										<Breadcrumbs items={breadcrumbItems} class="pb-2" />
										<div id="_top">
											{hasPageTitle ? (
												<slot name="page-title" />
											) : hideTitle ? null : (
												<Fragment>
													<div class="mt-6 flex flex-wrap items-center gap-3">
														<h1
															class="text-foreground mb-0 leading-tight"
															style={`font-size:var(--nb-h1-size);font-weight:var(--nb-h1-weight);letter-spacing:var(--nb-h1-tracking)`}
														>
															{title}
														</h1>
														{draft && (
															<Badge
																text="Draft"
																variant="warning"
																size="medium"
															/>
														)}
													</div>
													{summary && (
														<div
															class="text-muted-foreground mt-2 text-lg leading-relaxed"
															set:html={marked.parse(summary)}
														/>
													)}
													{/* `description` is meta-only (head tags via BaseLayout), matching
                        upstream cloudflare-docs which never renders it on the page. */}
													<PageActions lastUpdated={lastUpdated} class="mt-3" />
													{headings !== false && headings.length > 0 && (
														<div class="border-border bg-background/95 supports-[backdrop-filter]:bg-background/80 sticky top-14 z-20 -mx-4 mt-3 border-y px-4 py-2 backdrop-blur lg:-mx-6 lg:px-6 xl:hidden">
															<MobileTOC headings={headings} />
														</div>
													)}
													{(markdownUrl || audience === "human") &&
														(audience === "human" ? (
															<div
																class="mt-3 mb-6 flex items-center gap-3"
																role="none"
															>
																<div class="bg-border h-px flex-1" />
																<Badge
																	text="For humans"
																	variant="success"
																	size="small"
																	class="border-success/15 border font-mono uppercase"
																/>
																<div class="bg-border h-px flex-1" />
															</div>
														) : (
															<div
																class="xl:bg-border mt-3 mb-6 h-px w-full bg-transparent"
																role="none"
															/>
														))}
													{!markdownUrl && audience !== "human" && (
														<div class="mb-4" />
													)}
												</Fragment>
											)}
											{styleGuide?.component && (
												<div class="docs-content mt-12 max-w-none">
													<ComponentUsage component={styleGuide.component} />
												</div>
											)}
											<article class="docs-content max-w-none">
												<slot />
											</article>
											{hasContentFooter && <slot name="content-footer" />}
										</div>
										{hasPagination ? (
											<slot name="pagination" />
										) : (
											<Pagination prevNext={prevNext} />
										)}
										{(showFeedback || showActions) && (
											<div
												class:list={[
													"mt-10 flex flex-col gap-5",
													hasTocAside && "xl:hidden",
												]}
											>
												{showFeedback && (
													<FeedbackPrompt
														client:idle
														id="feedback-form-content"
													/>
												)}
												{showActions && <PageActionLinks editUrl={editUrl} />}
											</div>
										)}
									</div>
								</main>

								{headings !== false && (
									<aside
										data-nb-toc-scroll-host
										class="sticky top-14 hidden max-h-[calc(100vh-3.5rem)] w-(--nb-toc-width) shrink-0 overflow-y-auto xl:block"
									>
										<div class="pt-6 pr-6 pb-8 pl-8">
											{hasToc ? (
												<slot name="toc" />
											) : (
												<TOC headings={headings} />
											)}
											{(showFeedback || showActions) && (
												<div class="border-border mt-8 flex flex-col gap-5 border-t pt-6">
													{showFeedback && (
														<FeedbackPrompt
															client:only="react"
															id="feedback-form-toc"
														/>
													)}
													{showActions && <PageActionLinks editUrl={editUrl} />}
												</div>
											)}
										</div>
									</aside>
								)}
							</div>
						</div>
					</div>
					<Footer />
				</div>
			)
		}
	</div>

	{
		showSidebar && (
			/* Mobile sidebar — native <dialog> for free focus trap, escape, backdrop. */
			<dialog
				data-mobile-sidebar
				data-state="closed"
				class="group fixed inset-0 m-0 h-full max-h-full w-full max-w-full border-0 bg-transparent p-0 data-[state=closing]:bg-black/40 data-[state=open]:bg-black/40"
				aria-label="Site navigation"
			>
				<div
					data-mobile-sidebar-panel
					class="bg-background h-full w-full -translate-x-full overflow-y-auto shadow-lg transition-transform duration-250 ease-out group-data-[state=open]:translate-x-0 motion-reduce:transition-none"
				>
					<div class="border-border sticky top-0 z-[1] flex items-center justify-between border-b bg-inherit px-4 py-3">
						<a
							href="/"
							aria-label="Cloudflare Docs"
							class="group flex items-center gap-2 no-underline"
						>
							<img
								src={logo.src}
								alt=""
								width="51"
								height="23"
								class="h-[20px] w-auto"
							/>
							<CloudflareWordmark
								role="img"
								aria-label="Cloudflare"
								className="text-foreground group-hover:text-primary hidden h-[11px] w-auto transition-colors sm:block"
							/>
							<span class="text-foreground/70 border-border-strong hidden rounded-md border px-1.5 py-0.5 text-[11px] leading-none font-semibold tracking-[0.08em] uppercase sm:inline-block">
								Docs
							</span>
						</a>
						<button
							data-close-sidebar
							class="text-muted-foreground hover:bg-accent hover:text-foreground flex h-8 w-8 items-center justify-center rounded-md transition-colors"
							aria-label="Close sidebar"
						>
							<Icon name="ph:x" class="h-5 w-5" />
						</button>
					</div>
					<div data-mobile-sidebar-slot />
				</div>
			</dialog>
		)
	}

	<ScrollToTop />
</BaseLayout>
