---
/**
 * Feature — bordered list item used in CF landing-page "Features" sections.
 * Renders a header link, slotted description, and a CTA line.
 *
 * CF source: cloudflare-docs/src/components/Feature.astro
 *
 * Aligned with cf/RelatedProduct (structure, typography, hover behaviour)
 * with two intentional differences: no icon column, plus a brand-accent CTA
 * line. Consecutive Features form a single divider list; the
 * `:not(.feature + .feature)` selector strips the top border off the first
 * feature in a group. The whole row is clickable via a stretched link, and
 * hovering anywhere underlines the header (exactly like RelatedProduct).
 */
interface Props {
	header: string;
	href: string;
	cta?: string;
}

const { header, href, cta } = Astro.props;
const title = cta ?? `Use ${header}`;
---

<div
	class="feature group border-border relative my-0! border-t py-4 transition-colors motion-reduce:transition-none"
>
	{
		/* after:* stretches the header link over the whole row so it's fully clickable. */
	}
	<a
		href={href}
		class="text-foreground! focus-visible:outline-ring block text-base font-semibold no-underline after:absolute after:inset-0 after:content-[''] hover:underline focus-visible:outline-2 focus-visible:outline-offset-2"
		>{header}</a
	>
	{
		/* Description sits outside the header link; its own links are raised above the stretched overlay. */
	}
	<div
		class="feature-description text-foreground/90 mt-1.5 text-base leading-relaxed [&_a]:relative [&_a]:z-[1]"
	>
		<slot />
	</div>
	<span
		class="mt-2 inline-block text-sm font-medium text-[var(--color-primary)]"
		aria-hidden="true"
	>
		{title}
	</span>
</div>

<style>
	/* First Feature in a consecutive group — no top divider. Scope to the
     markdown body so non-prose Feature usage (rare) isn't affected. */
	:global(.prose > .feature:not(.feature + .feature)) {
		border-top: none;
	}

	.feature-description :global(p) {
		margin: 0;
	}
	.feature-description :global(p + p) {
		margin-top: 0.375rem;
	}

	/* Inline links in description: muted by default, accent on hover. */
	.feature-description :global(a) {
		color: var(--color-foreground);
		text-decoration: underline;
		text-decoration-color: transparent;
		text-underline-offset: 2px;
		transition: text-decoration-color 0.15s;
	}
	.feature-description :global(a:hover) {
		text-decoration-color: currentColor;
	}
</style>
