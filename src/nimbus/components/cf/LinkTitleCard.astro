---
import { Icon } from "astro-icon/components";
import CornerMarks from "../CornerMarks.astro";

interface Props {
  icon?: string;
  title: string;
  href: string;
}

const { icon, title, href } = Astro.props;
---

<div
  class="group/pc relative my-0! flex flex-col overflow-visible border border-border bg-background p-6 transition-colors duration-200 hover:bg-muted/30 motion-reduce:transition-none"
>
  <CornerMarks />
  {
    icon && (
      <span class="relative flex size-11 items-center justify-center rounded-md border border-border bg-muted text-muted-foreground transition-[background-color,border-color,color] duration-200 group-hover/pc:border-[color-mix(in_srgb,var(--color-primary)_30%,transparent)] group-hover/pc:bg-[color-mix(in_srgb,var(--color-primary)_5%,transparent)] group-hover/pc:text-[var(--color-primary)] group-has-[:focus-visible]/pc:border-[color-mix(in_srgb,var(--color-primary)_30%,transparent)] group-has-[:focus-visible]/pc:bg-[color-mix(in_srgb,var(--color-primary)_5%,transparent)] group-has-[:focus-visible]/pc:text-[var(--color-primary)] motion-reduce:transition-none">
        <Icon name={icon} size="24px" aria-hidden="true" />
      </span>
    )
  }
  <p
    class:list={[
      "mb-0 text-base font-medium leading-snug text-foreground md:text-lg",
      icon ? "mt-4" : "mt-0",
    ]}
  >
    {title}
  </p>
  <div class="mt-2 text-sm leading-relaxed text-muted-foreground [&>p]:my-0">
    <slot />
  </div>
  {/* Stretched overlay makes the whole card clickable; keep body text non-interactive. */}
  <a
    href={href}
    class="absolute inset-0 focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-primary"
    aria-label={title}></a>
</div>