---
/**
 * ThemeToggle — cycles light → dark → system. Persists to localStorage; the
 * resolved theme applies to `<html data-mode="dark">` via the inline script in
 * BaseLayout (no FOUC). The visible icon reflects the *selected preference*
 * (`:root[data-nb-pref]`), not the resolved mode, so "system" is
 * distinguishable and paints correctly before this component's script loads.
 */
import { Icon } from "astro-icon/components";
import { cn } from "@/lib/cn";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"button"> {}

const { class: className, ...attrs } = Astro.props;
---

<button
  data-nb-theme-toggle
  class={cn(
    "group flex items-center justify-center w-8 h-8 rounded-md text-muted-foreground hover:text-foreground hover:bg-accent transition-colors",
    className,
  )}
  {...attrs}
  aria-label="Toggle theme (light, dark, system)"
>
  {/* Icon visibility is driven by `:root[data-nb-pref]`, which BaseLayout's
      pre-paint script sets before first paint — so the correct icon shows with
      no flash, even before this component's script hydrates. */}
  <Icon name="ph:sun" class="w-[1.125rem] h-[1.125rem] nb-theme-ico nb-theme-ico-light" />
  <Icon name="ph:moon" class="w-[1.125rem] h-[1.125rem] nb-theme-ico nb-theme-ico-dark" />
  <Icon name="ph:monitor" class="w-[1.125rem] h-[1.125rem] nb-theme-ico nb-theme-ico-auto" />
</button>

<script>
  import "./theme-toggle.client";
</script>
