function detectRSIDivergence(pair,ca){
  if(ca.length<30)return null;
  const cl=ca.map(c=>c.close);
  const rsis=[];
  for(let i=14;i<cl.length;i++){
    let g=0,l=0;
    for(let j=i-13;j<=i;j++){const d=cl[j]-cl[j-1];d>0?g+=d:l-=d;}
    rsis.push(l===0?100:100-(100/(1+(g/14)/(l/14))));
  }
  const n=rsis.length,p=ca.length;
  const priceUp=ca[p-1].close>ca[p-10].close;
  const rsiUp=rsis[n-1]>rsis[n-10];
  if(priceUp===rsiUp)return null;
  const typ=priceUp&&!rsiUp?'BAISSIÈRE':'HAUSSIÈRE';
  const conf=typ==='BAISSIÈRE'?78:74;
  return{
    icon:'〰️',name:`DIVERGENCE RSI ${typ}`,rarity:'RARE',conf,
    msg:typ==='BAISSIÈRE'
      ?`Le prix monte mais l'élan intérieur s'effondre. La façade est belle, l'édifice se lézarde. Un renversement baissier se prépare dans l'ombre — les forces qui soutiennent la hausse s'épuisent.`
      :`Le prix chute mais la résistance intérieure grandit. La blessure est superficielle. Les forces haussières couvent sous les décombres et préparent une résurrection.`,
    action:typ==='BAISSIÈRE'?'PRUDENCE · Momentum divergent':'REBOND PROBABLE · Divergence positive'
  };
}

function detectRSIExtreme(pair,ca){
  const cl=ca.map(c=>c.close);
  let g=0,l=0;
  for(let i=cl.length-13;i<cl.length;i++){const d=cl[i]-cl[i-1];d>0?g+=d:l-=d;}
  const rsi=l===0?100:100-(100/(1+(g/14)/(l/14)));
  if(rsi>=30&&rsi<=75)return null;
  const surAchat=rsi>75;
  const rarity=surAchat?(rsi>90?'LÉGENDAIRE':rsi>85?'ÉPIQUE':'RARE'):(rsi<15?'LÉGENDAIRE':rsi<20?'ÉPIQUE':'RARE');
  const conf=Math.round(surAchat?50+rsi/4:50+(100-rsi)/3);
  return{
    icon:surAchat?'🔥':'🧊',
    name:surAchat?'SURACHAT EXTRÊME':'SURVENTE EXTRÊME',
    rarity,conf:Math.min(99,conf),
    msg:surAchat
      ?`L'énergie vitale dépasse ${rsi.toFixed(0)} — le guerrier brûle sa propre vie pour combattre. Une telle intensité ne peut durer : soit l'ascension se transforme en chute libre, soit une pause forcée s'impose.`
      :`Le mana tombe à ${rsi.toFixed(0)} — le guerrier est à genoux, vidé de toute réserve. Mais c'est souvent dans cet abîme de faiblesse absolue que naît la résurrection la plus violente.`,
    action:surAchat?'PRISE DE PROFIT · Surchauffe détectée':'ACCUMULATION · Zone de rebond'
  };
}

function detectGoldenDeathCross(pair,ca){
  if(ca.length<55)return null;
  const cl=ca.map(c=>c.close);
  const ema_f=(arr,n)=>{
    const k=2/(n+1);let e=arr[0];
    arr.forEach(v=>{e=v*k+e*(1-k)});return e;
  };
  const ema20now=ema_f(cl.slice(-20),20);
  const ema50now=ema_f(cl.slice(-50),50);
  const ema20prv=ema_f(cl.slice(-21,-1),20);
  const ema50prv=ema_f(cl.slice(-51,-1),50);
  const crossUp=ema20prv<=ema50prv&&ema20now>ema50now;
  const crossDn=ema20prv>=ema50prv&&ema20now<ema50now;
  if(!crossUp&&!crossDn)return null;
  return{
    icon:crossUp?'☀️':'💀',
    name:crossUp?'GOLDEN CROSS':'DEATH CROSS',
    rarity:'ÉPIQUE',conf:88,
    msg:crossUp
      ?`La courte mémoire vient de dépasser la longue mémoire. Le soleil se lève sur ce territoire — les grandes entités structurelles commencent à regarder dans cette direction.`
      :`La courte mémoire vient de plonger sous la longue mémoire. Les ténèbres structurelles s'installent — c'est le signal que les grandes entités ont commencé à fuir ce territoire.`,
    action:crossUp?'SIGNAL HAUSSIER FORT · Tendance confirmée':'SIGNAL BAISSIER FORT · Éviter les longs'
  };
}

function detectMomentumRupture(pair,ca){
  if(ca.length<20)return null;
  const recent=ca.slice(-10);
  const prev=ca.slice(-20,-10);
  const avgRecent=mean(recent.map(c=>Math.abs(c.close-c.open)/c.open));
  const avgPrev=mean(prev.map(c=>Math.abs(c.close-c.open)/c.open));
  const ratio=avgRecent/avgPrev;
  if(ratio<3)return null;
  const dir=mean(recent.map(c=>c.close-c.open))>0?'HAUSSIER':'BAISSIER';
  const rarity=ratio>=6?'ÉPIQUE':'RARE';
  return{
    icon:'💨',name:`RUPTURE DE MOMENTUM ${dir}`,rarity,conf:Math.min(99,Math.round(60+ratio*5)),
    msg:`L'amplitude des bougies récentes est ${ratio.toFixed(1)}× supérieure à la période précédente. Une force nouvelle et violente vient d'entrer dans l'arène — le calme plat qui précédait était trompeur.`,
    action:dir==='HAUSSIER'?'MOMENTUM POSITIF · Suivre la vague':'PRESSION VENDEUSE · Attention à la chute'
  };
}

function detectAbyssRebound(pair,ca){
  if(ca.length<20)return null;
  const cl=ca.map(c=>c.close);
  const low20=Math.min(...ca.slice(-20).map(c=>c.low));
  const cur=ca[ca.length-1];
  const prev=ca[ca.length-2];
  const atLow=prev.low<=low20*1.005;
  const rebond=(cur.close-prev.low)/prev.low;
  if(!atLow||rebond<0.02)return null;
  const rarity=rebond>=0.06?'ÉPIQUE':rebond>=0.04?'RARE':'NOTABLE';
  return{
    icon:'⚔️',name:'REBOND DES ABYSSES',rarity,conf:Math.min(99,Math.round(60+rebond*500)),
    msg:`Le guerrier a touché le fond du gouffre et s'est relevé — rebond de ${(rebond*100).toFixed(1)}% depuis le plus bas des 20 dernières bougies. Le sol a tenu. La résistance des acheteurs désespérés peut inverser le destin.`,
    action:'SURVEILLER LA CONFIRMATION · Rebond sur support'
  };
}

function detectAll(pair,ca){
  const detectors=[
    detectCompressionExtreme, detectVolumeAnomaly,
    detectWhaleEntry,         detectFauxBreakout,
    detectLiquidationCascade, detectRSIDivergence,
    detectRSIExtreme,         detectGoldenDeathCross,
    detectMomentumRupture,    detectAbyssRebound,
  ];
  return detectors
    .map(fn=>{try{return fn(pair,ca);}catch(e){return null;}})
    .filter(Boolean)
    .sort((a,b)=>{
      const r={'LÉGENDAIRE':4,'ÉPIQUE':3,'RARE':2,'NOTABLE':1};
      return(r[b.rarity]||0)-(r[a.rarity]||0);
    });
}

