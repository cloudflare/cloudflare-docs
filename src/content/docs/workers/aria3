function detectCompressionExtreme(pair,ca){
  const cl=ca.map(c=>c.close);
  let dur=0;
  for(let i=cl.length-1;i>=20&&dur<ca.length;i--){
    const sl=cl.slice(i-20,i),s=mean(sl),sd=stdDev(sl),a=calcATR(ca.slice(i-20,i));
    if((s+2*sd)<(s+1.5*a)&&(s-2*sd)>(s-1.5*a))dur++;else break;
  }
  if(dur<50)return null;
  const rarity=dur>=150?'LÉGENDAIRE':dur>=100?'ÉPIQUE':dur>=75?'RARE':'NOTABLE';
  const conf=Math.min(99,Math.round(60+dur/5));
  return{
    icon:'🗜️',name:'COMPRESSION EXTRÊME',rarity,conf,
    msg:`Le marché est comprimé depuis ${dur} bougies consécutives. Une énergie runique colossale s'accumule dans les profondeurs — l'explosion qui suit sera d'une violence proportionnelle à l'attente.`,
    action:'SURVEILLANCE MAXIMALE · Breakout imminent'
  };
}

function detectVolumeAnomaly(pair,ca){
  const last=ca[ca.length-1];
  const avgVol=mean(ca.slice(-20,-1).map(c=>c.volume));
  const ratio=+(last.volume/avgVol).toFixed(1);
  if(ratio<3)return null;
  const rarity=ratio>=8?'LÉGENDAIRE':ratio>=5?'ÉPIQUE':ratio>=4?'RARE':'NOTABLE';
  const conf=Math.min(99,Math.round(50+ratio*5));
  return{
    icon:'📊',name:'ANOMALIE DE VOLUME',rarity,conf,
    msg:`Le volume de la dernière bougie est ${ratio}× supérieur à la normale. Une entité d'une puissance inhabituelle vient d'entrer dans la bataille — institutionnel, baleine ou catalyseur externe.`,
    action:'IDENTIFIER LA CAUSE · News ou ordre massif'
  };
}

function detectWhaleEntry(pair,ca){
  const obvs=calcOBV(ca);
  let cons=0;
  for(let i=obvs.length-1;i>0;i--){if(obvs[i]>obvs[i-1])cons++;else break;}
  if(cons<4)return null;
  const cls=ca.slice(-cons);
  const priceRange=(Math.max(...cls.map(c=>c.high))-Math.min(...cls.map(c=>c.low)))/ca[ca.length-1].close;
  if(priceRange>0.05)return null;
  const rarity=cons>=10?'LÉGENDAIRE':cons>=7?'ÉPIQUE':cons>=5?'RARE':'NOTABLE';
  const conf=Math.min(99,Math.round(50+cons*4));
  return{
    icon:'🐋',name:'ENTRÉE DE BALEINE',rarity,conf,
    msg:`OBV haussier sur ${cons} bougies consécutives pendant que le prix reste flat. Les grandes créatures des abysses accumulent en silence, dissimulant leur appétit derrière une façade de calme trompeur.`,
    action:'SUIVRE L\'ACCUMULATION · Ne pas vendre'
  };
}

function detectFauxBreakout(pair,ca){
  if(ca.length<30)return null;
  const recent=ca.slice(-30);
  const rangeHi=Math.max(...recent.slice(0,20).map(c=>c.high));
  const rangeLo=Math.min(...recent.slice(0,20).map(c=>c.low));
  const last10=recent.slice(20);
  let faux=null;
  for(const c of last10){
    if(c.high>rangeHi*1.005&&c.close<rangeHi){faux={dir:'HAUT',c};break;}
    if(c.low<rangeLo*0.995&&c.close>rangeLo){faux={dir:'BAS',c};break;}
  }
  if(!faux)return null;
  return{
    icon:'🪤',name:'FAUX BREAKOUT',rarity:'RARE',conf:72,
    msg:`Cassure du range vers le ${faux.dir} sans clôture de confirmation. Le marché a tendu un piège aux chasseurs de breakout — les stops sont liquidés, la liquidité récoltée. Un renversement violent est possible.`,
    action:'ATTENDRE CONFIRMATION · Stop chasse détectée'
  };
}

function detectLiquidationCascade(pair,ca){
  if(ca.length<5)return null;
  const recent=ca.slice(-5);
  let cascade=null;
  for(let i=1;i<recent.length-1;i++){
    const drop=(recent[i].close-recent[i-1].close)/recent[i-1].close;
    const bounce=(recent[i+1].close-recent[i].close)/recent[i].close;
    const avgVol=mean(ca.slice(-20,-5).map(c=>c.volume));
    const volSpike=recent[i].volume>avgVol*2;
    if(drop<=-0.03&&bounce>=0.015&&volSpike){cascade={drop:+(drop*100).toFixed(1),bounce:+(bounce*100).toFixed(1)};break;}
  }
  if(!cascade)return null;
  return{
    icon:'⚡',name:'CASCADE DE LIQUIDATION',rarity:'ÉPIQUE',conf:81,
    msg:`Chute brutale de ${cascade.drop}% suivie d'un rebond de ${cascade.bounce}% avec volume explosif. Les positions longues ont été liquidées en masse — le marché a nettoyé le carnet. Zone de retournement potentielle.`,
    action:'ZONE DE RETOURNEMENT · Longs liquidés'
  };
}

