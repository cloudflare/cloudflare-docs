function analyze(pair,ca){
  const cl=ca.map(c=>c.close),price=cl[cl.length-1];
  const prev=ca[ca.length-2];
  const chg=+((price-prev.close)/prev.close*100).toFixed(2);
  const rsi=+calcRSI(cl).toFixed(1);
  const atr=calcATR(ca,14);
  const atrPct=+(atr/price*100).toFixed(2);
  const avgVol=mean(ca.slice(-10).map(c=>c.volume));
  const rvol=+(ca[ca.length-1].volume/avgVol).toFixed(1);
  const sqzDur=calcSqzDur(ca);
  const obvs=calcOBV(ca);let obCon=0;
  for(let i=obvs.length-1;i>0;i--){if(obvs[i]>obvs[i-1])obCon++;else break;}
  const obvR=obvs[obvs.length-1]>obvs[0];
  let score=0;
  const sl=cl.slice(-20),s=mean(sl),sd=stdDev(sl),a=calcATR(ca.slice(-20));
  const squeeze=(s+2*sd)<(s+1.5*a)&&(s-2*sd)>(s-1.5*a);
  if(squeeze)score+=15;
  if(obvR)score+=15;
  if(rsi<45)score+=12;
  if(rvol>1.5)score+=10;
  const sqzB=sqzDur>=100?24:sqzDur>=50?16:sqzDur>=20?8:sqzDur>=10?4:0;
  score+=sqzB;
  const whaleScore=Math.min(100,Math.round(obCon>=8?80:obCon>=5?60:obCon>=3?40:20));
  score+=Math.round(whaleScore*.12);
  score=Math.min(100,Math.max(0,score));
  const sigType=score>=70&&rvol>=2?'FIRE':squeeze&&score>=50?'SPRING':score>=40?'ALERT':'WATCH';
  const high150=Math.max(...ca.slice(-150).map(c=>c.high));
  const low150=Math.min(...ca.slice(-150).map(c=>c.low));

  // ── Swing Highs & Lows ────────────────────────────────────────
  function findSwingHighs(candles, str=5){
    const out=[];
    for(let i=str;i<candles.length-str;i++){
      const h=candles[i].high;
      if(candles.slice(i-str,i).every(c=>c.high<h)&&candles.slice(i+1,i+str+1).every(c=>c.high<h))
        out.push({price:h,idx:i});
    }
    return out;
  }
  function findSwingLows(candles, str=5){
    const out=[];
    for(let i=str;i<candles.length-str;i++){
      const l=candles[i].low;
      if(candles.slice(i-str,i).every(c=>c.low>l)&&candles.slice(i+1,i+str+1).every(c=>c.low>l))
        out.push({price:l,idx:i});
    }
    return out;
  }

  const allSwingHighs=findSwingHighs(ca,5);
  const allSwingLows=findSwingLows(ca,5);

  // Résistances : swing highs au-dessus du prix, triés croissant
  const resistances=allSwingHighs.map(s=>s.price).filter(h=>h>price*1.002).sort((a,b)=>a-b);
  // Supports : swing lows en dessous du prix, triés décroissant (le plus proche en premier)
  const supports=allSwingLows.map(s=>s.price).filter(l=>l<price*0.998).sort((a,b)=>b-a);

  // T1 = première vraie résistance, fallback price+ATR
  const t1=+(resistances[0]??price+atr).toFixed(8);
  // T2 = deuxième résistance, fallback Fibo 61.8%
  const t2=+(resistances[1]??(low150+(high150-low150)*.618)).toFixed(8);
  // SL = premier support sous le prix, fallback price-1.5×ATR
  const sl_price=+(supports[0]??(price-atr*1.5)).toFixed(8);

  // Résistances intermédiaires entre prix et T2 (obstacles sur le chemin)
  const obstacles=resistances.filter(h=>h>price&&h<t2).length;
  // Qualité du setup : ratio R/R
  const rr=t2>price&&sl_price<price?+((t2-price)/(price-sl_price)).toFixed(2):null;

  const btcBear=ema_fn(cl.slice(-50),50)>price;
  const anomalies=detectAll(pair,ca);
  return{pair,price,chg,score,rsi,rvol,atrPct,sqzDur,whaleScore,obCon,squeeze,obvR,sigType,
    t1,t2,sl_price,resistances,supports,obstacles,rr,
    pct1:+((t1-price)/price*100).toFixed(1),pct2:+((t2-price)/price*100).toFixed(1),
    high150,low150,btcBear,candles:ca,anomalies,
    t1IsSwing:!!resistances[0],t2IsSwing:!!resistances[1],slIsSwing:!!supports[0]};
}

