<script>
'use strict';
const CB = 'https://api.exchange.coinbase.com';

// ── Map symbol → CoinGecko ID ─────────────────────────────────
const CG_IDS = {
  BTC:'bitcoin',ETH:'ethereum',SOL:'solana',BNB:'binancecoin',
  AVAX:'avalanche-2',LINK:'chainlink',DOT:'polkadot',ATOM:'cosmos',
  ADA:'cardano',XRP:'ripple',DOGE:'dogecoin',MATIC:'matic-network',
  UNI:'uniswap',POLS:'polkastarter',FET:'fetch-ai',RNDR:'render-token',
  NEAR:'near',OP:'optimism',ARB:'arbitrum',INJ:'injective-protocol',
  OCEAN:'ocean-protocol',LTC:'litecoin',TRX:'tron',HBAR:'hedera-hashgraph',
  APT:'aptos',SUI:'sui',SEI:'sei-network',TIA:'celestia',
  JUP:'jupiter-exchange-solana',PYTH:'pyth-network',WIF:'dogwifcoin',
  PEPE:'pepe',BONK:'bonk',FLOKI:'floki',SHIB:'shiba-inu',
  ALGO:'algorand',FTM:'fantom',SAND:'the-sandbox',MANA:'decentraland',
  CRV:'curve-dao-token',AAVE:'aave',MKR:'maker',SNX:'synthetix-network-token',
  LDO:'lido-dao',RUNE:'thorchain',EGLD:'elrond-erd-2',ICP:'internet-computer',
  STX:'blockstack',IMX:'immutable-x',GRT:'the-graph',FIL:'filecoin'
};

function fmtMarketCap(v){
  if(!v||isNaN(v))return'—';
  if(v>=1e12)return'$'+(v/1e12).toFixed(2)+' T';
  if(v>=1e9)return'$'+(v/1e9).toFixed(1)+' Md';
  if(v>=1e6)return'$'+(v/1e6).toFixed(0)+' M';
  return'$'+v.toLocaleString();
}
function fmtNum(v){
  if(!v||isNaN(v))return'—';
  if(v>=1e12)return(v/1e12).toFixed(2)+' T';
  if(v>=1e9)return(v/1e9).toFixed(1)+' Md';
  if(v>=1e6)return(v/1e6).toFixed(0)+' M';
  return v.toLocaleString();
}
function fmtRank(r){
  if(!r)return'—';
  const s=String(r);
  const sfx=s.endsWith('11')||s.endsWith('12')||s.endsWith('13')?'ᵉ':
             s.endsWith('1')?'ᵉʳ':s.endsWith('2')?'ᵉ':s.endsWith('3')?'ᵉ':'ᵉ';
  return'#'+r;
}

async function fetchCoinGeckoData(base){
  const id=CG_IDS[base];
  if(!id)return null;
  try{
    const _cgBase=window.location.hostname==='localhost'?'/proxy/coingecko/':'https://api.coingecko.com/api/v3/';
    const url=`${_cgBase}coins/${id}?localization=false&tickers=false&community_data=false&developer_data=false&sparkline=false`;
    const r=await fetch(url,{headers:{'Accept':'application/json'}});
    if(!r.ok)return null;
    const d=await r.json();
    const md=d.market_data||{};
    return{
      rank:d.market_cap_rank,
      name:d.name,
      desc:(d.description?.fr||d.description?.en||'').replace(/<[^>]+>/g,' ').split('.').slice(0,2).join('.')+'.'.trim(),
      marketCap:md.market_cap?.usd,
      volume24h:md.total_volume?.usd,
      circulatingSupply:md.circulating_supply,
      totalSupply:md.total_supply||md.max_supply,
      maxSupply:md.max_supply,
      ath:md.ath?.usd,
      athDate:md.ath_date?.usd?.slice(0,4),
      athPct:md.ath_change_percentage?.usd,
      dominance:null, // injected after global call
      categories:(d.categories||[]).slice(0,3).join(' · ')||null,
      genesis:d.genesis_date||null,
      hashing:d.hashing_algorithm||null,
    };
  }catch(e){return null;}
}

async function fetchDominance(base){
  try{
    const _cgBase2=window.location.hostname==='localhost'?'/proxy/coingecko/':'https://api.coingecko.com/api/v3/';
    const r=await fetch(_cgBase2+'global');
    if(!r.ok)return null;
    const d=await r.json();
    const mp=d.data?.market_cap_percentage||{};
    const key=Object.keys(mp).find(k=>k.toUpperCase()===base.toUpperCase());
    return key?+mp[key].toFixed(2):null;
  }catch(e){return null;}
}

function renderCodex(base,cg){
  if(!cg){
    return`<div class="codex">
      <div class="codex-title">CODEX DE L'ACTIF</div>
      <div class="codex-loading">⚠ Données fondamentales indisponibles pour ${base}</div>
    </div>`;
  }

  const supplyPct=cg.maxSupply&&cg.circulatingSupply?Math.round(cg.circulatingSupply/cg.maxSupply*100):null;
  const athPctColor=cg.athPct>-20?'green':cg.athPct>-60?'':' red';

  return`<div class="codex">
    <div class="codex-title">📜 CODEX DE L'ACTIF · DONNÉES FONDAMENTALES</div>
    <div class="codex-grid">

      <div class="codex-item" style="display:flex;align-items:center;gap:14px">
        <div>
          <div class="codex-lbl">CLASSEMENT MONDIAL</div>
          <div class="codex-rank">${fmtRank(cg.rank)}</div>
          <div class="codex-sub">sur ~10 000+ actifs</div>
        </div>
      </div>

      <div class="codex-item">
        <div class="codex-lbl">CAPITALISATION</div>
        <div class="codex-val">${fmtMarketCap(cg.marketCap)}</div>
        <div class="codex-sub">USD · en temps réel</div>
      </div>

      <div class="codex-item">
        <div class="codex-lbl">VOLUME 24H</div>
        <div class="codex-val">${fmtMarketCap(cg.volume24h)}</div>
        <div class="codex-sub">Activité journalière</div>
      </div>

      <div class="codex-item">
        <div class="codex-lbl">ATH · RECORD ABSOLU</div>
        <div class="codex-val">$${cg.ath?.toLocaleString('en-US',{maximumFractionDigits:4})||'—'}</div>
        <div class="codex-sub ath-pct" style="color:${cg.athPct>-20?'#4a9e4a':cg.athPct>-60?'#c9a84c':'#c0392b'}">${cg.athPct!=null?(cg.athPct>0?'+':'')+cg.athPct.toFixed(1)+'% vs aujourd\'hui':'—'}${cg.athDate?' · '+cg.athDate:''}</div>
      </div>

      ${cg.dominance!=null?`<div class="codex-item full">
        <div class="codex-lbl">DOMINANCE DU MARCHÉ</div>
        <div style="display:flex;justify-content:space-between;align-items:baseline">
          <div class="codex-val">${cg.dominance}%</div>
          <div class="codex-sub">de la capitalisation totale crypto</div>
        </div>
        <div class="dominance-bar"><div class="dominance-fill" style="width:${Math.min(100,cg.dominance*2)}%"></div></div>
      </div>`:''}

      <div class="codex-item full">
        <div class="codex-lbl">SUPPLY EN CIRCULATION</div>
        <div class="supply-row">
          <span class="codex-val">${fmtNum(cg.circulatingSupply)} ${base}</span>
          ${supplyPct!=null?`<span style="color:var(--gold);font-family:var(--display);font-size:11px">${supplyPct}% du max</span>`:''}
        </div>
        ${cg.maxSupply?`<div class="supply-fill-wrap"><div class="supply-fill" style="width:${supplyPct||0}%"></div></div>
        <div class="codex-sub" style="margin-top:3px">Max : ${fmtNum(cg.maxSupply)} ${base}${cg.maxSupply?'  ·  Supply plafonnée ✓':''}</div>`
        :`<div class="codex-sub" style="margin-top:2px">Supply inflationniste — pas de max défini</div>`}
      </div>

      ${cg.categories?`<div class="codex-item full">
        <div class="codex-lbl">CATÉGORIES</div>
        <div class="codex-val" style="font-size:10px;letter-spacing:.5px;color:var(--text)">${cg.categories}</div>
      </div>`:''}

      ${cg.tvl?`<div class="codex-item full">
        <div class="codex-lbl">TVL — LIQUIDITÉ DE LA POOL</div>
        <div class="codex-val green">${fmtMarketCap(cg.tvl)}</div>
        <div class="codex-sub">${cg.poolName||'Pool principale'} · Valeur totale bloquée</div>
      </div>`:''}

      ${(cg.genesis||cg.hashing)?`<div class="codex-item full" style="display:flex;gap:20px">
        ${cg.genesis?`<div><div class="codex-lbl">CRÉATION</div><div class="codex-val" style="font-size:11px">${cg.genesis}</div></div>`:''}
        ${cg.hashing?`<div><div class="codex-lbl">ALGORITHME</div><div class="codex-val" style="font-size:11px">${cg.hashing}</div></div>`:''}
      </div>`:''}

    </div>
  </div>`;
}

const mean   = a => a.reduce((s,v)=>s+v,0)/a.length;
const stdDev = a => { const m=mean(a); return Math.sqrt(mean(a.map(v=>(v-m)**2)))||1e-9; };
const ema_fn = (arr,p) => { const k=2/(p+1); let e=arr[0]; for(let i=1;i<arr.length;i++) e=arr[i]*k+e*(1-k); return e; };

function calcRSI(cl,p=14){
  if(cl.length<p+1)return 50;
  let g=0,l=0;
  for(let i=cl.length-p;i<cl.length;i++){const d=cl[i]-cl[i-1];d>0?g+=d:l-=d;}
  g/=p;l/=p;return l===0?100:100-100/(1+g/l);
}
function calcATR(ca,p=14){
  if(ca.length<2)return 0;
  const tr=ca.slice(1).map((c,i)=>Math.max(c.high-c.low,Math.abs(c.high-ca[i].close),Math.abs(c.low-ca[i].close)));
  return mean(tr.slice(-p));
}
function calcOBV(ca){
  const o=[0];
  for(let i=1;i<ca.length;i++){
    const d=ca[i].close>ca[i-1].close?ca[i].volume:ca[i].close<ca[i-1].close?-ca[i].volume:0;
    o.push(o[o.length-1]+d);
  }
  return o;
}
function calcSqzDur(ca){
  const cl=ca.map(c=>c.close);let d=0;
  for(let i=cl.length-1;i>=20&&d<ca.length;i--){
    const sl=cl.slice(i-20,i),s=mean(sl),sd=stdDev(sl),atr=calcATR(ca.slice(i-20,i));
    if((s+2*sd)<(s+1.5*atr)&&(s-2*sd)>(s-1.5*atr))d++;else break;
  }
  return d;
}

async function fetchCandles(pair,gran,limit=200){
  const r=await fetch(`${CB}/products/${pair}/candles?granularity=${gran}&limit=${limit}`);
  if(!r.ok)throw new Error('Paire introuvable sur Coinbase');
  const d=await r.json();
  if(!Array.isArray(d)||d.length<30)throw new Error('Données insuffisantes');
  return d.slice(0,limit).reverse().map(x=>({ts:x[0],low:+x[1],high:+x[2],open:+x[3],close:+x[4],volume:+x[5]}));
}

// ── GeckoTerminal ─────────────────────────────────────────────
const GT='https://api.geckoterminal.com/api/v2';
const GT_TF={3600:'hour',21600:'hour',86400:'day'};
const GT_AGG={3600:1,21600:6,86400:1};

async function resolvePoolAddress(network,tokenAddress){
  // Récupère la pool avec le plus de liquidité pour ce token
  const r=await fetch(`${GT}/networks/${network}/tokens/${tokenAddress}/pools?page=1`);
  if(!r.ok)throw new Error('Token introuvable sur GeckoTerminal');
  const d=await r.json();
  const pools=d.data;
  if(!pools||pools.length===0)throw new Error('Aucune pool trouvée pour ce token');
  // Trier par reserve_in_usd décroissant
  pools.sort((a,b)=>(+b.attributes.reserve_in_usd||0)-(+a.attributes.reserve_in_usd||0));
  const pool=pools[0];
  return{
    address:pool.attributes.address,
    name:pool.attributes.name,
    tvl:+pool.attributes.reserve_in_usd||0,
    dex:pool.relationships?.dex?.data?.id||'dex'
  };
}

async function fetchCandlesGecko(network,tokenAddress,gran,limit=200){
  const tf=GT_TF[gran]||'hour';
  const agg=GT_AGG[gran]||1;
  // 1. Résoudre la pool
  const pool=await resolvePoolAddress(network,tokenAddress);
  // 2. Récupérer les bougies
  const url=`${GT}/networks/${network}/pools/${pool.address}/ohlcv/${tf}?aggregate=${agg}&limit=${Math.min(limit,1000)}&currency=usd`;
  const r=await fetch(url,{headers:{'Accept':'application/json'}});
  if(!r.ok)throw new Error('Bougies GeckoTerminal indisponibles');
  const d=await r.json();
  const raw=d.data?.attributes?.ohlcv_list;
  if(!raw||raw.length<10)throw new Error('Données graphiques insuffisantes');
  // Format: [timestamp, open, high, low, close, volume]
  const candles=raw.slice().reverse().map(x=>({
    ts:x[0],open:+x[1],high:+x[2],low:+x[3],close:+x[4],volume:+x[5]
  }));
  return{candles,pool};
}

async function fetchTokenNameGecko(network,tokenAddress){
  try{
    const r=await fetch(`${GT}/networks/${network}/tokens/${tokenAddress}`);
    if(!r.ok)return null;
    const d=await r.json();
    const attr=d.data?.attributes;
    return attr?{name:attr.name,symbol:attr.symbol,decimals:attr.decimals}:null;
  }catch(e){return null;}
}

function isContractAddress(str){
  // Ethereum/EVM : 0x + 40 hex chars
  if(/^0x[0-9a-fA-F]{40}$/.test(str))return true;
  // Solana : base58, 32-44 chars
  if(/^[1-9A-HJ-NP-Za-km-z]{32,44}$/.test(str)&&str.length>=32)return true;
  return false;
}

