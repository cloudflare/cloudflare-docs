function drawChart(ca){
  const canvas=document.getElementById('price-chart');
  if(!canvas)return;
  const dpr=window.devicePixelRatio||1;
  const W=canvas.offsetWidth,H=100;
  canvas.width=W*dpr;canvas.height=H*dpr;
  const ctx=canvas.getContext('2d');
  ctx.scale(dpr,dpr);
  const slice=ca.slice(-60);
  const highs=slice.map(c=>c.high),lows=slice.map(c=>c.low);
  const hi=Math.max(...highs),lo=Math.min(...lows),range=hi-lo||1;
  const bw=W/slice.length,pad=1;
  slice.forEach((c,i)=>{
    const x=i*bw+pad;const bww=bw-pad*2;
    const yH=H-(c.high-lo)/range*H;const yL=H-(c.low-lo)/range*H;
    const yO=H-(c.open-lo)/range*H;const yC=H-(c.close-lo)/range*H;
    ctx.strokeStyle='rgba(90,60,20,.6)';ctx.lineWidth=1;
    ctx.beginPath();ctx.moveTo(x+bww/2,yH);ctx.lineTo(x+bww/2,yL);ctx.stroke();
    const bull=c.close>=c.open;
    ctx.fillStyle=bull?'rgba(45,122,45,.8)':'rgba(192,57,43,.8)';
    ctx.fillRect(x,Math.min(yO,yC),bww,Math.abs(yO-yC)||1);
  });
}

