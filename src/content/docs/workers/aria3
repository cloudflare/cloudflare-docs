  const direction = s.btcBear
    ? 'Downward falling compositional energy, darkness dominant.'
    : 'Upward rising compositional energy, light visible above.';

  return [
    'Epic dark fantasy digital painting.',
    appearance + ',',
    weapon + '.',
    symbolOnWeapon,
    `Setting: ${atmo}.`,
    anomalyStr,
    direction,
    'Photorealistic ultra-detailed, cinematic composition, upper body portrait, face clearly visible, professional concept art, dramatic lighting, 2K. No text, no watermark, no border.',
