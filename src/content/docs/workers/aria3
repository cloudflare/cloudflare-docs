let wlActive={net:'coinbase',addr:'BTC'};

function wlLoad(){
  try{
    const saved=localStorage.getItem('aria_watchlist');
    return saved?JSON.parse(saved):JSON.parse(JSON.stringify(WL_DEFAULTS));
  }catch(e){return JSON.parse(JSON.stringify(WL_DEFAULTS));}
}
function wlSave(data){
  try{localStorage.setItem('aria_watchlist',JSON.stringify(data));}catch(e){}
}

function renderWatchlist(){
  const data=wlLoad();
  const net=document.getElementById('cfg-network').value;
  const tabs=document.getElementById('wl-tabs');
  const tokens=document.getElementById('wl-tokens');

  const netLabels={coinbase:'Coinbase',solana:'Solana',eth:'Ethereum',base:'Base',bsc:'BSC',arbitrum:'Arbitrum',polygon_pos:'Polygon',avax:'Avalanche'};

  // Onglets — afficher seulement les réseaux qui ont des tokens
  tabs.innerHTML=Object.keys(netLabels).filter(n=>data[n]&&data[n].length>0).map(n=>
    `<div class="wl-tab${n===net?' active':''}" onclick="wlSelectNet('${n}')">${netLabels[n]}</div>`
  ).join('');

  // Tokens du réseau actif
  const list=data[net]||[];
  if(list.length===0){
    tokens.innerHTML=`<div style="color:var(--text3);font-size:10px;font-style:italic;padding:4px">Aucun token — ajoutes-en un ci-dessous</div>`;
  } else {
    tokens.innerHTML=list.map((t,i)=>`
      <div class="wl-token${wlActive.net===net&&wlActive.addr===t.addr?' active':''}"
           onclick="wlInvoke('${net}','${t.addr}','${t.sym}')">
        <span class="wl-token-sym">${t.sym}</span>
        <span style="color:var(--text3);font-size:8px">${t.name}</span>
        <span class="wl-token-del" onclick="event.stopPropagation();wlDelete('${net}',${i})">✕</span>
      </div>`).join('');
  }
}

function wlSelectNet(net){
  document.getElementById('cfg-network').value=net;
  onNetworkChange();
  renderWatchlist();
}

function wlInvoke(net,addr,sym){
  wlActive={net,addr};
  document.getElementById('cfg-network').value=net;
  document.getElementById('cfg-pair').value=addr;
  onNetworkChange();
  renderWatchlist();
  invoke();
}

function wlDelete(net,idx){
  const data=wlLoad();
  data[net].splice(idx,1);
  wlSave(data);
  renderWatchlist();
}

function wlAdd(){
  const raw=document.getElementById('wl-inp').value.trim();
  if(!raw)return;
  const net=document.getElementById('cfg-network').value;
  const data=wlLoad();
  if(!data[net])data[net]=[];

  // Format: "NOM · ADRESSE" ou juste "ADRESSE" ou "SYMBOLE"
  let sym,addr,name;
  if(raw.includes('·')){
    const parts=raw.split('·').map(s=>s.trim());
    sym=parts[0].toUpperCase();
    addr=parts[1];
    name=parts[0];
  } else if(isContractAddress(raw)){
    sym=raw.slice(0,6)+'…';
    addr=raw;
    name='Token custom';
  } else {
    sym=raw.toUpperCase();
    addr=raw.toUpperCase();
    name=raw;
  }

  // Éviter les doublons
  if(data[net].some(t=>t.addr===addr)){
    document.getElementById('wl-inp').value='';
    return;
  }
  data[net].push({sym,addr,name});
  wlSave(data);
  document.getElementById('wl-inp').value='';
  renderWatchlist();
}

function onNetworkChange(){
  const net=document.getElementById('cfg-network').value;
  const inp=document.getElementById('cfg-pair');
  if(net==='coinbase'){
    inp.placeholder='BTC, ETH, POLS…';
  } else {
    inp.placeholder='Adresse du token…';
    inp.value='';
  }
  renderWatchlist();
}

