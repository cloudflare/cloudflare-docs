async function invoke(){
  const network=document.getElementById('cfg-network').value;
  const raw=document.getElementById('cfg-pair').value.trim();
  const gran=parseInt(document.getElementById('cfg-tf').value);
  const btn=document.getElementById('invoke-btn');
  const prog=document.getElementById('prog');

  if(!raw){prog.textContent='⚠ Entrez un symbole ou une adresse';return;}

  btn.disabled=true;btn.textContent='⟳ INVOCATION…';
  prog.innerHTML='<span class="rune-spin">⚗</span>Consultation des oracles…';
  document.getElementById('sheet').innerHTML='';

  try{
    let ca,cgRaw,dom,label,externalLinks=null;

    if(network==='coinbase'){
      // ── Mode Coinbase (symboles connus) ───────────────────────
      const pair=raw.includes('-')?raw.toUpperCase():raw.toUpperCase()+'-USD';
      const base=pair.replace('-USD','');
      label=base;
      const [candles,cg,dominance]=await Promise.all([
        fetchCandles(pair,gran),
        fetchCoinGeckoData(base),
        fetchDominance(base)
      ]);
      ca=candles;cgRaw=cg;dom=dominance;
      if(cgRaw&&dom!=null)cgRaw.dominance=dom;

    } else {
      // ── Mode GeckoTerminal (adresse contrat) ──────────────────
      prog.innerHTML='<span class="rune-spin">⚗</span>Recherche de la pool sur '+network+'…';
      const tokenAddr=raw;
      const [geckoResult,tokenInfo]=await Promise.all([
        fetchCandlesGecko(network,tokenAddr,gran),
        fetchTokenNameGecko(network,tokenAddr)
      ]);
      ca=geckoResult.candles;
      const pool=geckoResult.pool;
      const symbol=tokenInfo?.symbol||pool.name.split('/')[0]||'TOKEN';
      label=symbol+(tokenInfo?.name?' · '+tokenInfo.name:'');

      // CoinGecko pour le codex (si token connu)
      const base=symbol.toUpperCase();
      const [cg,dominance]=await Promise.all([
        fetchCoinGeckoData(base),
        fetchDominance(base)
      ]);
      cgRaw=cg;dom=dominance;
      if(cgRaw&&dom!=null)cgRaw.dominance=dom;

      // TVL dans le codex si pas de CoinGecko
      if(!cgRaw&&pool.tvl>0){
        cgRaw={rank:null,name:tokenInfo?.name||symbol,marketCap:null,
          volume24h:null,circulatingSupply:null,totalSupply:null,maxSupply:null,
          ath:null,athDate:null,athPct:null,dominance:null,
          categories:pool.dex+' · '+network,genesis:null,hashing:null,
          tvl:pool.tvl,poolName:pool.name};
      }

      externalLinks=buildExternalLinks(network,tokenAddr,symbol,pool.address);
    }

    prog.innerHTML='<span class="rune-spin">⚔</span>Analyse des augures…';
    await new Promise(r=>setTimeout(r,300));
    const s=analyze(label,ca);
    s.externalLinks=externalLinks;
    await renderSheet(s,cgRaw);
    prog.textContent='✦ Personnage invoqué avec succès ✦';
    setTimeout(()=>prog.textContent='',3000);

  }catch(e){
    prog.textContent='';
    document.getElementById('sheet').innerHTML=`<div class="empty">⚠ ${e.message}<br>Vérifie l'adresse ou le réseau sélectionné</div>`;
  }
  btn.disabled=false;btn.textContent='⚔ INVOQUER';
}


