}

async function generatePortrait(s) {
  const genEl   = document.getElementById('avatar-gen');
  const imgEl   = document.getElementById('avatar-portrait');
  const symEl   = document.getElementById('avatar-symbol');
  const retryEl = document.getElementById('avatar-retry');
  const orKey   = document.getElementById('cfg-gemini')?.value.trim();
  const hfKey   = document.getElementById('cfg-hf')?.value.trim();

  if (!imgEl || (!orKey && !hfKey)) { if (genEl) genEl.textContent = ''; return; }

  _lastPortraitState = s;
  if (retryEl) retryEl.style.display = 'none';
  const prompt = buildPortraitPrompt(s);

  // ── Stratégie 1 : OpenRouter / Grok Imagine (payant, meilleure qualité) ──
  if (orKey) {
    if (genEl) genEl.textContent = '🎨 GROK FORGE LE PORTRAIT…';
    try {
      const resp = await fetch('https://openrouter.ai/api/v1/chat/completions', {
        method: 'POST',
        headers: {
          'Content-Type':  'application/json',
          'Authorization': `Bearer ${orKey}`,
          'HTTP-Referer':  window.location.href,
          'X-Title':       'ARIA RPG',
        },
        body: JSON.stringify({
          model:      'x-ai/grok-imagine-image-quality',
          modalities: ['image'],
          messages:   [{ role: 'user', content: prompt }],
        })
      });
      if (resp.ok) {
        const data    = await resp.json();
        const msg     = data?.choices?.[0]?.message;
        const images  = msg?.images || [];
        const parts   = Array.isArray(msg?.content) ? msg.content : [];
        let url = images[0]?.image_url?.url
               || parts.find(c=>c.type==='image_url')?.image_url?.url
               || (typeof msg?.content==='string'&&msg.content.startsWith('data:') ? msg.content : null);
        if (url) { console.log('✓ Grok Imagine'); _showPortrait(imgEl, symEl, genEl, url); return; }
        console.warn('Grok: réponse OK sans image', JSON.stringify(data).slice(0,300));
      } else {
        const err = await resp.json().catch(()=>({}));
        const msg = err?.error?.message||'';
        console.warn('Grok:', resp.status, msg.slice(0,100));
        if (resp.status === 429) {
          const secs = Math.ceil(parseFloat(msg.match(/retry in ([\d.]+)s/)?.[1]||30));
          let r = secs;
          if (genEl) genEl.textContent = `⏳ ${r}s`;
          const t = setInterval(()=>{ r--; if(genEl) genEl.textContent=r>0?`⏳ ${r}s`:''; if(r<=0){clearInterval(t);if(retryEl)retryEl.style.display='block';}},1000);
          if (!hfKey) return;
        }
        if (resp.status === 402 && !hfKey) {
          if (genEl) { genEl.textContent='✗ Crédits insuffisants'; setTimeout(()=>{if(genEl)genEl.textContent='';if(retryEl)retryEl.style.display='block';},3000); }
          return;
        }
      }
    } catch(e) { console.warn('Grok exception:', e.message); }
  }

  // ── Stratégie 2 : Cloudflare Workers AI — FLUX.1 Schnell (10 000 img/jour gratuit) ──
  if (hfKey) {
    const cfAccount = document.getElementById('cfg-cf-account')?.value.trim();
    if (!cfAccount) {
      if (genEl) { genEl.textContent = '✗ Account ID Cloudflare manquant'; setTimeout(()=>{if(genEl)genEl.textContent='';},3000); }
      return;
    }

    if (genEl) genEl.textContent = '☁ CLOUDFLARE FORGE LE PORTRAIT…';

    // Cloudflare Workers AI — FLUX.1 Schnell (rapide) ou SDXL Lightning
    // Modèles disponibles : @cf/black-forest-labs/flux-1-schnell ou @cf/stabilityai/stable-diffusion-xl-lightning

    // Cloudflare Workers AI — via proxy local (CORS bloqué côté navigateur)
    const cfModel = '@cf/black-forest-labs/flux-1-schnell';
    const cfUrl   = '/proxy/cloudflare'; // Le proxy Python ajoute le bon endpoint CF

    try {
      const resp = await fetch(cfUrl, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          _cf_token:   hfKey,
          _cf_account: cfAccount,
          _cf_model:   cfModel,
          prompt,
          num_steps: 4,
          guidance:  3.5,
          width:     512,
          height:    640,
        }),
      });

      if (!resp.ok) {
        const e = await resp.json().catch(()=>({}));
        const msg = e?.errors?.[0]?.message || JSON.stringify(e).slice(0,150);
        console.warn('Cloudflare Workers AI:', resp.status, msg);
        if (genEl) { genEl.textContent = `✗ CF ${resp.status}`; setTimeout(()=>{if(genEl)genEl.textContent='';if(retryEl)retryEl.style.display='block';},3000); }
        return;
      }

      // Cloudflare retourne l'image directement en binaire (pas JSON)
      const contentType = resp.headers.get('content-type') || '';
      if (contentType.includes('image') || contentType.includes('octet')) {
        const blob = await resp.blob();
        if (blob.size > 1000) {
          console.log('✓ Cloudflare FLUX.1 Schnell');
          _showPortrait(imgEl, symEl, genEl, URL.createObjectURL(blob));
          return;
        }
      }

      // Parfois Cloudflare retourne un JSON avec l'image en base64
      const data = await resp.json().catch(()=>({}));
      const b64  = data?.result?.image || data?.image;
      if (b64) {
        console.log('✓ Cloudflare FLUX base64');
        _showPortrait(imgEl, symEl, genEl, `data:image/png;base64,${b64}`);
        return;
      }

      console.warn('Cloudflare: réponse inattendue', JSON.stringify(data).slice(0,300));
      if (genEl) genEl.textContent = '';
      if (retryEl) retryEl.style.display = 'block';

    } catch(e) {
      console.warn('Cloudflare exception:', e.message);
      if (genEl) genEl.textContent = '';
      if (retryEl) retryEl.style.display = 'block';
    }
  }

  if (genEl) genEl.textContent = '';
  if (retryEl) retryEl.style.display = 'block';
}

function _showPortrait(imgEl, symEl, genEl, src) {
  imgEl.onload = () => {
    imgEl.style.opacity = '1';
    const ph = document.getElementById('hero-placeholder');
    if (ph) ph.style.display = 'none';
    if (genEl) genEl.textContent = '';
    const retryEl = document.getElementById('avatar-retry');
    if (retryEl) retryEl.style.display = 'none';
  };
  imgEl.src = src;
}

// Stock du dernier état pour le retry
let _lastPortraitState = null;
function retryPortrait() {
  const retryEl = document.getElementById('avatar-retry');
  if (retryEl) retryEl.style.display = 'none';
  if (_lastPortraitState) generatePortrait(_lastPortraitState);
}
