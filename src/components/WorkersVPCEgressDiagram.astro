---
const policies = [
	{ label: "DNS", href: "/cloudflare-one/traffic-policies/dns-policies/" },
	{ label: "HTTP", href: "/cloudflare-one/traffic-policies/http-policies/" },
	{ label: "Network", href: "/cloudflare-one/traffic-policies/network-policies/" },
];

const logs = ["DNS", "HTTP", "Network"];
const logsHref = "/cloudflare-one/insights/logs/dashboard-logs/gateway-logs/";
---

<figure class="vpc-egress-diagram" aria-label="Workers VPC public Internet egress through Cloudflare Mesh and Cloudflare Gateway">
	<div class="diagram-map">
		<div class="flow-row">
			<a class="node-card worker-card" href="/workers/" aria-label="Cloudflare Workers">
				<header class="node-header">
					<span class="node-icon worker-icon" aria-hidden="true">W</span>
					<div class="node-title">Worker</div>
				</header>
				<div class="node-body">
					<code>env.EGRESS.fetch()</code>
				</div>
			</a>

			<div class="flow-connector" aria-hidden="true">
				<span class="connector-label">VPC binding</span>
				<span class="connector-arrow">→</span>
			</div>

			<a class="node-card mesh-card" href="/cloudflare-one/networks/connectors/cloudflare-mesh/" aria-label="Cloudflare Mesh">
				<header class="node-header">
					<span class="node-icon mesh-icon" aria-hidden="true">M</span>
					<div class="node-title">Cloudflare Mesh</div>
				</header>
				<div class="node-body">
					<a class="inline-pill mesh-pill" href="/workers-vpc/configuration/vpc-networks/">
						<code>cf1:network</code>
					</a>
				</div>
			</a>

			<div class="flow-connector" aria-hidden="true">
				<span class="connector-arrow">→</span>
			</div>

			<a class="node-card gateway-card" href="/cloudflare-one/traffic-policies/" aria-label="Cloudflare Gateway">
				<header class="node-header">
					<span class="node-icon gateway-icon" aria-hidden="true">G</span>
					<div class="node-title">Cloudflare Gateway</div>
				</header>
				<div class="node-body">
					<div class="pill-row">
						{policies.map((p) => (
							<a class="policy-pill" href={p.href}>{p.label}</a>
						))}
					</div>
					<div class="node-caption">Policies applied</div>
				</div>
			</a>

			<div class="flow-connector" aria-hidden="true">
				<span class="connector-arrow">→</span>
			</div>

			<a class="node-card internet-card" href="https://www.cloudflare.com/learning/network-layer/what-is-the-internet/" aria-label="Public Internet destination">
				<header class="node-header">
					<span class="node-icon internet-icon" aria-hidden="true">↗</span>
					<div class="node-title">Public Internet</div>
				</header>
				<div class="node-body">
					<code>https://api.example.com</code>
				</div>
			</a>
		</div>

		<a class="logs-card" href={logsHref} aria-label="Gateway logs">
			<span class="logs-title">Gateway logs</span>
			<span class="logs-pills">
				{logs.map((l) => <span class="logs-pill">{l}</span>)}
			</span>
		</a>
	</div>
</figure>

<style>
	.vpc-egress-diagram {
		--map-bg: light-dark(#fafafa, #0f0f10);
		--map-card: light-dark(#ffffff, #171719);
		--map-elevated: light-dark(#fafafa, #111113);
		--map-overlay: light-dark(#f5f5f5, #222226);
		--map-line: light-dark(rgb(0 0 0 / 12%), rgb(255 255 255 / 14%));
		--map-text: light-dark(#171717, #f5f5f5);
		--map-strong: light-dark(#525252, #a3a3a3);
		--map-subtle: light-dark(#737373, #d4d4d4);
		--map-caption: light-dark(#737373, #a3a3a3);
		--map-brand: #f6821f;
		--map-mesh: light-dark(#7c3aed, #a78bfa);
		--map-gateway: light-dark(#0ea5e9, #38bdf8);
		--map-internet: light-dark(#10b981, #34d399);
		margin: 1.25rem 0;
		font-family: "Inter Variable", ui-sans-serif, system-ui, sans-serif;
		font-feature-settings: "cv02", "cv03", "cv04", "calt";
		-webkit-font-smoothing: antialiased;
		letter-spacing: -0.01em;
	}

	.vpc-egress-diagram a {
		color: inherit;
		text-decoration: none;
	}

	.diagram-map {
		display: flex;
		flex-direction: column;
		gap: 14px;
		width: 100%;
		padding: 22px 20px;
		border: 1px solid var(--map-line);
		border-radius: 12px;
		background:
			radial-gradient(circle, var(--map-line) 1px, transparent 1px),
			var(--map-bg);
		background-size: 14px 14px;
	}

	.flow-row {
		display: flex;
		align-items: stretch;
		gap: 0;
	}

	.node-card {
		display: flex;
		flex-direction: column;
		gap: 10px;
		flex: 1 1 0;
		min-width: 0;
		padding: 12px 14px;
		border: 1px solid var(--map-line);
		border-radius: 10px;
		background: var(--map-card);
		box-shadow: 0 5px 14px rgb(0 0 0 / 7%);
		color: var(--map-text);
		transition:
			background-color 150ms ease,
			border-color 150ms ease,
			transform 150ms ease;
	}

	.node-card:hover {
		background: var(--map-overlay);
		border-color: color-mix(in srgb, var(--map-brand) 50%, var(--map-line));
		transform: translateY(-1px);
	}

	.node-header {
		display: flex;
		align-items: center;
		gap: 10px;
	}

	.node-title {
		min-width: 0;
		flex: 1;
		color: var(--map-text);
		font-size: 14px;
		font-weight: 600;
		letter-spacing: -0.01em;
	}

	.node-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 28px;
		height: 28px;
		border-radius: 7px;
		font-size: 14px;
		font-weight: 600;
	}

	.worker-icon {
		background: color-mix(in srgb, var(--map-brand) 14%, transparent);
		color: var(--map-brand);
	}

	.mesh-icon {
		background: color-mix(in srgb, var(--map-mesh) 14%, transparent);
		color: var(--map-mesh);
	}

	.gateway-icon {
		background: color-mix(in srgb, var(--map-gateway) 14%, transparent);
		color: var(--map-gateway);
	}

	.internet-icon {
		background: color-mix(in srgb, var(--map-internet) 14%, transparent);
		color: var(--map-internet);
	}

	.node-body {
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.node-body code {
		display: inline-block;
		max-width: 100%;
		padding: 3px 6px;
		overflow: hidden;
		border: 1px solid var(--map-line);
		border-radius: 5px;
		background: var(--map-elevated);
		color: var(--map-text);
		font-family: "Paper Mono", ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
		font-size: 11px;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.flow-connector {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 4px;
		flex: 0 0 auto;
		width: 80px;
		min-width: 60px;
		padding: 0 6px;
		color: var(--map-strong);
	}

	.connector-label {
		color: var(--map-caption);
		font-family: "Paper Mono", ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
		font-size: 11px;
		font-weight: 500;
		text-align: center;
		line-height: 1.1;
	}

	.connector-arrow {
		font-size: 22px;
		font-weight: 400;
		line-height: 1;
		color: var(--map-strong);
	}

	.inline-pill {
		display: inline-flex;
		align-items: center;
		padding: 3px 8px;
		border: 1px solid color-mix(in srgb, var(--map-mesh) 35%, var(--map-line));
		border-radius: 6px;
		background: color-mix(in srgb, var(--map-mesh) 6%, var(--map-card));
		font-size: 11px;
		transition:
			border-color 150ms ease,
			background-color 150ms ease;
	}

	.mesh-pill:hover {
		border-color: var(--map-mesh);
		background: color-mix(in srgb, var(--map-mesh) 12%, var(--map-card));
	}

	.inline-pill code {
		padding: 0;
		border: 0;
		background: transparent;
		color: var(--map-mesh);
		font-family: "Paper Mono", ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
		font-size: 11px;
		white-space: nowrap;
	}

	.pill-row {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
	}

	.policy-pill {
		display: inline-flex;
		align-items: center;
		padding: 4px 10px;
		border: 1px solid color-mix(in srgb, var(--map-gateway) 35%, var(--map-line));
		border-radius: 6px;
		background: color-mix(in srgb, var(--map-gateway) 6%, var(--map-card));
		color: var(--map-text);
		font-size: 11px;
		font-weight: 500;
		transition:
			border-color 150ms ease,
			background-color 150ms ease;
	}

	.policy-pill:hover {
		border-color: var(--map-gateway);
		background: color-mix(in srgb, var(--map-gateway) 14%, var(--map-card));
	}

	.node-caption {
		color: var(--map-caption);
		font-size: 11px;
		font-style: italic;
	}

	.logs-card {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 14px;
		padding: 10px 16px;
		border: 1px solid var(--map-line);
		border-radius: 8px;
		background: var(--map-card);
		box-shadow: 0 5px 14px rgb(0 0 0 / 7%);
		color: var(--map-text);
		transition:
			background-color 150ms ease,
			border-color 150ms ease,
			transform 150ms ease;
	}

	.logs-card:hover {
		background: var(--map-overlay);
		border-color: color-mix(in srgb, var(--map-brand) 50%, var(--map-line));
		transform: translateY(-1px);
	}

	.logs-title {
		color: var(--map-strong);
		font-family: "Paper Mono", ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
		font-size: 12px;
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: -0.01em;
	}

	.logs-pills {
		display: inline-flex;
		gap: 6px;
	}

	.logs-pill {
		display: inline-flex;
		align-items: center;
		padding: 2px 8px;
		border: 1px solid var(--map-line);
		border-radius: 5px;
		background: var(--map-elevated);
		color: var(--map-subtle);
		font-size: 11px;
	}

	@media (max-width: 58rem) {
		.flow-row {
			flex-direction: column;
			gap: 10px;
		}

		.flow-connector {
			flex-direction: row;
			width: auto;
			padding: 0;
		}

		.connector-arrow {
			transform: rotate(90deg);
			display: inline-block;
		}

		.node-card {
			width: 100%;
		}
	}
</style>
