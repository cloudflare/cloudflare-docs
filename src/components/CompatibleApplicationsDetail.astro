---
import { getCollection } from "astro:content";
import { Tabs, TabItem } from "@astrojs/starlight/components";

type Item = {
	operation_name: string;
	operation_id: number;
	application_control: string | null;
	application_control_id: number | null;
	contains_payload: boolean;
	operation_group: string;
	operation_group_id: number;
};

type Control = {
	label: string;
	items: Item[];
};

type Application = {
	name: string;
	display_name: string;
	controls: Control[];
};

const collection = await getCollection("granular-control-applications");

const sorted = [...collection].sort((a, b) =>
	a.data.display_id.localeCompare(b.data.display_id),
);

const COLUMNS = [
	"Operation name",
	"Operation ID",
	"Application control",
	"Application control ID",
	"Contains payload",
	"Operation group",
	"Operation group ID",
] as const;
---

<div class="compatible-apps">
	{
		sorted.map((entry) => (
			<>
				<h2 id={entry.id}>{entry.data.display_id}</h2>
				{(entry.data.applications as Application[]).map((app) => (
					<>
						<h3 id={app.name}>{app.display_name}</h3>
						{app.controls.length > 1 ? (
							<Tabs>
								{app.controls.map((control) => (
									<TabItem label={control.label}>
										<table>
											<thead>
												<tr>
													{COLUMNS.map((col) => (
														<th>{col}</th>
													))}
												</tr>
											</thead>
											<tbody>
												{control.items.map((item) => (
													<tr>
														<td data-label="Operation name">
															<strong>{item.operation_name}</strong>
														</td>
														<td data-label="Operation ID">
															<code>{item.operation_id}</code>
														</td>
														<td data-label="Application control">
															{item.application_control ?? "—"}
														</td>
														<td data-label="Application control ID">
															{item.application_control_id !== null ? (
																<code>{item.application_control_id}</code>
															) : (
																"—"
															)}
														</td>
														<td data-label="Contains payload">
															{item.contains_payload ? "✓" : "—"}
														</td>
														<td data-label="Operation group">
															{item.operation_group}
														</td>
														<td data-label="Operation group ID">
															<code>{item.operation_group_id}</code>
														</td>
													</tr>
												))}
											</tbody>
										</table>
									</TabItem>
								))}
							</Tabs>
						) : (
							<table>
								<thead>
									<tr>
										{COLUMNS.map((col) => (
											<th>{col}</th>
										))}
									</tr>
								</thead>
								<tbody>
									{app.controls[0].items.map((item) => (
										<tr>
											<td data-label="Operation name">
												<strong>{item.operation_name}</strong>
											</td>
											<td data-label="Operation ID">
												<code>{item.operation_id}</code>
											</td>
											<td data-label="Application control">
												{item.application_control ?? "—"}
											</td>
											<td data-label="Application control ID">
												{item.application_control_id !== null ? (
													<code>{item.application_control_id}</code>
												) : (
													"—"
												)}
											</td>
											<td data-label="Contains payload">
												{item.contains_payload ? "✓" : "—"}
											</td>
											<td data-label="Operation group">
												{item.operation_group}
											</td>
											<td data-label="Operation group ID">
												<code>{item.operation_group_id}</code>
											</td>
										</tr>
									))}
								</tbody>
							</table>
						)}
					</>
				))}
			</>
		))
	}
</div>

<style is:global>
	@media (max-width: 640px) {
		.sl-markdown-content
			.compatible-apps
			tbody:has(tr:nth-child(5))
			tr:nth-child(even)
			td {
			background-color: transparent;
		}

		.compatible-apps table {
			display: block;
			overflow-x: unset;
		}

		.compatible-apps thead {
			display: none;
		}

		.compatible-apps tbody,
		.compatible-apps tr {
			display: block;
		}

		.compatible-apps tr {
			border-bottom: 1px solid var(--color-table-fill);
			padding-block: 0.75rem;
		}

		.compatible-apps tr:last-child {
			border-bottom: none;
		}

		.compatible-apps td {
			display: flex;
			align-items: baseline;
			gap: 0.75rem;
			border-bottom: none;
			padding: 0.2rem 1rem;
		}

		.compatible-apps td::before {
			content: attr(data-label);
			flex: 0 0 10rem;
			font-size: 0.8125rem;
			color: var(--sl-color-gray-3);
			font-weight: 400;
		}
	}
</style>
