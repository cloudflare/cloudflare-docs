---

---

<figure
	class="artifacts-platform-shared-ci-diagram not-content"
	aria-label="Five Artifacts repos in a single platform namespace all fan in to one shared CI workflow, authored and owned by the platform, that runs build, lint, test, and typecheck. The workflow then fans out to a separate deploy for each repo."
>
	<cfdocs-artifacts-platform-shared-ci-diagram>
		<div class="diagram-container">
			<section class="namespace-group" aria-label="Platform namespace">
				<span class="group-label">Platform namespace</span>
				<div class="repo-column">
					<div class="node repo">Artifact repo A</div>
					<div class="node repo">Artifact repo B</div>
					<div class="node repo">Artifact repo C</div>
					<div class="node repo">Artifact repo D</div>
					<div class="node repo">Artifact repo E</div>
				</div>
			</section>

			<div class="fan fan-in" aria-hidden="true">
				<svg viewBox="0 0 60 400" preserveAspectRatio="none">
					<path d="M2 40 L58 200"></path>
					<path d="M2 120 L58 200"></path>
					<path d="M2 200 L58 200"></path>
					<path d="M2 280 L58 200"></path>
					<path d="M2 360 L58 200"></path>
				</svg>
			</div>

			<div class="ci-card" aria-label="Shared CI workflow">
				<span class="ci-title">Shared CI workflow</span>
				<span class="ci-sub">authored &amp; owned by platform</span>
				<div class="ci-steps">
					<span class="ci-step">build</span>
					<span class="ci-step">lint</span>
					<span class="ci-step">test</span>
					<span class="ci-step">typecheck</span>
				</div>
			</div>

			<div class="fan fan-out" aria-hidden="true">
				<svg viewBox="0 0 60 400" preserveAspectRatio="none">
					<path d="M2 200 L58 40"></path>
					<path d="M2 200 L58 120"></path>
					<path d="M2 200 L58 200"></path>
					<path d="M2 200 L58 280"></path>
					<path d="M2 200 L58 360"></path>
				</svg>
			</div>

			<div class="deploy-column" aria-label="Deploy per repo">
				<div class="node deploy">deploy A</div>
				<div class="node deploy">deploy B</div>
				<div class="node deploy">deploy C</div>
				<div class="node deploy">deploy D</div>
				<div class="node deploy">deploy E</div>
			</div>
		</div>
		<figcaption class="diagram-caption">deploy per repo</figcaption>
	</cfdocs-artifacts-platform-shared-ci-diagram>
</figure>

<style>
	.artifacts-platform-shared-ci-diagram {
		margin: 1.5rem 0;
	}

	cfdocs-artifacts-platform-shared-ci-diagram {
		--diagram-surface: rgb(255 255 255);
		--diagram-group: rgb(250 250 250);
		--diagram-border: rgb(229 229 229);
		--diagram-line: rgb(212 212 212);
		--diagram-text: rgb(23 23 23);
		--diagram-muted: rgb(115 115 115);
		--diagram-accent: rgb(249 115 22);
		display: block;
		width: 100%;
	}

	:root[data-theme="dark"] cfdocs-artifacts-platform-shared-ci-diagram {
		--diagram-surface: rgb(23 23 23);
		--diagram-group: rgb(18 18 18);
		--diagram-border: rgb(64 64 64);
		--diagram-line: rgb(64 64 64);
		--diagram-text: rgb(245 245 245);
		--diagram-muted: rgb(163 163 163);
	}

	.diagram-container {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 0.4fr minmax(0, 1.2fr) 0.4fr minmax(
				0,
				0.8fr
			);
		align-items: center;
		gap: 0;
		width: 100%;
		max-width: 720px;
		margin: 0 auto;
	}

	.namespace-group {
		position: relative;
		background: var(--diagram-group);
		border: 1px dashed var(--diagram-line);
		border-radius: 0.75rem;
		padding: 1.75rem 0.75rem 0.75rem;
		transition: border-color 0.3s ease;
	}

	.group-label {
		position: absolute;
		top: 0.5rem;
		left: 0.75rem;
		font-size: 0.6875rem;
		font-weight: 600;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--diagram-text);
	}

	.repo-column,
	.deploy-column {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.node {
		display: flex;
		align-items: center;
		justify-content: center;
		text-align: center;
		padding: 0.625rem 0.75rem;
		background: var(--diagram-surface);
		border: 1px solid var(--diagram-border);
		border-radius: 0.5rem;
		font-family:
			ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
		font-size: 0.75rem;
		font-weight: 500;
		color: var(--diagram-text);
	}

	.fan {
		align-self: stretch;
		display: flex;
	}

	.fan svg {
		width: 100%;
		height: 100%;
		fill: none;
		stroke: var(--diagram-line);
		stroke-width: 1.5;
		stroke-linecap: round;
	}

	.ci-card {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 0.25rem;
		padding: 1rem 0.875rem;
		background: var(--diagram-group);
		border: 1px solid var(--diagram-accent);
		border-radius: 0.75rem;
	}

	.ci-title {
		font-weight: 700;
		font-size: 0.875rem;
		color: var(--diagram-text);
	}

	.ci-sub {
		font-size: 0.6875rem;
		color: var(--diagram-muted);
	}

	.ci-steps {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.375rem;
		margin-top: 0.5rem;
		width: 100%;
	}

	.ci-step {
		padding: 0.375rem 0.25rem;
		background: var(--diagram-surface);
		border: 1px solid var(--diagram-border);
		border-radius: 0.375rem;
		font-family:
			ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
		font-size: 0.6875rem;
		font-weight: 600;
		color: var(--diagram-text);
	}

	.diagram-caption {
		margin-top: 0.75rem;
		text-align: center;
		font-size: 0.6875rem;
		color: var(--diagram-muted);
	}

	@media (max-width: 40rem) {
		.diagram-container {
			grid-template-columns: 1fr;
			gap: 1rem;
			max-width: 320px;
		}

		.fan {
			display: none;
		}

		.repo-column,
		.deploy-column {
			gap: 0.5rem;
		}
	}
</style>
