---
import { getEntry } from "astro:content";

import { z } from "astro/zod";

type Props = z.infer<typeof props>;
const props = z.object({
	product: z.string(),
});

const input = props.parse(Astro.props);

const entry = await getEntry("product-maturity", input.product);

if (!entry) {
	throw new Error(
		`Product maturity entry not found for product="${input.product}"`,
	);
}
---

{entry.data}
