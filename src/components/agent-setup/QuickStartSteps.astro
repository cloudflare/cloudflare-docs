---
// Renders quick-start steps using Starlight's native `.sl-steps` styling.
// We can't use the <Steps> component directly because it expects a parsed
// MDX <ol> in its default slot and our steps come from structured YAML data.
// Instead we render the same <ol class="sl-steps"> markup that <Steps>
// generates — the global Starlight stylesheet styles it automatically,
// giving us the site-standard compact numbered list with a hairline guide.
import { Code } from "@astrojs/starlight/components";

interface Step {
	title: string;
	description: string;
	command?: string;
	link?: string;
}

interface Props {
	steps: Step[];
}

const { steps } = Astro.props;
---

<ol class="sl-steps agent-setup-steps">
	{
		steps.map((step) => (
			<li>
				<p class="agent-setup-step-title">{step.title}</p>
				<p class="agent-setup-step-description" set:html={step.description} />
				{step.command && <Code code={step.command} lang="bash" />}
				{step.link && !step.command && (
					<a
						href={step.link}
						class="agent-setup-link"
						target="_blank"
						rel="noopener noreferrer"
					>
						{step.link} &rarr;
					</a>
				)}
			</li>
		))
	}
</ol>
