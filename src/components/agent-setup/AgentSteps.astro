---
// Drop-in replacement for Starlight's <Steps> component for agent-setup pages.
//
// Starlight's <Steps> calls `await Astro.slots.render('default')` internally,
// then runs a rehype transform to add `class="sl-steps"` and `role="list"` to
// the <ol>. Our Page.astro override also calls `Astro.slots.render("default")`
// to build the ToC, which interferes with nested slot rendering in some Astro
// versions and causes the "found no child elements" error.
//
// This component solves the problem by rendering its slot directly and applying
// the sl-steps class via a wrapping element + CSS, so no rehype processing of
// the slot is required.
---

<div class="agent-steps">
	<slot />
</div>

<style is:global>
	/* Mirror Starlight's sl-steps styles for our wrapper.
	   The slot content is a markdown <ol>, so we target .agent-steps > ol */
	.agent-steps > ol {
		--bullet-size: calc(var(--sl-line-height) * 1rem);
		--bullet-margin: 0.375rem;

		list-style: none;
		counter-reset: steps-counter;
		padding-inline-start: 0;
	}

	.agent-steps > ol > li {
		counter-increment: steps-counter;
		position: relative;
		padding-inline-start: calc(var(--bullet-size) + 1rem);
		padding-bottom: 1px;
		min-height: calc(var(--bullet-size) + var(--bullet-margin));
	}

	.agent-steps > ol > li + li {
		margin-top: 0;
	}

	/* Numbered bullet */
	.agent-steps > ol > li::before {
		content: counter(steps-counter);
		position: absolute;
		top: 0;
		inset-inline-start: 0;
		width: var(--bullet-size);
		height: var(--bullet-size);
		line-height: var(--bullet-size);

		font-size: var(--sl-text-xs);
		font-weight: 600;
		text-align: center;
		color: var(--sl-color-white);
		background-color: var(--sl-color-gray-6);
		border-radius: 99rem;
		box-shadow: inset 0 0 0 1px var(--sl-color-gray-5);
	}

	/* Vertical guideline */
	.agent-steps > ol > li::after {
		--guide-width: 1px;
		content: "";
		position: absolute;
		top: calc(var(--bullet-size) + var(--bullet-margin));
		bottom: var(--bullet-margin);
		inset-inline-start: calc((var(--bullet-size) - var(--guide-width)) / 2);
		width: var(--guide-width);
		background-color: var(--sl-color-hairline-light);
	}

	/* Align first child with bullet */
	.agent-steps > ol > li > :first-child {
		--lh: calc(1em * var(--sl-line-height));
		--shift-y: calc(0.5 * (var(--bullet-size) - var(--lh)));
		transform: translateY(var(--shift-y));
		margin-bottom: var(--shift-y);
	}

	.agent-steps > ol > li > :first-child:where(h1, h2, h3, h4, h5, h6) {
		--lh: calc(1em * var(--sl-line-height-headings));
	}

	@supports (--prop: 1lh) {
		.agent-steps > ol > li > :first-child {
			--lh: 1lh;
		}
	}
</style>
