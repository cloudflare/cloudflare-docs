---
import { getAgentIconSource } from "./types";

interface Props {
	icon: string;
	iconFile?: string;
	name: string;
	size?: number;
}

const { icon, iconFile, name, size = 36 } = Astro.props;
const lightSrc = getAgentIconSource(icon, iconFile, "light");
const darkSrc = getAgentIconSource(icon, iconFile, "dark");
---

<span
	class="agent-setup-icon-wrap"
	style={`width: ${size}px; height: ${size}px; flex-shrink: 0;`}
>
	<img
		src={lightSrc}
		alt={`${name} icon`}
		width={size}
		height={size}
		class="agent-icon-light"
	/>
	<img
		src={darkSrc}
		alt={`${name} icon`}
		width={size}
		height={size}
		class="agent-icon-dark"
	/>
</span>
