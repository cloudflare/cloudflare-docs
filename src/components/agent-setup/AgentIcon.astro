---
import { getAgentIconSource } from "./icons";

interface Props {
	icon: string;
	iconFile?: string;
	name: string;
	size?: number;
}

const { icon, iconFile, name, size = 36 } = Astro.props;
const sharedSrc = iconFile
	? getAgentIconSource(icon, iconFile, "light")
	: undefined;
const lightSrc = getAgentIconSource(icon, undefined, "light");
const darkSrc = getAgentIconSource(icon, undefined, "dark");
---

<span
	class="agent-setup-icon-wrap"
	style={`width: ${size}px; height: ${size}px; flex-shrink: 0;`}
>
	{sharedSrc ? (
		<img src={sharedSrc} alt={`${name} icon`} width={size} height={size} />
	) : (
		<>
			<img
				src={lightSrc}
				alt={`${name} icon`}
				width={size}
				height={size}
				class="agent-icon-light"
			/>
			<img
				src={darkSrc}
				alt={`${name} icon`}
				width={size}
				height={size}
				class="agent-icon-dark"
			/>
		</>
	)}
</span>
