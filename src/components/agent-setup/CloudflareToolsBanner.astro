---
// Shown between the page title and the agent catalog.
// Communicates what Cloudflare provides before the user picks an agent.

interface Props {
	cli?: "current" | "cf";
}

const { cli = "current" } = Astro.props;
---

<div class="cf-banner not-content">
	<div class="cf-banner-items">
		<div class="cf-banner-item">
			<p class="cf-banner-item-title">Skills</p>
			<p class="cf-banner-item-desc">
				Reusable prompt packages that teach agents about Cloudflare products and
				APIs.
			</p>
			<div class="cf-banner-item-links">
				<a
					href="https://github.com/cloudflare/skills"
					target="_blank"
					rel="noopener noreferrer"
				>
					cloudflare/skills &nearr;
				</a>
			</div>
		</div>

		<div class="cf-banner-item">
			<p class="cf-banner-item-title">MCP</p>
			<p class="cf-banner-item-desc">
				Connect agents to your Cloudflare account. Two flavors:{" "}
				<a
					href="https://github.com/cloudflare/mcp"
					target="_blank"
					rel="noopener noreferrer"
				>
					Code Mode &nearr;
				</a>{" "}
				for broad API coverage across all products, or{" "}
				<a
					href="https://github.com/cloudflare/mcp-server-cloudflare"
					target="_blank"
					rel="noopener noreferrer"
				>
					domain-specific servers &nearr;
				</a>{" "}
				for purpose-built tools within one product area.
			</p>
		</div>

		<div class="cf-banner-item">
			<p class="cf-banner-item-title">CLI</p>
			<p class="cf-banner-item-desc">
				{cli === "cf" ? (
					<>
						The <a href="/cf/">Cloudflare CLI</a>, <code>cf</code>, manages
						resources across Cloudflare and supports Workers project workflows.
						<a href="/workers/wrangler/">Wrangler</a> remains available for
						Workers-specific workflows and convenience commands.
					</>
				) : (
					<>
						<a href="/workers/wrangler/">Wrangler</a> for deploying and managing
						Workers, KV, D1, R2, and more. The <a href="/cf/">Cloudflare CLI</a>
						, <code>cf</code>, covers the whole Cloudflare API and is in beta.
					</>
				)}
			</p>
		</div>
	</div>
</div>
