---
import CornerMarks from "~/components/CornerMarks.astro";
import { Badge } from "@/components/ui/badge";
import type { AgentData } from "./types";
import { capabilityLabels, capabilityTooltips } from "./definitions";

interface Props {
	agents: AgentData[];
}

const { agents } = Astro.props;

interface ColumnDef {
	key: string;
	label: string;
	align?: "left" | "center";
}

const COLUMNS: ColumnDef[] = [
	{ key: "name", label: "Agent", align: "left" },
	{ key: "terminal", label: "Terminal" },
	{ key: "ide", label: "IDE" },
	{ key: "extension", label: "Extension" },
	{ key: "cloud", label: "Cloud" },
	{ key: "pricing_model", label: "Pricing" },
	{ key: "model_flexibility", label: "Model" },
	{ key: "context_approach", label: "Context" },
	{ key: "open_source", label: "Open source" },
];

function sortValue(agent: AgentData, key: string): string {
	switch (key) {
		case "name":
			return agent.name.toLowerCase();
		case "terminal":
		case "ide":
		case "extension":
		case "cloud":
		case "open_source":
			return agent.capabilities[key as keyof AgentData["capabilities"]]
				? "0"
				: "1";
		case "pricing_model":
			return agent.pricing_model ?? "~";
		case "model_flexibility":
			return agent.model_flexibility ?? "~";
		case "context_approach":
			return agent.context_approach ?? "~";
		default:
			return "";
	}
}

const sorted = [...agents].sort((a, b) =>
	sortValue(a, "name").localeCompare(sortValue(b, "name")),
);

type RowData = { agent: AgentData; sortKeys: Record<string, string> };

const rows: RowData[] = sorted.map((agent) => {
	const sortKeys: Record<string, string> = {};
	for (const col of COLUMNS) sortKeys[col.key] = sortValue(agent, col.key);
	return { agent, sortKeys };
});

// Capability columns rendered as check / dash indicators, in table order.
const CAP_COLUMNS: (keyof AgentData["capabilities"])[] = [
	"terminal",
	"ide",
	"extension",
	"cloud",
];

// Value columns rendered as Nimbus badges, in table order.
const VALUE_COLUMNS: (keyof AgentData)[] = [
	"pricing_model",
	"model_flexibility",
	"context_approach",
];

// Each distinct value maps to its own Badge tone (no danger/red), so the
// same value always shares a color and no two values share one.
type BadgeVariant =
	"default" | "info" | "success" | "warning" | "cyan" | "orange" | "steel";
const VALUE_VARIANT: Record<string, BadgeVariant> = {
	subscription: "info",
	hybrid: "warning",
	byok: "cyan",
	locked: "default",
	multi_provider: "success",
	project_memory: "orange",
	indexed_codebase: "steel",
	session: "default",
};

const checkIcon = `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-label="Yes" style="display:inline-block;vertical-align:middle"><path d="M3 8.5L6.5 12L13 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
const dashIcon = `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-label="No" style="display:inline-block;vertical-align:middle"><path d="M4 8H12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>`;
---

<div class="not-content">
	<div class="border-border relative border">
		<CornerMarks />
		<div class="overflow-x-auto">
			<table
				class="w-full min-w-[900px] border-collapse text-sm"
				data-agent-table
			>
				<thead>
					<tr class="bg-muted">
						{
							COLUMNS.map((col, i) => (
								<th
									class:list={[
										"border-border border-b p-0 align-middle",
										i === 0 &&
											"border-border bg-muted sticky left-0 z-20 border-r",
									]}
									data-align={col.align ?? "center"}
									aria-sort={i === 0 ? "ascending" : "none"}
								>
									<button
										type="button"
										class:list={[
											"text-muted-foreground hover:text-foreground data-[active=true]:text-primary flex w-full items-center gap-1.5 px-3 py-3 font-mono text-xs tracking-wider uppercase transition-colors",
											col.align === "left" ? "justify-start" : "justify-center",
										]}
										data-sort-key={col.key}
										data-active={i === 0 ? "true" : "false"}
									>
										<span>{col.label}</span>
										<span
											class="text-primary text-[0.7rem]"
											aria-hidden="true"
											data-indicator
										>
											{i === 0 ? "↑" : ""}
										</span>
									</button>
								</th>
							))
						}
					</tr>
				</thead>
				<tbody data-agent-tbody>
					{
						rows.map(({ agent, sortKeys }) => (
							<tr
								class="group/row border-border hover:bg-muted/50 border-b transition-colors last:border-b-0"
								data-sort-keys={JSON.stringify(sortKeys)}
							>
								<td
									class="border-border bg-background group-hover/row:bg-muted/50 sticky left-0 z-10 border-r px-3 py-3 text-left align-middle"
									data-align="left"
								>
									<a
										href={`/agent-setup/${agent.slug}/`}
										class="text-foreground hover:text-primary font-medium no-underline transition-colors"
									>
										{agent.name}
									</a>
								</td>

								{CAP_COLUMNS.map((cap) => (
									<td
										class:list={[
											"px-3 py-3 text-center align-middle",
											agent.capabilities[cap]
												? "agent-check"
												: "text-muted-foreground/40",
										]}
										set:html={agent.capabilities[cap] ? checkIcon : dashIcon}
									/>
								))}

								{VALUE_COLUMNS.map((key) => {
									const value = agent[key] as string | undefined;
									return (
										<td class="px-3 py-3 text-center align-middle">
											{value ? (
												<Badge
													text={capabilityLabels[value] ?? value}
													variant={VALUE_VARIANT[value] ?? "default"}
													size="small"
													data-agent-tooltip={capabilityTooltips[value] ?? ""}
												/>
											) : (
												<span class="text-muted-foreground/40">—</span>
											)}
										</td>
									);
								})}

								<td
									class:list={[
										"px-3 py-3 text-center align-middle",
										agent.capabilities.open_source
											? "agent-check"
											: "text-muted-foreground/40",
									]}
									set:html={
										agent.capabilities.open_source ? checkIcon : dashIcon
									}
								/>
							</tr>
						))
					}
				</tbody>
			</table>
		</div>
	</div>
	<p class="text-muted-foreground mt-3 text-center text-xs">
		Every agent listed supports Skills and MCP.
	</p>
</div>

<script>
	import { addTooltip } from "~/util/tippy";

	document
		.querySelectorAll<HTMLElement>("[data-agent-tooltip]")
		.forEach((el) => {
			const content = el.dataset.agentTooltip;
			if (!content) return;
			el.style.cursor = "help";
			addTooltip(el, content, { maxWidth: 280, delay: [150, 0] });
		});

	document
		.querySelectorAll<HTMLTableElement>("[data-agent-table]")
		.forEach((table) => {
			const tbody = table.querySelector<HTMLElement>("[data-agent-tbody]");
			if (!tbody) return;

			const rows = Array.from(tbody.querySelectorAll("tr"));
			const buttons = Array.from(
				table.querySelectorAll<HTMLButtonElement>("[data-sort-key]"),
			);

			let currentKey = "name";
			let currentDir: "asc" | "desc" = "asc";

			const sortBy = (key: string, dir: "asc" | "desc") => {
				const sorted = [...rows].sort((r1, r2) => {
					const k1 = JSON.parse(r1.dataset.sortKeys ?? "{}")[key] ?? "";
					const k2 = JSON.parse(r2.dataset.sortKeys ?? "{}")[key] ?? "";
					const result = String(k1).localeCompare(String(k2));
					return dir === "asc" ? result : -result;
				});
				const frag = document.createDocumentFragment();
				sorted.forEach((row) => frag.appendChild(row));
				tbody.appendChild(frag);
			};

			const updateHeaders = (key: string, dir: "asc" | "desc") => {
				buttons.forEach((btn) => {
					const isActive = btn.dataset.sortKey === key;
					btn.dataset.active = String(isActive);
					const indicator = btn.querySelector<HTMLElement>("[data-indicator]");
					if (indicator) {
						indicator.textContent = isActive ? (dir === "asc" ? "↑" : "↓") : "";
					}
					const th = btn.closest("th");
					th?.setAttribute(
						"aria-sort",
						isActive ? (dir === "asc" ? "ascending" : "descending") : "none",
					);
				});
			};

			buttons.forEach((btn) => {
				btn.addEventListener("click", () => {
					const key = btn.dataset.sortKey;
					if (!key) return;
					if (key === currentKey) {
						currentDir = currentDir === "asc" ? "desc" : "asc";
					} else {
						currentKey = key;
						currentDir = "asc";
					}
					sortBy(currentKey, currentDir);
					updateHeaders(currentKey, currentDir);
				});
			});
		});
</script>
