---
interface Workflow {
	title: string;
	steps: string[];
}

interface Props {
	workflows: Workflow[];
}

const { workflows } = Astro.props;
---

<div>
	{
		workflows.map((workflow, i) => (
			<div class="agent-setup-workflow">
				<div class="agent-setup-workflow-header">
					<span
						style={{
							fontSize: "0.75rem",
							fontWeight: 700,
							color: "var(--color-cl1-gray-5)",
						}}
					>
						{i + 1}
					</span>
					{workflow.title}
				</div>
				<ol class="agent-setup-workflow-steps">
					{workflow.steps.map((step) => (
						<li>{step}</li>
					))}
				</ol>
			</div>
		))
	}
</div>
