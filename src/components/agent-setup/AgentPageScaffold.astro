---
// Shared scaffold for per-agent detail pages.
//
// Each agent has its own page under src/pages/agent-setup/{slug}.astro
// which looks up its YAML entry and composes this scaffold with named
// slots for agent-specific content (quick start, notes, tips, etc.).
// Structural bits (header, TOC, section order, default components) live
// here so the 6 agent pages stay focused on their unique content.
import type { MarkdownHeading } from "astro";
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import type { StarlightPageProps } from "@astrojs/starlight/props";
import type { AgentData } from "./types";
import AgentIcon from "./AgentIcon.astro";
import CapabilityBadge from "./CapabilityBadge.astro";

import ExamplePrompts from "./ExamplePrompts.astro";
import FAQSection from "./FAQSection.astro";
import TroubleshootingSection from "./TroubleshootingSection.astro";
import OtherAgents from "./OtherAgents.astro";
import BuildAgentsCallout from "./BuildAgentsCallout.astro";

interface Props {
	agent: AgentData;
	allAgents: AgentData[];
}

const { agent, allAgents } = Astro.props;

const headings: MarkdownHeading[] = [
	{ depth: 2, slug: "quick-start", text: "Quick start" },
	{ depth: 2, slug: "platform-access", text: "Cloudflare platform access" },
	{ depth: 2, slug: "example-prompts", text: "Example prompts" },
	{ depth: 2, slug: "tips", text: "Tips" },
	{ depth: 2, slug: "faq", text: "FAQ" },
	{ depth: 2, slug: "troubleshooting", text: "Troubleshooting" },
	{ depth: 2, slug: "build-on-cloudflare", text: "Build agents on Cloudflare" },
	{ depth: 2, slug: "other-agents", text: "Other agents" },
];

const starlightPageProps = {
	frontmatter: {
		title: `${agent.name} + Cloudflare`,
		description: agent.description,
		template: "splash",
	},
	headings,
	hideTitle: true,
	hideBreadcrumbs: true,
} as StarlightPageProps;

const externalLinks = [
	agent.links.skills && { label: "Skills", href: agent.links.skills },
	agent.links.mcp_server && {
		label: "MCP Server",
		href: agent.links.mcp_server,
	},
	agent.links.cli && { label: "CLI", href: agent.links.cli },
	agent.links.docs && { label: `${agent.name} Docs`, href: agent.links.docs },
].filter(Boolean) as { label: string; href: string }[];
---

<StarlightPage {...starlightPageProps}>
	<!-- Back button -->
	<a href="/agent-setup/" class="agent-setup-back">
		<svg
			xmlns="http://www.w3.org/2000/svg"
			width="16"
			height="16"
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="2"
			stroke-linecap="round"
			stroke-linejoin="round"
			aria-hidden="true"
		>
			<polyline points="15 18 9 12 15 6"></polyline>
		</svg>
		All agents
	</a>

	<!-- Header -->
	<div class="mb-6 flex items-center gap-4">
		<AgentIcon icon={agent.icon} name={agent.name} size={48} />
		<div>
			<h1 id="_top" class="-mt-1! mb-0! text-3xl! leading-none! font-bold!">
				{agent.name} + Cloudflare
			</h1>
			<span class="text-sm" style={`color: var(--color-cl1-gray-5)`}>
				{agent.vendor}
			</span>
		</div>
	</div>

	<!-- Description / intro. Agent pages can pass a richer custom intro via
	     the "intro" slot; otherwise the YAML description is rendered. -->
	{
		Astro.slots.has("intro") ? (
			<div class="agent-setup-intro">
				<slot name="intro" />
			</div>
		) : (
			<p class="mb-4 text-base" style={{ lineHeight: 1.6 }}>
				{agent.description}
			</p>
		)
	}

	<div class="mb-4">
		<CapabilityBadge capabilities={agent.capabilities} />
	</div>

	{
		externalLinks.length > 0 && (
			<div class="agent-setup-links">
				{externalLinks.map((link) => (
					<a
						href={link.href}
						class="agent-setup-link"
						target="_blank"
						rel="noopener noreferrer"
					>
						{link.label} &nearr;
					</a>
				))}
			</div>
		)
	}

	<!-- Quick start (always custom per agent — passed via the "quick-start" slot) -->
	<div class="agent-setup-section">
		<h2 id="quick-start">Quick start</h2>
		<slot name="quick-start" />
	</div>

	<!-- Cloudflare platform access (custom content + optional notes) -->
	<div class="agent-setup-section">
		<h2 id="platform-access">Cloudflare platform access</h2>
		<div class="agent-setup-platform-access">
			<slot name="platform-access" />
		</div>
	</div>

	<!-- Example prompts (YAML-driven, but agents can override via slot) -->
	<div class="agent-setup-section">
		<h2 id="example-prompts">Example prompts</h2>
		{
			Astro.slots.has("example-prompts") ? (
				<slot name="example-prompts" />
			) : (
				<ExamplePrompts prompts={agent.example_prompts} />
			)
		}
	</div>

	<!-- Tips (YAML-driven, overridable) -->
	<div class="agent-setup-section">
		<h2 id="tips">Tips</h2>
		{
			Astro.slots.has("tips") ? (
				<slot name="tips" />
			) : (
				<ul class="agent-setup-tips">
					{agent.tips.map((tip) => (
						<li>{tip}</li>
					))}
				</ul>
			)
		}
	</div>

	<!-- FAQ (YAML-driven, overridable) -->
	<div class="agent-setup-section">
		<h2 id="faq">FAQ</h2>
		{
			Astro.slots.has("faq") ? (
				<slot name="faq" />
			) : (
				<FAQSection items={agent.faq} />
			)
		}
	</div>

	<!-- Troubleshooting (YAML-driven, overridable) -->
	<div class="agent-setup-section">
		<h2 id="troubleshooting">Troubleshooting</h2>
		{
			Astro.slots.has("troubleshooting") ? (
				<slot name="troubleshooting" />
			) : (
				<TroubleshootingSection items={agent.troubleshooting} />
			)
		}
	</div>

	<!-- Build agents on Cloudflare (shared) -->
	<div class="agent-setup-section">
		<h2 id="build-on-cloudflare" class="sr-only">Build agents on Cloudflare</h2>
		<BuildAgentsCallout />
	</div>

	<!-- Other agents — lists every other agent in the collection -->
	<div class="agent-setup-section">
		<h2 id="other-agents">Other agents</h2>
		<OtherAgents currentSlug={agent.slug} allAgents={allAgents} />
	</div>
</StarlightPage>
