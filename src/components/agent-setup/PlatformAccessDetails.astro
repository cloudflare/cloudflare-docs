---
// Accordion row used inside <PlatformAccess>. Delegates to the shared
// Accordion so it stays aligned with FAQItem and TroubleshootingItem. The
// body slot stays in the prose context so inline <code>, links, and lists
// render naturally.
import Accordion from "./Accordion.astro";

interface Props {
	header: string;
	open?: boolean;
}

const { header, open } = Astro.props;
---

<Accordion title={header} open={open}>
	<slot />
</Accordion>
