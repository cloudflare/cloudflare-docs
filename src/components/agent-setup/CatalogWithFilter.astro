---
import { Icon } from "astro-icon/components";
import CornerMarks from "~/components/CornerMarks.astro";
import type { AgentData } from "./types";

interface Props {
	agents: AgentData[];
}

const { agents } = Astro.props;

const FILTERS = [
	{ key: "all", label: "All" },
	{ key: "terminal", label: "Terminal" },
	{ key: "ide", label: "IDE" },
	{ key: "cloud", label: "Cloud" },
	{ key: "extension", label: "Extension" },
] as const;
---

<div class="not-content" data-agent-catalog>
	{/* Filter strip */}
	<div class="mb-6 flex flex-wrap items-center gap-x-3 gap-y-2">
		<span class="text-muted-foreground text-sm">Filter by workflow:</span>
		<div
			class="flex flex-wrap items-center gap-2"
			role="group"
			aria-label="Filter agents"
		>
			{
				FILTERS.map((f, i) => (
					<button
						type="button"
						class="border-border text-muted-foreground hover:border-primary hover:text-foreground aria-pressed:border-primary aria-pressed:bg-primary aria-pressed:text-primary-foreground inline-flex h-8 items-center justify-center rounded-full border px-4 text-sm font-medium transition-colors"
						data-filter={f.key}
						aria-pressed={i === 0 ? "true" : "false"}
					>
						{f.label}
					</button>
				))
			}
		</div>
	</div>

	{
		/* Grid — cards touch via overlapping hairlines (wrapper draws the top+left
	    edge, each card draws its right+bottom edge), so the grid reflows cleanly
	    when cards are filtered out without leaving stray filled cells. */
	}
	<div class="border-border relative border-t border-l">
		<CornerMarks />
		<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3" data-agent-grid>
			{
				agents.map((agent) => {
					const matchKeys = [
						...Object.entries(agent.capabilities)
							.filter(([, v]) => v)
							.map(([k]) => k),
					]
						.filter(Boolean)
						.join(" ");

					return (
						<a
							href={`/agent-setup/${agent.slug}/`}
							class="group/agent-card border-border bg-background text-foreground hover:bg-muted/40 focus-visible:outline-primary relative flex flex-col border-r border-b p-6 no-underline transition-colors focus-visible:outline-2 focus-visible:-outline-offset-2 [&[hidden]]:hidden"
							data-agent-card
							data-match={matchKeys}
						>
							<div class="mb-5 flex items-center gap-3">
								<span class="border-border bg-muted flex size-10 shrink-0 items-center justify-center rounded-md border">
									<img
										src={`/icons/agents/${agent.icon}/light.svg`}
										alt=""
										width="24"
										height="24"
										class="block size-6 dark:hidden"
									/>
									<img
										src={`/icons/agents/${agent.icon}/dark.svg`}
										alt=""
										width="24"
										height="24"
										class="hidden size-6 dark:block"
									/>
								</span>
								<div class="min-w-0 leading-tight">
									<div class="text-primary mb-0.5 font-mono text-xs tracking-widest uppercase">
										{agent.vendor}
									</div>
									<h3 class="text-foreground m-0 text-base leading-snug font-medium md:text-lg">
										{agent.name}
									</h3>
								</div>
							</div>

							<p class="text-muted-foreground mb-6 flex-1 text-sm leading-relaxed">
								{agent.description}
							</p>

							<span class="text-muted-foreground mt-auto inline-flex w-fit items-center gap-2 text-sm font-medium underline-offset-4 group-hover/agent-card:underline">
								View guide
								<Icon
									name="ph:arrow-right"
									class="h-3.5 w-3.5 transition-transform group-hover/agent-card:translate-x-0.5"
								/>
							</span>
						</a>
					);
				})
			}
		</div>
	</div>

	{/* Empty state (hidden unless no cards match) */}
	<div
		class="border-border bg-muted/30 mt-4 border p-8 text-center"
		data-filter-empty
		hidden
	>
		<p class="text-muted-foreground mb-3">No agents match this filter.</p>
		<button
			type="button"
			class="border-border text-muted-foreground hover:border-primary hover:text-foreground inline-flex h-8 items-center justify-center rounded-full border px-4 text-sm font-medium transition-colors"
			data-clear-filter
		>
			Clear filter
		</button>
	</div>
</div>

<script>
	import { addTooltip } from "~/util/tippy";

	// Scoped to each Catalog component on the page so multiple instances don't
	// clash. Handles filter chip selection, URL sync, visibility toggling, and
	// the empty state.
	const FILTER_PARAM = "workflow";
	const VALID_FILTERS = ["all", "terminal", "ide", "cloud", "extension"];

	// Initialize tippy tooltips on all capability badges. Appending to body
	// escapes the table's overflow clip.
	document
		.querySelectorAll<HTMLElement>("[data-agent-tooltip]")
		.forEach((el) => {
			const content = el.dataset.agentTooltip;
			if (!content) return;
			el.style.cursor = "help";
			addTooltip(el, content, { maxWidth: 280, delay: [150, 0] });
		});

	function initCatalog(root: HTMLElement) {
		const chips = root.querySelectorAll<HTMLButtonElement>("[data-filter]");
		const cards = root.querySelectorAll<HTMLElement>("[data-agent-card]");
		const emptyEl = root.querySelector<HTMLElement>("[data-filter-empty]");
		const clearBtn = root.querySelector<HTMLButtonElement>(
			"[data-clear-filter]",
		);

		const applyFilter = (filter: string) => {
			let visible = 0;

			cards.forEach((card) => {
				const matches =
					filter === "all" ||
					(card.dataset.match?.split(/\s+/).includes(filter) ?? false);
				card.hidden = !matches;
				if (matches) visible++;
			});

			// Chip active state (drives Tailwind `aria-pressed:` styling)
			chips.forEach((chip) => {
				const isActive = chip.dataset.filter === filter;
				chip.setAttribute("aria-pressed", String(isActive));
			});

			// Empty state
			if (emptyEl) emptyEl.hidden = visible > 0;

			// URL sync
			const url = new URL(window.location.href);
			if (filter === "all") url.searchParams.delete(FILTER_PARAM);
			else url.searchParams.set(FILTER_PARAM, filter);
			window.history.replaceState({}, "", url.toString());
		};

		// Wire up chips
		chips.forEach((chip) => {
			chip.addEventListener("click", () => {
				const filter = chip.dataset.filter;
				if (filter) applyFilter(filter);
			});
		});

		// "Clear filter" button in empty state
		clearBtn?.addEventListener("click", () => applyFilter("all"));

		// Read initial filter from URL
		const params = new URLSearchParams(window.location.search);
		const initial = params.get(FILTER_PARAM);
		if (initial && VALID_FILTERS.includes(initial)) {
			applyFilter(initial);
		}
	}

	document
		.querySelectorAll<HTMLElement>("[data-agent-catalog]")
		.forEach((root) => initCatalog(root));
</script>
