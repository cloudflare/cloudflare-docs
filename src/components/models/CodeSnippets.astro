---
import { Code, Tabs, TabItem } from "~/components";
import type { CodeSnippet } from "~/schemas/catalog-models";

interface Props {
	snippets: CodeSnippet[];
}

const { snippets } = Astro.props;

// Map common language labels to syntax highlighting language codes
const languageMap: Record<string, string> = {
	typescript: "ts",
	javascript: "js",
	python: "python",
	curl: "bash",
	bash: "bash",
	shell: "bash",
	go: "go",
	rust: "rust",
	ruby: "ruby",
	java: "java",
	csharp: "txt", // Not supported, fallback to txt
	php: "php",
};

// Get display label for a language
function getDisplayLabel(label: string): string {
	const displayNames: Record<string, string> = {
		typescript: "TypeScript",
		javascript: "JavaScript",
		python: "Python",
		curl: "cURL",
		bash: "Bash",
		shell: "Shell",
		go: "Go",
		rust: "Rust",
		ruby: "Ruby",
		java: "Java",
		csharp: "C#",
		php: "PHP",
	};
	return displayNames[label.toLowerCase()] || label;
}

// Get syntax highlighting language code
function getLangCode(label: string): string {
	return languageMap[label.toLowerCase()] || "txt";
}
---

{
	snippets.length === 1 ? (
		<Code code={snippets[0].code} lang={getLangCode(snippets[0].label)} />
	) : (
		<Tabs>
			{snippets.map((snippet) => (
				<TabItem label={getDisplayLabel(snippet.label)}>
					<Code code={snippet.code} lang={getLangCode(snippet.label)} />
				</TabItem>
			))}
		</Tabs>
	)
}
