---
/**
 * ModelBadges — provider + capability + deprecation badges for a model:
 *   - provider badge (Cloudflare-hosted / Third-party) — `default`
 *   - capability badges — `default` (model) / `caution` (platform)
 *   - deprecation — `danger` (Deprecated / Planned deprecation)
 */
import { Badge } from "~/components/ui/badge";
import { CAPABILITY_PROPERTIES, type ModelCardData } from "~/util/models";

interface Props {
	model: ModelCardData;
	maxVisible?: number;
}

const { model, maxVisible } = Astro.props;

type BadgeDef = {
	variant: "default" | "caution" | "danger";
	text: string;
	/** Supplementary tooltip — only the ZDR badge carries one (zdr_comment). */
	title?: string;
};

// Provider badge — always first.
const providerBadge: BadgeDef = {
	variant: "default",
	text: model.hosting === "proxied" ? "Third-party" : "Cloudflare-hosted",
};

// Property badges — iterate the ordered property list so capability +
// deprecation badges appear in data-array order (deprecation interleaved where
// it appears, not forced first).
const propertyBadges: BadgeDef[] = [];
for (const { property_id, value } of model.propertiesList) {
	if (property_id in CAPABILITY_PROPERTIES && value === "true") {
		const def = CAPABILITY_PROPERTIES[property_id];
		const badge: BadgeDef = {
			variant: def.category === "platform" ? "caution" : "default",
			text: def.label,
		};
		// ZDR badge carries the catalog `zdr_comment` as a tooltip.
		if (property_id === "zdr" && model.zdrComment) {
			badge.title = model.zdrComment;
		}
		propertyBadges.push(badge);
	} else if (property_id === "planned_deprecation_date") {
		const ts = Math.floor(new Date(value as string).getTime());
		propertyBadges.push({
			variant: "danger",
			text: Date.now() > ts ? "Deprecated" : "Planned deprecation",
		});
	}
}

const badges: BadgeDef[] = [providerBadge, ...propertyBadges];
const visibleBadges =
	maxVisible === undefined ? badges : badges.slice(0, maxVisible);
const remainingBadges =
	maxVisible === undefined ? [] : badges.slice(maxVisible);
const remainingBadgeLabels = remainingBadges
	.map((badge) => badge.text)
	.join(", ");
---

<ul
	class:list={[
		"pointer-events-auto m-0 flex list-none flex-wrap items-center gap-x-1.5 gap-y-0.5 p-0",
		maxVisible !== undefined && "cursor-default",
	]}
>
	{visibleBadges.map((badge) => (
		<li class="m-0 flex">
			<Badge
				text={badge.text}
				variant={badge.variant}
				size="small"
				title={badge.title}
			/>
		</li>
	))}
	{remainingBadges.length > 0 && (
		<li class="m-0 flex">
			<Badge
				text={`+${remainingBadges.length}`}
				variant="default"
				size="small"
				data-model-badge-tooltip={remainingBadgeLabels}
				aria-label={`${remainingBadges.length} more: ${remainingBadgeLabels}`}
				tabindex="0"
			/>
		</li>
	)}
</ul>

<script>
	import { addTooltip } from "~/util/tippy";

	function initModelBadgeTooltips() {
		document
			.querySelectorAll<HTMLElement>("[data-model-badge-tooltip]")
			.forEach((element) => {
				if ((element as unknown as { _tippy?: unknown })._tippy) return;
				const content = element.dataset.modelBadgeTooltip;
				if (!content) return;
				addTooltip(element, content, { maxWidth: 280, delay: [150, 0] });
			});
	}

	initModelBadgeTooltips();
	document.addEventListener("astro:page-load", initModelBadgeTooltips);
</script>
