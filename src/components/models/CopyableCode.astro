---
/**
 * CopyableCode — copy affordance for the model ID: the id is shown as `<code>`
 * inside the button, the label is a `title`/`aria-label` tooltip, and success
 * is shown by swapping the copy icon for a checkmark.
 */
interface Props {
	text: string;
	label?: string;
}

const { text, label = "Copy" } = Astro.props;
---

<copyable-code data-text={text} class="block min-w-0">
	<button
		type="button"
		title={label}
		aria-label={label}
		class="copy-button text-foreground flex min-h-11 w-full cursor-pointer items-center justify-between gap-3 rounded-sm bg-transparent [padding-block:0.625rem] [padding-inline:0.75rem] text-start active:bg-accent"
	>
		<code class="min-w-0 border-0 bg-transparent p-0 font-mono text-sm [overflow-wrap:anywhere]">
			{text}
		</code>
		<span class="text-muted-foreground inline-flex shrink-0 items-center gap-1.5 text-xs">
			<svg
				aria-hidden="true"
				xmlns="http://www.w3.org/2000/svg"
				width="14"
				height="14"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				class="copy-icon text-muted-foreground shrink-0"
			>
				<rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
				<path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
			</svg>
			Copy
		</span>
	</button>
</copyable-code>

<style>
	.copy-button:focus-visible {
		outline: 2px solid currentColor;
		outline-offset: 4px;
	}

	@media (hover: hover) and (pointer: fine) {
		.copy-button:hover {
			background-color: var(--nb-accent);
		}
	}
</style>

<script>
	class CopyableCode extends HTMLElement {
		connectedCallback() {
			const text = this.dataset.text ?? "";
			const button = this.querySelector("button");
			const icon = this.querySelector<SVGElement>(".copy-icon");

			const copyPath = icon?.innerHTML;
			const checkPath = '<polyline points="20 6 9 17 4 12"></polyline>';

			button?.addEventListener("click", async () => {
				try {
					await navigator.clipboard.writeText(text);

					if (icon && copyPath) {
						icon.innerHTML = checkPath;
						icon.style.color = "var(--nb-success)";
						setTimeout(() => {
							icon.innerHTML = copyPath;
							icon.style.color = "";
						}, 1500);
					}
				} catch {
					// Ignore clipboard failures (denied/unavailable access)
				}
			});
		}
	}

	if (!customElements.get("copyable-code")) {
		customElements.define("copyable-code", CopyableCode);
	}
</script>
