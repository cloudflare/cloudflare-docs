---
/**
 * ExampleCard — renders one example: a code snippet block (single `<Code>` or
 * `<Tabs>` of languages) plus its rendered output (text / media) and/or raw
 * JSON response.
 */
import { Code } from "~/components/ui/code";
import { Tabs, TabItem } from "~/components/ui/tabs";
import OutputBody from "~/components/models/OutputBody.astro";
import type { ModelExample, CodeSnippet } from "~/util/models";
import {
	getDocumentLayers,
	getHtmlDocument,
	getInputParts,
	getToolCalls,
} from "~/util/models/example-content";

interface Props {
	example: ModelExample;
	fallbackSnippets?: CodeSnippet[];
	layout?: "stack" | "side-by-side";
}

const { example, fallbackSnippets, layout = "side-by-side" } = Astro.props;

const snippets = example.code_snippets ?? fallbackSnippets ?? [];
const hasSnippets = snippets.length > 0;

const output = example.output;

// Text output (e.g. LLM responses): { text: "..." } or { response: "..." }.
// Some examples provide streaming-style chunks as a string array.
function toTextOutput(value: unknown): string | undefined {
	if (typeof value === "string") return value;
	if (Array.isArray(value)) {
		return value.filter((v): v is string => typeof v === "string").join("");
	}
	return undefined;
}

const textOutput = toTextOutput(output?.text ?? output?.response);

const rawImageUrl = output?.image ?? output?.image_url;
const imageUrl = typeof rawImageUrl === "string" ? rawImageUrl : undefined;

// Some models return an `images` array of URLs.
const rawImages = output?.images;
const imageUrls = Array.isArray(rawImages)
	? rawImages.filter((v): v is string => typeof v === "string")
	: [];

const rawVideoUrl = output?.video ?? output?.video_url;
const videoUrl = typeof rawVideoUrl === "string" ? rawVideoUrl : undefined;

const rawAudioUrl = output?.audio ?? output?.audio_url;
const audioUrl = typeof rawAudioUrl === "string" ? rawAudioUrl : undefined;

const hasImage = !!imageUrl || imageUrls.length > 0;
const hasVideo = !!videoUrl;
const hasAudio = !!audioUrl;
// Layered design documents (for example Ad Delayer) show their layers; the
// short status text that comes with them adds nothing next to the layers.
const layers = getDocumentLayers(output);
const hasLayers = layers.length > 0;
const hasText = !!textOutput && !hasLayers;
const hasMedia = hasImage || hasVideo || hasAudio;

const toolCalls = getToolCalls(output);
const hasToolCalls = toolCalls.length > 0;

// What the reader would send: the prompt in prose and any images, shown above
// the request code so the example reads as "this went in, this came out".
const inputParts = getInputParts(example.input);
const hasInputPanel = inputParts.imageUrls.length > 0;

// A full HTML page in the output gets a sandboxed live preview.
const htmlDocument = getHtmlDocument(textOutput);

// The Output tab has renderable content if we detected any known shape above.
const hasOutput = hasText || hasMedia || hasToolCalls || hasLayers;
const hasRawResponse = !!example.raw_response;
const hasResponse = hasOutput || hasRawResponse;

const MAX_STREAM_ITEMS = 3;
const MAX_RAW_JSON_CHARS = 8000;

/**
 * Safely stringify a raw value by truncating any root array and trimming the
 * resulting string. Raw responses can be huge (hundreds of streamed SSE
 * chunks), so this keeps page size reasonable for readers and agents.
 */
function safeStringify(raw: unknown): string {
	let value: unknown = raw;
	if (Array.isArray(value) && value.length > MAX_STREAM_ITEMS) {
		const omitted = value.length - MAX_STREAM_ITEMS;
		value = [
			...value.slice(0, MAX_STREAM_ITEMS - 1),
			`... ${omitted} more chunks omitted ...`,
			value[value.length - 1],
		];
	}
	const json = JSON.stringify(value, null, 2);
	return json.length > MAX_RAW_JSON_CHARS
		? `${json.slice(0, MAX_RAW_JSON_CHARS)}\n... response truncated ...`
		: json;
}

const safeResponse = hasRawResponse ? safeStringify(example.raw_response) : "";

// Only enable the side-by-side layout when a code block and renderable media
// are both present — text-only or JSON-only responses stack better vertically.
const sideBySide =
	layout === "side-by-side" && hasSnippets && hasResponse && hasMedia;

const languageMap: Record<string, string> = {
	typescript: "ts",
	javascript: "js",
	python: "python",
	curl: "bash",
	bash: "bash",
	shell: "bash",
	cURL: "bash",
};

const displayNames: Record<string, string> = {
	typescript: "TypeScript",
	javascript: "JavaScript",
	python: "Python",
	curl: "cURL",
	cURL: "cURL",
	bash: "Bash",
};

// Returns a Shiki language id. Cast to `any` at call sites because Astro's
// `Code` types `lang` as the literal `CodeLanguage` union, while these labels
// are resolved dynamically from the catalog data.
function getLang(label: string): any {
	return languageMap[label] ?? languageMap[label.toLowerCase()] ?? "txt";
}

function getLabel(label: string): string {
	return displayNames[label] ?? displayNames[label.toLowerCase()] ?? label;
}
---

<div class:list={["example-card", { "side-by-side": sideBySide }]}>
	{hasInputPanel && (
		<figure class="example-input">
			<div class="example-input-images">
				{inputParts.imageUrls.map((url) => (
					<img src={url} alt={`Input for ${example.name}`} loading="lazy" />
				))}
			</div>
			{inputParts.prompt && (
				<figcaption class="example-input-prompt">
					{inputParts.prompt}
				</figcaption>
			)}
		</figure>
	)}

	{hasSnippets && (
		<div class="example-code">
			{snippets.length === 1 ? (
				<Code code={snippets[0].code} lang={getLang(snippets[0].label)} />
			) : (
				<Tabs>
					{snippets.map((snippet) => (
						<TabItem label={getLabel(snippet.label)}>
							<Code code={snippet.code} lang={getLang(snippet.label)} />
						</TabItem>
					))}
				</Tabs>
			)}
		</div>
	)}

	{hasResponse && (
		<div class="example-response">
			{hasOutput && hasRawResponse ? (
				<Tabs>
					{htmlDocument && (
						<TabItem label="Live preview">
							<iframe
								class="example-html-preview"
								title={`Live preview of ${example.name}`}
								sandbox="allow-scripts"
								loading="lazy"
								srcdoc={htmlDocument}
							/>
						</TabItem>
					)}
					<TabItem label="Output">
						<OutputBody
							alt={example.name}
							textOutput={hasText ? textOutput : undefined}
							toolCalls={toolCalls}
							layers={layers}
							imageUrl={imageUrl}
							imageUrls={imageUrls}
							videoUrl={videoUrl}
							audioUrl={audioUrl}
						/>
					</TabItem>
					<TabItem label="Raw response">
						<div class="example-raw-response">
							<Code code={safeResponse} lang="json" />
						</div>
					</TabItem>
				</Tabs>
			) : hasOutput ? (
				<OutputBody
					alt={example.name}
					textOutput={hasText ? textOutput : undefined}
					toolCalls={toolCalls}
					layers={layers}
					imageUrl={imageUrl}
					imageUrls={imageUrls}
					videoUrl={videoUrl}
					audioUrl={audioUrl}
				/>
			) : (
				<div class="example-raw-response">
					<Code code={safeResponse} lang="json" />
				</div>
			)}
		</div>
	)}

	{!hasResponse && !hasSnippets && example.input && (
		<Code code={JSON.stringify(example.input, null, 4)} lang="json" />
	)}
</div>

<style>
	.example-card {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.example-card.side-by-side {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(200px, 1fr);
		gap: 1rem;
		align-items: stretch;
	}

	@media (max-width: 768px) {
		.example-card.side-by-side {
			grid-template-columns: 1fr;
		}
	}

	.example-code {
		min-width: 0;
		min-height: 0;
		overflow: hidden;
		display: flex;
		flex-direction: column;
	}

	.example-response {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		margin-top: 0;
		min-width: 0;
	}

	.example-card.side-by-side .example-response {
		position: sticky;
		top: 5rem;
		align-self: start;
	}

	.example-input {
		margin: 0;
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
		gap: 1rem;
		align-items: center;
		padding: 0.75rem;
		border: 1px solid var(--nb-border);
		border-radius: 0.5rem;
		background: var(--nb-muted);
	}

	@media (max-width: 768px) {
		.example-input {
			grid-template-columns: 1fr;
		}
	}

	.example-input-images {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.example-input-images img {
		width: 100%;
		max-height: 18rem;
		object-fit: contain;
		border-radius: 0.375rem;
	}

	.example-input-prompt {
		font-size: 0.9375rem;
		line-height: 1.6;
		white-space: pre-wrap;
	}

	.example-input-prompt::before {
		content: "Prompt";
		display: block;
		margin-bottom: 0.25rem;
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		opacity: 0.7;
	}

	.example-html-preview {
		width: 100%;
		height: 32rem;
		border: 1px solid var(--nb-border);
		border-radius: 0.5rem;
		background: #fff;
	}

	/* Cap raw response JSON so the two tabs render at a similar size. */
	.example-raw-response :global(pre) {
		max-height: 32rem;
		overflow: auto;
	}
</style>
