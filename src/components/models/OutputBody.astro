---
/**
 * OutputBody — renders an example's output: Markdown text, tool calls, image(s),
 * video, or audio.
 */
import MarkdownOutput from "~/components/models/MarkdownOutput";
import type { LayerView, ToolCallView } from "~/util/models/example-content";

interface Props {
	alt: string;
	textOutput?: string;
	toolCalls?: ToolCallView[];
	layers?: LayerView[];
	imageUrl?: string;
	imageUrls?: string[];
	videoUrl?: string;
	audioUrl?: string;
}

const {
	alt,
	textOutput,
	toolCalls = [],
	layers = [],
	imageUrl,
	imageUrls = [],
	videoUrl,
	audioUrl,
} = Astro.props;
---

<div class="example-output-body">
	{textOutput && <MarkdownOutput text={textOutput} />}
	{toolCalls.map((call) => (
		<div class="example-tool-call">
			<div class="example-tool-call-label">Calls tool</div>
			<code class="example-tool-call-name">{call.name}</code>
			<pre class="example-tool-call-args">{call.args}</pre>
		</div>
	))}
	{layers.length > 0 && (
		<div class="example-layers">
			<div class="example-layers-summary">
				{layers.length} editable layers:{" "}
				{layers.filter((l) => l.imageUrl).length} image,{" "}
				{layers.filter((l) => l.text).length} text
			</div>
			<ol class="example-layers-grid">
				{layers.map((layer) => (
					<li class="example-layer">
						{layer.imageUrl ? (
							<img src={layer.imageUrl} alt={layer.id} loading="lazy" />
						) : (
							<p
								class="example-layer-text"
								style={
									layer.color ? `--layer-color: ${layer.color}` : undefined
								}
							>
								{layer.text}
							</p>
						)}
						<div class="example-layer-meta">
							<code>{layer.subtype ?? layer.type}</code>
							{layer.font && <span>{layer.font}</span>}
						</div>
					</li>
				))}
			</ol>
		</div>
	)}
	{imageUrl && <img src={imageUrl} alt={alt} loading="lazy" />}
	{imageUrls.map((url) => (
		<img src={url} alt={alt} loading="lazy" />
	))}
	{
		/* AI-generated outputs do not ship caption tracks. */
		/* eslint-disable-next-line astro/jsx-a11y/media-has-caption */
		videoUrl && <video src={videoUrl} controls preload="metadata" />
	}
	{
		/* AI-generated outputs do not ship caption tracks. */
		/* eslint-disable-next-line astro/jsx-a11y/media-has-caption */
		audioUrl && <audio src={audioUrl} controls preload="metadata" />
	}
</div>

<style>
	.example-output-body {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.example-output-body :global(.example-markdown) {
		padding: 0.25rem 1rem;
		border: 1px solid var(--nb-border);
		border-radius: 0.5rem;
		background: var(--nb-muted);
		color: var(--nb-foreground);
		font-size: 0.9375rem;
		line-height: 1.6;
		max-height: 36rem;
		overflow: auto;
		overflow-wrap: anywhere;
	}

	.example-output-body :global(.example-markdown table) {
		display: block;
		overflow-x: auto;
		border-collapse: collapse;
		font-size: 0.875rem;
	}

	.example-output-body :global(.example-markdown th),
	.example-output-body :global(.example-markdown td) {
		border: 1px solid var(--nb-border);
		padding: 0.375rem 0.625rem;
		vertical-align: top;
	}

	.example-output-body :global(.example-markdown pre) {
		padding: 0.75rem;
		border-radius: 0.375rem;
		background: var(--nb-background);
		overflow-x: auto;
		font-size: 0.8125rem;
	}

	.example-output-body :global(.example-markdown code) {
		font-family: var(--nb-font-mono);
		font-size: 0.85em;
	}

	.example-layers-summary {
		margin-bottom: 0.5rem;
		font-size: 0.875rem;
		opacity: 0.8;
	}

	.example-layers-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr));
		gap: 0.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
		max-height: 32rem;
		overflow: auto;
	}

	.example-layer {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 0.375rem;
		margin: 0;
		padding: 0.5rem;
		border: 1px solid var(--nb-border);
		border-radius: 0.375rem;
		/* Checkerboard so transparent cutouts read as cutouts. */
		background: repeating-conic-gradient(#8881 0% 25%, transparent 0% 50%) 0 0 /
			16px 16px;
	}

	.example-output-body .example-layer img {
		width: 100%;
		height: 6rem;
		object-fit: contain;
		border: 0;
		border-radius: 0;
	}

	.example-layer-text {
		margin: 0;
		padding: 0.25rem;
		border-radius: 0.25rem;
		background: #111;
		color: var(--layer-color, #fff);
		font-size: 0.8125rem;
		font-weight: 600;
		line-height: 1.3;
		overflow-wrap: anywhere;
		white-space: pre-line;
	}

	.example-layer-meta {
		display: flex;
		flex-direction: column;
		font-size: 0.6875rem;
		opacity: 0.75;
	}

	.example-tool-call {
		padding: 0.75rem 1rem;
		border: 1px solid var(--nb-border);
		border-left: 3px solid var(--nb-accent, #f6821f);
		border-radius: 0.5rem;
		background: var(--nb-muted);
	}

	.example-tool-call-label {
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		opacity: 0.7;
	}

	.example-tool-call-name {
		display: block;
		margin: 0.25rem 0 0.5rem;
		font-family: var(--nb-font-mono);
		font-size: 1rem;
		font-weight: 600;
	}

	.example-tool-call-args {
		margin: 0;
		font-family: var(--nb-font-mono);
		font-size: 0.8125rem;
		white-space: pre-wrap;
	}

	.example-output-body :global(img),
	.example-output-body :global(video) {
		width: 100%;
		border-radius: 0.5rem;
		border: 1px solid var(--nb-border);
	}

	.example-output-body :global(audio) {
		width: 100%;
	}
</style>
