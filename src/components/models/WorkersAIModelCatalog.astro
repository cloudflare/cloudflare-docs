---
import { Aside } from "~/components";
import ModelCatalog from "~/components/models/ModelCatalog.astro";
import { getHostedModels, toModelCardData } from "~/util/models";

const models = (await getHostedModels()).map(toModelCardData);
---

<ModelCatalog models={models} basePath="/workers-ai/models">
	<Aside
		type="tip"
		title="Looking for more models, including external providers?"
	>
		Check out the <a href="/ai/models/">unified AI model catalog</a>.
	</Aside>
</ModelCatalog>
