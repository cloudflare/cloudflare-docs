---
import {
	SchemaTree,
	type SchemaNode,
	type RegularNode,
	type SchemaTreeRefDereferenceFn,
} from "@stoplight/json-schema-tree";
import SchemaRow from "~/components/models/SchemaRow.astro";
import { Tabs, TabItem, Code } from "~/components";

// Import the new format system
import type { FormatContext } from "~/util/workers-ai/schema-formats";
import {
	detectFormat,
	generateFromSchema,
} from "~/util/workers-ai/schema-formats";
import { INPUT_FORMATS } from "~/util/workers-ai/input-formats";
import { OUTPUT_FORMATS } from "~/util/workers-ai/output-formats";
import {
	formatLabel,
	getFormatPriority,
} from "~/util/workers-ai/format-labels";

const { schema, type = "input", modelName, taskName } = Astro.props;

// Reference resolver for schema processing
const defaultResolver: SchemaTreeRefDereferenceFn = (dereferencedNode: any) => {
	const ref = dereferencedNode?.$ref || dereferencedNode?.value?.$ref;

	if (!ref) {
		return dereferencedNode;
	}

	const pointer = typeof ref === "string" ? ref : null;

	if (!pointer) {
		throw new ReferenceError(`Could not resolve reference`);
	}

	throw new ReferenceError(`Could not resolve '${pointer}`);
};

// Create format context
const context: FormatContext = {
	type,
	taskName,
	modelName,
};

// Check if the schema has oneOf at the root level
const hasOneOf = schema.oneOf && Array.isArray(schema.oneOf);

// Check if this is a gpt-oss Responses schema that should be shown as a tab
const isGptOssModel = modelName && modelName.includes("gpt-oss");
const isGptOssResponses =
	(schema.title &&
		schema.title.toLowerCase().includes("gpt_oss") &&
		schema.title.toLowerCase().includes("responses")) ||
	isGptOssModel;

// Process the schema based on whether it has oneOf
let options: any[] = [];
let singleTree: SchemaTree | null = null;
let singleJsonExample: string | null = null;

if (hasOneOf) {
	// Filter out streaming for gpt-oss models before processing
	let oneOfOptions = schema.oneOf;
	if (isGptOssModel && type === "output") {
		oneOfOptions = oneOfOptions.filter(
			(option: any) => option.contentType !== "text/event-stream",
		);
	}

	// Process each oneOf option
	options = oneOfOptions.map((option: any, index: number) => {
		const tree = new SchemaTree(option, {
			mergeAllOf: true,
			refResolver: defaultResolver,
			maxRefDepth: 1,
		});
		tree.populate();

		// Use the new format detection system
		const formatRegistry = type === "input" ? INPUT_FORMATS : OUTPUT_FORMATS;
		const detectedFormat = detectFormat(option, context, formatRegistry);

		let jsonExample = "";
		if (detectedFormat) {
			jsonExample = detectedFormat.generateExample(option, context);
		} else {
			// Fallback to schema-based generation
			if (option.type === "string" && option.format === "binary") {
				jsonExample = "Raw binary audio data sent as request body";
			} else if (option.type === "object" || option.properties) {
				jsonExample = generateFromSchema(option);
			} else {
				jsonExample = "{}";
			}
		}

		return {
			label: formatLabel(option) || `Format ${index + 1}`,
			title: option.title,
			tree: tree,
			description: option.description,
			jsonExample: jsonExample,
		};
	});

	// Sort options based on type (input vs output)
	options.sort((a, b) => {
		const aTitle = (a.title || "").toLowerCase();
		const bTitle = (b.title || "").toLowerCase();
		const aPriority = getFormatPriority(aTitle, a.label, type);
		const bPriority = getFormatPriority(bTitle, b.label, type);
		return aPriority - bPriority;
	});
} else if (isGptOssResponses) {
	// Treat gpt-oss Responses schema as a single-tab format
	const tree = new SchemaTree(schema, {
		mergeAllOf: true,
		refResolver: defaultResolver,
		maxRefDepth: 1,
	});
	tree.populate();

	// Use the new format detection system
	const formatRegistry = type === "input" ? INPUT_FORMATS : OUTPUT_FORMATS;
	const detectedFormat = detectFormat(schema, context, formatRegistry);

	options = [
		{
			label: "Responses",
			title: schema.title || "GPT_OSS_Responses",
			tree: tree,
			description: schema.description,
			jsonExample: detectedFormat
				? detectedFormat.generateExample(schema, context)
				: "{}",
		},
	];
} else {
	// If there's no oneOf, use the standard single schema view
	singleTree = new SchemaTree(schema, {
		mergeAllOf: true,
		refResolver: defaultResolver,
		maxRefDepth: 1,
	});
	singleTree.populate();

	// Use the new format detection system
	const formatRegistry = type === "input" ? INPUT_FORMATS : OUTPUT_FORMATS;
	const detectedFormat = detectFormat(schema, context, formatRegistry);

	if (detectedFormat) {
		singleJsonExample = detectedFormat.generateExample(schema, context);
	} else {
		// Fallback to schema-based generation
		if (schema.type === "string" && schema.format === "binary") {
			singleJsonExample = "Raw binary audio data sent as request body";
		} else if (schema.type === "object" || schema.properties) {
			singleJsonExample = generateFromSchema(schema);
		} else {
			singleJsonExample = "{}";
		}
	}
}
---

{
	options.length > 0 ? (
		<Tabs>
			{options.map((option) => {
				const children =
					(option.tree.root.children[0] as RegularNode).children || [];
				const requiredChildren = children.filter((node: SchemaNode) => {
					const required = node.parent?.fragment?.required;
					return (
						Array.isArray(required) &&
						required.includes(node.subpath[node.subpath.length - 1])
					);
				});
				const optionalChildren = children.filter((node: SchemaNode) => {
					const required = node.parent?.fragment?.required;
					return (
						!Array.isArray(required) ||
						!required.includes(node.subpath[node.subpath.length - 1])
					);
				});

				return (
					<TabItem label={option.label}>
						{option.jsonExample && (
							<div class="mb-4">
								<Code code={option.jsonExample} lang="json" />
							</div>
						)}
						<ul class="pl-0">
							{requiredChildren.map((node: SchemaNode) => (
								<SchemaRow node={node} />
							))}
							{optionalChildren.map((node: SchemaNode) => (
								<SchemaRow node={node} />
							))}
						</ul>
					</TabItem>
				);
			})}
		</Tabs>
	) : (
		<>
			{singleJsonExample && (
				<div class="mb-4">
					<Code code={singleJsonExample} lang="json" />
				</div>
			)}
			<ul class="pl-0">
				{singleTree &&
					(() => {
						const children =
							(singleTree.root.children[0] as RegularNode).children || [];
						const requiredChildren = children.filter((node: SchemaNode) => {
							const required = node.parent?.fragment?.required;
							return (
								Array.isArray(required) &&
								required.includes(node.subpath[node.subpath.length - 1])
							);
						});
						const optionalChildren = children.filter((node: SchemaNode) => {
							const required = node.parent?.fragment?.required;
							return (
								!Array.isArray(required) ||
								!required.includes(node.subpath[node.subpath.length - 1])
							);
						});
						return [...requiredChildren, ...optionalChildren].map(
							(node: SchemaNode) => <SchemaRow node={node} />,
						);
					})()}
			</ul>
		</>
	)
}
