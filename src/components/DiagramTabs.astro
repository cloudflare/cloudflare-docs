---
import { Tabs, TabItem } from "@astrojs/starlight/components";

interface Props {
	mermaid: string;
}

const { mermaid } = Astro.props;
---

<Tabs syncKey="diagramFormat">
	<TabItem label="Diagram" icon="document">
		<slot />
	</TabItem>
	<TabItem label="Mermaid" icon="information">
		<pre class="mermaid">{mermaid}</pre>
	</TabItem>
</Tabs>
