---
import { z } from "astro:schema";

const props = z.object({
  size: z.enum(["large", "medium", "small"])
});

type Props = z.infer<typeof props>;
const { size } = Astro.props;

const widthClasses = {
  large: "w-3/4",
  medium: "w-1/2",
  small: "w-1/4"
};
---

<div class={widthClasses[size]}>
  <slot />
</div>
