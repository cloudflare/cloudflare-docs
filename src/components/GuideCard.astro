---
import Icon from "@cloudflare/nimbus-docs/components/Icon.astro";

interface Props {
	icon: string;
	product: string;
	title: string;
	description: string;
	href: string;
	cta?: string;
	headingLevel?: 3 | 4;
}

const {
	icon,
	product,
	title,
	description,
	href,
	cta = "View guide",
	headingLevel,
} = Astro.props;

const TitleTag = headingLevel === 4 ? "h4" : "h3";
---

<a
	href={href}
	class="group/guide-card border-border bg-background text-foreground hover:bg-muted/40 focus-visible:outline-primary relative flex flex-col border-r border-b p-6 no-underline transition-colors focus-visible:outline-2 focus-visible:-outline-offset-2"
>
	<div class="mb-5 flex items-center gap-3">
		<span class="border-border bg-muted text-muted-foreground flex size-10 shrink-0 items-center justify-center rounded-md border">
			<Icon name={icon} size="24px" />
		</span>
		<div class="min-w-0 leading-tight">
			<div class="text-primary mb-0.5 font-mono text-xs tracking-widest uppercase">
				{product}
			</div>
			<TitleTag class="text-foreground m-0 text-base leading-snug font-medium md:text-lg">
				{title}
			</TitleTag>
		</div>
	</div>

	<p class="text-muted-foreground mb-6 flex-1 text-sm leading-relaxed">
		{description}
	</p>

	<span class="text-muted-foreground mt-auto inline-flex w-fit items-center gap-2 text-sm font-medium underline-offset-4 group-hover/guide-card:underline">
		{cta}
		<Icon
			name="ph:arrow-right"
			class="h-3.5 w-3.5 transition-transform group-hover/guide-card:translate-x-0.5"
		/>
	</span>
</a>
