---
const aiSearchApiUrl =
	"https://ai-search.developers.cloudflare.com/api/ai-search";
---

<cfdocs-docsearch id="docsearch" transition:persist="docsearch">
	<button
		type="button"
		class="DocSearch DocSearch-Button"
		aria-label="Search"
		data-search-trigger
	>
		<span class="DocSearch-Button-Container">
			<svg
				width="20"
				height="20"
				class="DocSearch-Search-Icon"
				viewBox="0 0 20 20"
				aria-hidden="true"
			>
				<path
					d="M14.386 14.386l4.0877 4.0877-4.0877-4.0877c-2.9418 2.9419-7.7115 2.9419-10.6533 0-2.9419-2.9418-2.9419-7.7115 0-10.6533 2.9418-2.9419 7.7115-2.9419 10.6533 0 2.9419 2.9418 2.9419 7.7115 0 10.6533z"
					stroke="currentColor"
					fill="none"
					fill-rule="evenodd"
					stroke-linecap="round"
					stroke-linejoin="round"></path>
			</svg>
			<span class="DocSearch-Button-Placeholder">Search</span>
		</span>
		<span class="DocSearch-Button-Keys">
			<kbd class="DocSearch-Button-Key" data-search-shortcut-modifier>Ctrl</kbd>
			<kbd class="DocSearch-Button-Key">K</kbd>
		</span>
	</button>
	<search-modal-snippet
		api-url={aiSearchApiUrl}
		placeholder="Search documentation..."
		max-results="50"
		max-render-results="10"
		group-by="product"
		hide-thumbnails="true"
		show-url="false"></search-modal-snippet>
</cfdocs-docsearch>

<style is:global>
	#docsearch {
		display: inline-flex;
	}

	#docsearch .DocSearch-Button {
		margin: 0;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		height: 2.25rem;
		width: 2.25rem;
		padding: 0;
		border: 1px solid transparent;
		border-radius: 0.5rem;
		background-color: transparent;
		color: var(--nb-muted-foreground);
		font-size: 0.875rem;
		cursor: pointer;
		transition:
			color 150ms,
			background-color 150ms,
			border-color 150ms;
	}

	#docsearch .DocSearch-Button:hover {
		color: var(--nb-foreground);
		background-color: var(--nb-muted);
		box-shadow: none;
	}

	#docsearch .DocSearch-Button:focus-visible {
		outline: 2px solid var(--nb-primary);
		outline-offset: 2px;
	}

	#docsearch .DocSearch-Button-Container {
		display: contents;
	}

	#docsearch .DocSearch-Search-Icon {
		width: 1rem;
		height: 1rem;
		color: currentColor;
		stroke-width: 1.6;
	}

	#docsearch .DocSearch-Button-Placeholder {
		display: none;
		padding: 0;
		font-size: 0.875rem;
	}

	#docsearch .DocSearch-Button-Keys {
		display: none;
		align-items: center;
		gap: 0.125rem;
		min-width: auto;
		margin-inline-start: 0.5rem;
	}

	#docsearch .DocSearch-Button-Key {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		height: 1.25rem;
		min-width: 1.25rem;
		padding: 0 0.25rem;
		margin: 0;
		border: 1px solid var(--nb-border);
		border-radius: 0.25rem;
		background: var(--nb-muted);
		box-shadow: none;
		color: var(--nb-muted-foreground);
		font-size: 0.6875rem;
		font-weight: 600;
	}

	#docsearch search-modal-snippet {
		display: contents;
		--search-snippet-font-family: var(--nb-font-sans);
		--search-snippet-background: var(--nb-background);
		--search-snippet-surface: var(--nb-card);
		--search-snippet-hover-background: var(--nb-accent);
		--search-snippet-border-color: var(--nb-border);
		--search-snippet-text-color: var(--nb-foreground);
		--search-snippet-text-secondary: var(--nb-muted-foreground);
		--search-snippet-text-description: var(--nb-muted-foreground);
		--search-snippet-primary-color: var(--nb-primary);
		--search-snippet-primary-hover: var(--nb-primary-hover);
		--search-snippet-focus-ring: color-mix(
			in oklch,
			var(--nb-primary) 20%,
			transparent
		);
		--search-snippet-result-icon-size: 20px;
		--search-snippet-result-icon-color: var(--nb-muted-foreground);
		--search-snippet-result-icon-active-color: var(--nb-primary);
	}

	#docsearch search-modal-snippet::part(result-icon-page),
	#docsearch search-modal-snippet::part(result-icon-section) {
		display: block;
		background-color: currentColor;
		-webkit-mask-position: center;
		mask-position: center;
		-webkit-mask-repeat: no-repeat;
		mask-repeat: no-repeat;
		-webkit-mask-size: contain;
		mask-size: contain;
	}

	#docsearch search-modal-snippet::part(result-icon-page) {
		-webkit-mask-image: url("@phosphor-icons/core/regular/file.svg");
		mask-image: url("@phosphor-icons/core/regular/file.svg");
	}

	#docsearch search-modal-snippet::part(result-icon-section) {
		-webkit-mask-image: url("@phosphor-icons/core/regular/hash.svg");
		mask-image: url("@phosphor-icons/core/regular/hash.svg");
	}

	@media (min-width: 768px) {
		#docsearch .DocSearch-Button {
			width: auto;
			padding: 0 0.625rem 0 0.75rem;
			border-color: var(--nb-border);
			background-color: var(--nb-card);
		}

		#docsearch .DocSearch-Button:hover {
			border-color: var(--nb-border-strong);
			background-color: var(--nb-card);
		}

		#docsearch .DocSearch-Button-Placeholder {
			display: inline;
		}

		#docsearch .DocSearch-Button-Keys {
			display: flex;
		}
	}
</style>

<script>
	import "@cloudflare/ai-search-snippet/search";
	import type { SearchModalSnippet } from "@cloudflare/ai-search-snippet/search";

	class DocSearchElement extends HTMLElement {
		private trigger: HTMLButtonElement | null = null;
		private modal: SearchModalSnippet | null = null;

		private open = async () => {
			await customElements.whenDefined("search-modal-snippet");
			this.modal?.open();
		};

		private close = () => this.modal?.close();

		connectedCallback() {
			this.trigger = this.querySelector("[data-search-trigger]");
			this.modal = this.querySelector("search-modal-snippet");
			this.trigger?.addEventListener("click", this.open);
			// document.addEventListener("astro:before-preparation", this.close);

			const modifier = this.querySelector("[data-search-shortcut-modifier]");
			if (modifier && /Mac|iPhone|iPad|iPod/.test(navigator.platform)) {
				modifier.textContent = "⌘";
			}
		}

		disconnectedCallback() {
			this.trigger?.removeEventListener("click", this.open);
			document.removeEventListener("astro:before-preparation", this.close);
		}
	}

	if (!customElements.get("cfdocs-docsearch")) {
		customElements.define("cfdocs-docsearch", DocSearchElement);
	}
</script>
