---
import { z } from "astro:schema";
import { parse } from "node-html-parser";
import { renderMermaid } from "~/lib/beautiful-mermaid-patched.js";

type Props = z.infer<typeof props>;

// Validate color props - allow hex, rgb/rgba, hsl/hsla, named colors, or CSS variables
// Block semicolons and braces to prevent CSS injection
const cssColorRegex = /^[^;{}]+$/;

const props = z
	.object({
		fg: z.string().regex(cssColorRegex, "Invalid CSS color value").optional(),
		bg: z.string().regex(cssColorRegex, "Invalid CSS color value").optional(),
		line: z.string().regex(cssColorRegex, "Invalid CSS color value").optional(),
		accent: z.string().regex(cssColorRegex, "Invalid CSS color value").optional(),
		muted: z.string().regex(cssColorRegex, "Invalid CSS color value").optional(),
		surface: z.string().regex(cssColorRegex, "Invalid CSS color value").optional(),
		border: z.string().regex(cssColorRegex, "Invalid CSS color value").optional(),
	})
	.strict();

const { fg, bg, line, accent, muted, surface, border } = props.parse(
	Astro.props,
);

// Cloudflare default theme (light mode base)
const cloudflareTheme = {
	bg: bg ?? "#FFFDFB",
	fg: fg ?? "#1d1d1d",
	accent: accent ?? "#EC5829",
	line: line ?? "#EC5829",
	muted: muted,
	surface: surface,
	border: border ?? "#EC5829",
};

// Extract mermaid code from slot
const slot = await Astro.slots.render("default");
const html = parse(slot);
const copy = html.querySelector("div.copy > button");

if (!copy) {
	throw new Error("[MermaidDiagram] No code block found in slot content. Ensure you have a mermaid code block inside the component.");
}

let diagram = copy.attributes["data-code"];
if (!diagram) {
	throw new Error("[MermaidDiagram] No data-code attribute found on code block.");
}

// Restore newlines (encoded as \u007f by Expressive Code)
diagram = diagram.replace(/\u007f/g, "\n");

// Check for empty diagram content
if (!diagram.trim()) {
	throw new Error("[MermaidDiagram] Empty diagram content. Add mermaid syntax inside the code block.");
}

// Extract accessibility metadata before stripping
// Handle single-line: accTitle: My Title
const accTitleMatch = diagram.match(/accTitle:\s*(.+)/);
// Handle both single-line (accDescr: text) and multi-line (accDescr { text })
const accDescrSingleMatch = diagram.match(/accDescr:\s*([^\n{]+)/);
const accDescrMultiMatch = diagram.match(/accDescr\s*\{([^}]+)\}/s);
const accTitle = accTitleMatch?.[1]?.trim();
const accDescr = accDescrMultiMatch?.[1]?.trim() || accDescrSingleMatch?.[1]?.trim();

// Generate unique ID for accessibility using crypto for better randomness
const uniqueId = crypto.randomUUID().slice(0, 8);

// Strip unsupported mermaid directives
diagram = diagram
	.split("\n")
	.filter((line) => {
		const trimmed = line.trim();
		return (
			!trimmed.startsWith("accTitle:") &&
			!trimmed.startsWith("accDescr:") &&
			!trimmed.startsWith("accDescr {") &&
			!trimmed.startsWith("linkStyle")
		);
	})
	.join("\n")
	// Also remove multi-line accDescr blocks that span lines
	.replace(/accDescr\s*\{[^}]*\}/gs, "");

// Render at build time with error handling
let svg: string;
try {
	svg = await renderMermaid(diagram, cloudflareTheme);
} catch (error) {
	const message = error instanceof Error ? error.message : String(error);
	const preview = diagram.slice(0, 300).replace(/\n/g, "\\n");
	throw new Error(
		`[MermaidDiagram] Failed to render diagram: ${message}\n\nDiagram preview: ${preview}${diagram.length > 300 ? "..." : ""}`
	);
}
---

<figure
	class="mermaid-diagram"
	role="img"
	aria-label={accTitle}
	aria-describedby={accDescr ? `mermaid-desc-${uniqueId}` : undefined}
>
	<Fragment set:html={svg} />
	{
		accDescr && (
			<figcaption id={`mermaid-desc-${uniqueId}`} class="sr-only">
				{accDescr}
			</figcaption>
		)
	}
</figure>

<style>
	.mermaid-diagram {
		margin: 1rem 0;
	}

	.mermaid-diagram :global(svg) {
		max-width: 100%;
		height: auto;
		display: block;
	}

	/* Screen reader only text */
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}
</style>
