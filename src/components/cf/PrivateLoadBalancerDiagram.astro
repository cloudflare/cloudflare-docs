---
/* `role="list"` on the lists below is intentional, not redundant: Safari
   + VoiceOver drop the implicit list role when `list-style: none` is
   applied, so the explicit role is required to preserve list semantics
   for screen reader users. */
/* eslint-disable astro/jsx-a11y/no-redundant-roles */
import { z } from "astro/zod";
import Icon from "@cloudflare/nimbus-docs/components/Icon.astro";

const connectors = {
	tunnel: {
		label: "Cloudflare Tunnel",
		icon: "tunnel",
		href: "/cloudflare-one/networks/connectors/cloudflare-tunnel/",
	},
	mesh: {
		label: "Cloudflare Mesh node",
		icon: "cloudflare-mesh",
		href: "/mesh/",
	},
	wan: {
		label: "Cloudflare WAN",
		icon: "cloudflare-wan",
		href: "/cloudflare-wan/",
	},
} as const;

const pool = z.object({
	name: z.string(),
	site: z.string().optional(),
	connector: z.enum(["tunnel", "mesh", "wan"]),
	endpoints: z
		.array(z.object({ ip: z.string(), vnet: z.string() }))
		.min(1),
});

const props = z.object({
	client: z.string().default("Cloudflare One Client or Cloudflare WAN site"),
	ip: z.string().default("100.112.0.0"),
	pools: z
		.array(pool)
		.min(1)
		.max(3)
		.default([
			{
				name: "Pool 1",
				connector: "tunnel",
				endpoints: [{ ip: "10.0.0.1", vnet: "vnet-a" }],
			},
			{
				name: "Pool 2",
				connector: "mesh",
				endpoints: [{ ip: "10.1.0.1", vnet: "default" }],
			},
			{
				name: "Pool 3",
				connector: "wan",
				endpoints: [{ ip: "10.2.0.1", vnet: "default" }],
			},
		]),
});

const { client, ip, pools } = props.parse(Astro.props);

const summary = pools
	.map(
		(p) =>
			`${p.name}${p.site ? ` in ${p.site}` : ""} through ${connectors[p.connector].label} to ${p.endpoints
				.map((e) => `${e.ip} in virtual network ${e.vnet}`)
				.join(" and ")}`,
	)
	.join("; ");

const ariaLabel = `Private load balancing: a ${client} connects to the private load balancer IP ${ip}. The load balancer picks a healthy endpoint from one of its pools and sends traffic through the connector that routes it: ${summary}.`;
---

<figure class="private-lb-diagram not-content" aria-label={ariaLabel}>
	<div class="diagram">
		<div class="row single-row">
			<div class="node-card">
				<div class="node-header">
					<span class="node-icon client-icon" aria-hidden="true">
						<Icon name="warp-client" />
					</span>
					<span class="node-title">{client}</span>
				</div>
				<p class="node-caption">
					Connects to <code>{ip}</code>
				</p>
			</div>
		</div>

		<div class="row single-row">
			<div class="node-card lb-card">
				<div class="node-header">
					<span class="node-icon lb-icon" aria-hidden="true">
						<Icon name="load-balancing" />
					</span>
					<a class="node-title" href="/load-balancing/private-network/">
						Private load balancer
					</a>
				</div>
				<p class="node-caption">
					Picks a healthy endpoint based on your steering policy
				</p>
				<div class="pill-row">
					<a class="lb-pill" href="/load-balancing/monitors/">Health monitors</a>
					<a
						class="lb-pill"
						href="/load-balancing/understand-basics/traffic-steering/"
					>
						Steering
					</a>
					<a
						class="lb-pill"
						href="/load-balancing/understand-basics/session-affinity/#private-load-balancers"
					>
						Session affinity
					</a>
				</div>
			</div>
		</div>

		<ul
			class:list={["row", "pools-row", `pools-${pools.length}`]}
			role="list"
		>
			{
				pools.map((p) => {
					const c = connectors[p.connector];
					return (
						<li class:list={["node-card", "pool-card", `${p.connector}-card`]}>
							<span class="pool-name">
								{p.name}
								{p.site && <span class="pool-site"> · {p.site}</span>}
							</span>
							<div class="node-header">
								<span
									class:list={["node-icon", `${p.connector}-icon`]}
									aria-hidden="true"
								>
									<Icon name={c.icon} />
								</span>
								<a class="node-title" href={c.href}>
									{c.label}
								</a>
							</div>
							<ul class="endpoint-list" role="list">
								{p.endpoints.map((e) => (
									<li class="endpoint">
										<code>{e.ip}</code>
										<span class="vnet-pill">{e.vnet}</span>
									</li>
								))}
							</ul>
						</li>
					);
				})
			}
		</ul>
	</div>
	<figcaption>Endpoint = IP address + virtual network</figcaption>
</figure>

<style>
	.private-lb-diagram {
		--map-bg: light-dark(#fafafa, #0f0f10);
		--map-card: light-dark(#ffffff, #171719);
		--map-elevated: light-dark(#fafafa, #111113);
		--map-line: light-dark(rgb(0 0 0 / 12%), rgb(255 255 255 / 14%));
		--map-text: light-dark(#171717, #f5f5f5);
		--map-strong: light-dark(#525252, #a3a3a3);
		--map-caption: light-dark(#737373, #a3a3a3);
		--map-brand: #f6821f;
		--map-lb: light-dark(#0ea5e9, #38bdf8);
		--map-tunnel: light-dark(#0891b2, #67e8f9);
		--map-mesh: light-dark(#7c3aed, #a78bfa);
		--map-wan: light-dark(#db2777, #f9a8d4);

		display: flex;
		flex-direction: column;
		gap: 12px;
		margin: 1.5rem 0;
		padding: 22px;
		border: 1px solid var(--map-line);
		border-radius: 12px;
		background:
			radial-gradient(circle, var(--map-line) 1px, transparent 1px),
			var(--map-bg);
		background-size: 14px 14px;
		font-family: "Inter Variable", ui-sans-serif, system-ui, sans-serif;
		font-feature-settings: "cv02", "cv03", "cv04", "calt";
		-webkit-font-smoothing: antialiased;
		letter-spacing: -0.01em;
	}

	.private-lb-diagram a {
		color: inherit;
		text-decoration: none;
	}

	.diagram {
		display: flex;
		flex-direction: column;
		gap: 18px;
	}

	.row {
		position: relative;
		display: grid;
		gap: 16px;
		align-items: stretch;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.row::before {
		content: "";
		position: absolute;
		top: -14px;
		left: 50%;
		width: 2px;
		height: 12px;
		background: var(--map-line);
	}

	.row:first-child::before {
		display: none;
	}

	.single-row {
		grid-template-columns: minmax(0, 1fr);
		justify-items: center;
	}

	.single-row .node-card {
		width: 100%;
		max-width: 420px;
	}

	.pools-1 {
		grid-template-columns: minmax(0, 360px);
		justify-content: center;
	}

	.pools-2 {
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}

	.pools-3 {
		grid-template-columns: repeat(3, minmax(0, 1fr));
	}

	.node-card {
		display: flex;
		flex-direction: column;
		gap: 8px;
		margin: 0;
		padding: 12px 14px;
		border: 1px solid var(--map-line);
		border-radius: 10px;
		background: var(--map-card);
		box-shadow: 0 5px 14px rgb(0 0 0 / 7%);
		color: var(--map-text);
	}

	.lb-card {
		border-color: color-mix(in srgb, var(--map-lb) 40%, var(--map-line));
	}

	.node-header {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 10px;
	}

	.node-title {
		min-width: 0;
		color: var(--map-text);
		font-size: 14px;
		font-weight: 600;
		letter-spacing: -0.01em;
		text-align: center;
	}

	a.node-title {
		transition: color 150ms ease;
	}

	a.node-title:hover {
		color: var(--map-brand);
	}

	.node-icon {
		display: inline-flex;
		flex: 0 0 auto;
		align-items: center;
		justify-content: center;
		width: 28px;
		height: 28px;
		border-radius: 7px;
	}

	.node-icon :global(svg) {
		width: 18px;
		height: 18px;
		fill: currentColor;
	}

	.client-icon {
		background: color-mix(in srgb, var(--map-brand) 14%, transparent);
		color: var(--map-brand);
	}

	.lb-icon {
		background: color-mix(in srgb, var(--map-lb) 14%, transparent);
		color: var(--map-lb);
	}

	.tunnel-icon {
		background: color-mix(in srgb, var(--map-tunnel) 14%, transparent);
		color: var(--map-tunnel);
	}

	.mesh-icon {
		background: color-mix(in srgb, var(--map-mesh) 14%, transparent);
		color: var(--map-mesh);
	}

	.wan-icon {
		background: color-mix(in srgb, var(--map-wan) 14%, transparent);
		color: var(--map-wan);
	}

	.node-caption {
		margin: 0;
		color: var(--map-caption);
		font-size: 12px;
		line-height: 1.5;
		text-align: center;
	}

	code {
		display: inline;
		padding: 1px 6px;
		border: 1px solid var(--map-line);
		border-radius: 5px;
		background: var(--map-elevated);
		color: var(--map-text);
		font-family:
			"Paper Mono", ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas,
			monospace;
		font-size: 11px;
		white-space: nowrap;
	}

	.pill-row {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 6px;
	}

	.lb-pill {
		display: inline-flex;
		align-items: center;
		padding: 4px 10px;
		border: 1px solid color-mix(in srgb, var(--map-lb) 35%, var(--map-line));
		border-radius: 6px;
		background: color-mix(in srgb, var(--map-lb) 6%, var(--map-card));
		color: var(--map-text);
		font-size: 11px;
		font-weight: 500;
		transition:
			border-color 150ms ease,
			background-color 150ms ease;
	}

	.lb-pill:hover {
		border-color: var(--map-lb);
		background: color-mix(in srgb, var(--map-lb) 14%, var(--map-card));
	}

	.pool-name {
		align-self: center;
		padding: 2px 8px;
		border: 1px dashed var(--map-line);
		border-radius: 9999px;
		color: var(--map-strong);
		font-family:
			"Paper Mono", ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas,
			monospace;
		font-size: 11px;
		font-weight: 500;
	}

	.pool-site {
		color: var(--map-caption);
	}

	.endpoint-list {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 6px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.endpoint {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 6px;
		margin: 0;
	}

	.vnet-pill {
		padding: 1px 6px;
		border-radius: 5px;
		background: color-mix(in srgb, var(--map-strong) 10%, transparent);
		color: var(--map-caption);
		font-family:
			"Paper Mono", ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas,
			monospace;
		font-size: 11px;
		white-space: nowrap;
	}

	.tunnel-card .vnet-pill {
		background: color-mix(in srgb, var(--map-tunnel) 12%, transparent);
		color: var(--map-tunnel);
	}

	.mesh-card .vnet-pill {
		background: color-mix(in srgb, var(--map-mesh) 12%, transparent);
		color: var(--map-mesh);
	}

	.wan-card .vnet-pill {
		background: color-mix(in srgb, var(--map-wan) 12%, transparent);
		color: var(--map-wan);
	}

	figcaption {
		color: var(--map-caption);
		font-family:
			"Paper Mono", ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas,
			monospace;
		font-size: 11px;
		text-align: center;
	}

	@media (max-width: 52rem) {
		.pools-2,
		.pools-3 {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
