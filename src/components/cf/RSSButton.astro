---
/**
 * RSSButton — link to a changelog RSS feed (or arbitrary href).
 *
 * CF source: cloudflare-docs/src/components/RSSButton.astro
 *
 * Mapping notes:
 *   - astro-icon's <Icon> is swapped for Nimbus Icon. The Starlight icon name
 *     `rss` maps to Phosphor `ph:rss-simple`; any other name passes through
 *     unchanged (callers should pass a qualified `set:name` string).
 */
import { z } from "astro/zod";
import Icon from "@cloudflare/nimbus-docs/components/Icon.astro";

const props = z
	.object({
		text: z.string().default("Subscribe to RSS"),
		icon: z.string().default("rss"),
	})
	.and(
		z
			.object({
				changelog: z
					.string()
					.transform((val) => val.toLowerCase().replaceAll(" ", "-")),
			})
			.or(
				z.object({
					href: z.string(),
				}),
			),
	);

const input = props.parse(Astro.props);
const iconName = input.icon === "rss" ? "ph:rss-simple" : input.icon;
---

<a
	href={"href" in input ? input.href : `/changelog/rss/${input.changelog}.xml`}
	class="ms-3 inline-flex items-center justify-center gap-1 rounded-sm font-semibold no-underline"
	target="_blank"
>
	{input.text}
	<Icon name={iconName} size="1.25rem" />
</a>
