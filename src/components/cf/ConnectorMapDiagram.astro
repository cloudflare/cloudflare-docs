				key: "wan",
				icon: "cloudflare-wan",
				title: "Cloudflare WAN",
				caption: "IPsec or GRE",
				href: "/cloudflare-one/networks/connectors/cloudflare-wan/",
				hint: "Whole sites over IPsec or GRE from your routers, with BGP and route control for network teams.",
				tone: "wan",
				group: "Whole sites",
			},
			{
				key: "appliance",
				glyph: GLYPH.appliance,
				title: "Cloudflare One Appliance",
