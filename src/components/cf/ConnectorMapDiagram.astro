			},
		],
	},
	agents: {
		label:
			"Three on-ramps for AI agents, a Mesh node, a Worker with a cf1:network binding, and the Cloudflare One Client, share one Cloudflare One policy plane to reach private databases, APIs, MCP servers, and other clouds.",
		inTitle: "Where the agent runs",
		outTitle: "What it reaches privately",
		coreTitle: "Cloudflare One",
		coreLines: [
			"Gateway network and HTTP policies",
			"DLP on what moves",
			"DNS, HTTP, and network logs",
			"Unified routing: Mesh, Tunnel, WAN",
		],
		pills: [
			{ label: "Gateway", href: "/cloudflare-one/traffic-controls/" },
			{ label: "DLP", href: "/cloudflare-one/data-loss-prevention/" },
			{ label: "Logs", href: "/cloudflare-one/insights/logs/" },
		],
		defaultHint:
			"Agents and employees reach private resources through the same controls.",
		inbound: [
			{
				key: "node",
				icon: "cloudflare-mesh",
				title: "Mesh node",
				caption: "VM, container, or CI runner",
				href: "/mesh/guides/run-mesh-in-containers/",
				hint: "Agents on a server or in a container get a service identity, logged separately from your people.",
				tone: "mesh",
			},
			{
				key: "worker",
				icon: "workers",
				title: "Worker",
				caption: "cf1:network binding",
				href: "/workers-vpc/configuration/vpc-networks/",
				hint: "Agents on Workers call private services with fetch() or connect(). The address picks the destination.",
				tone: "workers",
			},
			{
				key: "laptop",
				icon: "warp-client",
				title: "Cloudflare One Client",
