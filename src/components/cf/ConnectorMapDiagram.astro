		inTitle: "How traffic arrives",
		outTitle: "What it reaches",
		coreTitle: "Cloudflare One",
		coreLines: [
			"One global network",
			"One set of policies",
			"One view of traffic",
		],
		pills: [
			{ label: "Gateway", href: "/cloudflare-one/traffic-controls/" },
			{ label: "Access", href: "/cloudflare-one/access-controls/" },
			{ label: "Logs", href: "/cloudflare-one/insights/logs/" },
		],
		defaultHint: "Choose the connector that matches what you are connecting.",
		inbound: [
			{
				key: "client",
				icon: "warp-client",
				title: "Cloudflare One Client",
				caption: "People and devices",
				href: "/cloudflare-one/team-and-resources/devices/cloudflare-one-client/",
				hint: "People and their devices sign in through your IdP and send traffic through Cloudflare.",
				tone: "client",
			},
			{
				key: "tunnel",
				icon: "tunnel",
				title: "Cloudflare Tunnel",
				caption: "Applications",
				href: "/tunnel/",
				hint: "Public web applications: HTTP on a public hostname, with or without Access. cloudflared connects out.",
				tone: "tunnel",
			},
			{
				key: "mesh",
