---
// Three-column map used on the "Choose a connector" page:
// how traffic arrives -> Cloudflare One -> what it reaches.
//
// variant="connectors": the connector mental model (one card per connector).
// variant="agents": three on-ramps for AI agents and one policy plane.
//
// Hovering or focusing an on-ramp highlights it, dims the others, and shows
// its one-line summary in the centre panel. Without JavaScript the diagram
// is a static, fully linked figure.
/* `role="list"` on the lists below is intentional, not redundant: Safari
   + VoiceOver drop the implicit list role when `list-style: none` is
   applied, so the explicit role is required to preserve list semantics
   for screen reader users. */
/* eslint-disable astro/jsx-a11y/no-redundant-roles */
import Icon from "@cloudflare/nimbus-docs/components/Icon.astro";

type Variant = "connectors" | "agents";

interface Props {
	variant?: Variant;
}

const { variant = "connectors" } = Astro.props;

type Item = {
	key: string;
	icon?: string;
	glyph?: string;
	title: string;
	caption: string;
	href?: string;
	hint?: string;
	tone?: string;
	mono?: boolean;
	// Consecutive inbound items with the same group render side by side
	// under one shared label, for example "Whole sites".
	group?: string;
};

type Row = { group?: string; cls: string; items: Item[] };

function toRows(items: Item[]): Row[] {
	const rows: Row[] = [];
	for (const item of items) {
		const last = rows.at(-1);
		if (last && item.group && last.group === item.group) {
			last.items.push(item);
			continue;
		}
		const tone = `tone-${item.tone ?? "neutral"}`;
		const cls = item.group ? `pair ${tone}` : tone;
		rows.push({ group: item.group, cls, items: [item] });
	}
	return rows;
}

interface MapData {
	label: string;
	inTitle: string;
	outTitle: string;
	coreTitle: string;
	coreLines: string[];
	pills: { label: string; href: string }[];
	defaultHint: string;
	inbound: Item[];
	outbound: Item[];
}

const GLYPH = {
	globe:
