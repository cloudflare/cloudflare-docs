---
// CF source: src/components/WARPReleases.astro (verbatim; upstream's
// backtick-attribute `header=`...`` written as the `header={`...`}` form).
// Releases are sorted by version instead of release date.
import WARPRelease from "./WARPRelease.astro";
import Details from "./Details.astro";
import { getCollection } from "astro:content";
import { z } from "astro/zod";
import { sub } from "date-fns";
import { compareWarpVersions } from "~/util/warp-version";

type Props = z.infer<typeof props>;

const props = z.object({
	track: z.enum([
		"windows/ga",
		"windows/beta",
		"macos/ga",
		"macos/beta",
		"linux/ga",
	]),
});

const { track } = props.parse(Astro.props);

// Newest version first. Sorting by version rather than release date keeps a
// backport (e.g. 2026.7.1384.0 shipped after 2026.8.2115.0) from being shown
// as the latest release.
const sortByVersion = (a: any, b: any) =>
	compareWarpVersions(b.version, a.version);

const entries = await getCollection("warp-releases", (release) => {
	if (!release.id.startsWith(track)) return false;

	const oneYearAgo = sub(new Date(), {
		years: 1,
	});

	if (release.data.releaseDate.getTime() < oneYearAgo.getTime()) return false;

	return true;
});

const releases = entries.map((x) => x.data);

releases.sort(sortByVersion);

const latestRelease = releases.at(0);

if (!latestRelease) {
	throw new Error();
}

const platform = latestRelease.platformName;
---

<WARPRelease header="Latest release" open={true} release={latestRelease} />

<Details header={`Previous version history (${releases.length - 1})`}>
	{releases
		.slice(1)
		.sort(sortByVersion)
		.map((release) => (
			<WARPRelease
				header={`${platform} ${release.version}`}
				release={release}
			/>
		))}
</Details>
