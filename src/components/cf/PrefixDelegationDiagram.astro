---
// Three-column map for the BYOIP "Prefix delegations" concept page.
//
// variant="overview": what the prefix owner account manages -> the
// delegation -> what the delegated account can use.
// variant="lending": one prefix owner account lends IP addresses to more
// than one account. Each account uses its own address maps and zones.
//
// The layout, styles, and hover behavior follow the connector map diagram
// introduced in cloudflare-docs PR #35178. Consolidate both into one
// data-driven component after that PR merges.
//
// Hovering or focusing an item on the left highlights it, dims the others,
// and shows its one-line summary in the centre panel. Without JavaScript the
// diagram is a static, fully linked figure.
/* `role="list"` on the lists below is intentional, not redundant: Safari
   + VoiceOver drop the implicit list role when `list-style: none` is
   applied, so the explicit role is required to preserve list semantics
   for screen reader users. */
/* eslint-disable astro/jsx-a11y/no-redundant-roles */
import Icon from "@cloudflare/nimbus-docs/components/Icon.astro";

type Variant = "overview" | "lending";

interface Props {
	variant?: Variant;
}

const { variant = "overview" } = Astro.props;

type Item = {
	key: string;
	icon?: string;
	glyph?: string;
	title: string;
	caption: string;
	href?: string;
	hint?: string;
	tone?: string;
	mono?: boolean;
};

const GLYPH = {
	link: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1"/><path d="M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1"/></svg>',
	records:
		'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><rect x="3" y="4" width="18" height="4.5" rx="1.5"/><rect x="3" y="10" width="18" height="4.5" rx="1.5"/><rect x="3" y="16" width="18" height="4" rx="1.5"/></svg>',
	globe:
		'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.6 3 2.6 15 0 18M12 3c-2.6 3-2.6 15 0 18"/></svg>',
	app: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><rect x="3" y="4" width="18" height="16" rx="2.5"/><path d="M3 9h18"/></svg>',
	cloud:
		'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"><path d="M7 18h10.5a4 4 0 0 0 .5-8 6 6 0 0 0-11.6 1.5A3.3 3.3 0 0 0 7 18Z"/></svg>',
};

const ownerInbound: Item[] = [
	{
		key: "prefix",
		icon: "byoip",
		title: "BYOIP prefix",
		caption: "Onboarded and approved",
		href: "/byoip/get-started/",
		hint: "The owner account onboards and owns the prefix. Only the owner account needs a BYOIP subscription. A delegation does not transfer ownership.",
		tone: "owner",
	},
	{
		key: "bindings",
		glyph: GLYPH.link,
		title: "Service bindings",
		caption: "CDN or Spectrum",
		href: "/byoip/service-bindings/",
		hint: "Only the owner account creates and manages service bindings. The delegated account uses each IP address with the service that it is bound to.",
		tone: "bindings",
	},
	{
		key: "advertisement",
		glyph: GLYPH.globe,
		title: "Advertisement",
		caption: "Advertise or withdraw",
		href: "/byoip/concepts/dynamic-advertisement/",
		hint: "Only the owner account advertises or withdraws the prefix.",
		tone: "bgp",
	},
];

const pills = [
	{
		label: "Delegations API",
		href: "/api/resources/addressing/subresources/prefixes/subresources/delegations/methods/list/",
	},
	{ label: "Delegate a prefix", href: "/byoip/delegate-a-prefix/" },
];

const data: Record<
	Variant,
	{
		label: string;
		inTitle: string;
		outTitle: string;
		coreTitle: string;
		coreLines: string[];
		defaultHint: string;
		inbound: Item[];
		outbound: Item[];
	}
> = {
	overview: {
		label:
			"The prefix owner account manages the BYOIP prefix, its service bindings, and its advertisement. It delegates a CIDR inside the prefix to another account. The delegated account does not need a BYOIP subscription. It can use the delegated IP addresses with address maps in its own account, Cloudflare for SaaS custom hostnames, and Spectrum applications.",
		inTitle: "Prefix owner account",
		outTitle: "What the delegated account can use",
		coreTitle: "Prefix delegation",
		coreLines: [
			"One CIDR, as small as one IP address",
			"One delegated account",
			"No expiry: the owner removes it",
		],
		defaultHint:
			"Hover over or focus on an item to see which account manages it.",
		inbound: ownerInbound,
		outbound: [
			{
				key: "address-maps",
				glyph: GLYPH.records,
				title: "Address maps",
				caption: "In its own account, with its own zones",
				href: "/byoip/address-maps/",
			},
			{
				key: "saas",
				glyph: GLYPH.cloud,
				title: "Cloudflare for SaaS",
				caption: "Custom hostnames",
				href: "/cloudflare-for-platforms/cloudflare-for-saas/",
			},
			{
				key: "spectrum",
				glyph: GLYPH.app,
				title: "Spectrum",
				caption: "TCP and UDP applications",
				href: "/spectrum/about/byoip/",
			},
		],
	},
	lending: {
		label:
			"One prefix owner account delegates different CIDRs from the same prefix to Account B, Account C, and Account D. Each delegated account creates address maps in its own account, with its own zones. The delegated accounts do not need a BYOIP subscription. The owner account removes each delegation when it is no longer needed.",
		inTitle: "Account A (prefix owner)",
		outTitle: "Delegated accounts",
		coreTitle: "One delegation per account",
		coreLines: [
			"203.0.113.10/32 to Account B",
			"203.0.113.11/32 to Account C",
			"203.0.113.16/28 to Account D",
		],
		defaultHint:
			"Hover over or focus on an item to see what Account A controls for every delegated account.",
		inbound: ownerInbound,
		outbound: [
			{
				key: "account-b",
				glyph: GLYPH.records,
				title: "Account B",
				caption: "203.0.113.10 in its own address map",
				mono: true,
				href: "/byoip/address-maps/",
			},
			{
				key: "account-c",
				glyph: GLYPH.records,
				title: "Account C",
				caption: "203.0.113.11 in its own address map",
				mono: true,
				href: "/byoip/address-maps/",
			},
			{
				key: "account-d",
				glyph: GLYPH.app,
				title: "Account D",
				caption: "203.0.113.16/28 for Spectrum",
				mono: true,
				href: "/spectrum/about/byoip/",
			},
		],
	},
};

const d = { ...data[variant], pills };
---

<figure
	class="delegation-map not-content"
	aria-label={d.label}
	data-delegation-map
>
	<div class="col col-in">
		<p class="col-title">{d.inTitle}</p>
		<ul class="stack" role="list">
			{d.inbound.map((item) => (
				<li class={`tone-${item.tone ?? "neutral"}`}>
					<a
						class={`card in-card tone-${item.tone ?? "neutral"}`}
						href={item.href}
						data-key={item.key}
						data-hint={item.hint}
					>
						<span class="icon" aria-hidden="true">
							{item.icon && <Icon name={item.icon} />}
							{item.glyph && <Fragment set:html={item.glyph} />}
						</span>
						<span class="text">
							<span class="title">{item.title}</span>
							<span class="caption">{item.caption}</span>
						</span>
					</a>
					<span class="rail" aria-hidden="true">
						<span class="pulse"></span>
					</span>
				</li>
			))}
		</ul>
	</div>

	<div class="col col-core">
		<div class="core">
			<span class="core-glow" aria-hidden="true"></span>
			<p class="core-title">{d.coreTitle}</p>
			<ul class="core-lines" role="list">
				{d.coreLines.map((l) => (
					<li>
						<span>{l}</span>
					</li>
				))}
			</ul>
			<div class="pills">
				{d.pills.map((p) => (
					<a class="pill" href={p.href}>
						{p.label}
					</a>
				))}
			</div>
			<p class="hint" data-hint-target data-default={d.defaultHint}>
				{d.defaultHint}
			</p>
		</div>
	</div>

	<div class="col col-out">
		<p class="col-title">{d.outTitle}</p>
		<ul class="stack" role="list">
			{d.outbound.map((item) => (
				<li>
					<a class="card out-card" href={item.href}>
						<span class="rail rail-out" aria-hidden="true">
							<span class="pulse"></span>
						</span>
						<span class="icon icon-out" aria-hidden="true">
							<Fragment set:html={item.glyph} />
						</span>
						<span class="text">
							<span class="title">{item.title}</span>
							<span class={item.mono ? "caption mono" : "caption"}>
								{item.caption}
							</span>
						</span>
					</a>
				</li>
			))}
		</ul>
	</div>
</figure>

<script>
	function initDelegationMaps() {
		const selector = "[data-delegation-map]:not([data-ready])";
		for (const map of document.querySelectorAll<HTMLElement>(selector)) {
			map.dataset.ready = "true";
			const hint = map.querySelector<HTMLElement>("[data-hint-target]");
			const cards = map.querySelectorAll<HTMLElement>(".in-card");
			const activate = (card: HTMLElement | null) => {
				cards.forEach((c) => c.classList.toggle("is-active", c === card));
				map.classList.toggle("has-active", card !== null);
				const text = card?.dataset.hint ?? hint?.dataset.default ?? "";
				if (hint) hint.textContent = text;
			};
			cards.forEach((card) => {
				card.addEventListener("mouseenter", () => activate(card));
				card.addEventListener("focus", () => activate(card));
				card.addEventListener("mouseleave", () => activate(null));
				card.addEventListener("blur", () => activate(null));
			});
		}
	}
	initDelegationMaps();
	document.addEventListener("astro:page-load", initDelegationMaps);
</script>

<style>
	.delegation-map {
		--map-bg: light-dark(#fafafa, #0f0f10);
		--map-card: light-dark(#ffffff, #171719);
		--map-elevated: light-dark(#fafafa, #111113);
		--map-line: light-dark(rgb(0 0 0 / 12%), rgb(255 255 255 / 14%));
		--map-text: light-dark(#171717, #f5f5f5);
		--map-caption: light-dark(#737373, #a3a3a3);
		--map-brand: #f6821f;
		--tone-bindings: light-dark(#2563eb, #60a5fa);
		--tone-owner: #f6821f;
		--tone-bgp: light-dark(#0d9488, #2dd4bf);
		--tone-neutral: light-dark(#525252, #a3a3a3);

		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr) minmax(0, 1fr);
		align-items: center;
		gap: 0;
		margin: 1.25rem 0;
		padding: 20px 16px;
		border: 1px solid var(--map-line);
		border-radius: 12px;
		background:
			radial-gradient(circle, var(--map-line) 1px, transparent 1px),
			var(--map-bg);
		background-size: 14px 14px;
		font-family: "Inter Variable", ui-sans-serif, system-ui, sans-serif;
		-webkit-font-smoothing: antialiased;
		letter-spacing: -0.01em;
		color: var(--map-text);
	}

	.delegation-map a {
		color: inherit;
		text-decoration: none;
	}

	.col-title {
		margin: 0 0 10px;
		color: var(--map-caption);
		font-family: "Paper Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: 10px;
		font-weight: 500;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		text-align: center;
	}

	.stack {
		display: flex;
		flex-direction: column;
		gap: 8px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.card {
		--tone: var(--tone-neutral);
		position: relative;
		display: flex;
		align-items: center;
		gap: 10px;
		min-height: 52px;
		padding: 9px 12px;
		border: 1px solid var(--map-line);
		border-radius: 10px;
		background: var(--map-card);
		box-shadow: 0 5px 14px rgb(0 0 0 / 6%);
		transition:
			border-color 160ms ease,
			box-shadow 160ms ease,
			opacity 160ms ease,
			transform 160ms ease;
	}

	.tone-owner {
		--tone: var(--tone-owner);
	}
	.tone-bindings {
		--tone: var(--tone-bindings);
	}
	.tone-bgp {
		--tone: var(--tone-bgp);
	}

	a.in-card:hover,
	a.in-card:focus-visible,
	.in-card.is-active {
		border-color: color-mix(in srgb, var(--tone) 60%, var(--map-line));
		box-shadow:
			0 0 0 3px color-mix(in srgb, var(--tone) 14%, transparent),
			0 8px 20px rgb(0 0 0 / 8%);
		transform: translateX(2px);
		outline: none;
	}

	.has-active .in-card:not(.is-active) {
		opacity: 0.5;
	}

	a.out-card[href]:hover {
		border-color: color-mix(in srgb, var(--map-brand) 50%, var(--map-line));
	}

	.icon {
		display: inline-flex;
		flex: 0 0 auto;
		align-items: center;
		justify-content: center;
		width: 30px;
		height: 30px;
		border-radius: 8px;
		background: color-mix(in srgb, var(--tone) 13%, transparent);
		color: var(--tone);
	}

	.icon :global(svg) {
		width: 18px;
		height: 18px;
	}

	.icon:not(.icon-out) :global(svg) {
		fill: currentColor;
	}

	.icon :global(svg[fill="none"]) {
		fill: none;
	}

	.col-in .stack > li {
		position: relative;
	}

	.icon-out {
		background: var(--map-elevated);
		border: 1px solid var(--map-line);
		color: var(--map-caption);
	}

	.text {
		display: flex;
		flex-direction: column;
		min-width: 0;
	}

	.title {
		font-size: 13px;
		font-weight: 600;
		line-height: 1.3;
	}

	.caption {
		color: var(--map-caption);
		font-size: 12px;
		line-height: 1.35;
	}

	.caption.mono {
		font-family: "Paper Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: 11px;
	}

	/* Rails: short connectors from each card to the core panel. */
	.rail {
		position: absolute;
		top: 50%;
		right: -17px;
		width: 16px;
		height: 2px;
		background: var(--map-line);
		overflow: hidden;
	}

	.rail-out {
		right: auto;
		left: -17px;
	}

	.pulse {
		position: absolute;
		top: 0;
		left: -6px;
		width: 6px;
		height: 2px;
		background: var(--tone, var(--map-brand));
		opacity: 0;
	}

	li:has(.is-active) > .rail,
	li:has(a.in-card:hover) > .rail {
		background: color-mix(in srgb, var(--tone) 45%, var(--map-line));
	}

	li:has(.is-active) > .rail .pulse,
	li:has(a.in-card:hover) > .rail .pulse {
		animation: map-pulse 900ms linear infinite;
	}

	.has-active .rail-out .pulse {
		background: var(--map-brand);
		animation: map-pulse 900ms linear infinite;
		animation-delay: 450ms;
	}

	@keyframes map-pulse {
		0% {
			left: -6px;
			opacity: 1;
		}
		100% {
			left: 100%;
			opacity: 1;
		}
	}

	.col-core {
		padding: 0 16px;
		align-self: stretch;
		display: flex;
		align-items: center;
	}

	.core {
		position: relative;
		width: 100%;
		padding: 18px 14px 14px;
		border: 1px solid color-mix(in srgb, var(--map-brand) 45%, var(--map-line));
		border-radius: 14px;
		background: var(--map-card);
		box-shadow:
			0 0 0 4px color-mix(in srgb, var(--map-brand) 8%, transparent),
			0 10px 26px rgb(0 0 0 / 8%);
		text-align: center;
		overflow: hidden;
	}

	.core-glow {
		position: absolute;
		inset: -40% -20% auto;
		height: 120px;
		--glow: color-mix(in srgb, var(--map-brand) 18%, transparent);
		background: radial-gradient(closest-side, var(--glow), transparent);
		pointer-events: none;
	}

	.core-title {
		position: relative;
		margin: 0 0 8px;
		color: var(--map-brand);
		font-size: 16px;
		font-weight: 700;
		letter-spacing: -0.02em;
	}

	.core-lines {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 4px;
		margin: 0 0 12px;
		padding: 0;
		list-style: none;
		font-size: 12px;
		line-height: 1.35;
	}

	.pills {
		position: relative;
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 6px;
		margin-bottom: 12px;
	}

	.pill {
		padding: 3px 9px;
		border: 1px solid var(--map-line);
		border-radius: 6px;
		background: var(--map-elevated);
		font-size: 11px;
		font-weight: 500;
		transition: border-color 150ms ease;
	}

	.pill:hover {
		border-color: var(--map-brand);
	}

	.hint {
		position: relative;
		min-height: 3.2em;
		margin: 0;
		padding-top: 10px;
		border-top: 1px dashed var(--map-line);
		color: var(--map-caption);
		font-size: 12px;
		line-height: 1.4;
	}

	@media (prefers-reduced-motion: reduce) {
		.pulse {
			animation: none !important;
			opacity: 0 !important;
		}
		.card {
			transition: none;
			transform: none !important;
		}
	}

	/* Phones and narrow columns: stack the three columns vertically. */
	@media (max-width: 720px) {
		.delegation-map {
			grid-template-columns: minmax(0, 1fr);
			gap: 18px;
			padding: 16px 12px;
		}
		.col-core {
			padding: 0;
		}
		.col-core::before,
		.col-core::after {
			content: "↓";
			display: block;
			text-align: center;
			color: var(--map-caption);
		}
		.col-core {
			flex-direction: column;
			gap: 6px;
		}
		.rail {
			display: none;
		}
	}
</style>
