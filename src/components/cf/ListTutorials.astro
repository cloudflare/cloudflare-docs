---
/**
 * ListTutorials — table of every tutorial in the current product section
 * (pages with `pcx_content_type: tutorial`), newest-reviewed first.
 *
 * A tutorial is listed when it lives under the section (or the optional
 * `directory` prefix) or when its `products` frontmatter references the
 * section's directory entry, so tutorials stored in another product's
 * folder still appear.
 */
import { getCollection, getEntry } from "astro:content";

interface Props {
	/** Path prefix to restrict tutorials to, e.g. `rules/origin-rules/tutorials/`. */
	directory?: string;
}

// `products` entries are typed as strings but resolve to `{ id }` references at runtime.
const productRefId = (product: string | { id: string }) =>
	typeof product === "string" ? product : product.id;

const currentSection = (Astro.params.slug as string).split("/")[0];
const { directory } = Astro.props;

// Some sections (e.g. style-guide) have no directory entry; fall back to path matching only.
const currentProduct = await getEntry("directory", currentSection);
const productId = currentProduct?.id;

const pathPrefix = directory ?? `${currentSection}/`;

const tutorials = await getCollection(
	"docs",
	(entry) =>
		entry.data.pcx_content_type === "tutorial" &&
		(entry.id.startsWith(pathPrefix) ||
			(!directory &&
				productId !== undefined &&
				entry.data.products?.some(
					(product) => productRefId(product) === productId,
				))),
);

const toDate = (value?: string | Date) => (value ? new Date(value) : undefined);

tutorials.sort(
	(a, b) =>
		(toDate(b.data.reviewed)?.getTime() ?? 0) -
		(toDate(a.data.reviewed)?.getTime() ?? 0),
);

function timeAgo(value?: string | Date) {
	const date = toDate(value);
	if (!date) return undefined;

	const rtf = new Intl.RelativeTimeFormat("en", { numeric: "auto" });
	const days = Math.round((date.getTime() - Date.now()) / 86_400_000);
	if (Math.abs(days) < 30) return rtf.format(days, "day");
	if (Math.abs(days) < 365) return rtf.format(Math.round(days / 30), "month");
	return rtf.format(Math.round(days / 365), "year");
}
---

<table>
	<thead>
		<tr>
			<td>Name</td>
			<td>Last Updated</td>
			<td>Difficulty</td>
		</tr>
	</thead>
	<tbody>
		{tutorials.map((tutorial) => (
			<tr>
				<td>
					<a href={`/${tutorial.id}/`}>{tutorial.data.title}</a>
				</td>
				<td>{timeAgo(tutorial.data.reviewed)}</td>
				<td>{tutorial.data.difficulty}</td>
			</tr>
		))}
	</tbody>
</table>
