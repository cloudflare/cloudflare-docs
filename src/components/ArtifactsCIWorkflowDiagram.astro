---
import { Icon as AstroIcon } from "astro-icon/components";

interface Props {
	autoPlay?: boolean;
	loop?: boolean;
}

const { autoPlay = true, loop = true } = Astro.props;
---

<figure
	class="artifacts-ci-workflow-diagram not-content"
	aria-label="An Artifacts repository change starts a CI Workflow on git push. The Workflow installs and caches dependencies, then runs build, lint, typecheck, and format steps. Non-main branches deploy to a preview, while the main branch deploys to production."
>
	<cfdocs-artifacts-ci-workflow-diagram
		data-autoplay={String(autoPlay)}
		data-loop={String(loop)}
	>
		<div class="diagram-container">
			<div class="source-stage" data-step="1">
				<span class="stage-label">Artifacts repo changes</span>
				<div class="node-card source-card">
					<span class="node-icon" aria-hidden="true">
						<AstroIcon name="artifacts" />
					</span>
					<span class="node-name">Repository changes</span>
				</div>
			</div>

			<div class="push-flow" data-step="2" aria-hidden="true">
				<div class="connector-line"></div>
				<span class="connector-label">git push</span>
				<svg class="connector-arrow" viewBox="0 0 12 8">
					<path d="M1 1l5 5 5-5"></path>
				</svg>
			</div>

			<section class="workflow-group" data-step="3" aria-label="CI Workflow">
				<span class="group-label">CI Workflow</span>

				<div class="workflow-step dependency-step" data-step="3">
					<span class="step-number">1</span>
					<span class="step-icon" aria-hidden="true">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
							<path d="M4 7.5 12 3l8 4.5-8 4.5-8-4.5Z"></path>
							<path d="m4 12 8 4.5 8-4.5M4 16.5l8 4.5 8-4.5"></path>
						</svg>
					</span>
					<span class="step-name">Install &amp; cache dependencies</span>
				</div>

				<div class="workflow-connector" data-step="4" aria-hidden="true"></div>

				<div class="checks-stage">
					<div class="checks-heading" data-step="5">
						<span class="step-number">2</span>
						<span class="step-name">Run CI steps</span>
					</div>
					<div class="checks-grid">
						<div class="check-card" data-step="5">
							<span class="check-icon" aria-hidden="true">
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
									<path d="m7 8-4 4 4 4M17 8l4 4-4 4M14 4l-4 16"></path>
								</svg>
							</span>
							<span>Build</span>
						</div>
						<div class="check-card" data-step="5">
							<span class="check-icon" aria-hidden="true">
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
									<path d="m9 12 2 2 4-4"></path>
									<circle cx="12" cy="12" r="9"></circle>
								</svg>
							</span>
							<span>Lint</span>
						</div>
						<div class="check-card" data-step="5">
							<span class="check-icon" aria-hidden="true">
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
									<path d="M5 5h14v14H5zM8 9h8M8 13h5"></path>
								</svg>
							</span>
							<span>Typecheck</span>
						</div>
						<div class="check-card" data-step="5">
							<span class="check-icon" aria-hidden="true">
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
									<path d="M4 6h16M4 12h10M4 18h13"></path>
								</svg>
							</span>
							<span>Format</span>
						</div>
					</div>
				</div>
			</section>

			<div class="branch-split" aria-hidden="true">
				<svg viewBox="0 0 400 94" preserveAspectRatio="none">
					<path class="split-path split-stem" data-step="6" d="M200 0v24"
					></path>
					<path class="split-path split-bar" data-step="6" d="M100 24h200"
					></path>
					<path
						class="split-path preview-path"
						data-step="7"
						d="M100 24v17M100 61v33"></path>
					<path
						class="split-path production-path"
						data-step="8"
						d="M300 24v17M300 61v33"></path>
				</svg>
				<div class="branch-labels">
					<span class="branch-label" data-step="7">Non-main branch</span>
					<span class="branch-label" data-step="8">Main branch</span>
				</div>
			</div>

			<section
				class="deployment-group"
				data-step="6"
				aria-label="Deploy Worker"
			>
				<span class="group-label">Deploy Worker</span>
				<div class="deployment-grid">
					<div class="deployment-card" data-step="7">
						<span class="deployment-icon" aria-hidden="true">
							<AstroIcon name="workers" />
						</span>
						<span class="deployment-name">Preview</span>
						<span class="deployment-note">Non-main branch</span>
					</div>
					<div class="deployment-card" data-step="8">
						<span class="deployment-icon" aria-hidden="true">
							<AstroIcon name="workers" />
						</span>
						<span class="deployment-name">Production</span>
						<span class="deployment-note">Main branch</span>
					</div>
				</div>
			</section>
		</div>
	</cfdocs-artifacts-ci-workflow-diagram>
</figure>

<style>
	.artifacts-ci-workflow-diagram {
		margin: 1.5rem 0;
	}

	cfdocs-artifacts-ci-workflow-diagram {
		--diagram-surface: rgb(255 255 255);
		--diagram-group: rgb(250 250 250);
		--diagram-border: rgb(229 229 229);
		--diagram-line: rgb(212 212 212);
		--diagram-text: rgb(23 23 23);
		--diagram-muted: rgb(115 115 115);
		--diagram-accent: rgb(249 115 22);
		display: block;
		width: 100%;
	}

	:root[data-theme="dark"] cfdocs-artifacts-ci-workflow-diagram {
		--diagram-surface: rgb(23 23 23);
		--diagram-group: rgb(18 18 18);
		--diagram-border: rgb(64 64 64);
		--diagram-line: rgb(64 64 64);
		--diagram-text: rgb(245 245 245);
		--diagram-muted: rgb(163 163 163);
	}

	.diagram-container {
		width: min(100%, 520px);
		margin: 0 auto;
	}

	.source-stage {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.5rem;
	}

	.stage-label,
	.group-label {
		font-size: 0.6875rem;
		font-weight: 600;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--diagram-text);
	}

	.node-card,
	.workflow-step,
	.check-card,
	.deployment-card {
		background: var(--diagram-surface);
		border: 1px solid var(--diagram-border);
		border-radius: 0.5rem;
		transition:
			border-color 0.3s ease,
			box-shadow 0.3s ease,
			background-color 0.3s ease;
	}

	.source-card {
		display: flex;
		align-items: center;
		gap: 0.625rem;
		width: 240px;
		padding: 0.625rem 0.875rem;
	}

	.node-icon,
	.step-icon,
	.check-icon,
	.deployment-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		color: var(--diagram-muted);
		transition: color 0.3s ease;
	}

	.node-icon {
		width: 1.5rem;
		height: 1.5rem;
	}

	.node-icon :global(svg),
	.deployment-icon :global(svg),
	.step-icon svg,
	.check-icon svg {
		width: 100%;
		height: 100%;
	}

	.step-icon svg,
	.check-icon svg {
		stroke-width: 1.8;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.node-name,
	.step-name,
	.check-card,
	.deployment-name {
		font-family:
			ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
		font-weight: 500;
		color: var(--diagram-text);
	}

	.node-name,
	.step-name {
		font-size: 0.75rem;
	}

	.source-stage.is-active .source-card,
	.workflow-step.is-active,
	.check-card.is-active,
	.deployment-card.is-active {
		border-color: var(--diagram-accent);
		box-shadow: 0 0 0 3px rgb(249 115 22 / 10%);
	}

	.source-stage.is-active .node-icon,
	.workflow-step.is-active .step-icon,
	.check-card.is-active .check-icon,
	.deployment-card.is-active .deployment-icon {
		color: var(--diagram-accent);
	}

	.push-flow {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		height: 64px;
	}

	.connector-line {
		width: 2px;
		height: 57px;
		background: var(--diagram-line);
		transition: background-color 0.3s ease;
	}

	.connector-arrow {
		position: absolute;
		bottom: 0;
		width: 12px;
		height: 8px;
		fill: none;
		stroke: var(--diagram-line);
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
		transition: stroke 0.3s ease;
	}

	.connector-label {
		position: absolute;
		top: 21px;
		left: calc(50% + 12px);
		font-size: 0.625rem;
		font-family:
			ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
		color: var(--diagram-muted);
		white-space: nowrap;
	}

	.push-flow.is-active .connector-line {
		background: var(--diagram-accent);
	}

	.push-flow.is-active .connector-arrow {
		stroke: var(--diagram-accent);
	}

	.workflow-group,
	.deployment-group {
		position: relative;
		background: var(--diagram-group);
		border: 1px dashed var(--diagram-line);
		border-radius: 0.75rem;
		transition: border-color 0.3s ease;
	}

	.workflow-group {
		padding: 2.25rem 1rem 1rem;
	}

	.workflow-group > .group-label,
	.deployment-group > .group-label {
		position: absolute;
		top: 0.625rem;
		left: 0.75rem;
	}

	.workflow-group.is-active,
	.deployment-group.is-active {
		border-color: var(--diagram-accent);
	}

	.workflow-step {
		display: flex;
		align-items: center;
		gap: 0.625rem;
		padding: 0.625rem 0.75rem;
	}

	.step-number {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 1.25rem;
		height: 1.25rem;
		flex-shrink: 0;
		border-radius: 999px;
		background: var(--diagram-border);
		font-size: 0.625rem;
		font-weight: 600;
		color: var(--diagram-muted);
		transition:
			background-color 0.3s ease,
			color 0.3s ease;
	}

	.is-active > .step-number,
	.checks-heading.is-active .step-number {
		background: var(--diagram-accent);
		color: white;
	}

	.step-icon {
		width: 1.25rem;
		height: 1.25rem;
	}

	.workflow-connector {
		width: 2px;
		height: 24px;
		margin: 0 auto;
		background: var(--diagram-line);
		transition: background-color 0.3s ease;
	}

	.workflow-connector.is-active {
		background: var(--diagram-accent);
	}

	.checks-stage {
		margin: 0;
	}

	.checks-heading {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin-bottom: 0.625rem;
	}

	.checks-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.5rem;
	}

	.check-card {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		min-width: 0;
		padding: 0.5rem 0.625rem;
		font-size: 0.6875rem;
	}

	.check-icon {
		width: 1rem;
		height: 1rem;
	}

	.branch-split {
		position: relative;
		height: 94px;
		margin-bottom: -1px;
	}

	.branch-split svg {
		display: block;
		width: 100%;
		height: 100%;
		overflow: visible;
	}

	.split-path {
		fill: none;
		stroke: var(--diagram-line);
		stroke-width: 2;
		vector-effect: non-scaling-stroke;
		transition: stroke 0.3s ease;
	}

	.split-path.is-active {
		stroke: var(--diagram-accent);
	}

	.branch-label {
		font-size: 0.5625rem;
		line-height: 1.25rem;
		color: var(--diagram-muted);
		text-align: center;
		white-space: nowrap;
		transition: color 0.3s ease;
	}

	.branch-label.is-active {
		color: var(--diagram-accent);
	}

	.branch-labels {
		position: absolute;
		top: 41px;
		left: 0;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		width: 100%;
	}

	.deployment-group {
		padding: 2.25rem 0.75rem 0.75rem;
	}

	.deployment-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.5rem;
	}

	.deployment-card {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.25rem;
		min-width: 0;
		padding: 0.75rem 0.5rem;
	}

	.deployment-icon {
		width: 1.25rem;
		height: 1.25rem;
	}

	.deployment-name {
		font-size: 0.6875rem;
	}

	.deployment-note {
		font-size: 0.5625rem;
		color: var(--diagram-muted);
	}

	@media (max-width: 30rem) {
		.diagram-container {
			width: 100%;
		}

		.workflow-group {
			padding-inline: 0.75rem;
		}

		.check-card {
			padding-inline: 0.5rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		cfdocs-artifacts-ci-workflow-diagram * {
			transition: none !important;
		}
	}
</style>

<script>
	class ArtifactsCIWorkflowDiagramElement extends HTMLElement {
		private static readonly MAX_STEP = 8;
		private currentStep = 0;
		private timeout: number | undefined;
		private observer: IntersectionObserver | undefined;

		connectedCallback() {
			const reducedMotion = window.matchMedia(
				"(prefers-reduced-motion: reduce)",
			).matches;

			if (reducedMotion || this.dataset.autoplay !== "true") {
				this.showComplete();
				return;
			}

			this.observer = new IntersectionObserver(
				(entries) => {
					if (!entries.some((entry) => entry.isIntersecting)) return;
					this.observer?.disconnect();
					this.timeout = window.setTimeout(() => this.advance(), 400);
				},
				{ threshold: 0.25 },
			);
			this.observer.observe(this);
		}

		disconnectedCallback() {
			this.observer?.disconnect();
			if (this.timeout !== undefined) window.clearTimeout(this.timeout);
		}

		private advance() {
			if (this.currentStep < ArtifactsCIWorkflowDiagramElement.MAX_STEP) {
				this.currentStep += 1;
				this.update();
				this.timeout = window.setTimeout(() => this.advance(), 850);
				return;
			}

			if (this.dataset.loop !== "true") return;

			this.timeout = window.setTimeout(() => {
				this.currentStep = 0;
				this.update();
				this.timeout = window.setTimeout(() => this.advance(), 600);
			}, 1800);
		}

		private showComplete() {
			this.currentStep = ArtifactsCIWorkflowDiagramElement.MAX_STEP;
			this.update();
		}

		private update() {
			this.querySelectorAll<Element>("[data-step]").forEach((element) => {
				const step = Number(element.getAttribute("data-step"));
				element.classList.toggle("is-active", step <= this.currentStep);
			});
		}
	}

	if (!customElements.get("cfdocs-artifacts-ci-workflow-diagram")) {
		customElements.define(
			"cfdocs-artifacts-ci-workflow-diagram",
			ArtifactsCIWorkflowDiagramElement,
		);
	}
</script>
