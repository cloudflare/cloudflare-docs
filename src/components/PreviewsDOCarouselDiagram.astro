---

<figure
	class="pdoc"
	aria-label="Each Preview gets its own Durable Object namespace"
>
	<div class="pdoc-shell">
		<!-- Code -->
		<div class="pdoc-code">
			<code
				><span class="pdoc-kw">const</span> counter = ctx.exports.<span
					class="pdoc-hl">Counter</span
				>.get(id);</code
			>
		</div>

		<!-- Stacked card area -->
		<div class="pdoc-stack-wrap">
			<div class="pdoc-stack">
				<!-- Initial 3 cards -->
				<div class="pdoc-card pdoc-layer-0" data-pdoc-idx="0">
					<div class="pdoc-card-header">
						<span class="pdoc-card-branch">redesign</span>
						<button class="pdoc-close" aria-label="Delete Preview">
							<svg width="10" height="10" viewBox="0 0 10 10" fill="none">
								<path
									d="M1 1l8 8M9 1l-8 8"
									stroke="currentColor"
									stroke-width="1.5"
									stroke-linecap="round"></path>
							</svg>
						</button>
					</div>
					<div class="pdoc-card-body">
						<span class="pdoc-section-label">DO namespace</span>
						<div class="pdoc-ns">
							<code>Counter</code>
							<span class="pdoc-ns-badge">isolated</span>
						</div>
						<div class="pdoc-instances">
							<span class="pdoc-instance"></span>
							<span class="pdoc-instance"></span>
							<span class="pdoc-instance"></span>
							<span class="pdoc-instance-more">instances</span>
						</div>
					</div>
				</div>

				<div class="pdoc-card pdoc-layer-1" data-pdoc-idx="1">
					<div class="pdoc-card-header">
						<span class="pdoc-card-branch">fix-api</span>
						<button class="pdoc-close" aria-label="Delete Preview">
							<svg width="10" height="10" viewBox="0 0 10 10" fill="none">
								<path
									d="M1 1l8 8M9 1l-8 8"
									stroke="currentColor"
									stroke-width="1.5"
									stroke-linecap="round"></path>
							</svg>
						</button>
					</div>
					<div class="pdoc-card-body">
						<span class="pdoc-section-label">DO namespace</span>
						<div class="pdoc-ns">
							<code>Counter</code>
							<span class="pdoc-ns-badge">isolated</span>
						</div>
						<div class="pdoc-instances">
							<span class="pdoc-instance"></span>
							<span class="pdoc-instance"></span>
							<span class="pdoc-instance"></span>
							<span class="pdoc-instance-more">instances</span>
						</div>
					</div>
				</div>

				<div class="pdoc-card pdoc-layer-2" data-pdoc-idx="2">
					<div class="pdoc-card-header">
						<span class="pdoc-card-branch">feature/login</span>
						<button class="pdoc-close" aria-label="Delete Preview">
							<svg width="10" height="10" viewBox="0 0 10 10" fill="none">
								<path
									d="M1 1l8 8M9 1l-8 8"
									stroke="currentColor"
									stroke-width="1.5"
									stroke-linecap="round"></path>
							</svg>
						</button>
					</div>
					<div class="pdoc-card-body">
						<span class="pdoc-section-label">DO namespace</span>
						<div class="pdoc-ns">
							<code>Counter</code>
							<span class="pdoc-ns-badge">isolated</span>
						</div>
						<div class="pdoc-instances">
							<span class="pdoc-instance"></span>
							<span class="pdoc-instance"></span>
							<span class="pdoc-instance"></span>
							<span class="pdoc-instance-more">instances</span>
						</div>
					</div>
				</div>

				<!-- Hidden until + is clicked -->
				<div class="pdoc-card pdoc-hidden" data-pdoc-idx="3">
					<div class="pdoc-card-header">
						<span class="pdoc-card-branch">new-feature</span>
						<button class="pdoc-close" aria-label="Delete Preview">
							<svg width="10" height="10" viewBox="0 0 10 10" fill="none">
								<path
									d="M1 1l8 8M9 1l-8 8"
									stroke="currentColor"
									stroke-width="1.5"
									stroke-linecap="round"></path>
							</svg>
						</button>
					</div>
					<div class="pdoc-card-body">
						<span class="pdoc-section-label">DO namespace</span>
						<div class="pdoc-ns">
							<code>Counter</code>
							<span class="pdoc-ns-badge">isolated</span>
						</div>
						<div class="pdoc-instances">
							<span class="pdoc-instance"></span>
							<span class="pdoc-instance"></span>
							<span class="pdoc-instance"></span>
							<span class="pdoc-instance-more">instances</span>
						</div>
					</div>
				</div>

				<div class="pdoc-card pdoc-hidden" data-pdoc-idx="4">
					<div class="pdoc-card-header">
						<span class="pdoc-card-branch">dark-mode</span>
						<button class="pdoc-close" aria-label="Delete Preview">
							<svg width="10" height="10" viewBox="0 0 10 10" fill="none">
								<path
									d="M1 1l8 8M9 1l-8 8"
									stroke="currentColor"
									stroke-width="1.5"
									stroke-linecap="round"></path>
							</svg>
						</button>
					</div>
					<div class="pdoc-card-body">
						<span class="pdoc-section-label">DO namespace</span>
						<div class="pdoc-ns">
							<code>Counter</code>
							<span class="pdoc-ns-badge">isolated</span>
						</div>
						<div class="pdoc-instances">
							<span class="pdoc-instance"></span>
							<span class="pdoc-instance"></span>
							<span class="pdoc-instance"></span>
							<span class="pdoc-instance-more">instances</span>
						</div>
					</div>
				</div>

				<!-- Add preview button -->
				<button
					class="pdoc-add"
					aria-label="Add a Preview"
					title="Add a Preview"
				>
					<svg width="14" height="14" viewBox="0 0 14 14" fill="none">
						<path
							d="M7 1v12M1 7h12"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"></path>
					</svg>
				</button>
			</div>

			<!-- Dots -->
			<div class="pdoc-dots" aria-hidden="true">
				<button class="pdoc-dot pdoc-dot-active" data-pdoc-dot="0"></button>
				<button class="pdoc-dot" data-pdoc-dot="1"></button>
				<button class="pdoc-dot" data-pdoc-dot="2"></button>
				<button class="pdoc-dot pdoc-dot-hidden" data-pdoc-dot="3"></button>
				<button class="pdoc-dot pdoc-dot-hidden" data-pdoc-dot="4"></button>
			</div>
		</div>

		<!-- Footer -->
		<p class="pdoc-footer">
			Class + migration = <strong>separate</strong> namespace per Preview
		</p>
	</div>
</figure>

<style>
	/* Reset */
	.pdoc,
	.pdoc * {
		margin: 0;
		padding: 0;
		border: none;
		background: none;
		box-shadow: none;
		font-size: inherit;
		line-height: inherit;
		color: inherit;
		box-sizing: border-box;
	}

	.pdoc code {
		background: none !important;
		padding: 0 !important;
		border: none !important;
		border-radius: 0 !important;
		font-size: inherit !important;
		line-height: inherit !important;
	}

	.pdoc {
		--p-bg: light-dark(#fafafa, #0f0f10);
		--p-card: light-dark(#ffffff, #171719);
		--p-muted: light-dark(#737373, #a3a3a3);
		--p-text: light-dark(#171717, #f5f5f5);
		--p-border: light-dark(rgb(0 0 0 / 12%), rgb(255 255 255 / 14%));
		--p-grid: light-dark(rgb(0 0 0 / 5%), rgb(255 255 255 / 7%));
		--p-soft: light-dark(#f5f5f5, #222226);
		--p-brand: #f6821f;
		--p-brand-soft: light-dark(#fff7ed, #431407);
		--p-purple: light-dark(#7c3aed, #a78bfa);
		--p-red: light-dark(#dc2626, #f87171);
		--p-red-soft: light-dark(#fef2f2, #450a0a);
		--pdoc-offset-x: 7px;
		--pdoc-offset-y: 7px;
		--pdoc-depth: 4;
		--pdoc-ease: cubic-bezier(0.16, 1, 0.3, 1);
		--pdoc-drag-x: 0px;
		--pdoc-drag-rotate: 0deg;
		margin: 1.25rem 0 1.75rem;
		font-family: "Inter Variable", ui-sans-serif, system-ui, sans-serif;
		font-size: 0.8125rem;
		line-height: 1.45;
		letter-spacing: -0.01em;
		color: var(--p-text);
		max-width: 100%;
	}

	.pdoc-shell {
		padding: 24px 20px 20px;
		border: 1px solid var(--p-border);
		border-radius: 14px;
		overflow: hidden;
		background:
			radial-gradient(circle, var(--p-grid) 0.9px, transparent 1px), var(--p-bg);
		background-size: 18px 18px;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 14px;
	}

	/* ── Code ── */
	.pdoc-code {
		padding: 10px 16px;
		border: 1px solid var(--p-border);
		border-radius: 8px;
		background: var(--p-card);
		box-shadow: 0 1px 2px rgb(0 0 0 / 4%);
	}

	.pdoc-code code {
		font-family:
			"Paper Mono", ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas,
			monospace;
		font-size: 0.72rem;
		line-height: 1.5;
		color: var(--p-muted);
	}

	.pdoc-kw {
		color: var(--p-purple);
	}

	.pdoc-hl {
		color: var(--p-text);
		font-weight: 700;
	}

	/* ── Subtitle ── */
	.pdoc-subtitle {
		font-size: 0.875rem;
		font-weight: 600;
		color: var(--p-text);
		text-align: center;
	}

	/* ── Stack wrapper ── */
	.pdoc-stack-wrap {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 20px;
		width: 100%;
		max-width: 520px;
	}

	/* ── Stack ── */
	.pdoc-stack {
		position: relative;
		width: 100%;
		padding-right: calc(var(--pdoc-offset-x) * var(--pdoc-depth));
		margin-bottom: calc(var(--pdoc-offset-y) * var(--pdoc-depth));
		cursor: grab;
		touch-action: pan-y;
	}

	.pdoc-stack:active {
		cursor: grabbing;
	}

	/* ── Card ── */
	.pdoc-card {
		position: absolute;
		top: 0;
		left: 0;
		width: calc(100% - var(--pdoc-offset-x) * var(--pdoc-depth));
		border: 1px solid color-mix(in srgb, var(--p-brand) 24%, var(--p-border));
		border-radius: 12px;
		background: var(--p-card);
		overflow: hidden;
		user-select: none;
		will-change: transform, opacity;
		transition:
			transform 0.5s var(--pdoc-ease),
			opacity 0.38s ease,
			box-shadow 0.5s var(--pdoc-ease),
			border-color 0.24s ease;
	}

	/* Hidden cards */
	.pdoc-hidden {
		display: none !important;
	}

	/* Layer positions */
	.pdoc-layer-0 {
		z-index: 3;
		transform: translate(var(--pdoc-drag-x), 0) rotate(var(--pdoc-drag-rotate));
		box-shadow:
			0 8px 28px rgb(0 0 0 / 8%),
			0 1px 3px rgb(0 0 0 / 5%);
		position: relative;
	}

	.pdoc-dragging .pdoc-layer-0 {
		transition: none;
	}

	.pdoc-swipe-out-next {
		opacity: 0 !important;
		transform: translate(-42px, -4px) rotate(-2deg) scale(0.98) !important;
	}

	.pdoc-swipe-out-prev {
		opacity: 0 !important;
		transform: translate(42px, -4px) rotate(2deg) scale(0.98) !important;
	}

	.pdoc-layer-1 {
		z-index: 2;
		transform: translate(var(--pdoc-offset-x), var(--pdoc-offset-y));
		opacity: 0.7;
	}

	.pdoc-layer-1 .pdoc-card-body {
		visibility: hidden;
	}

	.pdoc-layer-2 {
		z-index: 1;
		transform: translate(
			calc(var(--pdoc-offset-x) * 2),
			calc(var(--pdoc-offset-y) * 2)
		);
		opacity: 0.5;
	}

	.pdoc-layer-2 .pdoc-card-body {
		visibility: hidden;
	}

	.pdoc-layer-3 {
		z-index: 0;
		transform: translate(
			calc(var(--pdoc-offset-x) * 3),
			calc(var(--pdoc-offset-y) * 3)
		);
		opacity: 0.36;
	}

	.pdoc-layer-3 .pdoc-card-body {
		visibility: hidden;
	}

	.pdoc-layer-4 {
		z-index: -1;
		transform: translate(
			calc(var(--pdoc-offset-x) * 4),
			calc(var(--pdoc-offset-y) * 4)
		);
		opacity: 0.26;
	}

	.pdoc-layer-4 .pdoc-card-body {
		visibility: hidden;
	}

	/* ── Card header (branch name + close button) ── */
	.pdoc-card-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 12px 12px 12px 16px;
		border-bottom: 1px solid
			color-mix(in srgb, var(--p-brand) 16%, var(--p-border));
		background: var(--p-brand-soft);
	}

	.pdoc-card-branch {
		font-weight: 650;
		font-size: 0.875rem;
		color: var(--p-text);
		font-family:
			"Paper Mono", ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas,
			monospace;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	/* ── Close / delete button ── */
	.pdoc-close {
		width: 24px;
		height: 24px;
		border-radius: 6px;
		display: flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		color: var(--p-muted);
		flex-shrink: 0;
		transition:
			background 0.15s ease,
			color 0.15s ease;
		padding: 0;
		opacity: 0;
		pointer-events: none;
	}

	/* Only show X on the front card */
	.pdoc-layer-0 .pdoc-close {
		opacity: 1;
		pointer-events: auto;
	}

	.pdoc-close:hover {
		background: var(--p-red-soft);
		color: var(--p-red);
	}

	/* Hide X buttons when at minimum card count */
	.pdoc-close-disabled {
		display: none !important;
	}

	.pdoc-card-body {
		padding: 16px;
		display: flex;
		flex-direction: column;
		gap: 10px;
	}

	/* ── Section label ── */
	.pdoc-section-label {
		font-size: 0.625rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--p-muted);
	}

	/* ── Namespace pill ── */
	.pdoc-ns {
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 8px 12px;
		border-radius: 8px;
		border: 1px dashed color-mix(in srgb, var(--p-brand) 40%, var(--p-border));
		background: var(--p-brand-soft);
		transition:
			border-color 0.3s ease,
			background 0.3s ease;
	}

	.pdoc-ns code {
		font-family:
			"Paper Mono", ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas,
			monospace;
		font-size: 0.8125rem;
		font-weight: 650;
		color: var(--p-text);
		transition:
			text-decoration 0.3s ease,
			opacity 0.3s ease;
	}

	.pdoc-ns-badge {
		margin-left: auto;
		font-size: 0.5625rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.03em;
		color: var(--p-brand);
		flex-shrink: 0;
		transition: color 0.3s ease;
	}

	/* ── Destroying state — smooth transition into red ── */
	.pdoc-destroying {
		transition:
			border-color 0.34s ease,
			opacity 0.5s ease,
			transform 0.5s var(--pdoc-ease) !important;
		border-color: color-mix(
			in srgb,
			var(--p-red) 40%,
			var(--p-border)
		) !important;
		z-index: 10 !important;
	}

	.pdoc-destroying .pdoc-card-header {
		background: var(--p-red-soft) !important;
		border-bottom-color: color-mix(
			in srgb,
			var(--p-red) 20%,
			var(--p-border)
		) !important;
		transition:
			background 0.4s ease,
			border-color 0.4s ease;
	}

	.pdoc-destroying .pdoc-ns {
		border-color: color-mix(
			in srgb,
			var(--p-red) 40%,
			var(--p-border)
		) !important;
		background: var(--p-red-soft) !important;
		transition:
			background 0.4s ease,
			border-color 0.4s ease;
	}

	.pdoc-destroying .pdoc-ns code {
		text-decoration: line-through !important;
		opacity: 0.5 !important;
		transition: opacity 0.4s ease;
	}

	.pdoc-destroying .pdoc-ns-badge {
		color: var(--p-red) !important;
		transition: color 0.4s ease;
	}

	.pdoc-destroying .pdoc-instance {
		background: color-mix(
			in srgb,
			var(--p-red) 40%,
			var(--p-border)
		) !important;
		transition: background 0.4s ease;
	}

	/* Fade + shrink out — uses transition not animation for smoothness */
	.pdoc-removing {
		position: absolute !important;
		top: 0;
		left: 0;
		opacity: 0 !important;
		transform: translate(-30px, -10px) rotate(-2deg) scale(0.94) !important;
		pointer-events: none !important;
	}

	.pdoc-entering {
		opacity: 0 !important;
		transform: translate(
				calc(var(--pdoc-offset-x) * 2),
				calc(var(--pdoc-offset-y) * 3)
			)
			scale(0.96) !important;
	}

	/* ── Instances ── */
	.pdoc-instances {
		display: flex;
		align-items: center;
		gap: 6px;
		padding: 2px 0;
	}

	.pdoc-instance {
		width: 7px;
		height: 7px;
		border-radius: 999px;
		background: color-mix(in srgb, var(--p-brand) 45%, var(--p-border));
		transition: background 0.3s ease;
	}

	.pdoc-instance-more {
		font-size: 0.5625rem;
		color: var(--p-muted);
		letter-spacing: 0.02em;
	}

	/* ── Add button ── */
	.pdoc-add {
		position: absolute;
		z-index: 10;
		bottom: -18px;
		right: calc(var(--pdoc-offset-x) * var(--pdoc-depth) - 18px);
		width: 36px;
		height: 36px;
		border-radius: 999px;
		background: var(--p-brand);
		color: #fff;
		display: flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		box-shadow: 0 6px 16px rgb(246 130 31 / 20%);
		transition:
			transform 0.18s var(--pdoc-ease),
			box-shadow 0.18s ease,
			opacity 0.3s ease;
		padding: 0;
	}

	.pdoc-add:hover {
		transform: scale(1.1);
		box-shadow: 0 8px 18px rgb(246 130 31 / 24%);
	}

	.pdoc-add:active {
		transform: scale(0.95);
	}

	.pdoc-add-used {
		opacity: 0.3;
		cursor: not-allowed;
	}

	.pdoc-add-used:hover,
	.pdoc-add-used:active {
		transform: none;
		box-shadow: 0 6px 16px rgb(246 130 31 / 20%);
	}

	/* ── Dots ── */
	.pdoc-dots {
		display: flex;
		gap: 8px;
		justify-content: center;
	}

	.pdoc-dot {
		width: 8px;
		height: 8px;
		border-radius: 999px;
		background: var(--p-border);
		transition:
			background 0.2s ease,
			transform 0.2s ease;
		cursor: pointer;
		padding: 0;
	}

	.pdoc-dot:hover {
		background: color-mix(in srgb, var(--p-brand) 50%, var(--p-border));
	}

	.pdoc-dot-active {
		background: var(--p-brand);
		transform: scale(1.25);
	}

	@media (prefers-reduced-motion: reduce) {
		.pdoc-card,
		.pdoc-add,
		.pdoc-dot,
		.pdoc-ns,
		.pdoc-ns code,
		.pdoc-ns-badge,
		.pdoc-instance {
			transition-duration: 0.01ms !important;
		}
	}

	.pdoc-dot-hidden {
		display: none;
	}

	/* ── Footer ── */
	.pdoc-footer {
		font-size: 0.75rem;
		color: var(--p-muted);
		text-align: center;
		line-height: 1.4;
	}

	.pdoc-footer strong {
		font-weight: 650;
		color: var(--p-text);
	}

	.pdoc-footer code {
		font-family:
			"Paper Mono", ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas,
			monospace;
		font-weight: 650;
		color: var(--p-text);
	}

	/* ── Responsive ── */
	@media (max-width: 700px) {
		.pdoc {
			--pdoc-offset-x: 6px;
			--pdoc-offset-y: 6px;
		}

		.pdoc-shell {
			padding: 16px 12px;
		}

		.pdoc-stack-wrap {
			max-width: 100%;
		}
	}
</style>

<script>
	for (const diagram of document.querySelectorAll<HTMLElement>(".pdoc")) {
		const stack = diagram.querySelector<HTMLElement>(".pdoc-stack");
		const addBtn = diagram.querySelector<HTMLButtonElement>(".pdoc-add");
		const MIN_CARDS = 1;

		if (!stack) continue;

		let current = 0;
		let animating = false;

		const getVisibleCards = () =>
			Array.from(diagram.querySelectorAll<HTMLElement>(".pdoc-card")).filter(
				(c) =>
					!c.classList.contains("pdoc-hidden") &&
					!c.classList.contains("pdoc-removing"),
			);

		const getVisibleDots = () =>
			Array.from(diagram.querySelectorAll<HTMLElement>(".pdoc-dot")).filter(
				(d) => !d.classList.contains("pdoc-dot-hidden"),
			);

		const updateCloseButtons = () => {
			const cards = getVisibleCards();
			const canDelete = cards.length > MIN_CARDS;
			for (const card of cards) {
				const btn = card.querySelector<HTMLElement>(".pdoc-close");
				if (btn) {
					btn.classList.toggle("pdoc-close-disabled", !canDelete);
				}
			}
		};

		const updateLayers = () => {
			const cards = getVisibleCards();
			const dots = getVisibleDots();
			const total = cards.length;

			for (let i = 0; i < total; i++) {
				cards[i].classList.remove(
					"pdoc-layer-0",
					"pdoc-layer-1",
					"pdoc-layer-2",
					"pdoc-layer-3",
					"pdoc-layer-4",
				);
				const offset = (i - current + total) % total;
				const layer = Math.min(offset, 4);
				cards[i].classList.add(`pdoc-layer-${layer}`);
			}

			for (let i = 0; i < dots.length; i++) {
				dots[i].classList.toggle("pdoc-dot-active", i === current);
			}

			updateCloseButtons();
		};

		const goTo = (idx: number) => {
			const total = getVisibleCards().length;
			if (total === 0 || animating) return;
			const wrapped = ((idx % total) + total) % total;
			if (wrapped === current) return;
			const cards = getVisibleCards();
			const outgoing = cards[current];
			const forwardSteps = (wrapped - current + total) % total;
			const direction = forwardSteps <= total / 2 ? "next" : "prev";

			animating = true;
			outgoing?.classList.add(
				direction === "next" ? "pdoc-swipe-out-next" : "pdoc-swipe-out-prev",
			);

			setTimeout(() => {
				current = wrapped;
				updateLayers();
				outgoing?.classList.remove(
					"pdoc-swipe-out-next",
					"pdoc-swipe-out-prev",
				);
			}, 180);

			setTimeout(() => {
				animating = false;
			}, 620);
		};

		// Delete a card
		const deleteCard = (card: HTMLElement) => {
			const cards = getVisibleCards();
			if (cards.length <= MIN_CARDS || animating) return;

			animating = true;

			// 1. Show destroying state (namespace turns red, strikethrough)
			card.classList.add("pdoc-destroying");

			// Update the badge text to "destroyed"
			const badge = card.querySelector<HTMLElement>(".pdoc-ns-badge");
			if (badge) badge.textContent = "deleted";

			// 2. Let the "deleted" state sit, then fade out and refill the stack together
			setTimeout(() => {
				card.classList.add("pdoc-removing");

				const dots = getVisibleDots();
				if (dots.length > 0) {
					dots[dots.length - 1].classList.add("pdoc-dot-hidden");
				}

				const remaining = getVisibleCards();
				if (current >= remaining.length) {
					current = Math.max(0, remaining.length - 1);
				}

				updateLayers();
				updateAddBtn();

				// Wait for the fade-out transition to finish
				setTimeout(() => {
					card.classList.add("pdoc-hidden");
					card.classList.remove(
						"pdoc-destroying",
						"pdoc-removing",
						"pdoc-layer-0",
						"pdoc-layer-1",
						"pdoc-layer-2",
						"pdoc-layer-3",
						"pdoc-layer-4",
					);

					// Reset the badge for if it ever comes back
					if (badge) badge.textContent = "isolated";

					setTimeout(() => {
						animating = false;
					}, 120);
				}, 560);
			}, 450);
		};

		// Close button clicks
		for (const closeBtn of diagram.querySelectorAll<HTMLElement>(
			".pdoc-close",
		)) {
			closeBtn.addEventListener("click", (e: MouseEvent) => {
				e.stopPropagation();
				const card = closeBtn.closest<HTMLElement>(".pdoc-card");
				if (card) deleteCard(card);
			});
		}

		// Dot clicks
		for (const dot of diagram.querySelectorAll<HTMLElement>(".pdoc-dot")) {
			dot.addEventListener("click", (e: MouseEvent) => {
				e.stopPropagation();
				const visibleDots = getVisibleDots();
				const visibleIdx = visibleDots.indexOf(dot);
				if (visibleIdx >= 0) goTo(visibleIdx);
			});
		}

		// Click the stack to advance
		stack.addEventListener("click", (e: MouseEvent) => {
			if ((e.target as HTMLElement).closest(".pdoc-dots")) return;
			if ((e.target as HTMLElement).closest(".pdoc-add")) return;
			if ((e.target as HTMLElement).closest(".pdoc-close")) return;
			goTo(current + 1);
		});

		// Add button
		const updateAddBtn = () => {
			if (!addBtn) return;
			const visible = getVisibleCards().length;
			const disabled = visible >= 5;
			addBtn.classList.toggle("pdoc-add-used", disabled);
			addBtn.disabled = disabled;
			addBtn.setAttribute("aria-disabled", String(disabled));
		};

		if (addBtn) {
			addBtn.addEventListener("click", (e: MouseEvent) => {
				e.stopPropagation();
				const visible = getVisibleCards().length;
				if (animating || visible >= 5) return;

				// Find the first hidden card
				const nextCard = diagram.querySelector<HTMLElement>(
					".pdoc-card.pdoc-hidden",
				);
				if (!nextCard) return;

				animating = true;

				// Show the card from behind the stack, then settle it into place
				nextCard.classList.add("pdoc-entering");
				nextCard.classList.remove("pdoc-hidden");

				// Show a dot
				const nextDot = diagram.querySelector<HTMLElement>(
					".pdoc-dot.pdoc-dot-hidden",
				);
				if (nextDot) {
					nextDot.classList.remove("pdoc-dot-hidden");
				}

				// Navigate to the new card
				current = getVisibleCards().length - 1;
				updateLayers();
				updateAddBtn();

				requestAnimationFrame(() => {
					nextCard.classList.remove("pdoc-entering");
				});

				setTimeout(() => {
					animating = false;
				}, 520);
			});
		}

		// Trackpad wheel
		let wheelAccum = 0;
		let wheelTimer: ReturnType<typeof setTimeout> | null = null;

		stack.addEventListener(
			"wheel",
			(e: WheelEvent) => {
				if (animating) return;

				const delta =
					Math.abs(e.deltaX) > Math.abs(e.deltaY) ? e.deltaX : e.deltaY;
				wheelAccum += delta;

				if (wheelTimer) clearTimeout(wheelTimer);
				wheelTimer = setTimeout(() => {
					wheelAccum = 0;
				}, 200);

				if (Math.abs(wheelAccum) > 50) {
					if (wheelAccum > 0) {
						goTo(current + 1);
					} else {
						goTo(current - 1);
					}
					wheelAccum = 0;
					e.preventDefault();
				}
			},
			{ passive: false },
		);

		// Touch swipe
		let touchStartX = 0;
		let touchStartY = 0;
		let touchDx = 0;
		let touchDragging = false;
		const SWIPE_THRESHOLD = 44;
		const DRAG_LIMIT = 72;

		const resetDrag = () => {
			touchDx = 0;
			touchDragging = false;
			diagram.classList.remove("pdoc-dragging");
			diagram.style.setProperty("--pdoc-drag-x", "0px");
			diagram.style.setProperty("--pdoc-drag-rotate", "0deg");
		};

		stack.addEventListener(
			"touchstart",
			(e: TouchEvent) => {
				if (animating || e.touches.length !== 1) return;
				touchStartX = e.touches[0].clientX;
				touchStartY = e.touches[0].clientY;
				touchDx = 0;
				touchDragging = false;
			},
			{ passive: true },
		);

		stack.addEventListener(
			"touchmove",
			(e: TouchEvent) => {
				if (animating || e.touches.length !== 1) return;
				const dx = e.touches[0].clientX - touchStartX;
				const dy = e.touches[0].clientY - touchStartY;

				if (!touchDragging && Math.abs(dx) < 10) return;
				if (!touchDragging && Math.abs(dy) > Math.abs(dx)) return;

				touchDragging = true;
				touchDx = dx;
				const clamped = Math.max(-DRAG_LIMIT, Math.min(DRAG_LIMIT, dx));
				diagram.classList.add("pdoc-dragging");
				diagram.style.setProperty("--pdoc-drag-x", `${clamped}px`);
				diagram.style.setProperty("--pdoc-drag-rotate", `${clamped / 24}deg`);
			},
			{ passive: true },
		);

		stack.addEventListener(
			"touchend",
			(e: TouchEvent) => {
				if (animating) return;
				const dx = touchDragging
					? touchDx
					: e.changedTouches[0].clientX - touchStartX;
				const dy = e.changedTouches[0].clientY - touchStartY;
				resetDrag();

				if (Math.abs(dx) > SWIPE_THRESHOLD && Math.abs(dx) > Math.abs(dy)) {
					if (dx < 0) {
						goTo(current + 1);
					} else {
						goTo(current - 1);
					}
				}
			},
			{ passive: true },
		);

		stack.addEventListener("touchcancel", resetDrag, { passive: true });

		updateLayers();
	}
</script>
