---
/**
 * RequestLifecycle — Self-contained Astro component
 *
 * Catalogue-style product nodes + kumo/flow connectors.
 * Zero framework JS — vanilla <script> for interactivity.
 *
 * Visual: dashed-border icon nodes, category-colored fills, kumo S-curve
 * connectors with pin-square terminals, dot grid background, segmented
 * toggle toolbar, step-based request animation timeline.
 */
import { Icon } from "astro-icon/components";

interface PipelineNode {
	id: string;
	icon: string;
	label: string;
	href: string;
	security: boolean;
	color?: string;
	borderColor: string;
	bgColor: string;
	iconColor: string;
	iconSize: string;
	iconAdjust?: string;
}

const ACCENT = "#f56500";
const BLUE = "#0A95FF";
const RED = "#ef4444";
const AMBER = "#f59e0b";
const PURPLE = "#8b5cf6";
const TEAL = "#14b8a6";

const NODES: PipelineNode[] = [
	{
		id: "dns",
		icon: "dns",
		label: "DNS",
		href: "/dns/",
		security: false,
		borderColor: BLUE,
		bgColor: "rgba(10,149,255,0.18)",
		iconColor: BLUE,
		iconSize: "28px",
		iconAdjust: "translate(1.5px,1.5px)",
	},
	{
		id: "tls",
		icon: "ssl",
		label: "TLS",
		href: "/ssl/",
		security: false,
		borderColor: BLUE,
		bgColor: "rgba(10,149,255,0.18)",
		iconColor: BLUE,
		iconSize: "24px",
		iconAdjust: "translate(-0.5px,-0.5px)",
	},
	{
		id: "ddos",
		icon: "ddos-protection",
		label: "DDoS",
		href: "/ddos-protection/",
		security: true,
		color: RED,
		borderColor: RED,
		bgColor: "rgba(239,68,68,0.18)",
		iconColor: RED,
		iconSize: "27px",
	},
	{
		id: "waf",
		icon: "waf",
		label: "WAF",
		href: "/waf/",
		security: true,
		color: AMBER,
		borderColor: AMBER,
		bgColor: "rgba(245,158,11,0.18)",
		iconColor: AMBER,
		iconSize: "23px",
	},
	{
		id: "bots",
		icon: "bots",
		label: "Bots",
		href: "/bots/",
		security: true,
		color: PURPLE,
		borderColor: PURPLE,
		bgColor: "rgba(139,92,246,0.18)",
		iconColor: PURPLE,
		iconSize: "25px",
		iconAdjust: "translateY(-1px)",
	},
	{
		id: "rate",
		icon: "waf",
		label: "Rate",
		href: "/waf/rate-limiting-rules/",
		security: true,
		color: "#3b82f6",
		borderColor: "#3b82f6",
		bgColor: "rgba(59,130,246,0.18)",
		iconColor: "#3b82f6",
		iconSize: "23px",
	},
	{
		id: "cache",
		icon: "cache",
		label: "Cache",
		href: "/cache/",
		security: false,
		borderColor: TEAL,
		bgColor: "rgba(20,184,166,0.18)",
		iconColor: TEAL,
		iconSize: "24px",
	},
	{
		id: "origin",
		icon: "workers",
		label: "Origin",
		href: "/workers/",
		security: false,
		borderColor: BLUE,
		bgColor: "rgba(10,149,255,0.18)",
		iconColor: BLUE,
		iconSize: "24px",
	},
];

const SECURITY = NODES.filter((n) => n.security);
---

<section
	id="request"
	class="rl-section hidden pt-14 pb-8 max-[900px]:pt-10 max-[900px]:pb-8"
	aria-labelledby="rl-heading"
	data-rl
>
	<div class="mb-3">
		<span class="text-accent font-mono text-xs tracking-widest uppercase"
			>Project</span
		>
	</div>
	<h2
		id="rl-heading"
		class="mb-2 text-2xl leading-tight font-medium -tracking-tight text-balance text-zinc-900 dark:text-zinc-50"
	>
		The anatomy of a request
	</h2>
	<p
		class="mb-8 max-w-[520px] text-sm leading-relaxed text-pretty text-zinc-500 dark:text-zinc-400"
	>
		Every request passes through Cloudflare's edge before reaching your origin.
		Toggle security features to add inspection checkpoints.
	</p>

	<!-- Toolbar -->
	<div class="rl-toolbar">
		<div class="rl-toolbar-left">
			<button type="button" class="rl-send" data-rl-send>
				<svg width="7" height="7" viewBox="0 0 24 24" fill="currentColor"
					><polygon points="5 3 19 12 5 21"></polygon></svg
				>
				Send
			</button>
			<span
				class="rl-status"
				data-rl-status
				aria-live="polite"
				aria-atomic="true"></span>
		</div>
		<div class="rl-toolbar-right" role="group" aria-label="Security features">
			{
				SECURITY.map((n, i) => (
					<button
						type="button"
						class:list={["rl-seg", i === SECURITY.length - 1 && "rl-seg--last"]}
						data-rl-toggle={n.id}
						data-rl-color={n.color}
						aria-pressed="true"
					>
						<span class="rl-seg-dot" />
						{n.label}
					</button>
				))
			}
		</div>
	</div>

	<!-- Pipeline container -->
	<div class="rl-container" data-rl-container>
		<!-- Dot grid -->
		<div
			class="pointer-events-none absolute inset-0 z-0 overflow-hidden"
			aria-hidden="true"
		>
			<div
				class="absolute h-full w-full"
				style="background-image: radial-gradient(var(--l-dot-color) 1px, transparent 1px); background-size: var(--l-dot-size); mask-image: var(--l-dot-mask)"
			>
			</div>
		</div>

		<!-- Corner marks -->
		{
			[
				"-top-[5.5px] -left-[5.5px]",
				"-top-[5.5px] -right-[5.5px]",
				"-bottom-[5.5px] -left-[5.5px]",
				"-right-[5.5px] -bottom-[5.5px]",
			].map((pos) => (
				<svg
					width="10"
					height="10"
					viewBox="0 0 10 10"
					class={`pointer-events-none absolute ${pos} z-10`}
					aria-hidden="true"
				>
					<line
						x1="0"
						y1="5"
						x2="10"
						y2="5"
						stroke-width="1"
						class="stroke-accent dark:stroke-white"
					/>
					<line
						x1="5"
						y1="0"
						x2="5"
						y2="10"
						stroke-width="1"
						class="stroke-accent dark:stroke-white"
					/>
				</svg>
			))
		}

		<!-- SVG connectors -->
		<svg class="rl-svg" aria-hidden="true" data-rl-svg>
			<defs>
				<marker
					id="rl-pin"
					markerWidth="6"
					markerHeight="6"
					refX="3"
					refY="3"
					orient="auto"
					markerUnits="userSpaceOnUse"
				>
					<rect
						x="0.5"
						y="0.5"
						width="5"
						height="5"
						rx="0.5"
						class="rl-pin-fill"
						stroke="currentColor"
						stroke-width="1"></rect>
				</marker>
				<marker
					id="rl-pin-a"
					markerWidth="6"
					markerHeight="6"
					refX="3"
					refY="3"
					orient="auto"
					markerUnits="userSpaceOnUse"
				>
					<rect
						x="0.5"
						y="0.5"
						width="5"
						height="5"
						rx="0.5"
						class="rl-pin-fill"
						stroke="var(--color-accent, #f56500)"
						stroke-width="1"></rect>
				</marker>
			</defs>
		</svg>

		<!-- Grid -->
		<div class="rl-grid">
			<!-- Request (user icon) -->
			<div class="rl-cell" style="grid-column:1">
				<div class="rl-wrap group">
					<span
						class="rl-label"
						style={`color:${ACCENT};background:rgba(245,101,0,0.06);border-color:${ACCENT};display:none;opacity:0`}
						>Request</span
					>
					<div
						class="rl-node-user"
						data-rl-node="request"
						style={`color:${ACCENT}`}
					>
						<svg
							width="56"
							height="56"
							viewBox="0 0 24 24"
							fill="none"
							style={`color:${ACCENT}`}
						>
							<path
								d="M22.62 1.38H1.38V22.62H22.62V1.38Z"
								stroke="currentColor"
								stroke-width="0.6"></path>
							<path
								d="M21.6 0.18H23.4C23.632 0.18 23.82 0.368 23.82 0.6V2.4C23.82 2.632 23.632 2.82 23.4 2.82H21.6C21.368 2.82 21.18 2.632 21.18 2.4V0.6C21.18 0.368 21.368 0.18 21.6 0.18Z"
								class="rl-pin-fill"
								stroke="currentColor"
								stroke-width="0.6"></path>
							<path
								d="M23.4 21.18H21.6C21.368 21.18 21.18 21.368 21.18 21.6V23.4C21.18 23.632 21.368 23.82 21.6 23.82H23.4C23.632 23.82 23.82 23.632 23.82 23.4V21.6C23.82 21.368 23.632 21.18 23.4 21.18Z"
								class="rl-pin-fill"
								stroke="currentColor"
								stroke-width="0.6"></path>
							<path
								d="M2.4 21.18H0.6C0.368 21.18 0.18 21.368 0.18 21.6V23.4C0.18 23.632 0.368 23.82 0.6 23.82H2.4C2.632 23.82 2.82 23.632 2.82 23.4V21.6C2.82 21.368 2.632 21.18 2.4 21.18Z"
								class="rl-pin-fill"
								stroke="currentColor"
								stroke-width="0.6"></path>
							<path
								d="M0.6 0.18H2.4C2.632 0.18 2.82 0.368 2.82 0.6V2.4C2.82 2.632 2.632 2.82 2.4 2.82H0.6C0.368 2.82 0.18 2.632 0.18 2.4V0.6C0.18 0.368 0.368 0.18 0.6 0.18Z"
								class="rl-pin-fill"
								stroke="currentColor"
								stroke-width="0.6"></path>
							<path
								fill-rule="evenodd"
								clip-rule="evenodd"
								d="M8.109 14.925C9.111 13.862 10.482 13.2 12 13.2C13.518 13.2 14.889 13.862 15.891 14.925C16.001 15.041 16.031 15.211 15.967 15.358C15.904 15.504 15.76 15.6 15.6 15.6H8.4C8.24 15.6 8.096 15.504 8.033 15.358C7.97 15.211 7.999 15.041 8.109 14.925Z"
								stroke="currentColor"
								stroke-width="0.8"></path>
							<path
								fill-rule="evenodd"
								clip-rule="evenodd"
								d="M9.8 10.2C9.8 8.985 10.785 8 12 8C13.215 8 14.2 8.985 14.2 10.2C14.2 11.415 13.215 12.4 12 12.4C10.785 12.4 9.8 11.415 9.8 10.2Z"
								stroke="currentColor"
								stroke-width="0.8"></path>
						</svg>
					</div>
				</div>
			</div>

			<!-- Pipeline nodes -->
			{
				NODES.map((node, i) => (
					<div
						class="rl-cell"
						style={`grid-column:${i + 2}`}
						data-rl-cell={node.id}
					>
						<a
							href={node.href}
							class="rl-wrap group no-underline"
							data-rl-link={node.id}
							aria-label={node.label}
						>
							<span
								class="rl-label"
								style={`color:${node.borderColor};background:${node.bgColor};border-color:${node.borderColor};display:none;opacity:0`}
							>
								{node.label}
							</span>
							<div
								class="rl-node"
								data-rl-node={node.id}
								data-border-color={node.borderColor}
								style={`border-color:${node.borderColor};background:${node.bgColor};color:${node.iconColor}`}
							>
								<span
									class="rl-icon-wrap"
									style={
										node.iconAdjust ? `transform:${node.iconAdjust}` : undefined
									}
								>
									<Icon name={node.icon} size={node.iconSize} />
								</span>
							</div>
							{node.security && (
								<span class="rl-node-status" data-rl-st={node.id} />
							)}
						</a>
					</div>
				))
			}

			<!-- Response -->
			<div class="rl-cell" style="grid-column:10">
				<div class="rl-wrap group">
					<span
						class="rl-label"
						style={`color:${ACCENT};background:rgba(245,101,0,0.06);border-color:${ACCENT};display:none;opacity:0`}
						>Response</span
					>
					<div
						class="rl-node"
						data-rl-node="response"
						style={`border-color:${ACCENT};background:rgba(245,101,0,0.18);color:${ACCENT}`}
					>
						<svg
							width="20"
							height="20"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2.5"
							stroke-linecap="round"
							stroke-linejoin="round"
							><polyline points="20 6 9 17 4 12"></polyline></svg
						>
					</div>
				</div>
			</div>
		</div>

		<div class="rl-edge-label" aria-hidden="true">Cloudflare Edge</div>
	</div>
</section>

<style>
	/* ---- Toolbar ---- */
	.rl-toolbar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 8px;
		gap: 12px;
	}
	.rl-toolbar-left {
		display: flex;
		align-items: center;
		gap: 10px;
	}
	.rl-toolbar-right {
		display: flex;
		align-items: center;
	}

	.rl-send {
		display: flex;
		align-items: center;
		gap: 6px;
		font-family: var(--font-mono, monospace);
		font-size: 10px;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		padding: 5px 12px;
		border: 1px solid var(--color-zinc-200);
		background: transparent;
		color: var(--color-zinc-500);
		cursor: pointer;
		transition:
			color 0.15s,
			border-color 0.15s,
			background-color 0.15s;
		user-select: none;
		touch-action: manipulation;
	}
	.rl-send:hover {
		border-color: var(--color-accent);
		color: var(--color-accent);
	}
	.rl-send:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 2px;
	}

	.rl-status {
		font-family: var(--font-mono, monospace);
		font-size: 10px;
		letter-spacing: 0.03em;
		color: var(--color-zinc-400);
	}

	.rl-seg {
		font-family: var(--font-mono, monospace);
		font-size: 10px;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		padding: 5px 10px;
		border: 1px solid var(--color-zinc-200);
		border-right-width: 0;
		background: transparent;
		color: var(--color-zinc-500);
		cursor: pointer;
		transition:
			color 0.15s,
			border-color 0.15s,
			background-color 0.15s;
		user-select: none;
		display: flex;
		align-items: center;
		gap: 5px;
		touch-action: manipulation;
	}
	.rl-seg--last {
		border-right-width: 1px;
	}
	.rl-seg[aria-pressed="false"] {
		color: var(--color-zinc-500);
	}
	.rl-seg-dot {
		width: 5px;
		height: 5px;
		background: var(--color-zinc-300);
		transition: background 0.15s;
	}
	.rl-seg[aria-pressed="true"] .rl-seg-dot {
		background: currentColor;
	}
	.rl-seg:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: -2px;
	}

	/* ---- Container ---- */
	.rl-container {
		position: relative;
		overflow: visible;
		border: 1px solid var(--color-zinc-200);
		background: #fff;
		padding: 3rem 2rem 2.5rem;
	}

	/* ---- SVG layer ---- */
	.rl-svg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		pointer-events: none;
		z-index: 1;
		overflow: visible;
		color: rgba(0, 0, 0, 0.15);
	}
	.rl-pin-fill {
		fill: #fff;
	}

	/* ---- Grid ---- */
	.rl-grid {
		display: grid;
		grid-template-columns: repeat(10, 1fr);
		align-items: center;
		position: relative;
	}
	.rl-cell {
		display: flex;
		flex-direction: column;
		align-items: center;
		position: relative;
		z-index: 2;
	}
	.rl-cell[data-rl-off] .rl-wrap {
		opacity: 0;
		pointer-events: none;
	}

	/* ---- Node ---- */
	.rl-node {
		width: 56px;
		height: 56px;
		display: flex;
		align-items: center;
		justify-content: center;
		border: 1px dashed;
		border-radius: 6px;
		position: relative;
		z-index: 2;
		overflow: hidden;
	}
	.rl-node-user {
		width: 56px;
		height: 56px;
		display: flex;
		align-items: center;
		justify-content: center;
		position: relative;
		z-index: 2;
	}
	.rl-icon-wrap {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		height: 100%;
	}
	.rl-wrap {
		display: flex;
		flex-direction: column;
		align-items: center;
		position: relative;
		cursor: pointer;
		text-decoration: none;
		transition: opacity 0.25s;
	}
	.rl-wrap:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 4px;
	}

	/* ---- Label (hover-only, FOUC-proof via inline display:none) ---- */
	.rl-label {
		position: absolute;
		bottom: calc(100% + 6px);
		left: 50%;
		transform: translateX(-50%);
		white-space: nowrap;
		pointer-events: none;
		font-family: var(--font-mono, monospace);
		font-size: 10px;
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		line-height: 1;
		padding: 4px 8px;
		border: 1px dashed;
		z-index: 10;
	}
	.group:hover > .rl-label {
		display: block !important;
		opacity: 1 !important;
	}

	/* ---- Status (PASS / BLOCKED) ---- */
	.rl-node-status {
		position: absolute;
		top: calc(100% + 6px);
		left: 50%;
		transform: translateX(-50%);
		white-space: nowrap;
		pointer-events: none;
		font-family: var(--font-mono, monospace);
		font-size: 10px;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		line-height: 1;
		padding: 3px 7px;
		z-index: 10;
	}

	/* ---- Edge label ---- */
	.rl-edge-label {
		position: absolute;
		bottom: 8px;
		left: 50%;
		transform: translateX(-50%);
		font-family: var(--font-mono, monospace);
		font-size: 7px;
		text-transform: uppercase;
		letter-spacing: 1.5px;
		color: var(--color-accent);
		opacity: 0.25;
		white-space: nowrap;
	}

	/* ---- Dark mode ---- */
	:global(.dark) .rl-container,
	:global([data-theme="dark"]) .rl-container {
		border-color: #2a2a2a;
		background: #1d1d1d;
	}
	:global(.dark) .rl-svg,
	:global([data-theme="dark"]) .rl-svg {
		color: rgba(255, 255, 255, 0.25);
	}
	:global(.dark) .rl-pin-fill,
	:global([data-theme="dark"]) .rl-pin-fill {
		fill: #1d1d1d;
	}
	:global(.dark) .rl-send,
	:global([data-theme="dark"]) .rl-send {
		border-color: var(--color-zinc-700);
		color: var(--color-zinc-500);
	}
	:global(.dark) .rl-send:hover,
	:global([data-theme="dark"]) .rl-send:hover {
		border-color: var(--color-accent);
		color: var(--color-accent);
	}
	:global(.dark) .rl-seg,
	:global([data-theme="dark"]) .rl-seg {
		border-color: var(--color-zinc-700);
	}
	:global(.dark) .rl-seg[aria-pressed="false"],
	:global([data-theme="dark"]) .rl-seg[aria-pressed="false"] {
		color: var(--color-zinc-400);
	}
	:global(.dark) .rl-seg-dot,
	:global([data-theme="dark"]) .rl-seg-dot {
		background: var(--color-zinc-600);
	}

	/* ---- Responsive ---- */
	@media (max-width: 768px) {
		.rl-toolbar {
			flex-direction: column;
			align-items: stretch;
			gap: 8px;
		}
		.rl-toolbar-left {
			justify-content: space-between;
		}
		.rl-toolbar-right {
			overflow-x: auto;
		}
		.rl-grid {
			display: flex;
			flex-direction: column;
			align-items: stretch;
		}
		.rl-cell {
			flex-direction: row;
			gap: 8px;
			min-height: unset;
			padding: 4px 0;
		}
		.rl-wrap {
			flex-direction: row;
			gap: 8px;
		}
		.rl-label {
			position: static;
			transform: none;
			border: none;
			padding: 0;
			font-size: 9px;
			display: block !important;
			opacity: 1 !important;
		}
		.rl-svg {
			display: none;
		}
		.rl-edge-label {
			display: none;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.rl-node {
			transition: none !important;
		}
	}
</style>

<script>
	function initRL() {
		const root = document.querySelector("[data-rl]") as HTMLElement | null;
		if (!root) return;
		if (root.dataset.rlInit === "true") return;
		root.dataset.rlInit = "true";

		const svg = root.querySelector<SVGSVGElement>("[data-rl-svg]")!;
		const container = root.querySelector<HTMLElement>("[data-rl-container]")!;
		const statusEl = root.querySelector<HTMLElement>("[data-rl-status]")!;
		const active = new Set(["ddos", "waf", "bots", "rate"]);
		const ACCENT = "#f56500";
		const prefersReducedMotion = window.matchMedia(
			"(prefers-reduced-motion: reduce)",
		).matches;

		const NODES = [
			{ id: "dns", security: false },
			{ id: "tls", security: false },
			{ id: "ddos", security: true, label: "DDoS" },
			{ id: "waf", security: true, label: "WAF" },
			{ id: "bots", security: true, label: "Bots" },
			{ id: "rate", security: true, label: "Rate" },
			{ id: "cache", security: false },
			{ id: "origin", security: false },
		];

		// ---- kumo createRoundedPath (horizontal, single=true) ----
		function makePath(x1: number, y1: number, x2: number, y2: number): string {
			if (Math.abs(y2 - y1) <= 2) return `M ${x1} ${y1} L ${x2} ${y2}`;
			const r = Math.min(8, Math.abs(y2 - y1) / 2);
			const vx = x2 - 32;
			const sx = x2 > x1 ? 1 : -1;
			const sy = y2 > y1 ? 1 : -1;
			return `M ${x1} ${y1} L ${vx - sx * r} ${y1} Q ${vx} ${y1} ${vx} ${y1 + sy * r} L ${vx} ${y2 - sy * r} Q ${vx} ${y2} ${vx + sx * r} ${y2} L ${x2} ${y2}`;
		}

		type Edge = { id: string; d: string };
		let edges: Edge[] = [];

		function draw() {
			svg.querySelectorAll(".eg").forEach((g) => g.remove());
			edges = [];
			const cr = container.getBoundingClientRect();
			const allIds = ["request", ...NODES.map((n) => n.id), "response"];
			const vis = allIds.filter((id) => {
				const n = NODES.find((n) => n.id === id);
				return !n || !n.security || active.has(id);
			});

			for (let i = 0; i < vis.length - 1; i++) {
				const fEl = root!.querySelector<HTMLElement>(
					`[data-rl-node="${vis[i]}"]`,
				);
				const tEl = root!.querySelector<HTMLElement>(
					`[data-rl-node="${vis[i + 1]}"]`,
				);
				if (!fEl || !tEl) continue;
				const fr = fEl.getBoundingClientRect();
				const tr = tEl.getBoundingClientRect();
				const d = makePath(
					fr.right - cr.left,
					fr.top + fr.height / 2 - cr.top,
					tr.left - cr.left,
					tr.top + tr.height / 2 - cr.top,
				);
				const eid = `${vis[i]}-${vis[i + 1]}`;

				const g = document.createElementNS("http://www.w3.org/2000/svg", "g");
				g.classList.add("eg");
				g.dataset.eid = eid;

				const base = document.createElementNS(
					"http://www.w3.org/2000/svg",
					"path",
				);
				base.setAttribute("d", d);
				base.setAttribute("fill", "none");
				base.setAttribute("stroke", "currentColor");
				base.setAttribute("stroke-width", "2");
				base.setAttribute("marker-start", "url(#rl-pin)");
				base.setAttribute("marker-end", "url(#rl-pin)");
				g.appendChild(base);

				const hl = document.createElementNS(
					"http://www.w3.org/2000/svg",
					"path",
				);
				hl.setAttribute("d", d);
				hl.setAttribute("fill", "none");
				hl.setAttribute("stroke", "transparent");
				hl.setAttribute("stroke-width", "0");
				hl.setAttribute("marker-start", "url(#rl-pin-a)");
				hl.setAttribute("marker-end", "url(#rl-pin-a)");
				hl.classList.add("ehl");
				g.appendChild(hl);

				svg.appendChild(g);
				edges.push({ id: eid, d });
			}
		}

		// ---- Toggles ----
		const toggleCleanup: Array<() => void> = [];

		root
			.querySelectorAll<HTMLButtonElement>("[data-rl-toggle]")
			.forEach((btn) => {
				const id = btn.dataset.rlToggle!;
				const color = btn.dataset.rlColor!;
				const onClick = () => {
					if (active.has(id)) active.delete(id);
					else active.add(id);
					apply();
					requestAnimationFrame(draw);
				};
				function apply() {
					const on = active.has(id);
					btn.setAttribute("aria-pressed", String(on));
					btn.style.color = on ? color : "";
					const cell = root!.querySelector(
						`[data-rl-cell="${id}"]`,
					) as HTMLElement;
					if (cell) {
						if (on) cell.removeAttribute("data-rl-off");
						else cell.setAttribute("data-rl-off", "");
					}
				}
				btn.addEventListener("click", onClick);
				toggleCleanup.push(() => btn.removeEventListener("click", onClick));
				apply();
			});

		draw();
		const resizeObserver = new ResizeObserver(draw);
		resizeObserver.observe(container);
		const onWindowResize = () => draw();
		window.addEventListener("resize", onWindowResize, { passive: true });

		// ---- Animation ----
		let running = false;

		const sendButton = root.querySelector<HTMLButtonElement>("[data-rl-send]");
		if (!sendButton) return;
		const onSendClick = () => {
			if (!running) send();
		};
		sendButton.addEventListener("click", onSendClick);
		const autoSendTimeout = window.setTimeout(send, 800);

		function send() {
			if (running) return;
			running = true;
			reset();

			if (prefersReducedMotion) {
				statusEl.textContent = "200 OK — Response delivered";
				statusEl.style.color = ACCENT;
				running = false;
				return;
			}

			const threat = Math.random() < 0.3;
			statusEl.textContent = threat
				? "Scanning threat..."
				: "Routing request...";
			statusEl.style.color = threat ? "#ef4444" : "";

			const vis = NODES.filter((n) => !n.security || active.has(n.id));
			const ids = ["request", ...vis.map((n) => n.id), "response"];
			const steps: { at: number; fn: () => void }[] = [];
			let t = 0;

			for (let i = 0; i < ids.length; i++) {
				const nid = ids[i];
				const pid = i > 0 ? ids[i - 1] : null;
				const eid = pid ? `${pid}-${nid}` : null;

				if (eid) {
					const e = eid;
					steps.push({
						at: t,
						fn: () => {
							const g = svg.querySelector(`[data-eid="${e}"]`);
							const h = g?.querySelector(".ehl") as SVGPathElement | null;
							if (h) {
								h.setAttribute("stroke", ACCENT);
								h.setAttribute("stroke-width", "2");
							}
							const d = edges.find((x) => x.id === e)?.d;
							if (d && g) {
								const dot = document.createElementNS(
									"http://www.w3.org/2000/svg",
									"circle",
								);
								dot.setAttribute("r", "3");
								dot.style.fill = ACCENT;
								const anim = document.createElementNS(
									"http://www.w3.org/2000/svg",
									"animateMotion",
								);
								anim.setAttribute("dur", "0.8s");
								anim.setAttribute("repeatCount", "1");
								anim.setAttribute("path", d);
								anim.setAttribute("fill", "freeze");
								dot.appendChild(anim);
								g.appendChild(dot);
								setTimeout(() => dot.remove(), 850);
							}
						},
					});
					t += 800;
				}

				const cn = nid,
					ce = eid;
				const node = NODES.find((n) => n.id === cn);
				steps.push({
					at: t,
					fn: () => {
						if (ce) {
							const h = svg.querySelector(
								`[data-eid="${ce}"] .ehl`,
							) as SVGPathElement | null;
							if (h) {
								h.setAttribute("stroke", "transparent");
								h.setAttribute("stroke-width", "0");
							}
						}
						if (node?.security && threat && rBlock(cn)) {
							const st = root!.querySelector<HTMLElement>(
								`[data-rl-st="${cn}"]`,
							);
							if (st) {
								st.textContent = "BLOCKED";
								st.style.color = "#ef4444";
							}
							statusEl.textContent = `403 — Blocked by ${node.label}`;
							statusEl.style.color = "#ef4444";
							return;
						}
						if (node?.security) {
							const st = root!.querySelector<HTMLElement>(
								`[data-rl-st="${cn}"]`,
							);
							if (st) {
								st.textContent = "PASS";
								st.style.color = "#10b981";
							}
						}
					},
				});
				t += 200;
			}

			steps.push({
				at: t,
				fn: () => {
					statusEl.textContent = "200 OK — Response delivered";
					statusEl.style.color = ACCENT;
					running = false;
				},
			});

			let blocked = false;
			const t0 = performance.now();
			const q = [...steps];
			function tick(now: number) {
				if (blocked) return;
				while (q.length && q[0].at <= now - t0) {
					q.shift()!.fn();
					if (statusEl.textContent?.includes("403")) {
						blocked = true;
						running = false;
						return;
					}
				}
				if (q.length) requestAnimationFrame(tick);
				else running = false;
			}
			requestAnimationFrame(tick);
		}

		function reset() {
			root!.querySelectorAll<HTMLElement>("[data-rl-st]").forEach((el) => {
				el.textContent = "";
				el.style.color = "";
			});
			svg.querySelectorAll("circle").forEach((d) => d.remove());
			svg.querySelectorAll(".ehl").forEach((el) => {
				el.setAttribute("stroke", "transparent");
				el.setAttribute("stroke-width", "0");
			});
			statusEl.textContent = "";
			statusEl.style.color = "";
		}

		function rBlock(id: string): boolean {
			let h = 0;
			for (let i = 0; i < id.length; i++)
				h = ((h << 5) - h + id.charCodeAt(i)) | 0;
			return (Math.abs(h) + Math.floor(Math.random() * 4)) % 7 < 2;
		}

		document.addEventListener(
			"astro:before-swap",
			() => {
				window.clearTimeout(autoSendTimeout);
				resizeObserver.disconnect();
				window.removeEventListener("resize", onWindowResize);
				sendButton.removeEventListener("click", onSendClick);
				toggleCleanup.forEach((cleanup) => cleanup());
				root.dataset.rlInit = "false";
			},
			{ once: true },
		);
	}

	initRL();
	document.addEventListener("astro:page-load", initRL);
</script>
