---
/**
 * Full-page vertical container lines.
 *
 * Positioned absolutely within the same relative parent as StructuralGrid
 * so the lines share the same coordinate system as the plus marks and
 * corner brackets. Uses 100lvh height to extend beyond the content area;
 * parent containers have overflow:visible so the lines are not clipped.
 *
 * Uses the same container widths and responsive margin logic as StructuralGrid.
 */
const CONTAINERS = [1400, 1280, 720, 400];

const MIN_MARGINS = [0, 48, 120, 200];
function rw(w: number): string {
	const i = CONTAINERS.indexOf(w);
	const margin = i >= 0 ? MIN_MARGINS[i] : 0;
	if (margin === 0) return `min(${w}px, 100%)`;
	return `min(${w}px, calc(100% - ${margin}px))`;
}

const lineBase = "absolute top-0 left-1/2 -translate-x-1/2";
---

<div
	class="pointer-events-none absolute inset-x-0 top-0 z-0 max-[1024px]:hidden"
	style="height: 100%"
	aria-hidden="true"
>
	<!-- Center line -->
	<div
		class="absolute top-0 left-1/2 h-full w-0 border-l border-dotted border-black/[0.06] dark:border-white/[0.04]"
	>
	</div>

	<!-- Container lines -->
	{
		CONTAINERS.map((w) => (
			<div
				class={`${lineBase} h-full border-r border-black/[0.06] dark:border-white/[0.04]`}
				style={`width:${rw(w)}`}
			/>
		))
	}
</div>
