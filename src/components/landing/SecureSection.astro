---
/**
 * S6: Categorized grid with flair
 *
 * Two categories, three cards each. Cards have:
 * - Large product icon as the visual anchor
 * - Bold scenario text
 * - Product name as accent mono label
 * - CTA button links to product docs
 * - Plus marks on the outer grid corners
 * - gap-px grid technique from PlatformStats
 */
import ProductCard from "./ProductCard.astro";
import ProductCardGrid from "./ProductCardGrid.astro";

const categories = [
	{
		label: "Network & Application",
		threats: [
			{
				scenario: "Under DDoS attack",
				product: "WAF",
				href: "/waf",
				icon: "ddos-protection",
				detail: "Custom rules, rate limiting, automatic mitigation",
				cta: "Harden your app with WAF",
			},
			{
				scenario: "SSL is fragile or misconfigured",
				product: "SSL/TLS",
				href: "/ssl",
				icon: "ssl",
				detail: "Automatic certificates, strict mode, mTLS",
				cta: "Set up SSL/TLS",
			},
			{
				scenario: "Bots abusing login or forms",
				product: "Turnstile",
				href: "/turnstile",
				icon: "turnstile",
				detail: "Invisible challenge, zero CAPTCHA friction",
				cta: "Add Turnstile protection",
			},
		],
	},
	{
		label: "Access & Identity",
		threats: [
			{
				scenario: "Expose internal services safely",
				product: "Tunnel",
				href: "/cloudflare-one/networks/connectors/cloudflare-tunnel",
				icon: "tunnel",
				detail: "Outbound-only encrypted tunnels, no open ports",
				cta: "Create a secure Tunnel",
			},
			{
				scenario: "Secure access to internal tools",
				product: "Zero Trust",
				href: "/cloudflare-one/",
				icon: "access",
				detail: "Identity-aware access, device posture checks",
				cta: "Set up Zero Trust access",
			},
			{
				scenario: "Filter outbound traffic network-wide",
				product: "Gateway",
				href: "/cloudflare-one/traffic-policies/",
				icon: "gateway",
				detail: "DNS filtering, HTTP policies, network controls",
				cta: "Create Gateway policies",
			},
		],
	},
];
---

<section
	class="pt-14 pb-12 max-[900px]:pt-10 max-[900px]:pb-10"
	aria-labelledby="s6-heading"
	id="secure"
>
	<div class="mb-3">
		<span class="text-accent font-mono text-xs tracking-widest uppercase"
			>Secure</span
		>
	</div>
	<h2
		id="s6-heading"
		class="mb-2 text-2xl leading-tight font-medium -tracking-tight text-balance text-zinc-900 md:text-3xl dark:text-zinc-50"
	>
		Secure what you already have
	</h2>
	<p
		class="mb-8 max-w-[600px] text-sm leading-relaxed text-pretty text-zinc-500 md:text-lg dark:text-zinc-400"
	>
		Add Cloudflare in front of what is already running, no rebuild required.
	</p>

	<div class="space-y-8">
		{
			categories.map((cat) => (
				<ProductCardGrid label={cat.label}>
					{cat.threats.map((t) => (
						<ProductCard
							icon={t.icon}
							product={t.product}
							scenario={t.scenario}
							detail={t.detail}
							href={t.href}
							cta={t.cta}
						/>
					))}
				</ProductCardGrid>
			))
		}
	</div>
</section>
