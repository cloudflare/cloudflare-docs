---
import Eyebrow from "./Eyebrow.astro";
import ProductCard from "./ProductCard.astro";
import ProductCardGrid from "./ProductCardGrid.astro";
import SectionHeading from "./SectionHeading.astro";

const categories = [
	{
		label: "Public websites & apps",
		threats: [
			{
				scenario: "Block the latest attacks",
				product: "WAF",
				href: "/waf/",
				icon: "ddos-protection",
				detail: "Custom rules, rate limiting, zero-day protection",
				cta: "Harden your app with WAF",
			},
			{
				scenario: "Protect users and data",
				product: "SSL/TLS",
				href: "/ssl/",
				icon: "ssl",
				detail: "Automatic certificates, strict mode, mTLS",
				cta: "Set up SSL/TLS",
			},
			{
				scenario: "Replace CAPTCHAs",
				product: "Turnstile",
				href: "/turnstile/",
				icon: "turnstile",
				detail: "Invisible challenge, privacy-preserving verification",
				cta: "Add Turnstile protection",
			},
		],
	},
	{
		label: "Corporate and home networks",
		threats: [
			{
				scenario: "Replace legacy VPNs",
				product: "Tunnel",
				href: "/cloudflare-one/networks/connectors/cloudflare-tunnel/",
				icon: "tunnel",
				detail: "Outbound-only encrypted tunnels, no open ports",
				cta: "Create a secure Tunnel",
			},
			{
				scenario: "Manage access across your internal environment",
				product: "Zero Trust",
				href: "/cloudflare-one/",
				icon: "access",
				detail:
					"Identity-first, quantum-safe access with device posture checks",
				cta: "Set up Zero Trust access",
			},
			{
				scenario: "Protect employee Internet browsing",
				product: "Gateway",
				href: "/cloudflare-one/traffic-policies/",
				icon: "gateway",
				detail: "DNS filtering, HTTP policies, network controls",
				cta: "Create Gateway policies",
			},
		],
	},
];
---

<section
	class="pt-10 pb-10 lg:pt-14 lg:pb-12"
	aria-labelledby="secure-heading"
	id="secure"
>
	<Eyebrow>Secure</Eyebrow>
	<SectionHeading id="secure-heading" class="mb-2">
		Secure what you already have
	</SectionHeading>
	<p
		class="text-foreground-muted mb-8 max-w-[600px] text-sm leading-relaxed text-pretty md:text-lg"
	>
		Add Cloudflare in front of what is already running, no rebuild required.
	</p>

	<div class="space-y-8">
		{
			categories.map((cat) => (
				<ProductCardGrid label={cat.label}>
					{cat.threats.map((t) => (
						<ProductCard
							icon={t.icon}
							product={t.product}
							scenario={t.scenario}
							detail={t.detail}
							href={t.href}
							cta={t.cta}
						/>
					))}
				</ProductCardGrid>
			))
		}
	</div>
</section>
