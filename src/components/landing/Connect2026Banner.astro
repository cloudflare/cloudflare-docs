---
import Icon from "@cloudflare/nimbus-docs/components/Icon.astro";
import { LinkButton } from "@/components/ui/link-button";

const speakers = [
	{
		name: "Evan You",
		role: "Vue.js & Vite creator",
		src: "https://dash.cloudflare.com/images/connect-2026/avatars/evan-you.jpg",
	},
	{
		name: "Tanner Linsley",
		role: "Owner",
		src: "https://dash.cloudflare.com/images/connect-2026/avatars/tanner-linsley.jpg",
	},
	{
		name: "Corey Quinn",
		role: "Chief Cloud Economist",
		src: "https://dash.cloudflare.com/images/connect-2026/avatars/corey-quinn.jpg",
	},
	{
		name: "Peter Steinberger",
		role: "Member of Technical Staff",
		src: "https://dash.cloudflare.com/images/connect-2026/avatars/peter-steinberger.jpg",
	},
	{
		name: "Fred Schott",
		role: "Astro creator",
		src: "https://dash.cloudflare.com/images/connect-2026/avatars/fred-schott.jpg",
	},
];

const tooltipClass =
	"connect-speaker-tooltip border-border bg-card pointer-events-none absolute bottom-[calc(100%+0.625rem)] left-1/2 z-20 flex w-max min-w-44 max-w-60 flex-col rounded-xl border px-3.5 py-3 opacity-0 shadow-md transition-[opacity,transform] duration-150";
---

<section
	class="bg-muted @container relative rounded-2xl py-1.5 pr-1.5"
	data-connect-card
	aria-labelledby="connect-card-title"
>
	<aside
		class="connect-card relative isolate flex min-h-24 flex-col rounded-xl shadow-md"
		aria-label="Cloudflare Connect 2026 announcement"
	>
		<div class="connect-card-content border-border bg-card flex min-w-0 flex-1 flex-col gap-4 rounded-xl border p-5">
			<div class="min-w-0">
				<div class="flex min-w-0 flex-wrap items-center gap-x-2 gap-y-1">
					<h2
						id="connect-card-title"
						class="text-foreground text-lg leading-snug font-medium tracking-tight text-balance"
					>
						Meet the Agentic Internet Builders IRL
					</h2>
					<div
						class="relative flex shrink-0 items-center pl-1"
						aria-label="Featured speakers"
					>
						{speakers.map((speaker, index) => (
							<button
								type="button"
								class:list={[
									"connect-avatar relative grid size-5 shrink-0 place-items-center border-0 bg-transparent p-0 transition-transform duration-150 before:absolute before:-inset-0.5 before:content-[''] motion-reduce:transition-none",
									index > 0 && "-ml-1.5",
								]}
								style={`z-index:${index}`}
								aria-describedby={`connect-speaker-${index}`}
							>
								<img
									src={speaker.src}
									alt={speaker.name}
									width="20"
									height="20"
									loading="lazy"
									decoding="async"
									draggable="false"
									class="bg-card ring-card size-5 rounded-full object-cover ring-1"
								/>
								<span
									id={`connect-speaker-${index}`}
									class={tooltipClass}
									role="tooltip"
								>
									<strong class="text-foreground text-base leading-snug font-medium">
										{speaker.name}
									</strong>
									<small class="text-muted-foreground text-sm leading-snug">
										{speaker.role}
									</small>
								</span>
							</button>
						))}
						<span
							class="connect-avatar relative -ml-1.5 grid size-5 shrink-0 place-items-center transition-transform duration-150 motion-reduce:transition-none"
							style={`z-index:${speakers.length}`}
						>
							<a
								href="https://www.cloudflare.com/connect/speakers/"
								target="_blank"
								rel="noreferrer"
								aria-label="Browse all Cloudflare Connect speakers"
								aria-describedby="connect-speaker-all"
								class="border-border bg-muted text-muted-foreground hover:bg-accent hover:text-foreground focus-visible:outline-ring flex size-5 items-center justify-center rounded-full border no-underline transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 motion-reduce:transition-none"
							>
								<Icon name="ph:arrow-up-right" class="size-3" />
							</a>
							<span
								id="connect-speaker-all"
								class={tooltipClass}
								role="tooltip"
							>
								<strong class="text-foreground text-base leading-snug font-medium">
									Browse all
								</strong>
								<small class="text-muted-foreground text-sm leading-snug">
									180+ speakers
								</small>
							</span>
						</span>
					</div>
				</div>
				<p class="text-muted-foreground mt-1 max-w-[520px] text-sm leading-snug text-pretty">
					Connect brings the Cloudflare community together once a year to learn,
					collaborate, and shape what comes next. Oct 19–21, San Francisco.
				</p>
			</div>

			<div class="connect-card-actions flex w-full shrink-0 items-center gap-2">
				<LinkButton
					href="https://www.cloudflare.com/connect/"
					target="_blank"
					rel="noopener noreferrer"
					variant="primary"
					size="base"
					class="connect-card-cta"
				>
					Learn more
				</LinkButton>
				<div class="connect-card-dismiss text-foreground grid h-11 place-items-center overflow-hidden">
					<button
						type="button"
						data-connect-card-close
						aria-label="Dismiss Cloudflare Connect announcement"
						class="border-border hover:bg-accent grid size-7 cursor-pointer place-items-center rounded-full border bg-transparent transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 motion-reduce:transition-none"
					>
						<Icon name="ph:x" class="size-3.5" />
					</button>
				</div>
			</div>
		</div>
	</aside>
</section>

<script is:inline>
	try {
		if (localStorage.getItem("connect-2026-announcement")) {
			document.currentScript?.previousElementSibling?.remove();
		}
	} catch {
		void 0;
	}
</script>

<script>
	import { mount } from "@cloudflare/nimbus-docs/client";

	mount("[data-connect-card]", (card) => {
		const close = card.querySelector<HTMLButtonElement>(
			"[data-connect-card-close]",
		);
		if (!close) return () => {};

		const dismiss = () => {
			card.remove();
			try {
				localStorage.setItem("connect-2026-announcement", "viewed");
			} catch {
				return;
			}
		};
		close.addEventListener("click", dismiss);
		return () => close.removeEventListener("click", dismiss);
	});
</script>

<style>
	.connect-avatar:hover,
	.connect-avatar:focus-within {
		z-index: 10 !important;
		transform: translateY(-2px) scale(1.08);
	}

	.connect-avatar:hover ~ .connect-avatar,
	.connect-avatar:focus-within ~ .connect-avatar {
		transform: translateX(6px);
	}

	.connect-speaker-tooltip {
		transform: translate(-50%, 4px);
	}

	.connect-avatar:hover .connect-speaker-tooltip,
	.connect-avatar:focus-within .connect-speaker-tooltip {
		opacity: 1;
		transform: translate(-50%, 0);
	}

	@container (max-width: 767px) {
		.connect-speaker-tooltip {
			left: 0;
			transform: translateY(4px);
		}

		.connect-avatar:hover .connect-speaker-tooltip,
		.connect-avatar:focus-within .connect-speaker-tooltip {
			transform: translateY(0);
		}
	}

	.connect-card-cta {
		flex: 1 1 auto;
	}

	.connect-card-dismiss {
		position: absolute;
		top: 0.75rem;
		right: 0.75rem;
		z-index: 2;
		width: 0;
		opacity: 0;
		pointer-events: none;
		transform: translateY(1rem);
		transition:
			width 220ms cubic-bezier(0.34, 1.56, 0.64, 1),
			opacity 150ms ease-out,
			transform 220ms cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	[data-connect-card]:hover .connect-card-dismiss,
	[data-connect-card]:focus-within .connect-card-dismiss {
		width: 2.75rem;
		opacity: 1;
		pointer-events: auto;
		transform: translateY(0);
	}

	@container (min-width: 768px) {
		.connect-card {
			height: 6rem;
		}

		.connect-card-content {
			flex-direction: row;
			align-items: center;
			justify-content: space-between;
			padding-block: 0;
		}

		.connect-card-actions {
			width: auto;
		}

		.connect-card-cta {
			flex: none;
		}

		.connect-card-dismiss {
			position: static;
			order: -1;
		}
	}

	@media (pointer: coarse) {
		.connect-card-dismiss {
			width: 2.75rem;
			opacity: 1;
			pointer-events: auto;
			transform: translateY(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.connect-speaker-tooltip,
		.connect-card-dismiss {
			transition: none;
		}
	}
</style>
