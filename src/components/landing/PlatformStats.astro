---
import { stagger } from "./constants";

// Copy mirrors workers.cloudflare.com verbatim where the slot allows.
// See `landing-stats-decisions.md` at the repo root for sourcing rationale.
const stats = [
	{
		value: 330,
		suffix: "+",
		unit: "cities",
		label: "Run everywhere",
		detail: "Around the world",
	},
	{
		value: 100,
		suffix: "+",
		unit: "products",
		label: "Powerful primitives",
		detail: "Seamlessly integrated",
	},
	{
		value: 81,
		suffix: "M+",
		unit: "HTTP requests/sec",
		label: "Run at massive scale",
		detail: "On Cloudflare's infrastructure",
	},
	{
		value: 20,
		suffix: "%",
		unit: "of the Internet",
		label: "Internet scale",
		detail: "1 in 5 sites on the Internet",
	},
];
---

<section
	id="platform"
	class={`pt-10 pb-12 max-[900px]:pt-8 max-[900px]:pb-8 ${stagger(0.42)}`}
	aria-labelledby="stats-heading"
>
	<div class="mb-4">
		<span class="text-accent font-mono text-[13px] tracking-widest uppercase"
			>Platform at a Glance</span
		>
	</div>

	<div
		class="grid grid-cols-4 gap-px overflow-visible border border-[#e8e8e8] bg-[#e8e8e8] max-[768px]:grid-cols-2 dark:border-[#2a2a2a] dark:bg-[#2a2a2a]"
		id="stats-grid"
	>
		{
			stats.map((stat, i) => (
				<div class="bg-l-card hover:bg-l-card-hover dark:bg-l-card-dark dark:hover:bg-l-card-hover-dark relative flex flex-col justify-between px-5 py-5 transition-colors duration-150">
					{/* Corner plus marks — all four corners */}
					<svg
						width="10"
						height="10"
						viewBox="0 0 10 10"
						class="pointer-events-none absolute -top-[5.5px] -left-[5.5px] z-10"
						aria-hidden="true"
					>
						<line
							x1="0"
							y1="5"
							x2="10"
							y2="5"
							stroke-width="1"
							class="l-corner-stroke"
						/>
						<line
							x1="5"
							y1="0"
							x2="5"
							y2="10"
							stroke-width="1"
							class="l-corner-stroke"
						/>
					</svg>
					<svg
						width="10"
						height="10"
						viewBox="0 0 10 10"
						class="pointer-events-none absolute -top-[5.5px] -right-[5.5px] z-10"
						aria-hidden="true"
					>
						<line
							x1="0"
							y1="5"
							x2="10"
							y2="5"
							stroke-width="1"
							class="l-corner-stroke"
						/>
						<line
							x1="5"
							y1="0"
							x2="5"
							y2="10"
							stroke-width="1"
							class="l-corner-stroke"
						/>
					</svg>
					<svg
						width="10"
						height="10"
						viewBox="0 0 10 10"
						class="pointer-events-none absolute -bottom-[5.5px] -left-[5.5px] z-10"
						aria-hidden="true"
					>
						<line
							x1="0"
							y1="5"
							x2="10"
							y2="5"
							stroke-width="1"
							class="l-corner-stroke"
						/>
						<line
							x1="5"
							y1="0"
							x2="5"
							y2="10"
							stroke-width="1"
							class="l-corner-stroke"
						/>
					</svg>
					<svg
						width="10"
						height="10"
						viewBox="0 0 10 10"
						class="pointer-events-none absolute -right-[5.5px] -bottom-[5.5px] z-10"
						aria-hidden="true"
					>
						<line
							x1="0"
							y1="5"
							x2="10"
							y2="5"
							stroke-width="1"
							class="l-corner-stroke"
						/>
						<line
							x1="5"
							y1="0"
							x2="5"
							y2="10"
							stroke-width="1"
							class="l-corner-stroke"
						/>
					</svg>

					{/* Index */}
					<div
						class="mb-2.5 font-mono text-[11px] text-zinc-400 uppercase tabular-nums select-none dark:text-zinc-600"
						aria-hidden="true"
					>
						{String(i + 1).padStart(2, "0")}
					</div>

					{/* Stat value */}
					<p class="mb-1">
						<span class="stat-counter inline-flex items-baseline font-mono text-3xl leading-none font-medium -tracking-tight text-zinc-900 tabular-nums dark:text-white">
							<span
								class="stat-counter-value inline-block"
								data-target={stat.value}
								data-decimals={stat.value % 1 !== 0 ? "2" : "0"}
								style={`min-width: ${(stat.value % 1 !== 0 ? stat.value.toFixed(2) : String(stat.value)).length}ch;`}
							>
								{stat.value % 1 !== 0 ? stat.value.toFixed(2) : stat.value}
							</span>
							<span class="stat-counter-suffix">{stat.suffix}</span>
						</span>
					</p>

					{/* Unit */}
					<p class="text-accent mb-3 font-mono text-[12px] tracking-wide uppercase">
						{stat.unit}
					</p>

					{/* Label + detail */}
					<div class="border-t border-dashed border-[#e8e8e8] pt-3 dark:border-[#2a2a2a]">
						<div class="space-y-0.5">
							<p class="text-[15px] leading-snug font-medium text-pretty text-zinc-900 dark:text-zinc-50">
								{stat.label}
							</p>
							<p class="text-[13px] leading-snug text-pretty text-zinc-500 dark:text-zinc-400">
								{stat.detail}
							</p>
						</div>
					</div>
				</div>
			))
		}
	</div>
</section>

<script>
	function easeOutCubic(t: number): number {
		return 1 - Math.pow(1 - t, 3);
	}

	function animateCounter(el: HTMLElement) {
		if (el.dataset.animated === "true") return;

		const target = parseFloat(el.dataset.target ?? "0");
		const decimals = parseInt(el.dataset.decimals ?? "0", 10);
		const scale = 10 ** decimals;
		const targetScaled = Math.round(target * scale);
		const prefersReducedMotion = window.matchMedia(
			"(prefers-reduced-motion: reduce)",
		).matches;

		if (prefersReducedMotion) {
			el.textContent = target.toFixed(decimals);
			el.dataset.animated = "true";
			return;
		}

		const duration = 1250;
		const start = performance.now();
		let lastScaled = -1;

		function tick(now: number) {
			const elapsed = now - start;
			const progress = Math.min(elapsed / duration, 1);
			const eased = easeOutCubic(progress);
			const nextScaled = Math.min(
				targetScaled,
				Math.floor(targetScaled * eased),
			);

			if (nextScaled !== lastScaled) {
				el.textContent = (nextScaled / scale).toFixed(decimals);
				lastScaled = nextScaled;
			}

			if (progress < 1) {
				requestAnimationFrame(tick);
			} else {
				el.textContent = target.toFixed(decimals);
				el.dataset.animated = "true";
			}
		}

		requestAnimationFrame(tick);
	}

	function initPlatformStatsCounters() {
		const counters = document.querySelectorAll<HTMLElement>(
			".stat-counter-value",
		);

		if ("IntersectionObserver" in window) {
			const observer = new IntersectionObserver(
				(entries) => {
					entries.forEach((entry) => {
						if (entry.isIntersecting) {
							animateCounter(entry.target as HTMLElement);
							observer.unobserve(entry.target);
						}
					});
				},
				{ threshold: 0.35 },
			);
			counters.forEach((el) => observer.observe(el));
		} else {
			counters.forEach((el) => {
				const target = parseFloat(el.dataset.target ?? "0");
				const decimals = parseInt(el.dataset.decimals ?? "0", 10);
				el.textContent = target.toFixed(decimals);
				el.dataset.animated = "true";
			});
		}
	}

	initPlatformStatsCounters();
	if (
		!(window as Window & { __platformStatsCountersBound?: boolean })
			.__platformStatsCountersBound
	) {
		document.addEventListener("astro:page-load", initPlatformStatsCounters);
		(
			window as Window & { __platformStatsCountersBound?: boolean }
		).__platformStatsCountersBound = true;
	}
</script>
