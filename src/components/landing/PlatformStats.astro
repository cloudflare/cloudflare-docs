---
import CornerMarks from "./CornerMarks.astro";
import Eyebrow from "./Eyebrow.astro";
import { stagger } from "./constants";

const stats = [
	{
		value: 330,
		suffix: "+",
		unit: "cities",
		label: "Run everywhere",
		detail: "Around the world",
	},
	{
		value: 100,
		suffix: "+",
		unit: "products",
		label: "Powerful primitives",
		detail: "Seamlessly integrated",
	},
	{
		value: 81,
		suffix: "M+",
		unit: "HTTP requests/sec",
		label: "Run at massive scale",
		detail: "On Cloudflare's infrastructure",
	},
	{
		value: 20,
		suffix: "%",
		unit: "of the Internet",
		label: "Internet scale",
		detail: "1 in 5 sites on the Internet",
	},
];
---

<section
	id="platform"
	class={`pt-8 pb-8 lg:pt-10 lg:pb-12 ${stagger(0.42)}`}
	aria-labelledby="stats-heading"
>
	<Eyebrow id="stats-heading" class="mb-4">Platform at a Glance</Eyebrow>

	<div
		id="stats-grid"
		class="border-border-100 bg-border-100 relative grid grid-cols-2 gap-px overflow-visible border lg:grid-cols-4"
	>
		<CornerMarks />
		{
			stats.map((stat, i) => (
				<div class="stat-card bg-background relative flex flex-col px-4 py-4 transition-colors duration-150 sm:px-5 sm:py-5">
					<div
						class="text-foreground-subtle mb-2.5 font-mono text-[11px] uppercase tabular-nums select-none"
						aria-hidden="true"
					>
						{String(i + 1).padStart(2, "0")}
					</div>

					<p class="mb-1">
						<span class="stat-counter text-foreground inline-flex items-baseline font-mono text-3xl leading-none font-medium -tracking-tight tabular-nums">
							<span
								class="stat-counter-value inline-block"
								data-target={stat.value}
								data-decimals={stat.value % 1 !== 0 ? "2" : "0"}
								style={`min-width: ${(stat.value % 1 !== 0 ? stat.value.toFixed(2) : String(stat.value)).length}ch;`}
							>
								{stat.value % 1 !== 0 ? stat.value.toFixed(2) : stat.value}
							</span>
							<span class="stat-counter-suffix">{stat.suffix}</span>
						</span>
					</p>

					<p class="text-accent-100 stat-unit mb-3 min-h-[2.4em] font-mono text-[12px] tracking-wide text-balance uppercase">
						{stat.unit}
					</p>

					<div class="border-border-100 border-t border-dashed pt-3">
						<div class="space-y-0.5">
							<p class="text-foreground text-[15px] leading-snug font-medium text-balance">
								{stat.label}
							</p>
							<p class="text-foreground-muted text-[13px] leading-snug text-pretty">
								{stat.detail}
							</p>
						</div>
					</div>
				</div>
			))
		}
	</div>
</section>

<script>
	function easeOutCubic(t: number): number {
		return 1 - Math.pow(1 - t, 3);
	}

	function animateCounter(el: HTMLElement) {
		if (el.dataset.animated === "true") return;

		const target = parseFloat(el.dataset.target ?? "0");
		const decimals = parseInt(el.dataset.decimals ?? "0", 10);
		const scale = 10 ** decimals;
		const targetScaled = Math.round(target * scale);
		const prefersReducedMotion = window.matchMedia(
			"(prefers-reduced-motion: reduce)",
		).matches;

		if (prefersReducedMotion) {
			el.textContent = target.toFixed(decimals);
			el.dataset.animated = "true";
			return;
		}

		const duration = 1250;
		const start = performance.now();
		let lastScaled = -1;

		function tick(now: number) {
			const elapsed = now - start;
			const progress = Math.min(elapsed / duration, 1);
			const eased = easeOutCubic(progress);
			const nextScaled = Math.min(
				targetScaled,
				Math.floor(targetScaled * eased),
			);

			if (nextScaled !== lastScaled) {
				el.textContent = (nextScaled / scale).toFixed(decimals);
				lastScaled = nextScaled;
			}

			if (progress < 1) {
				requestAnimationFrame(tick);
			} else {
				el.textContent = target.toFixed(decimals);
				el.dataset.animated = "true";
			}
		}

		requestAnimationFrame(tick);
	}

	function initPlatformStatsCounters() {
		const counters = document.querySelectorAll<HTMLElement>(
			".stat-counter-value",
		);

		if ("IntersectionObserver" in window) {
			const observer = new IntersectionObserver(
				(entries) => {
					entries.forEach((entry) => {
						if (entry.isIntersecting) {
							animateCounter(entry.target as HTMLElement);
							observer.unobserve(entry.target);
						}
					});
				},
				{ threshold: 0.35 },
			);
			counters.forEach((el) => observer.observe(el));
		} else {
			counters.forEach((el) => {
				const target = parseFloat(el.dataset.target ?? "0");
				const decimals = parseInt(el.dataset.decimals ?? "0", 10);
				el.textContent = target.toFixed(decimals);
				el.dataset.animated = "true";
			});
		}
	}

	initPlatformStatsCounters();
	if (
		!(window as Window & { __platformStatsCountersBound?: boolean })
			.__platformStatsCountersBound
	) {
		document.addEventListener("astro:page-load", initPlatformStatsCounters);
		(
			window as Window & { __platformStatsCountersBound?: boolean }
		).__platformStatsCountersBound = true;
	}
</script>
