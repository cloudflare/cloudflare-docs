---
const products = [
	{
		name: "WAF",
		description:
			"Custom firewall rules, managed rulesets, and rate limiting. Block threats at the edge before they reach your origin.",
		detail: "Custom rules · Managed rulesets · Analytics",
		href: "/waf/",
	},
	{
		name: "Rate Limiting",
		description:
			"Protect APIs and pages from abuse. Configurable thresholds, fingerprinting, and response actions.",
		detail: "Per-IP · Per-session · Sliding window",
		href: "/waf/rate-limiting-rules/",
	},
	{
		name: "DDoS Protection",
		description:
			"Always-on, unmetered mitigation for L3–L7 attacks. Automatic detection with tunable sensitivity.",
		detail: "L3 · L4 · L7 · Unmetered",
		href: "/ddos-protection/",
	},
	{
		name: "Cloudflare Tunnel",
		description:
			"Expose private services to the internet without opening firewall ports. One command to create a secure outbound-only connection.",
		detail: "No inbound ports · Remote config · API",
		href: "/cloudflare-one/networks/connectors/cloudflare-tunnel/",
	},
	{
		name: "Access",
		description:
			"Zero Trust access control for any application. SSO, identity provider integration, and per-request policy enforcement.",
		detail: "SSO · IdP integrations · Policies",
		href: "/cloudflare-one/access-controls/policies/",
	},
	{
		name: "Gateway",
		description:
			"DNS, HTTP, and network filtering for your team's traffic. Block malware, phishing, and unwanted sites without a VPN.",
		detail: "DNS filtering · HTTP inspection · L4",
		href: "/cloudflare-one/traffic-policies/",
	},
	{
		name: "Bot Management",
		description:
			"Detect and block automated traffic. Behavioral analysis, challenge flows, and bot score APIs built into every request.",
		detail: "ML scoring · Challenge · JS detection",
		href: "/bots/",
	},
	{
		name: "Turnstile",
		description:
			"CAPTCHA-free bot detection for your frontend. Drop-in widget that challenges bots invisibly, never your users.",
		detail: "Invisible · Managed · Non-interactive",
		href: "/turnstile/",
	},
	{
		name: "SSL/TLS",
		description:
			"Universal SSL by default, with full control over cipher suites, certificate authorities, and origin authentication.",
		detail: "Universal · Advanced · mTLS · Origin CA",
		href: "/ssl/",
	},
];

const quickLinks = [
	{
		label: "Tunnel get started",
		href: "/cloudflare-one/networks/connectors/cloudflare-tunnel/get-started/create-remote-tunnel/",
	},
	{ label: "IP access rules", href: "/waf/tools/ip-access-rules/" },
	{
		label: "Turnstile troubleshooting",
		href: "/turnstile/troubleshooting/client-side-errors/error-codes/",
	},
	{ label: "WAF security events", href: "/waf/analytics/security-events/" },
	{ label: "Cloudflare One setup", href: "/cloudflare-one/setup/" },
	{ label: "WARP Client", href: "/warp-client/" },
];
---

<section
	class="px-4 pt-10 pb-12 lg:px-8 lg:pt-16"
	aria-labelledby="protect-heading"
>
	<!-- Section header -->
	<div
		class="mb-10 flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-end sm:gap-6"
	>
		<div>
			<div class="mb-3 flex items-center gap-2">
				<span
					class="text-accent font-mono text-[0.5625rem] tracking-[0.2em] uppercase"
				>
					Protect
				</span>
				<span class="bg-accent/40 h-px w-8"></span>
			</div>
			<h2
				id="protect-heading"
				class="text-[clamp(1.5rem,3vw,2rem)] leading-tight font-normal -tracking-[0.03em] text-[#18181b]"
			>
				Secure what you're building
			</h2>
			<p
				class="mt-3 max-w-[480px] text-[0.9375rem] leading-relaxed text-[#6b6b74]"
			>
				Layer security, access control, and bot protection onto any app or
				infrastructure — without re-architecting anything.
			</p>
		</div>
		<a
			href="/cloudflare-one/"
			class="hidden shrink-0 items-center gap-2 rounded-lg border border-black/10 bg-black/2 px-4 py-2 font-mono text-[0.625rem] tracking-widest text-[#6b6b74] uppercase no-underline transition-colors duration-100 hover:bg-black/5 hover:text-[#1a1a1e] sm:inline-flex"
		>
			Explore Zero Trust
			<svg
				width="10"
				height="10"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
			>
				<line x1="5" y1="12" x2="19" y2="12"></line>
				<polyline points="12 5 19 12 12 19"></polyline>
			</svg>
		</a>
	</div>

	<!-- Products list -->
	<div class="divide-y divide-black/6 overflow-hidden border border-black/6">
		{
			products.map((p) => (
				<a
					href={p.href}
					class="group focus-visible:outline-accent relative flex flex-col items-start gap-2 bg-white/90 px-4 py-4 text-inherit no-underline transition-colors duration-100 hover:bg-zinc-50 focus-visible:outline-2 focus-visible:-outline-offset-2 sm:flex-row sm:items-center sm:gap-6 sm:px-6 sm:py-5"
				>
					{/* Left accent reveal */}
					<span
						class="bg-accent pointer-events-none absolute top-0 left-0 h-0 w-[2px] transition-[height] duration-200 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:h-full"
						aria-hidden="true"
					/>

					{/* Product name */}
					<div class="w-auto shrink-0 sm:w-[140px]">
						<span class="text-[0.9375rem] leading-tight font-medium text-[#1a1a1e]">
							{p.name}
						</span>
					</div>

					{/* Description */}
					<p class="m-0 flex-1 text-[0.8125rem] leading-normal text-[#6b6b74]">
						{p.description}
					</p>

					{/* Detail tags */}
					<div class="hidden max-w-[200px] shrink-0 text-right font-mono text-[0.5625rem] leading-relaxed tracking-wide text-[#9b9ba4] lg:block">
						{p.detail}
					</div>

					{/* Arrow */}
					<div class="hidden shrink-0 -translate-x-1 items-center opacity-0 transition-[opacity,transform] duration-100 group-hover:translate-x-0 group-hover:opacity-100 sm:flex">
						<svg
							width="11"
							height="11"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2.5"
							stroke-linecap="round"
							stroke-linejoin="round"
							class="text-accent"
							aria-hidden="true"
						>
							<line x1="5" y1="12" x2="19" y2="12" />
							<polyline points="12 5 19 12 12 19" />
						</svg>
					</div>
				</a>
			))
		}
	</div>

	<!-- Quick links footer -->
	<div class="mt-4 flex flex-wrap items-center gap-2">
		<span
			class="mr-1 font-mono text-[0.5rem] tracking-[0.2em] text-[#9b9ba4] uppercase"
			>Also:</span
		>
		{
			quickLinks.map((l) => (
				<a
					href={l.href}
					class="hover:text-accent hover:border-accent border-b border-dashed border-black/15 pb-px font-mono text-[0.5625rem] tracking-wide text-[#6b6b74] no-underline transition-colors duration-100"
				>
					{l.label}
				</a>
			))
		}
	</div>
</section>
