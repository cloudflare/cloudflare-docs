---
import { Icon } from "@astrojs/starlight/components";
import { stagger } from "./constants";
---

<section id="hero" class="pb-16 max-[900px]:pb-12 md:pt-6">
	<h1
		class={`text-[clamp(2.75rem,5vw,3.5rem)] font-medium -tracking-[0.04em] leading-[1.05] text-balance mb-4 text-primary dark:text-white ${stagger(0.05)}`}
	>
		Cloudflare Developer Docs
	</h1>

	<p
		class={`text-lg text-pretty max-w-[480px] leading-relaxed mb-8 max-[480px]:text-base max-[480px]:mb-6 text-[#52525b] dark:text-[#a1a1aa] ${stagger(0.1)}`}
	>
		Connect to or build on the Cloudflare network. Make your apps, agents,
		employees, and networks fast and secure
	</p>

	<div
		class={`flex items-center gap-5 text-sm max-[480px]:flex-wrap max-[480px]:gap-3 ${stagger(0.16)}`}
	>
		<a
			href="/fundamentals"
			class="focus-visible:outline-accent inline-flex h-10 shrink-0 cursor-pointer items-center gap-2 rounded-lg rounded-md bg-[#18181b] px-4 text-base font-medium whitespace-nowrap text-white no-underline transition-colors duration-150 hover:bg-[#f56500] hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 max-[480px]:h-9 max-[480px]:px-3 max-[480px]:text-sm dark:bg-[#fafafa] dark:text-[#09090b] dark:hover:bg-[#e4e4e7] dark:hover:text-[#09090b]"
		>
			Get started
			<Icon name="right-arrow" size="0.75rem" />
		</a>
		<span
			class="h-4 w-px bg-black/10 max-[480px]:hidden dark:bg-white/10"
			aria-hidden="true"></span>
		<a
			href="#build"
			class="focus-visible:outline-accent cursor-pointer text-[#52525b] no-underline transition-colors duration-150 hover:text-[#f56500] focus-visible:outline-2 focus-visible:outline-offset-2 dark:text-[#d4d4d8] dark:hover:text-[#f56500]"
		>
			Build
		</a>
		<a
			href="#secure"
			class="focus-visible:outline-accent cursor-pointer text-[#52525b] no-underline transition-colors duration-150 hover:text-[#f56500] focus-visible:outline-2 focus-visible:outline-offset-2 dark:text-[#d4d4d8] dark:hover:text-[#f56500]"
		>
			Secure
		</a>
		<a
			href="#accelerate"
			class="focus-visible:outline-accent cursor-pointer text-[#52525b] no-underline transition-colors duration-150 hover:text-[#f56500] focus-visible:outline-2 focus-visible:outline-offset-2 dark:text-[#d4d4d8] dark:hover:text-[#f56500]"
		>
			Accelerate
		</a>
		<a
			href="#changelog"
			class="focus-visible:outline-accent cursor-pointer text-[#52525b] no-underline transition-colors duration-150 hover:text-[#f56500] focus-visible:outline-2 focus-visible:outline-offset-2 max-[480px]:hidden dark:text-[#d4d4d8] dark:hover:text-[#f56500]"
		>
			Changelog
		</a>
	</div>
</section>
