---
import { Icon } from "@astrojs/starlight/components";
import { stagger } from "./constants";
import Button from "./Button.astro";

interface Anchor {
	href: string;
	label: string;
	hideMobile?: boolean;
}

const anchors: Anchor[] = [
	{ href: "#build", label: "Build" },
	{ href: "#agent-setup", label: "Agent Setup" },
	{ href: "#secure", label: "Secure" },
	{ href: "#accelerate", label: "Accelerate" },
	{ href: "#changelog", label: "Changelog", hideMobile: true },
];

const anchorClass =
	"focus-visible:outline-accent-100 text-foreground-muted hover:text-foreground cursor-pointer text-base no-underline hover:underline hover:underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-2";
---

<section id="hero" class="pb-12 md:pt-6 lg:pb-16">
	<h1
		class={`text-[clamp(2.75rem,5vw,3.5rem)] font-medium text-balance mb-4 text-foreground ${stagger(0.05)}`}
	>
		Cloudflare Developer Docs
	</h1>

	<p
		class={`text-base text-pretty max-w-[480px] leading-relaxed mb-6 sm:text-lg sm:mb-8 text-foreground-muted ${stagger(0.1)}`}
	>
		Compute, storage, AI, and security — ship applications instead of managing
		and securing infrastructure
	</p>

	<div
		class={`flex flex-wrap items-center gap-x-5 gap-y-3 text-sm lg:flex-nowrap ${stagger(0.16)}`}
	>
		<Button href="/fundamentals/" variant="primary" size="md">
			<span class="inline-flex items-center gap-2 text-base font-medium">
				Get started
				<Icon name="right-arrow" size="1rem" />
			</span>
		</Button>

		<span class="bg-border-100 hidden h-4 w-px sm:block" aria-hidden="true"
		></span>

		{
			anchors.map((a) => (
				<a
					href={a.href}
					class:list={[anchorClass, a.hideMobile && "hidden sm:inline"]}
				>
					{a.label}
				</a>
			))
		}
	</div>
</section>
