---
import { Icon } from "@astrojs/starlight/components";
import { stagger } from "./constants";
---

<section id="hero" class="pb-12 md:pt-6 lg:pb-16">
	<h1
		class={`text-[clamp(2.75rem,5vw,3.5rem)] font-medium -tracking-[0.04em] leading-[1.05] text-balance mb-4 text-primary dark:text-white ${stagger(0.05)}`}
	>
		Cloudflare Developer Docs
	</h1>

	<p
		class={`text-base text-pretty max-w-[480px] leading-relaxed mb-6 sm:text-lg sm:mb-8 text-[#52525b] dark:text-[#a1a1aa] ${stagger(0.1)}`}
	>
		Compute, storage, AI, and security — ship applications instead of managing
		and securing infrastructure
	</p>

	<div
		class={`flex flex-wrap items-center gap-3 text-sm sm:flex-nowrap sm:gap-5 ${stagger(0.16)}`}
	>
		<a
			href="/fundamentals"
			class="focus-visible:outline-accent inline-flex h-9 shrink-0 cursor-pointer items-center gap-2 rounded-lg rounded-md bg-[#18181b] px-3 text-sm font-medium whitespace-nowrap text-white no-underline transition-colors duration-150 hover:bg-[#f56500] hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 sm:h-10 sm:px-4 sm:text-base dark:bg-[#fafafa] dark:text-[#09090b] dark:hover:bg-[#e4e4e7] dark:hover:text-[#09090b]"
		>
			Get started
			<Icon name="right-arrow" size="0.75rem" />
		</a>
		<span
			class="hidden h-4 w-px bg-black/10 sm:block dark:bg-white/10"
			aria-hidden="true"></span>
		<a
			href="#build"
			class="focus-visible:outline-accent cursor-pointer text-[#52525b] no-underline hover:underline hover:underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-2 dark:text-[#d4d4d8]"
		>
			Build
		</a>
		<a
			href="#secure"
			class="focus-visible:outline-accent cursor-pointer text-[#52525b] no-underline hover:underline hover:underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-2 dark:text-[#d4d4d8]"
		>
			Secure
		</a>
		<a
			href="#accelerate"
			class="focus-visible:outline-accent cursor-pointer text-[#52525b] no-underline hover:underline hover:underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-2 dark:text-[#d4d4d8]"
		>
			Accelerate
		</a>
		<a
			href="#changelog"
			class="focus-visible:outline-accent hidden cursor-pointer text-[#52525b] no-underline hover:underline hover:underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-2 sm:inline dark:text-[#d4d4d8]"
		>
			Changelog
		</a>
	</div>
</section>
