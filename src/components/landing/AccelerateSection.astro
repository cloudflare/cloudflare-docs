---
import { Icon } from "astro-icon/components";
import ProductCard from "./ProductCard.astro";
import ProductCardGrid from "./ProductCardGrid.astro";

const phases = [
	{
		id: "dns",
		phase: "DNS Lookup",
		before: { offset: 0, width: 8.33 },
		after: { offset: 0, width: 0.46 },
		product: "DNS",
		icon: "dns",
		href: "/dns/",
		outcome: "Resolve DNS in single-digit milliseconds",
		detail:
			"Fastest authoritative DNS — 11ms average. DNSSEC, wildcard records, proxy control.",
		cta: "Optimize DNS performance",
		tags: ["Authoritative DNS", "DNSSEC"],
		color: "bg-orange-400",
		colorMuted: "bg-orange-400/20",
	},
	{
		id: "connect",
		phase: "TCP + TLS",
		before: { offset: 8.33, width: 16.67 },
		after: { offset: 0.46, width: 2.04 },
		product: "Argo Smart Routing",
		icon: "argo-smart-routing",
		href: "/argo-smart-routing/",
		outcome: "Route around congestion automatically",
		detail:
			"Real-time network intelligence — typically 30% faster than public internet.",
		cta: "Turn on Argo Smart Routing",
		tags: ["Smart Routing", "Tiered Caching"],
		color: "bg-amber-500",
		colorMuted: "bg-amber-500/20",
	},
	{
		id: "wait",
		phase: "Server Wait (TTFB)",
		before: { offset: 25, width: 20.83 },
		after: { offset: 2.5, width: 0.21 },
		product: "Cache",
		icon: "cache",
		href: "/cache/get-started/",
		outcome: "Serve from cache, not from origin",
		detail: "Serve from 330+ cities. Cache Rules, tiered caching, purge API.",
		cta: "Improve cache hit ratio",
		tags: ["Cache Rules", "Tiered Cache", "Cache Reserve"],
		color: "bg-yellow-500",
		colorMuted: "bg-yellow-500/20",
	},
	{
		id: "db",
		phase: "Database Query",
		before: { offset: 37.5, width: 58.33 },
		after: { offset: 2.71, width: 9.71 },
		product: "Hyperdrive",
		icon: "hyperdrive",
		href: "/hyperdrive/",
		outcome: "Make database queries feel local",
		detail:
			"Connection pooling and query caching globally. Slash query latency for Postgres, MySQL, and more.",
		cta: "Speed up database queries",
		tags: ["Connection Pooling", "Query Caching"],
		color: "bg-lime-500",
		colorMuted: "bg-lime-500/20",
	},
	{
		id: "assets",
		phase: "Asset Optimization",
		before: { offset: 25, width: 11.25 },
		after: { offset: 2.5, width: 5.83 },
		product: "Images",
		icon: "images",
		href: "/images/",
		outcome: "Transform and serve images globally",
		detail:
			"Resize, convert to modern formats, and deliver from 330+ cities. No origin round-trip.",
		cta: "Optimize image delivery",
		tags: ["Transform", "Polish", "WebP/AVIF"],
		color: "bg-teal-500",
		colorMuted: "bg-teal-500/20",
	},
	{
		id: "scripts",
		phase: "Third-party Scripts",
		before: { offset: 37.5, width: 20.83 },
		after: { offset: 12.42, width: 0 },
		product: "Zaraz",
		icon: "zaraz",
		href: "/zaraz/",
		outcome: "Move third-party scripts off the main thread",
		detail:
			"Load analytics, ads, and pixels server-side. Fewer network requests, faster page loads.",
		cta: "Move scripts with Zaraz",
		tags: ["Server-side Tags", "Consent Mgmt"],
		color: "bg-sky-500",
		colorMuted: "bg-sky-500/20",
	},
];
---

<section
	class="pt-10 pb-10"
	aria-labelledby="accelerate-heading"
	id="accelerate"
>
	<!-- Section header -->
	<div class="mb-3">
		<span class="text-accent font-mono text-xs tracking-widest uppercase"
			>Accelerate</span
		>
	</div>
	<h2
		id="accelerate-heading"
		class="mb-2 text-2xl leading-[1.1] font-medium -tracking-[0.035em] text-balance text-zinc-900 md:text-3xl dark:text-zinc-50"
	>
		See where the milliseconds go
	</h2>
	<p
		class="mb-6 text-sm leading-relaxed text-pretty text-zinc-500 md:text-lg dark:text-zinc-400"
	>
		Every request is a waterfall of latency. Hover a phase to see which product
		eliminates it, and toggle to see the compound effect.
	</p>

	<!-- Toggle: Without / With Cloudflare -->
	<div
		class="mb-5 flex flex-wrap items-center justify-between gap-4 max-[600px]:gap-3"
		role="radiogroup"
		aria-label="Comparison mode"
	>
		<div
			class="wf-toggle-track relative inline-flex rounded-lg border border-zinc-200 bg-zinc-100 p-1 dark:border-[#2a2a2a] dark:bg-zinc-800/80"
		>
			<span
				id="wf-toggle-slider"
				class="wf-toggle-slider absolute top-1 bottom-1 left-1 rounded-lg transition-[left,width,background-color] duration-300 ease-[cubic-bezier(0.16,1,0.3,1)]"
				aria-hidden="true"></span>
			<button
				type="button"
				id="wf-toggle-after"
				role="radio"
				aria-checked="true"
				tabindex="0"
				class="wf-toggle-btn wf-toggle-active focus-visible:outline-accent relative z-10 flex min-h-[40px] cursor-pointer items-center gap-2 rounded-lg px-4 py-2 text-sm font-medium transition-colors duration-200 focus-visible:outline-2 focus-visible:-outline-offset-2 max-[600px]:px-2.5"
			>
				<span
					class="wf-toggle-dot size-2 shrink-0 rounded-full transition-colors duration-200"
					aria-hidden="true"></span>
				With Cloudflare
			</button>
			<button
				type="button"
				id="wf-toggle-before"
				role="radio"
				aria-checked="false"
				tabindex="-1"
				class="wf-toggle-btn focus-visible:outline-accent relative z-10 flex min-h-[40px] cursor-pointer items-center gap-2 rounded-lg px-4 py-2 text-sm font-medium transition-colors duration-200 focus-visible:outline-2 focus-visible:-outline-offset-2 max-[600px]:px-2.5"
			>
				<span
					class="wf-toggle-dot size-2 shrink-0 rounded-full transition-colors duration-200"
					aria-hidden="true"></span>
				Without Cloudflare
			</button>
		</div>
		<div
			class="wf-total-label flex items-baseline gap-2 font-mono text-xs text-zinc-500 tabular-nums transition-opacity duration-300 dark:text-zinc-400"
		>
			<span class="tracking-widest uppercase">Total</span>
			<span
				id="wf-total-value"
				class="font-medium text-zinc-900 tabular-nums dark:text-zinc-100"
				>~300 ms</span
			>
		</div>
	</div>

	<!-- Main waterfall container -->
	<div
		class="relative overflow-visible border border-zinc-200 dark:border-[#2a2a2a]"
	>
		<!-- Corner plus marks -->
		{
			[
				"-top-[5.5px] -left-[5.5px]",
				"-top-[5.5px] -right-[5.5px]",
				"-bottom-[5.5px] -left-[5.5px]",
				"-right-[5.5px] -bottom-[5.5px]",
			].map((pos) => (
				<svg
					width="10"
					height="10"
					viewBox="0 0 10 10"
					class={`pointer-events-none absolute ${pos} z-10`}
					aria-hidden="true"
				>
					<line
						x1="0"
						y1="5"
						x2="10"
						y2="5"
						stroke-width="1"
						class="l-corner-stroke"
					/>
					<line
						x1="5"
						y1="0"
						x2="5"
						y2="10"
						stroke-width="1"
						class="l-corner-stroke"
					/>
				</svg>
			))
		}

		<!-- Timescale ruler — uses the same grid as waterfall rows so ticks align with bars -->
		<div
			class="bg-l-card dark:bg-l-card-dark grid h-7 items-end gap-4 border-b border-zinc-200 px-5 max-[600px]:hidden dark:border-[#2a2a2a]"
			style="grid-template-columns: minmax(220px, 1.1fr) minmax(0, 3fr) auto;"
			aria-hidden="true"
		>
			<div></div>
			<div class="relative h-full">
				{
					[0, 400, 800, 1200, 1600, 2000].map((ms) => (
						<div
							class="absolute bottom-0 flex flex-col items-center"
							style={`left: ${(ms / 2400) * 100}%`}
						>
							<span
								class="wf-ruler-label mb-1 font-mono text-[9px] tracking-wider text-zinc-400 tabular-nums dark:text-zinc-500"
								data-ms={ms}
							>
								{ms === 0 ? "0" : `${ms}ms`}
							</span>
							<span class="h-1.5 w-px bg-zinc-200 dark:bg-zinc-700" />
						</div>
					))
				}
			</div>
			<div></div>
		</div>

		<!-- Waterfall rows -->
		{
			phases.map((p, i) => (
				<a
					href={p.href}
					class:list={[
						"wf-row group relative grid items-center gap-4 px-5 py-3 no-underline transition-colors duration-150",
						"bg-l-card hover:bg-l-card-hover dark:bg-l-card-dark dark:hover:bg-l-card-hover-dark",
						"focus-visible:outline-accent focus-visible:outline-2 focus-visible:-outline-offset-2",
						"max-[600px]:grid-cols-[1fr] max-[600px]:gap-2 max-[600px]:px-3 max-[600px]:py-3",
						i > 0 && "border-t border-zinc-200 dark:border-[#2a2a2a]",
					]}
					style="grid-template-columns: minmax(220px, 1.1fr) minmax(0, 3fr) auto;"
					data-phase={p.id}
				>
					{/* Accent bar — bottom reveal on hover */}
					<span
						class="bg-accent pointer-events-none absolute bottom-0 left-0 h-px w-0 transition-[width] duration-200 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:w-full"
						aria-hidden="true"
					/>

					{/* Left: phase name + product */}
					<div class="flex min-w-0 items-center gap-3 max-[600px]:gap-2">
						<span class="group-hover:border-accent/30 group-hover:bg-accent/5 group-hover:text-accent flex size-8 shrink-0 items-center justify-center rounded border border-zinc-200 bg-zinc-100 text-zinc-400 transition-colors duration-150 dark:border-[#2a2a2a] dark:bg-zinc-800 dark:text-zinc-500">
							<Icon name={p.icon} size="16px" />
						</span>
						<div class="min-w-0">
							<p class="text-sm leading-tight font-medium text-zinc-800 dark:text-zinc-100">
								{p.phase}
							</p>
							<p class="wf-product-label text-accent font-mono text-[11px] tracking-widest uppercase opacity-100 transition-opacity duration-300">
								{p.product}
							</p>
						</div>
					</div>

					{/* Center: waterfall bar visualization */}
					<div class="relative h-6 max-[600px]:h-5" aria-hidden="true">
						{/* Background track */}
						<div class="absolute inset-0 rounded-sm bg-zinc-100 dark:bg-zinc-800/50" />

						{/* "Before" bar (slow) */}
						<div
							class={`wf-bar wf-bar-before absolute top-1 bottom-1 rounded-sm transition-[left,width,box-shadow] duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] ${p.color}`}
							style={`left: ${p.after.offset}%; width: ${p.after.width}%;`}
							data-offset-before={p.before.offset}
							data-width-before={p.before.width}
							data-offset-after={p.after.offset}
							data-width-after={p.after.width}
						>
							<span class="wf-bar-label absolute top-1/2 right-1.5 -translate-y-1/2 font-mono text-[9px] font-medium whitespace-nowrap text-white/90 tabular-nums drop-shadow-sm max-[456px]:hidden">
								{Math.round(p.after.width * 24)}ms
							</span>
						</div>

						{/* Time markers (vertical dashed lines) */}
						{[25, 50, 75].map((pct) => (
							<div
								class="absolute top-0 bottom-0 border-l border-dashed border-zinc-200/60 dark:border-zinc-700/40"
								style={`left: ${pct}%`}
							/>
						))}
					</div>

					{/* Right: arrow */}
					<div class="group-hover:text-accent flex items-center text-zinc-300 transition-colors duration-150 max-[600px]:hidden dark:text-zinc-600">
						<svg
							width="14"
							height="14"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="1.5"
							stroke-linecap="round"
							stroke-linejoin="round"
							class="transition-transform duration-150 group-hover:translate-x-0.5"
							aria-hidden="true"
						>
							<line x1="5" y1="12" x2="19" y2="12" />
							<polyline points="12 5 19 12 12 19" />
						</svg>
					</div>
				</a>
			))
		}

		<!-- Total bar / savings summary row -->
		<div
			class="wf-summary bg-l-card dark:bg-l-card-dark border-t border-zinc-200 px-5 py-3 dark:border-[#2a2a2a]"
			aria-live="polite"
		>
			<div class="flex items-center justify-between gap-4">
				{
					/* Left: label + bar — same mono, uppercase, muted grey as the top "Total" label */
				}
				<div
					class="flex items-center gap-3 font-mono text-xs text-zinc-500 tabular-nums dark:text-zinc-400"
				>
					<span class="tracking-widest uppercase">Total latency</span>
					<div
						class="relative h-1.5 w-48 overflow-hidden rounded-full bg-zinc-100 max-[600px]:w-28 dark:bg-zinc-800/60"
						role="presentation"
					>
						<div
							id="wf-total-bar"
							class="bg-accent absolute inset-y-0 left-0 rounded-full transition-[width] duration-700 ease-[cubic-bezier(0.16,1,0.3,1)]"
							style="width: 12%;"
						>
						</div>
					</div>
				</div>

				{
					/* Right: savings — mirrors the top's `TOTAL ~300 ms` label+value rhythm */
				}
				<div
					id="wf-savings-group"
					class="flex items-baseline gap-2 font-mono text-xs text-zinc-500 tabular-nums transition-opacity duration-300 max-[500px]:hidden dark:text-zinc-400"
				>
					<span class="tracking-widest uppercase">Savings</span>
					<span
						id="wf-savings-badge"
						class="font-medium text-zinc-900 tabular-nums dark:text-zinc-100"
					>
						87% faster
					</span>
				</div>
			</div>
		</div>
	</div>

	<!-- Section bridge — connects waterfall to product cards -->
	<h3
		class="not-content mb-6 pt-12 text-lg font-medium -tracking-tight text-zinc-900 dark:text-zinc-100"
	>
		Explore by product
	</h3>

	<!-- Product detail cards -->
	<ProductCardGrid>
		{
			phases.map((p) => (
				<div
					class="wf-product-card flex transition-[background-color] duration-200"
					data-phase={p.id}
				>
					<ProductCard
						icon={p.icon}
						product={p.product}
						scenario={p.outcome}
						detail={p.detail}
						href={p.href}
						cta={p.cta}
					/>
				</div>
			))
		}
	</ProductCardGrid>
</section>

<style>
	/* Sliding background indicator */
	.wf-toggle-slider {
		background: white;
		box-shadow:
			inset 0 0 0 1px rgba(0, 0, 0, 0.06),
			0 1px 2px rgba(0, 0, 0, 0.08);
	}
	:root[data-theme="dark"] .wf-toggle-slider {
		background: #2a2a2a;
		box-shadow:
			inset 0 0 0 1px rgba(255, 255, 255, 0.06),
			0 1px 2px rgba(0, 0, 0, 0.3);
	}

	/* Toggle button states */
	.wf-toggle-btn {
		color: var(--color-zinc-500, #71717a);
		background: transparent;
	}
	:root[data-theme="dark"] .wf-toggle-btn {
		color: #71717a;
	}
	.wf-toggle-btn .wf-toggle-dot {
		background-color: var(--color-zinc-300, #d4d4d8);
	}
	:root[data-theme="dark"] .wf-toggle-btn .wf-toggle-dot {
		background-color: #52525b;
	}
	.wf-toggle-btn.wf-toggle-active {
		color: var(--color-zinc-900, #18181b);
	}
	:root[data-theme="dark"] .wf-toggle-btn.wf-toggle-active {
		color: var(--color-zinc-100, #f4f4f5);
	}
	/* Only the "With Cloudflare" button gets the accent dot */
	#wf-toggle-after.wf-toggle-active .wf-toggle-dot {
		background-color: color-mix(in srgb, white 88%, transparent);
	}
	#wf-toggle-after.wf-toggle-active {
		background: var(--color-accent, #f56500);
		color: white;
		box-shadow:
			inset 0 0 0 1px rgba(0, 0, 0, 0.12),
			0 1px 2px rgba(0, 0, 0, 0.1);
	}
	#wf-toggle-before.wf-toggle-active .wf-toggle-dot {
		background-color: var(--color-zinc-500, #71717a);
	}
	:root[data-theme="dark"] #wf-toggle-before.wf-toggle-active .wf-toggle-dot {
		background-color: #a1a1aa;
	}

	/* Waterfall row highlight when hovered — also highlights the matching product card */
	.wf-row[data-highlighted="true"] {
		background: color-mix(in srgb, var(--color-accent, #f56500) 3%, white);
	}
	:root[data-theme="dark"] .wf-row[data-highlighted="true"] {
		background: color-mix(in srgb, var(--color-accent, #f56500) 5%, #1d1d1d);
	}

	.wf-product-card:hover,
	.wf-product-card[data-highlighted="true"] {
		background: color-mix(in srgb, var(--color-accent, #f56500) 3%, white);
	}
	:root[data-theme="dark"] .wf-product-card:hover,
	:root[data-theme="dark"] .wf-product-card[data-highlighted="true"] {
		background: color-mix(in srgb, var(--color-accent, #f56500) 5%, #1d1d1d);
	}

	:global(.wf-product-card .pc-icon-shell) {
		border-style: solid;
	}
	:global(.wf-product-card[data-highlighted="true"] .pc-icon-shell) {
		background: var(--pc-hover-bg, rgba(245, 101, 0, 0.1));
		border-color: var(--pc-hover-color, #f56500);
		border-style: dashed;
		color: var(--pc-hover-color, #f56500);
	}
	:global(
		:root[data-theme="dark"]
			.wf-product-card[data-highlighted="true"]
			.pc-icon-shell
	) {
		background: var(--pc-hover-bg-dark, rgba(245, 101, 0, 0.16));
		border-color: var(--pc-hover-color, #f56500);
		color: var(--pc-hover-color, #f56500);
	}

	/* Bar label visibility — hide label if bar is too narrow */
	.wf-bar .wf-bar-label {
		opacity: 1;
		transition: opacity 0.3s ease;
	}

	/* Pulse on the bar when entering "after" state */
	.wf-bar.wf-bar-shrunk {
		animation: wf-shrink-pulse 0.6s ease-out;
	}

	@keyframes wf-shrink-pulse {
		0% {
			box-shadow: 0 0 0 0
				color-mix(in srgb, var(--color-accent, #f56500) 30%, transparent);
		}
		70% {
			box-shadow: 0 0 0 4px
				color-mix(in srgb, var(--color-accent, #f56500) 0%, transparent);
		}
		100% {
			box-shadow: 0 0 0 0
				color-mix(in srgb, var(--color-accent, #f56500) 0%, transparent);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.wf-bar {
			transition-duration: 0.01ms !important;
		}
		.wf-bar.wf-bar-shrunk {
			animation: none !important;
		}
	}

	/* Responsive: on mobile, switch waterfall row to stacked layout */
	@media (max-width: 600px) {
		.wf-row {
			grid-template-columns: 1fr !important;
		}
	}
</style>

<script>
	function initWaterfall() {
		const section = document.getElementById("accelerate");
		if (!section) return;
		const prefersReducedMotion = window.matchMedia(
			"(prefers-reduced-motion: reduce)",
		).matches;

		// Guard against double-init
		if (section.dataset.wfInit === "true") return;
		section.dataset.wfInit = "true";

		const btnBefore = section.querySelector(
			"#wf-toggle-before",
		) as HTMLButtonElement | null;
		const btnAfter = section.querySelector(
			"#wf-toggle-after",
		) as HTMLButtonElement | null;
		const slider = section.querySelector(
			"#wf-toggle-slider",
		) as HTMLElement | null;
		const totalValue = section.querySelector(
			"#wf-total-value",
		) as HTMLElement | null;
		const totalBar = section.querySelector(
			"#wf-total-bar",
		) as HTMLElement | null;
		const savingsBadge = section.querySelector(
			"#wf-savings-badge",
		) as HTMLElement | null;
		const savingsGroup = section.querySelector(
			"#wf-savings-group",
		) as HTMLElement | null;
		const bars = section.querySelectorAll<HTMLElement>(".wf-bar-before");
		const productLabels =
			section.querySelectorAll<HTMLElement>(".wf-product-label");
		const rows = section.querySelectorAll<HTMLElement>(".wf-row");
		const cards = section.querySelectorAll<HTMLElement>(".wf-product-card");

		let isAfter = true;

		/** Position the sliding indicator behind the active button */
		function positionSlider(activeBtn: HTMLElement | null) {
			if (!slider || !activeBtn) return;
			const track = slider.parentElement;
			if (!track) return;
			const trackRect = track.getBoundingClientRect();
			const btnRect = activeBtn.getBoundingClientRect();
			slider.style.left = `${btnRect.left - trackRect.left}px`;
			slider.style.width = `${btnRect.width}px`;
		}

		// Set initial slider position
		requestAnimationFrame(() => positionSlider(btnAfter));

		function setMode(after: boolean) {
			isAfter = after;

			// Update toggle buttons
			if (btnBefore && btnAfter) {
				btnBefore.classList.toggle("wf-toggle-active", !after);
				btnAfter.classList.toggle("wf-toggle-active", after);
				btnBefore.setAttribute("aria-checked", String(!after));
				btnAfter.setAttribute("aria-checked", String(after));
				btnBefore.setAttribute("tabindex", after ? "-1" : "0");
				btnAfter.setAttribute("tabindex", after ? "0" : "-1");
				positionSlider(after ? btnAfter : btnBefore);
			}

			// Show product names only in "With Cloudflare" state
			productLabels.forEach((label) => {
				if (after) {
					label.style.display = "block";
					label.style.opacity = "1";
				} else {
					label.style.display = "none";
					label.style.opacity = "0";
				}
			});

			// Animate bars
			bars.forEach((bar) => {
				const offset = after
					? bar.dataset.offsetAfter
					: bar.dataset.offsetBefore;
				const width = after ? bar.dataset.widthAfter : bar.dataset.widthBefore;
				bar.style.left = `${offset}%`;
				bar.style.width = `${width}%`;

				// Update label text
				const label = bar.querySelector(".wf-bar-label");
				if (label && width) {
					const ms = Math.round(parseFloat(width) * 24);
					label.textContent = `${ms}ms`;
					// Hide label if bar too narrow
					(label as HTMLElement).style.opacity =
						parseFloat(width) < 6 ? "0" : "1";
				}

				// Pulse effect on shrink
				if (after && !prefersReducedMotion) {
					bar.classList.remove("wf-bar-shrunk");
					void bar.offsetWidth; // force reflow
					bar.classList.add("wf-bar-shrunk");
				} else {
					bar.classList.remove("wf-bar-shrunk");
				}
			});

			// Update total bar + label
			if (totalBar) {
				totalBar.style.width = after ? "12%" : "96%";
			}
			if (totalValue) {
				totalValue.textContent = after ? "~300 ms" : "~2,300 ms";
			}
			if (savingsBadge) {
				savingsBadge.textContent = "87% faster";
			}
			if (savingsGroup) {
				savingsGroup.classList.toggle("hidden", !after);
			}
		}

		const onBeforeClick = () => setMode(false);
		const onAfterClick = () => setMode(true);
		btnBefore?.addEventListener("click", onBeforeClick);
		btnAfter?.addEventListener("click", onAfterClick);

		const onToggleKeyDown = (event: KeyboardEvent) => {
			if (!btnBefore || !btnAfter) return;
			const radios = [btnAfter, btnBefore];
			const currentIndex = isAfter ? 0 : 1;
			let nextIndex = currentIndex;

			switch (event.key) {
				case "ArrowRight":
				case "ArrowDown":
					nextIndex = (currentIndex + 1) % radios.length;
					break;
				case "ArrowLeft":
				case "ArrowUp":
					nextIndex = (currentIndex - 1 + radios.length) % radios.length;
					break;
				case "Home":
					nextIndex = 0;
					break;
				case "End":
					nextIndex = radios.length - 1;
					break;
				default:
					return;
			}

			event.preventDefault();
			setMode(nextIndex === 0);
			radios[nextIndex].focus();
		};

		btnBefore?.addEventListener("keydown", onToggleKeyDown);
		btnAfter?.addEventListener("keydown", onToggleKeyDown);

		setMode(true);

		// Cross-highlight: hovering a waterfall row highlights the matching product card and vice versa
		function highlightPhase(phaseId: string | null) {
			rows.forEach((row) => {
				const match = row.dataset.phase === phaseId;
				row.setAttribute("data-highlighted", String(match && phaseId !== null));
			});
			cards.forEach((card) => {
				const match = card.dataset.phase === phaseId;
				card.setAttribute(
					"data-highlighted",
					String(match && phaseId !== null),
				);
			});
		}

		rows.forEach((row) => {
			row.addEventListener("mouseenter", () =>
				highlightPhase(row.dataset.phase ?? null),
			);
			row.addEventListener("mouseleave", () => highlightPhase(null));
		});
		cards.forEach((card) => {
			card.addEventListener("mouseenter", () =>
				highlightPhase(card.dataset.phase ?? null),
			);
			card.addEventListener("mouseleave", () => highlightPhase(null));
		});

		// Re-position slider on resize
		const onResize = () => positionSlider(isAfter ? btnAfter : btnBefore);
		window.addEventListener("resize", onResize);

		// Cleanup on page leave (for Astro view transitions)
		document.addEventListener(
			"astro:before-swap",
			() => {
				window.removeEventListener("resize", onResize);
				btnBefore?.removeEventListener("click", onBeforeClick);
				btnAfter?.removeEventListener("click", onAfterClick);
				btnBefore?.removeEventListener("keydown", onToggleKeyDown);
				btnAfter?.removeEventListener("keydown", onToggleKeyDown);
			},
			{ once: true },
		);
	}

	// Initialize on both DOMContentLoaded and astro:page-load to cover all scenarios
	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", initWaterfall);
	} else {
		initWaterfall();
	}
	document.addEventListener("astro:page-load", initWaterfall);
</script>
