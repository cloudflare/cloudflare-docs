---
import ProductCard from "./ProductCard.astro";
import ProductCardGrid from "./ProductCardGrid.astro";
import SectionHeading from "./SectionHeading.astro";
import ViewAllLink from "./ViewAllLink.astro";
import Waterfall from "./Waterfall.astro";
import { phases, phaseColor } from "./accelerate-data";

// Cross-highlight rules: hovering a waterfall row tints the matching product
// card icon shell, and vice-versa. Both halves expose a `[data-phase]`
// attribute and an inline `--phase-color` so a single `:has()` selector
// rooted at `.wf-section` can wire them together.
const rowSelectors = phases
	.map(
		(p) =>
			`.wf-section:has([data-phase="${p.id}"]:hover) [data-phase="${p.id}"].wf-row`,
	)
	.join(",\n");

const shellSelectors = phases
	.map(
		(p) =>
			`.wf-section:has([data-phase="${p.id}"]:hover) [data-phase="${p.id}"] .pc-icon-shell`,
	)
	.join(",\n");

const crossHighlightCss = `
${rowSelectors} {
	background-color: color-mix(in srgb, var(--color-accent-100) 5%, transparent);
}
${shellSelectors} {
	border-color: var(--phase-color);
	border-style: dashed;
	background-color: color-mix(in srgb, var(--phase-color) 10%, transparent);
	color: var(--phase-color);
}`;
---

<section
	class="wf-section group/wf pt-10 pb-10"
	aria-labelledby="accelerate-heading"
	id="accelerate"
	data-mode="after"
>
	<div class="mb-6 flex items-center justify-between sm:mb-8">
		<div>
			<SectionHeading id="accelerate-heading" class="mb-2">
				Faster web performance
			</SectionHeading>
			<p
				class="text-foreground-muted max-w-[600px] text-sm leading-relaxed text-pretty md:text-lg"
			>
				Cloudflare routes traffic through the most reliable paths and delivers
				assets as close to end users as possible.
			</p>
		</div>
		<ViewAllLink href="/directory/?product-group=Application+performance">
			Explore Directory
		</ViewAllLink>
	</div>

	<!-- Leave out till approval -->
	<!-- <Waterfall phases={phases} /> -->

	<ProductCardGrid>
		{
			phases.map((p) => (
				<div
					class="wf-product-card flex"
					data-phase={p.id}
					style={`--phase-color: ${phaseColor(p)};`}
				>
					<ProductCard
						icon={p.icon}
						product={p.product}
						scenario={p.outcome}
						detail={p.detail}
						href={p.href}
						cta={p.cta}
						category={p.category}
					/>
				</div>
			))
		}
	</ProductCardGrid>
</section>

<style is:global set:html={crossHighlightCss}></style>
