---
/**
 * Structural grid overlay — dot grid + intersection markers.
 *
 * Works with FullPageLines.astro which draws the vertical lines.
 * This component adds:
 * 1. The dot grid background (full page)
 * 2. Plus marks at line intersections (where vertical lines meet the top)
 *
 * The plus marks are placed at the same widths as FullPageLines tiers:
 * - 1400px (outer scaffold)
 * - 1280px (content container)
 * - 1216px (content padding edge — where text starts)
 * - 720px  (inner scaffold)
 */

/** Must match FullPageLines tier widths exactly */
const LINE_TIERS = [
	{ width: "min(1400px, 100%)", accent: false },
	{ width: "min(1280px, calc(100% - 48px))", accent: true },
	{ width: "min(1216px, calc(100% - 112px))", accent: false },
	{ width: "min(720px, calc(100% - 120px))", accent: false },
];

const marks =
	"absolute -top-0 left-1/2 -translate-x-1/2 h-full pointer-events-none";
---

<!-- Dot grid — extends beyond content to reach the footer divider.
     The footer's opaque background-color covers any overshoot. -->
<div
	class="pointer-events-none absolute inset-x-0 top-0 z-0"
	style="height: calc(100% + 25rem)"
	aria-hidden="true"
>
	<div
		class="landing-dot-grid absolute h-full w-full"
		style="background-image: radial-gradient(var(--l-dot-color) 1px, transparent 1px); background-size: var(--l-dot-size)"
	>
	</div>
</div>

<!-- Plus marks at line intersections -->
<div
	class="pointer-events-none absolute inset-0 z-1 [contain:layout_style_paint] max-[1024px]:hidden"
	aria-hidden="true"
>
	<!-- Plus marks at each line tier intersection -->
	{
		LINE_TIERS.map((tier) => {
			const stroke = tier.accent
				? "var(--l-grid-mark-accent, var(--l-grid-mark))"
				: "var(--l-grid-mark)";
			const size = tier.accent ? 9 : 7;
			const half = size / 2;
			const offset = `-${half}px`;
			return (
				<div class={marks} style={`width:${tier.width}`}>
					<svg
						width={size}
						height={size}
						viewBox={`0 0 ${size} ${size}`}
						shape-rendering="crispEdges"
						class="absolute -top-[3px] -left-[3px]"
						style={`margin-top:${offset};margin-left:${offset}`}
						aria-hidden="true"
					>
						<line
							x1="0"
							y1={half}
							x2={size}
							y2={half}
							stroke={stroke}
							stroke-width="1"
						/>
						<line
							x1={half}
							y1="0"
							x2={half}
							y2={size}
							stroke={stroke}
							stroke-width="1"
						/>
					</svg>
					<svg
						width={size}
						height={size}
						viewBox={`0 0 ${size} ${size}`}
						shape-rendering="crispEdges"
						class="absolute -top-[3px] -right-[3px]"
						style={`margin-top:${offset};margin-right:${offset}`}
						aria-hidden="true"
					>
						<line
							x1="0"
							y1={half}
							x2={size}
							y2={half}
							stroke={stroke}
							stroke-width="1"
						/>
						<line
							x1={half}
							y1="0"
							x2={half}
							y2={size}
							stroke={stroke}
							stroke-width="1"
						/>
					</svg>
				</div>
			);
		})
	}
</div>
