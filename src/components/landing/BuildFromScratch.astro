---
import { Icon } from "astro-icon/components";
import CommandBlock from "./CommandBlock.astro";

const primitives = [
	{
		id: "compute",
		label: "Compute",
		icon: "workers-vpc",
		iconColor: "#0a95ff",
		iconBg: "rgba(10, 149, 255, 0.1)",
		iconBgDark: "rgba(10, 149, 255, 0.16)",
		heading: "Deploy with one command",
		description:
			"Deploy serverless functions and full-stack apps on Cloudflare's global network. No servers to manage. No cold starts or region complexity.",
		command: "npx wrangler init my-app",
		cta: {
			label: "Create your first Worker",
			href: "/workers/get-started/guide/",
		},
		tags: [
			{ label: "Workers", href: "/workers/" },
			{ label: "Pages", href: "/pages/" },
			{ label: "Containers", href: "/containers/" },
			{ label: "Workflows", href: "/workflows/" },
			{ label: "Queues", href: "/queues/" },
		],
	},
	{
		id: "ai",
		label: "AI",
		icon: "workers-ai",
		iconColor: "#19e306",
		iconBg: "#f2f5e1",
		iconBgDark: "rgba(25, 227, 6, 0.16)",
		heading: "Add intelligence to anything you build",
		description:
			"Run AI inference globally with one API call, build agents, and search across your data — no GPUs to manage, no capacity planning.",
		command: "npx wrangler ai models",
		cta: { label: "Browse available models", href: "/workers-ai/models/" },
		tags: [
			{ label: "Workers AI", href: "/workers-ai/" },
			{ label: "AI Gateway", href: "/ai-gateway/" },
			{ label: "AI Agents", href: "/agents/" },
			{ label: "Vectorize", href: "/vectorize/" },
			{ label: "Browser Rendering", href: "/browser-rendering/" },
		],
	},
	{
		id: "storage",
		label: "Storage",
		icon: "d1",
		iconColor: "#ee0ddb",
		iconBg: "rgba(238, 13, 219, 0.1)",
		iconBgDark: "rgba(238, 13, 219, 0.16)",
		heading: "Make your database feel instant, everywhere",
		description:
			"Serverless SQL, globally distributed key-value, and global database acceleration — query directly from Workers with no connection management.",
		command: "npx wrangler d1 create my-database",
		cta: { label: "Get started with D1", href: "/d1/get-started/" },
		tags: [
			{ label: "D1", href: "/d1/" },
			{ label: "KV", href: "/kv/" },
			{ label: "Hyperdrive", href: "/hyperdrive/" },
		],
	},
	{
		id: "media",
		label: "Media",
		icon: "images",
		iconColor: "#9616ff",
		iconBg: "rgba(150, 22, 255, 0.1)",
		iconBgDark: "rgba(150, 22, 255, 0.22)",
		heading: "Store anything, serve everywhere",
		description:
			"Scalable, durable, affordable object storage without egress fees, image optimization, and live and on-demand video streaming — store, transform, and deliver from Cloudflare's network.",
		command: "npx wrangler r2 bucket create my-bucket",
		cta: { label: "Get started with R2", href: "/r2/get-started/" },
		tags: [
			{ label: "R2", href: "/r2/" },
			{ label: "Images", href: "/images/" },
			{ label: "Stream", href: "/stream/" },
			{ label: "Realtime", href: "/realtime/" },
		],
	},
];
---

<section
	class="pt-10 pb-6 lg:pt-14"
	aria-labelledby="build-heading"
	id="build"
>
	<div class="mb-3">
		<span class="text-accent font-mono text-[13px] tracking-widest uppercase"
			>Build</span
		>
	</div>
	<h2
		id="build-heading"
		class="mb-8 text-2xl leading-[1.1] font-medium -tracking-[0.035em] text-balance text-zinc-900 md:text-3xl dark:text-zinc-50"
	>
		Powerful primitives, seamlessly integrated
	</h2>

	<div
		class="relative overflow-visible border border-zinc-200 dark:border-[#2a2a2a]"
		id="build-tabs-root"
	>
		<!-- Corner plus marks -->
		{
			[
				"-top-[5.5px] -left-[5.5px]",
				"-top-[5.5px] -right-[5.5px]",
				"-bottom-[5.5px] -left-[5.5px]",
				"-right-[5.5px] -bottom-[5.5px]",
			].map((pos) => (
				<svg
					width="10"
					height="10"
					viewBox="0 0 10 10"
					class={`pointer-events-none absolute ${pos} z-10`}
					aria-hidden="true"
				>
					<line
						x1="0"
						y1="5"
						x2="10"
						y2="5"
						stroke-width="1"
						class="l-corner-stroke"
					/>
					<line
						x1="5"
						y1="0"
						x2="5"
						y2="10"
						stroke-width="1"
						class="l-corner-stroke"
					/>
				</svg>
			))
		}

		<!-- Tab bar -->
		<div
			class="flex border-b border-zinc-200 bg-zinc-100/80 dark:border-[#2a2a2a] dark:bg-zinc-900/60"
			role="tablist"
			aria-label="Build primitives"
		>
			{
				primitives.map((p, i) => (
					<button
						role="tab"
						type="button"
						aria-selected={i === 0 ? "true" : "false"}
						aria-controls={`build-panel-${p.id}`}
						id={`build-tab-${p.id}`}
						class={[
							"build-tab group relative flex shrink-0 items-center gap-2 px-5 py-3",
							"text-sm font-medium -tracking-[0.005em]",
							"cursor-pointer transition-colors duration-150 select-none",
							"border-r border-zinc-200 last:border-r-0 dark:border-[#2a2a2a]",
							"focus-visible:outline-accent focus-visible:outline-2 focus-visible:-outline-offset-2",
							i === 0
								? "build-tab-active dark:text-accent text-zinc-900"
								: "build-tab-inactive",
						].join(" ")}
					>
						{p.label}
						<span
							class={`bg-accent pointer-events-none absolute bottom-0 left-0 h-0.5 transition-[width] duration-200 ease-[cubic-bezier(0.16,1,0.3,1)] ${i === 0 ? "w-full" : "w-0"}`}
							aria-hidden="true"
						/>
					</button>
				))
			}
		</div>

		<!-- Panels -->
		{
			primitives.map((p, i) => (
				<div
					role="tabpanel"
					id={`build-panel-${p.id}`}
					aria-labelledby={`build-tab-${p.id}`}
					hidden={i !== 0}
					class="bg-l-card dark:bg-l-card-dark p-5 sm:p-8"
				>
					<div class="w-full">
						<div class="mb-4 flex items-center gap-3">
							<div
								class="build-panel-icon flex size-8 shrink-0 items-center justify-center rounded border border-dashed"
								style={`--build-icon-color:${p.iconColor};--build-icon-bg:${p.iconBg};--build-icon-bg-dark:${p.iconBgDark};`}
							>
								<Icon name={p.icon} size="16px" />
							</div>
							<h3 class="text-base leading-snug font-medium text-zinc-900 md:text-lg dark:text-zinc-50">
								{p.heading}
							</h3>
						</div>
						<p class="mb-6 text-sm leading-relaxed text-zinc-500 md:text-base dark:text-zinc-400">
							{p.description}
						</p>

						{/* Command block — shared CommandBlock component */}
						<CommandBlock
							id={`build-cmd-${p.id}`}
							command={p.command}
							rounded
							class="mb-6 max-w-[680px]"
						/>

						{/* CTA + tags row */}
						<div class="flex w-full flex-col items-start gap-4 sm:flex-row sm:items-center sm:gap-6">
							<a
								href={p.cta.href}
								class="focus-visible:outline-accent inline-flex shrink-0 cursor-pointer items-center gap-2 rounded-md border border-zinc-300 bg-transparent px-4 py-2 text-sm font-medium text-zinc-900 no-underline transition-colors duration-150 hover:border-zinc-900 hover:bg-zinc-50 focus-visible:outline-2 focus-visible:outline-offset-2 dark:border-zinc-700 dark:text-zinc-50 dark:hover:border-zinc-300 dark:hover:bg-zinc-900"
							>
								{p.cta.label}
								<svg
									width="12"
									height="12"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
									class="shrink-0"
									aria-hidden="true"
								>
									<>
										<line x1="5" y1="12" x2="19" y2="12" />
										<polyline points="12 5 19 12 12 19" />
									</>
								</svg>
							</a>
							<p class="relative top-px min-w-0 flex-1 text-sm text-zinc-500 dark:text-zinc-400">
								{p.tags.map((tag, idx) => (
									<span class="inline-flex items-center">
										<a
											href={tag.href}
											class="text-zinc-600 no-underline hover:underline hover:underline-offset-4 dark:text-zinc-300"
										>
											{tag.label}
										</a>
										{idx < p.tags.length - 1 && (
											<span
												class="mx-1.5 text-zinc-300 dark:text-zinc-600"
												aria-hidden="true"
											>
												·
											</span>
										)}
									</span>
								))}
							</p>
						</div>
					</div>
				</div>
			))
		}
	</div>
</section>

<style is:global>
	.build-tab-active {
		background: var(--color-l-card);
	}
	.build-tab-inactive {
		background: transparent;
		color: #52525b;
	}
	:root[data-theme="dark"] .build-tab-inactive {
		color: #a1a1aa;
	}
	.build-tab-inactive:hover {
		background: var(--color-l-card);
		color: #18181b;
	}
	:root[data-theme="dark"] .build-tab-active {
		background: var(--color-l-card-dark);
	}
	:root[data-theme="dark"] .build-tab-inactive:hover {
		background: var(--color-l-card-dark);
		color: #fafafa;
	}

	.build-panel-icon {
		color: var(--build-icon-color);
		border-color: var(--build-icon-color);
		background: var(--build-icon-bg);
	}
	:root[data-theme="dark"] .build-panel-icon {
		background: var(--build-icon-bg-dark);
	}
</style>

<script>
	const root = document.getElementById("build-tabs-root");
	if (root) {
		const tabs = Array.from(
			root.querySelectorAll<HTMLButtonElement>("[role=tab]"),
		);
		const panels = Array.from(
			root.querySelectorAll<HTMLElement>("[role=tabpanel]"),
		);
		function activate(idx: number) {
			tabs.forEach((tab, i) => {
				const active = i === idx;
				tab.setAttribute("aria-selected", String(active));
				tab.classList.toggle("build-tab-active", active);
				tab.classList.toggle("text-zinc-900", active);
				tab.classList.toggle("dark:text-accent", active);
				tab.classList.toggle("build-tab-inactive", !active);
				const bar = tab.querySelector("span:last-child") as HTMLElement | null;
				if (bar) {
					bar.classList.toggle("w-full", active);
					bar.classList.toggle("w-0", !active);
				}
			});
			panels.forEach((p, i) => {
				if (i === idx) p.removeAttribute("hidden");
				else p.setAttribute("hidden", "");
			});
		}
		tabs.forEach((tab, i) => {
			tab.addEventListener("click", () => activate(i));
			tab.addEventListener("keydown", (e: KeyboardEvent) => {
				if (e.key === "ArrowRight") {
					e.preventDefault();
					const n = (i + 1) % tabs.length;
					activate(n);
					tabs[n].focus();
				}
				if (e.key === "ArrowLeft") {
					e.preventDefault();
					const n = (i - 1 + tabs.length) % tabs.length;
					activate(n);
					tabs[n].focus();
				}
			});
		});
	}
	// Copy behavior is now owned by CommandBlock.astro — see ./CommandBlock.astro
</script>
