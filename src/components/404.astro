---
// Shared by /404 and /[product]/404.
---

<div
	class="flex flex-col items-center justify-center gap-4 py-20 text-center md:py-28"
>
	<h1
		class="text-foreground text-[clamp(4rem,14vw,8rem)] leading-none font-bold"
	>
		404
	</h1>
	<p class="text-muted-foreground max-w-md text-lg">
		Check the URL, try using our <button
			id="404-search-link"
			class="cursor-pointer border-none bg-transparent p-0 font-[inherit] text-blue-500 underline hover:no-underline dark:text-orange-500"
			>search</button
		> or try our LLM-friendly
		<a
			href="/llms.txt"
			class="text-blue-500 underline hover:no-underline dark:text-orange-500"
			>llms.txt directory</a
		>.
	</p>
</div>

<script>
	import { openGlobalSearch } from "../util/search";

	// Gates the Cmd+K override so it goes inert after a soft-nav off the 404.
	function on404Page(): boolean {
		return document.getElementById("404-search-link") !== null;
	}

	// Read at call time (not module load) so it's correct across 404 soft-navs.
	function currentQuery(): string {
		return decodeURIComponent(
			window.location.pathname.replaceAll("/", " ").replaceAll("-", " ").trim(),
		);
	}

	function wire404(): void {
		const button = document.getElementById("404-search-link");
		if (button && !button.dataset.ready) {
			button.dataset.ready = "true";
			button.addEventListener("click", () => openGlobalSearch(currentQuery()));
		}
	}

	wire404();
	document.addEventListener("astro:page-load", wire404);

	// Capture-phase + stopPropagation beats DocSearch's own (bubble-phase) Cmd+K
	// so the query is prefilled instead of opening an empty modal.
	if (!document.documentElement.hasAttribute("data-404-search-key")) {
		document.documentElement.setAttribute("data-404-search-key", "true");
		document.addEventListener(
			"keydown",
			(keyboardEvent) => {
				if (!on404Page()) return;
				if (
					(keyboardEvent.metaKey || keyboardEvent.ctrlKey) &&
					keyboardEvent.key === "k"
				) {
					keyboardEvent.preventDefault();
					keyboardEvent.stopPropagation();
					openGlobalSearch(currentQuery());
				}
			},
			{ capture: true },
		);
	}
</script>
