---
import Icon from "@cloudflare/nimbus-docs/components/Icon.astro";

interface Props {
	autoPlay?: boolean;
	loop?: boolean;
}

const { autoPlay = true, loop = true } = Astro.props;
---

<figure
	class="ai-search-voice-diagram not-content"
	aria-label="Voice pipeline: microphone audio is transcribed to text by speech-to-text, the transcript is passed to the agent's onTurn handler on Cloudflare Agents, which can call AI Search as a retrieval tool to fetch relevant content from your knowledge base and then generates an answer, which is turned back into audio by text-to-speech and played through the speaker."
>
	<cfdocs-ai-search-voice-diagram
		data-autoplay={String(autoPlay)}
		data-loop={String(loop)}
	>
		<div class="asvd-flow">
			<!-- Mic: the user speaks -->
			<div class="asvd-node asvd-node-endpoint" data-step="0">
				<span class="asvd-node-head">Browser</span>
				<span class="asvd-node-body">
					<span class="asvd-node-icon" aria-hidden="true">
						<svg
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
						>
							<rect x="9" y="3" width="6" height="11" rx="3"></rect>
							<path d="M6 11a6 6 0 0 0 12 0"></path>
							<path d="M12 17v4"></path>
							<path d="M8 21h8"></path>
						</svg>
					</span>
					<span class="asvd-node-title">Mic</span>
				</span>
			</div>

			<div class="asvd-connector" data-step="1"></div>

			<!-- Speech-to-text (Workers AI) -->
			<a class="asvd-node" data-step="2" href="/workers-ai/">
				<span class="asvd-node-head">Workers AI</span>
				<span class="asvd-node-body">
					<span class="asvd-node-icon" aria-hidden="true">
						<svg
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
						>
							<path d="M4 10v4"></path>
							<path d="M8 6v12"></path>
							<path d="M12 9v6"></path>
							<path d="M16 6v12"></path>
							<path d="M20 10v4"></path>
						</svg>
					</span>
					<span class="asvd-node-title">Speech-to-text</span>
				</span>
			</a>

			<div class="asvd-connector" data-step="3"></div>

			<!-- Cloudflare Agents: the onTurn handler runs a model that can call
			     AI Search as one of its tools. -->
			<div class="asvd-node asvd-node-agent" data-step="4">
				<span class="asvd-node-head">Cloudflare Agents</span>
				<span class="asvd-node-body">
					<span class="asvd-node-icon" aria-hidden="true">
						<svg
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
						>
							<path d="M9 8l-4 4 4 4"></path>
							<path d="M15 8l4 4-4 4"></path>
						</svg>
					</span>
					<span class="asvd-node-title asvd-mono"
						>onTurn(<wbr />transcript)</span
					>
				</span>
				<div class="asvd-tools">
					<span class="asvd-tools-label">tool</span>
					<a class="asvd-tool" href="/ai-search/">
						<span class="asvd-tool-icon" aria-hidden="true">
							<Icon name="ai-search" />
						</span>
						<span class="asvd-tool-title">AI Search</span>
						<span class="asvd-tool-sub">retrieval</span>
					</a>
				</div>
			</div>

			<div class="asvd-connector" data-step="5"></div>

			<!-- Text-to-speech (Workers AI) -->
			<a class="asvd-node" data-step="6" href="/workers-ai/">
				<span class="asvd-node-head">Workers AI</span>
				<span class="asvd-node-body">
					<span class="asvd-node-icon" aria-hidden="true">
						<svg
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
						>
							<path d="M4 10v4"></path>
							<path d="M8 6v12"></path>
							<path d="M12 9v6"></path>
							<path d="M16 6v12"></path>
							<path d="M20 10v4"></path>
						</svg>
					</span>
					<span class="asvd-node-title">Text-to-speech</span>
				</span>
			</a>

			<div class="asvd-connector" data-step="7"></div>

			<!-- Speaker: the answer is played back -->
			<div class="asvd-node asvd-node-endpoint" data-step="8">
				<span class="asvd-node-head">Browser</span>
				<span class="asvd-node-body">
					<span class="asvd-node-icon" aria-hidden="true">
						<svg
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
						>
							<path d="M4 9v6h4l5 4V5L8 9H4z"></path>
							<path d="M17 8a5 5 0 0 1 0 8"></path>
							<path d="M20 5a9 9 0 0 1 0 14"></path>
						</svg>
					</span>
					<span class="asvd-node-title">Speaker</span>
				</span>
			</div>
		</div>
	</cfdocs-ai-search-voice-diagram>
</figure>

<style>
	.ai-search-voice-diagram {
		/* Neutral, Kumo-style monochrome palette with a single orange accent,
		   matching the other AI Search diagrams. */
		--asvd-panel: #fbfbfb;
		--asvd-dot: rgb(0 0 0 / 8%);
		--asvd-card: #ffffff;
		--asvd-head: #f4f4f5;
		--asvd-border: #e3e3e6;
		--asvd-line: #c1c1c8;
		--asvd-joint: #ffffff;
		--asvd-text: #1a1a1c;
		--asvd-muted: #8a8a90;
		--asvd-accent: #f6821f;
		--asvd-accent-soft: rgb(246 130 31 / 14%);

		margin: 1.5rem 0;
		/* Respond to the diagram's own available width, not the viewport. */
		container-type: inline-size;
	}

	:root[data-theme="dark"] .ai-search-voice-diagram {
		--asvd-panel: #121213;
		--asvd-dot: rgb(255 255 255 / 9%);
		--asvd-card: #1b1b1d;
		--asvd-head: #242427;
		--asvd-border: #38383c;
		--asvd-line: #4d4d54;
		--asvd-joint: #1b1b1d;
		--asvd-text: #f3f3f5;
		--asvd-muted: #9a9aa2;
	}

	cfdocs-ai-search-voice-diagram {
		display: block;
		width: 100%;
		padding: 1.5rem 1rem;
		border: 1px solid var(--asvd-border);
		border-radius: 0.75rem;
		background:
			radial-gradient(circle, var(--asvd-dot) 1px, transparent 1px),
			var(--asvd-panel);
		background-size: 16px 16px;
	}

	/* Vertical pipeline, centred, like the indexing and querying diagrams. */
	.asvd-flow {
		display: flex;
		flex-direction: column;
		align-items: center;
		width: 100%;
		max-width: 340px;
		margin: 0 auto;
	}

	/* --- Labeled cards (header + body) --- */
	.asvd-node {
		position: relative;
		display: block;
		box-sizing: border-box;
		width: 100%;
		max-width: 320px;
		overflow: hidden;
		background: var(--asvd-card);
		border: 1px solid var(--asvd-border);
		border-radius: 0.625rem;
		box-shadow: 0 1px 2px rgb(0 0 0 / 5%);
		color: inherit;
		text-decoration: none;
		transition:
			border-color 0.25s ease,
			box-shadow 0.25s ease,
			transform 0.15s ease;
	}

	.asvd-node-head {
		display: block;
		padding: 0.25rem 0.625rem;
		background: var(--asvd-head);
		border-bottom: 1px solid var(--asvd-border);
		white-space: nowrap;
		font-size: 0.625rem;
		font-family:
			ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
		letter-spacing: 0.01em;
		color: var(--asvd-muted);
	}

	.asvd-node-body {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.5rem 0.625rem;
	}

	.asvd-node-icon {
		flex: none;
		width: 1.25rem;
		height: 1.25rem;
		color: var(--asvd-muted);
		transition: color 0.25s ease;
	}

	.asvd-node-icon :global(svg) {
		display: block;
		width: 100%;
		height: 100%;
	}

	.asvd-node-title {
		font-size: 0.8125rem;
		font-weight: 600;
		line-height: 1.2;
		color: var(--asvd-text);
	}

	.asvd-mono {
		font-family:
			ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
		font-size: 0.75rem;
	}

	/* --- AI Search as a tool the agent owns, nested in the Agents card --- */
	.asvd-tools {
		padding: 0.5rem 0.625rem 0.625rem;
		border-top: 1px dashed var(--asvd-border);
	}

	.asvd-tools-label {
		display: block;
		margin-bottom: 0.35rem;
		font-size: 0.5625rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		font-family:
			ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
		color: var(--asvd-muted);
	}

	.asvd-tool {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.4rem 0.5rem;
		border: 1px solid
			color-mix(in srgb, var(--asvd-accent) 40%, var(--asvd-border));
		border-radius: 0.5rem;
		background: var(--asvd-card);
		color: inherit;
		text-decoration: none;
		transition:
			border-color 0.25s ease,
			box-shadow 0.25s ease;
	}

	.asvd-tool:hover {
		border-color: color-mix(
			in srgb,
			var(--asvd-accent) 60%,
			var(--asvd-border)
		);
		box-shadow: 0 2px 8px rgb(0 0 0 / 8%);
	}

	.asvd-tool:focus-visible {
		outline: 2px solid var(--asvd-accent);
		outline-offset: 2px;
	}

	.asvd-tool-icon {
		flex: none;
		width: 1.1rem;
		height: 1.1rem;
		color: var(--asvd-muted);
		transition: color 0.25s ease;
	}

	/* The AI Search product icon is filled, unlike the stroked glyphs. */
	.asvd-tool-icon :global(svg),
	.asvd-tool-icon :global(svg path) {
		display: block;
		width: 100%;
		height: 100%;
		fill: currentColor;
	}

	.asvd-tool-title {
		font-size: 0.75rem;
		font-weight: 600;
		color: var(--asvd-text);
	}

	.asvd-tool-sub {
		margin-left: auto;
		font-size: 0.5625rem;
		line-height: 1.2;
		color: var(--asvd-muted);
	}

	a.asvd-node:hover {
		border-color: color-mix(
			in srgb,
			var(--asvd-accent) 55%,
			var(--asvd-border)
		);
		box-shadow: 0 4px 12px rgb(0 0 0 / 8%);
		transform: translateY(-1px);
	}

	a.asvd-node:focus-visible {
		outline: 2px solid var(--asvd-accent);
		outline-offset: 2px;
	}

	/* --- Connectors: vertical wire with a joint at each end --- */
	.asvd-connector {
		position: relative;
		flex: none;
		width: 2px;
		height: 1.5rem;
		background: var(--asvd-line);
		transition: background-color 0.3s ease;
	}

	.asvd-connector::before,
	.asvd-connector::after {
		content: "";
		position: absolute;
		left: 50%;
		width: 9px;
		height: 9px;
		border-radius: 50%;
		background: var(--asvd-joint);
		border: 2px solid var(--asvd-line);
		box-sizing: border-box;
		transform: translateX(-50%);
		transition: border-color 0.3s ease;
		z-index: 2;
	}

	.asvd-connector::before {
		top: -4px;
	}

	.asvd-connector::after {
		bottom: -4px;
	}

	/* --- Active trace: the orange wire fills as the audio flows through, and
	   the current stage's icon lights up. When the agent stage is active its
	   AI Search tool lights up too, showing the model calling the tool. --- */
	.asvd-connector.current {
		background: var(--asvd-accent);
	}

	.asvd-connector.current::before,
	.asvd-connector.current::after {
		border-color: var(--asvd-accent);
	}

	.asvd-node.current {
		border-color: color-mix(
			in srgb,
			var(--asvd-accent) 45%,
			var(--asvd-border)
		);
	}

	.asvd-node.current .asvd-node-icon {
		color: var(--asvd-accent);
	}

	.asvd-node.current .asvd-tool {
		border-color: var(--asvd-accent);
	}

	.asvd-node.current .asvd-tool-icon {
		color: var(--asvd-accent);
	}

	/* --- Reduced motion: rest in the complete, neutral state --- */
	@media (prefers-reduced-motion: reduce) {
		.asvd-node,
		.asvd-node-icon,
		.asvd-tool,
		.asvd-tool-icon,
		.asvd-connector {
			transition: none;
		}
	}
</style>

<script>
	class AiSearchVoiceDiagramElement extends HTMLElement {
		private loop = false;
		private timer: number | null = null;
		private steps: Element[][] = [];

		connectedCallback() {
			this.loop = this.dataset.loop === "true";
			this.groupSteps();

			const reduced = window.matchMedia(
				"(prefers-reduced-motion: reduce)",
			).matches;

			if (!reduced && this.dataset.autoplay === "true" && this.steps.length) {
				this.timer = window.setTimeout(() => this.cycle(0), 500);
			}
		}

		disconnectedCallback() {
			if (this.timer !== null) window.clearTimeout(this.timer);
		}

		/** Group every [data-step] element by its step number, in order. */
		private groupSteps() {
			const byStep = new Map<number, Element[]>();
			this.querySelectorAll<HTMLElement>("[data-step]").forEach((el) => {
				const step = Number(el.dataset.step);
				if (Number.isNaN(step)) return;
				const group = byStep.get(step) ?? [];
				group.push(el);
				byStep.set(step, group);
			});
			this.steps = [...byStep.keys()]
				.sort((a, b) => a - b)
				.map((key) => byStep.get(key)!);
		}

		private clearCurrent() {
			this.querySelectorAll(".current").forEach((el) =>
				el.classList.remove("current"),
			);
		}

		/** Fill the pipeline in order (mic through speaker) so the whole voice
		 *  flow reads as one path, then loop. */
		private cycle(index: number) {
			if (index === 0) this.clearCurrent();

			if (index >= this.steps.length) {
				if (this.loop) {
					this.timer = window.setTimeout(() => this.cycle(0), 1500);
				}
				return;
			}

			this.steps[index].forEach((el) => el.classList.add("current"));
			this.timer = window.setTimeout(() => this.cycle(index + 1), 480);
		}
	}

	customElements.define(
		"cfdocs-ai-search-voice-diagram",
		AiSearchVoiceDiagramElement,
	);
</script>
