---
import ModelInfo from "./models/ModelInfo.astro";
import ModelBadges from "./models/ModelBadges.astro";
import { FilterDropdownWrapper } from "./models/FilterDropdownWrapper";
import { SortSelectWrapper } from "./models/SortSelectWrapper";
import { authorData } from "./models/data";
import type { ModelCardData } from "~/util/model-types";
import { getModelAuthor } from "~/util/model-helpers";
import {
	getCapabilities,
	getLabelsByCategory,
	hasProperty,
} from "~/util/model-properties";

interface Props {
	models: ModelCardData[];
	basePath?: string;
}

const { models, basePath = "/ai/models" } = Astro.props;

// Models pinned to the top of the list, in order
const pinnedModelNames = [
	"@cf/moonshotai/kimi-k2.6",
	"@cf/zai-org/glm-4.7-flash",
	"@cf/openai/gpt-oss-120b",
	"@cf/meta/llama-4-scout-17b-16e-instruct",
];

// Sort: pinned first (by pinnedModelNames order), then by created_at descending
const sortedModels = [...models].sort((a, b) => {
	const pinA = pinnedModelNames.indexOf(a.name);
	const pinB = pinnedModelNames.indexOf(b.name);
	const isPinnedA = pinA !== -1;
	const isPinnedB = pinB !== -1;
	if (isPinnedA && !isPinnedB) return -1;
	if (!isPinnedA && isPinnedB) return 1;
	if (isPinnedA && isPinnedB) return pinA - pinB;
	const dateA = a.created_at ? new Date(a.created_at).getTime() : 0;
	const dateB = b.created_at ? new Date(b.created_at).getTime() : 0;
	return dateB - dateA; // newest first (default; JS re-sorts on "oldest" event)
});

// Derive filter dropdown options at build time
const getAuthorDisplayName = (id: string) => authorData[id]?.name ?? id;

const taskItems = [...new Set(models.map((m) => m.task.name))]
	.sort()
	.map((t) => ({ value: t, label: t }));

const authorItems = [
	...new Map(
		models
			.map((m) => getModelAuthor(m.name))
			.map((id) => [getAuthorDisplayName(id), id] as const),
	).values(),
]
	.sort((a, b) =>
		getAuthorDisplayName(a).localeCompare(getAuthorDisplayName(b)),
	)
	.map((a) => ({ value: a, label: getAuthorDisplayName(a) }));

const capabilityItems = [
	...getLabelsByCategory(models, "model"),
	...getLabelsByCategory(models, "platform"),
].map((c) => ({ value: c, label: c }));

// Pre-compute card data (capabilities, author info, href) at build time
const cards = sortedModels.map((model) => {
	const author = getModelAuthor(model.name);
	const authorInfo = authorData[author];
	const capabilities = getCapabilities(model.properties);
	const isPinned = pinnedModelNames.includes(model.name);
	const isBeta = hasProperty(model.properties, "beta");
	const displayName = model.name.split("/").at(-1)!;
	const href = `${basePath}/${basePath === "/workers-ai/models" ? displayName : model.name}/`;
	const createdAt = model.created_at ?? "";

	return {
		model,
		author,
		authorInfo,
		capabilities,
		isPinned,
		isBeta,
		displayName,
		href,
		createdAt,
	};
});
---

<div class="not-content" id="model-catalog">
	{/* Toolbar */}
	<div class="mb-4 flex flex-col gap-3 md:flex-row md:items-center">
		{/* Search */}
		<div class="relative flex-1">
			<svg
				class="absolute top-1/2 left-3 h-4 w-4 -translate-y-1/2 text-gray-400"
				fill="none"
				viewBox="0 0 24 24"
				stroke="currentColor"
				stroke-width="2"
			>
				<path
					stroke-linecap="round"
					stroke-linejoin="round"
					d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
			</svg>
			<input
				id="model-search"
				type="text"
				class="w-full rounded-lg border border-gray-200 bg-white py-2 pr-3 pl-9 text-sm outline-none focus:border-blue-300 focus:ring-1 focus:ring-blue-300 dark:border-gray-600 dark:bg-gray-800 dark:text-gray-100 dark:focus:border-blue-500 dark:focus:ring-blue-500"
				placeholder="Search models"
			/>
		</div>

		{/* Filter dropdowns (React islands) */}
		<div class="flex flex-wrap items-center gap-2">
			<FilterDropdownWrapper
				label="Task Types"
				filterKey="tasks"
				items={taskItems}
				client:load
			/>
			<FilterDropdownWrapper
				label="Capabilities"
				filterKey="capabilities"
				items={capabilityItems}
				client:load
			/>
			<FilterDropdownWrapper
				label="Authors"
				filterKey="authors"
				items={authorItems}
				client:load
			/>
			<SortSelectWrapper client:load />
		</div>
	</div>

	{/* Result count + clear filters */}
	<div class="mb-4 flex items-center gap-3">
		<span class="text-sm text-gray-600 dark:text-gray-400">
			We found{" "}
			<span
				id="model-count"
				class="font-semibold text-gray-900 dark:text-gray-100"
			>
				{cards.length}
			</span>
			<span id="model-count-label">
				{cards.length === 1 ? " model" : " models"}
			</span>
		</span>
		<button
			id="clear-filters"
			type="button"
			class="hidden cursor-pointer text-sm text-blue-600 hover:text-blue-800 dark:text-blue-400 dark:hover:text-blue-300"
		>
			Clear filters
		</button>
	</div>

	{/* Model cards grid */}
	<div
		id="model-grid"
		class="grid w-full grid-cols-1 gap-3 md:grid-cols-2 lg:grid-cols-3"
	>
		{/* Empty state (hidden until JS shows it) */}
		<div
			id="model-empty"
			class="col-span-full hidden w-full flex-col justify-center rounded-md border bg-gray-50 py-6 text-center align-middle dark:border-gray-500 dark:bg-gray-800"
		>
			<span class="text-lg font-bold">No models found</span>
			<p>
				Try a different search term, or broaden your search by removing filters.
			</p>
		</div>

		{
			cards.map((card) => (
				<a
					class="model-card relative flex flex-col rounded-md border border-solid border-gray-200 p-3 text-inherit no-underline hover:bg-gray-50 dark:border-gray-700 dark:hover:bg-gray-800"
					href={card.href}
					data-name={card.model.name}
					data-author={getModelAuthor(card.model.name)}
					data-task={card.model.task.name}
					data-capabilities={card.capabilities.join(",")}
					data-created={card.createdAt}
					data-pinned={card.isPinned ? "true" : "false"}
					data-pin-index={
						card.isPinned
							? String(pinnedModelNames.indexOf(card.model.name))
							: ""
					}
				>
					{card.isPinned && (
						<span class="absolute top-1 right-2" title="Pinned model">
							📌
						</span>
					)}
					<div class="-mb-1 flex items-center">
						{card.authorInfo?.logo ? (
							<img
								class="mr-2 block w-6 rounded-xs p-0.5 dark:bg-gray-200 dark:ring-2 dark:ring-gray-200"
								src={card.authorInfo.logo}
								alt={`${card.authorInfo.name} logo`}
							/>
						) : (
							<div class="mr-2 flex h-6 w-6 items-center justify-center rounded-md bg-gray-100 text-sm font-black text-gray-400 uppercase">
								{card.author.slice(0, 1)}
							</div>
						)}
						<span class="overflow-hidden text-lg font-semibold text-ellipsis whitespace-nowrap">
							{card.displayName}
						</span>
						{card.isBeta && <span class="sl-badge caution ml-1">Beta</span>}
					</div>
					<div class="text-xs">
						<ModelInfo model={card.model} />
					</div>
					<p class="mt-2 line-clamp-2 flex-1 text-sm leading-6">
						{card.model.description}
					</p>
					<div class="mt-2 min-h-6 text-xs">
						<ModelBadges model={card.model} />
					</div>
				</a>
			))
		}
	</div>
</div>

<script>
	// ---------------------------------------------------------------------------
	// Model catalog filter + sort — vanilla JS
	// Reads filter state from CustomEvents fired by React dropdown islands and
	// from the search input, then shows/hides cards and re-sorts the grid.
	// ---------------------------------------------------------------------------

	const grid = document.getElementById("model-grid")!;
	const searchInput = document.getElementById(
		"model-search",
	) as HTMLInputElement;
	const countEl = document.getElementById("model-count")!;
	const countLabelEl = document.getElementById("model-count-label")!;
	const clearBtn = document.getElementById("clear-filters")!;
	const emptyEl = document.getElementById("model-empty")!;

	// ---------------------------------------------------------------------------
	// State
	// ---------------------------------------------------------------------------

	const state = {
		search: "",
		authors: [] as string[],
		tasks: [] as string[],
		capabilities: [] as string[],
		sort: "newest" as "newest" | "oldest",
	};

	// ---------------------------------------------------------------------------
	// Author display-name lookup (mirrors authorData in data.ts)
	// We store the author *id* on data-author; the filter values from the
	// dropdown are also ids, so comparison is direct.
	// ---------------------------------------------------------------------------

	// ---------------------------------------------------------------------------
	// Filter pass: show/hide cards, update count, toggle empty state
	// ---------------------------------------------------------------------------

	function applyFilters() {
		const cards = Array.from(
			grid.querySelectorAll<HTMLAnchorElement>(".model-card"),
		);

		let visible = 0;

		for (const card of cards) {
			const name = card.dataset.name ?? "";
			const author = card.dataset.author ?? "";
			const task = card.dataset.task ?? "";
			const capsList = card.dataset.capabilities ?? "";
			const caps = capsList ? capsList.split(",") : [];

			let show = true;

			if (state.authors.length > 0 && !state.authors.includes(author)) {
				show = false;
			}

			if (show && state.tasks.length > 0 && !state.tasks.includes(task)) {
				show = false;
			}

			if (
				show &&
				state.capabilities.length > 0 &&
				!state.capabilities.some((c) => caps.includes(c))
			) {
				show = false;
			}

			if (
				show &&
				state.search &&
				!name.toLowerCase().includes(state.search.toLowerCase())
			) {
				show = false;
			}

			card.classList.toggle("hidden", !show);
			if (show) visible++;
		}

		// Update count label
		countEl.textContent = String(visible);
		countLabelEl.textContent = visible === 1 ? " model" : " models";

		// Empty state
		emptyEl.classList.toggle("hidden", visible > 0);
		emptyEl.style.display = visible === 0 ? "flex" : "";

		// Clear filters button: show when any dropdown filter is active
		const hasActive =
			state.authors.length > 0 ||
			state.tasks.length > 0 ||
			state.capabilities.length > 0;
		clearBtn.classList.toggle("hidden", !hasActive);

		// Sync URL
		syncUrl();
	}

	// ---------------------------------------------------------------------------
	// Sort pass: reorder card elements in the DOM
	// ---------------------------------------------------------------------------

	function applySort() {
		const cards = Array.from(
			grid.querySelectorAll<HTMLAnchorElement>(".model-card"),
		);

		cards.sort((a, b) => {
			const pinnedA = a.dataset.pinned === "true";
			const pinnedB = b.dataset.pinned === "true";

			if (pinnedA && !pinnedB) return -1;
			if (!pinnedA && pinnedB) return 1;
			if (pinnedA && pinnedB) {
				return (
					Number(a.dataset.pinIndex ?? 0) - Number(b.dataset.pinIndex ?? 0)
				);
			}

			const dateA = a.dataset.created
				? new Date(a.dataset.created).getTime()
				: 0;
			const dateB = b.dataset.created
				? new Date(b.dataset.created).getTime()
				: 0;
			return state.sort === "newest" ? dateB - dateA : dateA - dateB;
		});

		// Re-insert in sorted order (empty state sentinel stays at top via CSS col-span)
		for (const card of cards) {
			grid.appendChild(card);
		}
	}

	// ---------------------------------------------------------------------------
	// URL sync
	// ---------------------------------------------------------------------------

	function syncUrl() {
		const params = new URLSearchParams();

		if (state.search) params.set("search", state.search);
		state.authors.forEach((a) => params.append("authors", a));
		state.tasks.forEach((t) => params.append("tasks", t));
		state.capabilities.forEach((c) => params.append("capabilities", c));
		if (state.sort !== "newest") params.set("sort", state.sort);

		const newUrl =
			params.size === 0
				? window.location.pathname
				: `${window.location.pathname}?${params.toString()}`;

		if (newUrl !== window.location.pathname + window.location.search) {
			history.pushState(null, "", newUrl);
		}
	}

	// ---------------------------------------------------------------------------
	// Initialise search from URL (dropdowns self-initialise via their useEffect)
	// ---------------------------------------------------------------------------

	const initParams = new URLSearchParams(window.location.search);
	const initSearch = initParams.get("search") ?? "";
	if (initSearch) {
		searchInput.value = initSearch;
		state.search = initSearch;
	}

	const initSort = initParams.get("sort");
	if (initSort === "oldest" || initSort === "newest") {
		state.sort = initSort;
	}

	// ---------------------------------------------------------------------------
	// Event listeners
	// ---------------------------------------------------------------------------

	searchInput.addEventListener("input", () => {
		state.search = searchInput.value;
		applyFilters();
	});

	document.addEventListener("model-catalog-filter", (e: Event) => {
		const { key, value } = (e as CustomEvent<{ key: string; value: string[] }>)
			.detail;
		if (key === "authors") state.authors = value;
		else if (key === "tasks") state.tasks = value;
		else if (key === "capabilities") state.capabilities = value;
		applyFilters();
	});

	document.addEventListener("model-catalog-sort", (e: Event) => {
		const { value } = (e as CustomEvent<{ value: "newest" | "oldest" }>).detail;
		state.sort = value;
		applySort();
		applyFilters();
	});

	clearBtn.addEventListener("click", () => {
		state.authors = [];
		state.tasks = [];
		state.capabilities = [];
		// Signal dropdowns to clear — they listen for this event
		document.dispatchEvent(new CustomEvent("model-catalog-clear"));
		applyFilters();
	});

	// Initial filter + sort pass (handles URL-initialised search and sort)
	applySort();
	applyFilters();
</script>
