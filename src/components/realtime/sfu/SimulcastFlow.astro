---
import RealtimeDiagramFrame from "./RealtimeDiagramFrame.astro";

const qualities = ["Low quality", "Medium quality", "High quality"];
---

<RealtimeDiagramFrame
	ariaLabel="A publisher sends low-, medium-, and high-quality encodings to Realtime SFU. Realtime SFU forwards a selected quality to each subscriber."
	className="rt-simulcast"
>
	<div class="rtsm-desktop">
		<div class="rt-diagram__node rtsm-publisher">
			<strong>Publisher</strong>
		</div>

		{qualities.map((quality, index) => (
			<div
				class="rt-diagram__connector rtsm-input"
				style={`--rtsm-row: ${index + 1};`}
			>
				<span class="rt-diagram__connector-label">{quality}</span>
			</div>
		))}

		<div class="rt-diagram__node rt-diagram__node--accent rtsm-sfu">
			<span class="rt-diagram__eyebrow">Cloudflare</span>
			<strong>Realtime SFU</strong>
		</div>

		{qualities.map((quality, index) => (
			<>
				<div
					class="rt-diagram__connector rtsm-output"
					style={`--rtsm-row: ${index + 1};`}
				>
					<span class="rt-diagram__connector-label">{quality}</span>
				</div>
				<div
					class="rt-diagram__node rtsm-subscribers"
					style={`--rtsm-row: ${index + 1};`}
				>
					<strong>Subscribers</strong>
				</div>
			</>
		))}
	</div>

	<div class="rtsm-mobile">
		{qualities.map((quality) => (
			<div class="rtsm-mobile-route">
				<span>Publisher</span>
				<small>{quality}</small>
				<span>Realtime SFU</span>
				<small>{quality}</small>
				<span>Subscribers</span>
			</div>
		))}
	</div>
</RealtimeDiagramFrame>

<style>
	.rtsm-desktop {
		display: grid;
		grid-template-columns:
			minmax(7rem, 1fr) minmax(6rem, 0.8fr) minmax(8rem, 1fr)
			minmax(6rem, 0.8fr) minmax(7rem, 1fr);
		grid-template-rows: repeat(3, minmax(4.5rem, auto));
		align-items: stretch;
		max-width: 780px;
		margin: 0 auto;
	}

	.rtsm-publisher,
	.rtsm-sfu {
		grid-row: 1 / 4;
		align-self: center;
	}

	.rtsm-publisher {
		grid-column: 1;
	}

	.rtsm-input {
		grid-column: 2;
		grid-row: var(--rtsm-row);
	}

	.rtsm-sfu {
		grid-column: 3;
	}

	.rtsm-output {
		grid-column: 4;
		grid-row: var(--rtsm-row);
	}

	.rtsm-subscribers {
		grid-column: 5;
		grid-row: var(--rtsm-row);
		margin-block: 0.35rem;
	}

	.rtsm-mobile {
		display: none;
		gap: 0.75rem;
	}

	.rtsm-mobile-route {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr) auto minmax(
				0,
				1fr
			);
		align-items: center;
		gap: 0.35rem;
		padding: 0.75rem;
		border: 1px solid var(--rtd-border);
		border-radius: 0.625rem;
		background: var(--rtd-card);
		color: var(--rtd-text);
		font-size: 0.625rem;
		line-height: 1.3;
		text-align: center;
	}

	.rtsm-mobile-route small {
		color: var(--rtd-muted);
		font-size: 0.5rem;
	}

	@container (max-width: 40rem) {
		.rtsm-desktop {
			display: none;
		}

		.rtsm-mobile {
			display: grid;
		}
	}
</style>
