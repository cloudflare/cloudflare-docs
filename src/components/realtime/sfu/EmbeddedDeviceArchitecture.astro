---
import RealtimeDiagramFrame from "./RealtimeDiagramFrame.astro";
---

<RealtimeDiagramFrame
	ariaLabel="Device firmware and browser listeners exchange audio, application data, and authorized controls through Realtime SFU. A Worker handles device and viewer authentication and SFU credentials. A RobotRoom Durable Object owns session state, discovery, the controller lease, and cleanup."
	className="rt-embedded"
>
	<div class="rtem-title">Embedded WebRTC with Realtime SFU</div>

	<div class="rtem-desktop">
		<div class="rt-diagram__node rtem-device">
			<strong>Device firmware</strong>
			<small>ESP32-S3 + Rust / str0m</small>
			<small>One peer and UDP socket</small>
			<small>Opus source + application channels</small>
		</div>

		<div class="rtem-device-links">
			<div class="rt-diagram__connector">
				<span class="rt-diagram__connector-label">
					Opus audio
					<br />
					robot + spectrum
				</span>
			</div>
			<div class="rt-diagram__connector rt-diagram__connector--left">
				<span class="rt-diagram__connector-label">Commands</span>
			</div>
		</div>

		<div class="rt-diagram__node rt-diagram__node--accent rtem-sfu">
			<span class="rt-diagram__eyebrow">Cloudflare</span>
			<strong>Realtime SFU</strong>
			<small>One session per endpoint</small>
			<small>Audio and DataChannels</small>
		</div>

		<div class="rtem-browser-links">
			<div class="rt-diagram__connector">
				<span class="rt-diagram__connector-label">Audio + data</span>
			</div>
			<div class="rt-diagram__connector rt-diagram__connector--left">
				<span class="rt-diagram__connector-label">
					robot replies
					<br />
					controller only
				</span>
			</div>
		</div>

		<div class="rt-diagram__node rt-diagram__node--blue rtem-browser">
			<strong>Browser listeners</strong>
			<small>One peer per tab</small>
			<small>Play audio, show data</small>
			<small>One authorized controller</small>
		</div>

		<div class="rtem-signal rtem-signal--device rtem-signal--both">
			<span>
				HTTPS signaling
				<br />
				offer, answer, IDs, liveness
			</span>
		</div>
		<div class="rtem-signal rtem-signal--sfu">
			<span>
				SFU HTTPS API
				<br />
				sessions, tracks, channels
			</span>
		</div>
		<div class="rtem-signal rtem-signal--browser rtem-signal--both">
			<span>
				HTTPS signaling
				<br />
				join, SDP, control lease
			</span>
		</div>

		<div class="rt-diagram__boundary rt-diagram__boundary--accent rtem-backend">
			<span class="rt-diagram__boundary-label">
				Trusted application backend (this example)
			</span>
			<div class="rtem-backend-grid">
				<div class="rt-diagram__node">
					<strong>Worker</strong>
					<small>Device / viewer authentication</small>
					<small>SFU credentials</small>
				</div>
				<div class="rt-diagram__connector">
					<span class="rt-diagram__connector-label">RPC</span>
				</div>
				<div class="rt-diagram__node">
					<strong>RobotRoom Durable Object</strong>
					<small>Session state + discovery</small>
					<small>Controller lease + cleanup</small>
				</div>
			</div>
		</div>
	</div>

	<div class="rt-diagram__mobile-routes">
		<div class="rt-diagram__mobile-route">
			<span>Device firmware</span>
			<small>Opus audio, robot + spectrum →</small>
			<span>Realtime SFU</span>
		</div>
		<div class="rt-diagram__mobile-route">
			<span>Realtime SFU</span>
			<small>Commands →</small>
			<span>Device firmware</span>
		</div>
		<div class="rt-diagram__mobile-route">
			<span>Realtime SFU</span>
			<small>Audio + data →</small>
			<span>Browser listeners</span>
		</div>
		<div class="rt-diagram__mobile-route">
			<span>Browser listeners</span>
			<small>robot replies, controller only →</small>
			<span>Realtime SFU</span>
		</div>
		<div class="rt-diagram__mobile-route">
			<span>Device firmware</span>
			<small>HTTPS signaling ↔</small>
			<span>Worker</span>
		</div>
		<div class="rt-diagram__mobile-route">
			<span>Browser listeners</span>
			<small>HTTPS signaling ↔</small>
			<span>Worker</span>
		</div>
		<div class="rt-diagram__mobile-route">
			<span>Worker</span>
			<small>RPC →</small>
			<span>RobotRoom Durable Object</span>
		</div>
		<div class="rt-diagram__mobile-route">
			<span>RobotRoom Durable Object</span>
			<small>SFU HTTPS API →</small>
			<span>Realtime SFU</span>
		</div>
	</div>
</RealtimeDiagramFrame>

<style>
	.rtem-title {
		margin: 0 0 1.5rem;
		color: var(--rtd-text);
		font-size: 1rem;
		font-weight: 600;
		line-height: 1.3;
		text-align: center;
	}

	.rtem-desktop {
		display: grid;
		grid-template-columns:
			minmax(8rem, 1fr) minmax(6rem, 0.8fr) minmax(8rem, 1fr)
			minmax(6rem, 0.8fr) minmax(8rem, 1fr);
		grid-template-rows: minmax(8.5rem, auto) 7rem auto;
		align-items: stretch;
		max-width: 940px;
		margin: 0 auto;
	}

	.rtem-device {
		grid-column: 1;
		grid-row: 1;
	}

	.rtem-device-links {
		display: grid;
		grid-column: 2;
		grid-row: 1;
		grid-template-rows: repeat(2, 1fr);
	}

	.rtem-sfu {
		grid-column: 3;
		grid-row: 1;
	}

	.rtem-browser-links {
		display: grid;
		grid-column: 4;
		grid-row: 1;
		grid-template-rows: repeat(2, 1fr);
	}

	.rtem-browser {
		grid-column: 5;
		grid-row: 1;
	}

	.rtem-signal {
		position: relative;
		grid-row: 2;
		justify-self: center;
		width: 100%;
		color: var(--rtd-muted);
		font-size: 0.5625rem;
		line-height: 1.35;
		text-align: center;
	}

	.rtem-signal::before {
		content: "";
		position: absolute;
		top: 0;
		bottom: 0;
		left: 50%;
		border-left: 1.5px dashed var(--rtd-line);
	}

	.rtem-signal::after {
		content: "";
		position: absolute;
		top: 0;
		left: calc(50% - 3px);
		width: 6px;
		height: 6px;
		border-top: 1.5px solid var(--rtd-line);
		border-right: 1.5px solid var(--rtd-line);
		transform: rotate(-45deg);
	}

	.rtem-signal--both > span::after {
		content: "";
		position: absolute;
		bottom: -2.65rem;
		left: calc(50% - 3px);
		width: 6px;
		height: 6px;
		border-top: 1.5px solid var(--rtd-line);
		border-right: 1.5px solid var(--rtd-line);
		transform: rotate(135deg);
	}

	.rtem-signal > span {
		position: relative;
		top: 50%;
		display: inline-block;
		padding: 0.25rem 0.4rem;
		background: var(--rtd-panel);
		transform: translateY(-50%);
		z-index: 1;
	}

	.rtem-signal--device {
		grid-column: 1;
	}

	.rtem-signal--sfu {
		grid-column: 3;
	}

	.rtem-signal--browser {
		grid-column: 5;
	}

	.rtem-backend {
		grid-column: 1 / 6;
		grid-row: 3;
	}

	.rtem-backend-grid {
		display: grid;
		grid-template-columns: minmax(8rem, 1fr) minmax(6rem, 0.65fr) minmax(
				8rem,
				1fr
			);
		align-items: stretch;
		max-width: 620px;
		margin: 0 auto;
	}

	@container (max-width: 32rem) {
		.rtem-desktop {
			display: none;
		}

		.rt-diagram__mobile-routes {
			display: grid;
		}
	}
</style>
