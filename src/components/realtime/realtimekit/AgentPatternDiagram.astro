---
import RealtimeDiagramFrame from "../sfu/RealtimeDiagramFrame.astro";

interface Props {
	variant: "hidden" | "visible";
}

const { variant } = Astro.props;
const hidden = variant === "hidden";

const agentName = hidden ? "Monitor" : "Notes bot";
const events = "Transcripts, joins, broadcasts";

const ariaLabel = hidden
	? "People join a RealtimeKit meeting from a browser or app. A hidden agent is also in the meeting, but the RealtimeKit SDKs filter it out of the participant list and video grid, so people see only each other. The agent forwards transcripts, joins and leaves, and broadcasts over a WebSocket to your Durable Object."
	: "People join a RealtimeKit meeting from a browser or app. A visible agent named Notes bot is also in the meeting and appears as a tile in the video grid, even though it sends no audio or video. The agent forwards transcripts, joins and leaves, and broadcasts over a WebSocket to your Durable Object.";
---

<RealtimeDiagramFrame ariaLabel={ariaLabel} className="rt-agent-pattern">
	<div class="rtap-desktop">
		<div class="rt-diagram__node rtap-people">
			<strong>People</strong>
			<small>Browser or app with the RealtimeKit SDKs</small>
		</div>

		<div class="rt-diagram__connector rt-diagram__connector--both">
			<span class="rt-diagram__connector-start" aria-hidden="true"></span>
			<span class="rt-diagram__connector-label">Audio, video, chat</span>
		</div>

		<div class="rt-diagram__boundary rt-diagram__boundary--accent rtap-meeting">
			<span class="rt-diagram__boundary-label">RealtimeKit meeting</span>

			<div class="rtap-screen">
				<span class="rtap-screen-label">What people see</span>
				<div class="rtap-tiles">
					<div class="rtap-tile">Alice</div>
					<div class="rtap-tile">Bob</div>
					{!hidden && <div class="rtap-tile rtap-tile--agent">{agentName}</div>}
				</div>
			</div>

			<div
				class:list={[
					"rt-diagram__node",
					"rt-diagram__node--accent",
					"rtap-agent",
					{ "rtap-agent--hidden": hidden },
				]}
			>
				<span class="rt-diagram__eyebrow">
					{hidden ? "Hidden agent" : "Visible agent"}
				</span>
				<strong>{agentName}</strong>
				<small>
					{hidden
						? "Filtered out of the list and grid"
						: "Shows as a tile, with no audio or video"}
				</small>
			</div>
		</div>

		<div class="rt-diagram__connector">
			<span class="rt-diagram__connector-label">{events}</span>
		</div>

		<div class="rt-diagram__node rt-diagram__node--blue rtap-backend">
			<span class="rt-diagram__eyebrow">My code</span>
			<strong>Durable Object</strong>
			<small>WebSocket &harr; JSON</small>
		</div>
	</div>

	<div class="rt-diagram__mobile-routes">
		<div class="rt-diagram__mobile-route">
			<span>People</span>
			<small>Audio, video, chat ↔</small>
			<span>RealtimeKit meeting</span>
		</div>
		<div class="rt-diagram__mobile-route">
			<span>{agentName}</span>
			<small>{hidden ? "Hidden from people" : "Tile in the grid"}</small>
			<span>RealtimeKit meeting</span>
		</div>
		<div class="rt-diagram__mobile-route">
			<span>{agentName}</span>
			<small>{events} →</small>
			<span>Durable Object</span>
		</div>
	</div>
</RealtimeDiagramFrame>

<style>
	.rtap-desktop {
		display: grid;
		grid-template-columns:
			minmax(6.5rem, 1fr) minmax(4.5rem, 0.8fr) minmax(13rem, 1.8fr)
			minmax(5rem, 0.9fr) minmax(7rem, 1fr);
		align-items: center;
		max-width: 940px;
		margin: 0 auto;
	}

	.rtap-meeting {
		display: grid;
		gap: 0.75rem;
	}

	.rtap-screen {
		display: grid;
		gap: 0.4rem;
		padding: 0.5rem;
		border: 1px solid var(--rtd-border);
		border-radius: 0.5rem;
		background: var(--rtd-card);
	}

	.rtap-screen-label {
		color: var(--rtd-muted);
		font-family:
			ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
		font-size: 0.5625rem;
		text-transform: uppercase;
		letter-spacing: 0.04em;
	}

	.rtap-tiles {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.35rem;
	}

	.rtap-tile {
		display: flex;
		align-items: center;
		justify-content: center;
		aspect-ratio: 16 / 10;
		border-radius: 0.3rem;
		background: var(--rtd-head);
		color: var(--rtd-text);
		font-size: 0.625rem;
	}

	.rtap-tile--agent {
		border: 1px solid var(--rtd-accent);
		background: var(--rtd-accent-soft);
	}

	.rtap-agent--hidden {
		border-style: dashed;
		opacity: 0.85;
	}

	@container (max-width: 40rem) {
		.rtap-desktop {
			display: none;
		}

		.rt-diagram__mobile-routes {
			display: grid;
		}
	}
</style>
