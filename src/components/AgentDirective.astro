---
interface Props {
	/** Absolute or site-relative URL for the top-level llms.txt index. */
	llmsUrl: string;
}

const { llmsUrl } = Astro.props;
---

<blockquote class="llms-txt-directive" aria-hidden="true">
	Documentation Index<br />
	Fetch the complete documentation index at: {llmsUrl}<br />
	Use this file to discover all available pages before exploring further.
</blockquote>

<style>
	.llms-txt-directive {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}
</style>
